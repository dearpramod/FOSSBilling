            <td><input type="text" class="form-control form-control-sm" name="support_getting_started_url" value="{{ settings.support_getting_started_url }}" placeholder="/support/getting-started"></td>
            <td><input type="text" class="form-control form-control-sm" name="support_getting_started_label" value="{{ settings.support_getting_started_label }}" placeholder="{{ 'Getting Started Guide'|trans }}"></td>
          </tr>

        </tbody>
      </table>
    </div>
  </div>
</div>
</section>

{# ── Page Titles ── #}
<section id="s-titles">
<h4>{{ 'Page Titles'|trans }}</h4>
<div class="card mb-4">
  <div class="card-body">
    <label class="form-label">{{ 'Show category name in browser tab title'|trans }}</label>
    <div>
      <div class="btn-group" role="group">
        <input type="radio" class="btn-check" name="category_title_in_tab" id="r_ctit1" value="1" autocomplete="off"
               {% if settings.category_title_in_tab|default('1') != '0' %} checked="checked"{% endif %}>
        <label class="btn btn-outline-success" for="r_ctit1">{{ 'Yes'|trans }}</label>
        <input type="radio" class="btn-check" name="category_title_in_tab" id="r_ctit0" value="0" autocomplete="off"
               {% if settings.category_title_in_tab == '0' %} checked="checked"{% endif %}>
        <label class="btn btn-outline-secondary" for="r_ctit0">{{ 'No'|trans }}</label>
      </div>
    </div>
    <div class="form-text mt-2">{{ 'Prepends the product category name to the tab title on store pages.'|trans }}</div>
  </div>
</div>
</section>

{# ── Custom Code ── #}
<section id="s-code">
<h4>{{ 'Custom Code'|trans }}</h4>
<div class="card mb-0">
  <div class="card-body">
    <label class="form-label" for="inject_javascript">{{ 'Inject JavaScript (analytics, chat widgets, etc.)'|trans }}</label>
    <textarea class="form-control font-monospace" name="inject_javascript" id="inject_javascript"
              rows="7" placeholder="&lt;!-- Paste your script tags here --&gt;">{{ settings.inject_javascript }}</textarea>
    <div class="form-text">{{ 'Injected before the closing </body> tag on all pages.'|trans }}</div>
  </div>
</div>
</section>

{% endblock %}
