      <div class="col-md-4">
        <label class="form-label" for="support_chat_label">{{ 'Live Chat button label'|trans }}</label>
        <input type="text" class="form-control" name="support_chat_label" id="support_chat_label"
               value="{{ settings.support_chat_label }}" placeholder="{{ 'Start Live Chat'|trans }}">
      </div>
    </div>
  </div>
</div>
</section>

{# ── Help Panel ── #}
