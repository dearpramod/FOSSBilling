                <input type="radio" class="btn-check" name="support_show_view_tickets" id="r_ssvt0" value="0" autocomplete="off"
                       {% if settings.support_show_view_tickets == '0' %} checked="checked"{% endif %}>
                <label class="btn btn-sm btn-outline-secondary" for="r_ssvt0">{{ 'Hide'|trans }}</label>
              </div>
            </td>
            <td colspan="2"><small class="text-muted">{{ 'Uses Support URL above'|trans }}</small></td>
          </tr>

          <tr>
            <td><strong>{{ 'WhatsApp Support'|trans }}</strong><br><small class="text-muted">{{ 'Shown only if number set'|trans }}</small></td>
            <td>
              <div class="btn-group btn-group-sm" role="group">
                <input type="radio" class="btn-check" name="support_show_whatsapp" id="r_sswp1" value="1" autocomplete="off"
