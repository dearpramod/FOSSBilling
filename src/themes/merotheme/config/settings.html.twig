                <label class="btn btn-sm btn-outline-success" for="r_sst1">{{ 'Show'|trans }}</label>
                <input type="radio" class="btn-check" name="support_show_ticket" id="r_sst0" value="0" autocomplete="off"
                       {% if settings.support_show_ticket == '0' %} checked="checked"{% endif %}>
