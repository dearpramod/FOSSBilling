      <table class="table table-sm table-bordered align-middle">
        <thead class="table-light">
          <tr>
            <th>{{ 'Panel Item'|trans }}</th>
            <th>{{ 'Visibility'|trans }}</th>
            <th>{{ 'URL'|trans }}</th>
            <th>{{ 'Label'|trans }}</th>
