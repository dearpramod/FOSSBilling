            <td colspan="2"><small class="text-muted">{{ 'Uses WhatsApp number from Support & Contact above'|trans }}</small></td>
          </tr>

          <tr>
            <td><strong>{{ 'Phone Support'|trans }}</strong><br><small class="text-muted">{{ 'Shown only if number set'|trans }}</small></td>
            <td>
              <div class="btn-group btn-group-sm" role="group">
                <input type="radio" class="btn-check" name="support_show_phone" id="r_ssph1" value="1" autocomplete="off"
                       {% if settings.support_show_phone|default('1') != '0' %} checked="checked"{% endif %}>
                <label class="btn btn-sm btn-outline-success" for="r_ssph1">{{ 'Show'|trans }}</label>
                <input type="radio" class="btn-check" name="support_show_phone" id="r_ssph0" value="0" autocomplete="off"
