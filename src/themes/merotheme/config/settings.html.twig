            <td><input type="text" class="form-control form-control-sm" name="support_kb_label" value="{{ settings.support_kb_label }}" placeholder="{{ 'Knowledge Base'|trans }}"></td>
          </tr>

          <tr>
            <td><strong>{{ 'Getting Started Guide'|trans }}</strong></td>
            <td>
              <div class="btn-group btn-group-sm" role="group">
                <input type="radio" class="btn-check" name="support_show_getting_started" id="r_ssgs1" value="1" autocomplete="off"
                       {% if settings.support_show_getting_started|default('1') != '0' %} checked="checked"{% endif %}>
