                <input type="radio" class="btn-check" name="support_show_kb" id="r_sskb1" value="1" autocomplete="off"
                       {% if settings.support_show_kb|default('1') != '0' %} checked="checked"{% endif %}>
                <label class="btn btn-sm btn-outline-success" for="r_sskb1">{{ 'Show'|trans }}</label>
                <input type="radio" class="btn-check" name="support_show_kb" id="r_sskb0" value="0" autocomplete="off"
                       {% if settings.support_show_kb == '0' %} checked="checked"{% endif %}>
