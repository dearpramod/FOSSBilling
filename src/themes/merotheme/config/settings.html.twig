                <label class="btn btn-sm btn-outline-secondary" for="r_ssst0">{{ 'Hide'|trans }}</label>
              </div>
            </td>
            <td><input type="text" class="form-control form-control-sm" name="support_sales_ticket_url" value="{{ settings.support_sales_ticket_url }}" placeholder="/support"></td>
            <td><input type="text" class="form-control form-control-sm" name="support_sales_ticket_label" value="{{ settings.support_sales_ticket_label }}" placeholder="{{ 'Create Sales Ticket'|trans }}"></td>
          </tr>

          <tr>
            <td><strong>{{ 'View My Tickets'|trans }}</strong><br><small class="text-muted">{{ 'Logged-in only'|trans }}</small></td>
            <td>
              <div class="btn-group btn-group-sm" role="group">
                <input type="radio" class="btn-check" name="support_show_view_tickets" id="r_ssvt1" value="1" autocomplete="off"
