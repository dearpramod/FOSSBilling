{% macro selectbox(name, options, selected, required, nullOption) %}
    <select name="{{ name }}" class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent {% if required %}is-required{% endif %}">
        {% if nullOption %}<option value="">{{ nullOption }}</option>{% endif %}
        {% for val, label in options %}
            <option value="{{ val }}" {% if selected == val %}selected{% endif %}>{{ label }}</option>
        {% endfor %}
    </select>
{% endmacro %}

{% macro selectboxtld(name, options, selected, required) %}
    <select name="{{ name }}" class="px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 {% if required %}is-required{% endif %}" style="width: 120px;">
        {% for data in options %}
            <option value="{{ data.tld }}" {% if selected == data.tld %}selected{% endif %}>{{ data.tld }}</option>
        {% endfor %}
    </select>
{% endmacro %}

{% macro currency_format(price, currency) %}
    {{ price | money(currency) }}
{% endmacro %}

{% macro currency(price, currency) %}
    {{ price | money_convert }}
{% endmacro %}

{% macro status_badge(status) %}
    {% set s = status|replace({'_': " "})|trim|lower %}
    {% if s == 'active' %}
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-green-500/15 text-green-400 border border-green-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>Active
        </span>
    {% elseif s == 'pending setup' %}
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-amber-500/15 text-amber-400 border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>Pending Setup
        </span>
    {% elseif s == 'failed setup' or s == 'failed renew' %}
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-red-500/15 text-red-400 border border-red-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>{{ status|replace({'_': " "})|title }}
        </span>
    {% elseif s == 'suspended' %}
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-orange-500/15 text-orange-400 border border-orange-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>Suspended
        </span>
    {% elseif s == 'canceled' or s == 'cancelled' %}
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-500/15 text-gray-400 border border-gray-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>Canceled
        </span>
    {% elseif s == 'paid' %}
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-green-500/15 text-green-400 border border-green-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>Paid
        </span>
    {% elseif s == 'unpaid' %}
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-red-500/15 text-red-400 border border-red-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>Unpaid
        </span>
    {% elseif s == 'refunded' %}
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-500/15 text-blue-400 border border-blue-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>Refunded
        </span>
    {% elseif s == 'on_hold' or s == 'on hold' %}
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-amber-500/15 text-amber-400 border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>On Hold
        </span>
    {% elseif s == 'open' %}
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-500/15 text-blue-400 border border-blue-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>Open
        </span>
    {% elseif s == 'closed' %}
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-500/15 text-gray-400 border border-gray-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>Closed
        </span>
    {% else %}
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-white/5 text-gray-400 border border-white/10">
            {{ status|replace({'_': " "})|title }}
        </span>
    {% endif %}
{% endmacro %}

{% macro period_name(period) %}
    {{ period | period_title }}
{% endmacro %}

{% macro form_field(label, name, type, value, required, placeholder) %}
    <div class="space-y-1.5">
        <label class="block text-sm font-medium text-gray-300">{{ label }}{% if required %} <span class="text-red-400">*</span>{% endif %}</label>
        <input type="{{ type|default('text') }}"
               name="{{ name }}"
               value="{{ value }}"
               {% if required %}required{% endif %}
               {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
               class="w-full px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
    </div>
{% endmacro %}

