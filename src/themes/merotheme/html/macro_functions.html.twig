{% macro recaptcha() %}
{% if guest.extension_is_on({"mod":"spamchecker"}) %}
{% set rc = guest.spamchecker_recaptcha %}
    {% if rc.enabled and rc.publickey and rc.pages.contact %}
        {% if rc.version == 3 %}
            {# reCAPTCHA Enterprise — invisible score-based, no user-facing widget #}
            <script src="https://www.google.com/recaptcha/enterprise.js?render={{ rc.publickey }}" async defer></script>
            <input type="hidden" name="g-recaptcha-response" id="g-recaptcha-response-macro">
            <script>
            (function(){
                function attachEnterprise(form) {
                    if (!form) return;
                    form.addEventListener('submit', function(e) {
                        e.preventDefault();
                        grecaptcha.enterprise.ready(function() {
                            grecaptcha.enterprise.execute('{{ rc.publickey }}', {action: 'SUBMIT_TICKET'}).then(function(token) {
                                var field = form.querySelector('[name="g-recaptcha-response"]');
                                if (field) field.value = token;
                                form.submit();
                            });
                        });
                    }, {once: false});
                }
                document.addEventListener('DOMContentLoaded', function() {
                    var el = document.getElementById('g-recaptcha-response-macro');
                    if (el) attachEnterprise(el.closest('form'));
                });
            }());
            </script>
        {% else %}
            {# reCAPTCHA v2 — checkbox widget #}
            <script src='https://www.google.com/recaptcha/api.js' async defer></script>
            <div class="g-recaptcha mt-3 mb-4" data-sitekey="{{ rc.publickey }}"></div>
        {% endif %}
    {% endif %}
{% endif %}
{% endmacro %}

{% macro status_name(status) %}
    {% set s = status|replace({'_': " "})|title|trim %}
    {% if s == 'Active' %}{{ 'Active'|trans }}
    {% elseif s == 'Pending Setup' %}{{ 'Pending Setup'|trans }}
    {% elseif s == 'Failed Setup' %}{{ 'Failed Setup'|trans }}
    {% elseif s == 'Failed Renew' %}{{ 'Failed Renewal'|trans }}
    {% elseif s == 'Suspended' %}{{ 'Suspended'|trans }}
    {% elseif s == 'Canceled' or s == 'Cancelled' %}{{ 'Canceled'|trans }}
    {% elseif s == 'Paid' %}{{ 'Paid'|trans }}
    {% elseif s == 'Unpaid' %}{{ 'Unpaid'|trans }}
    {% elseif s == 'Refunded' %}{{ 'Refunded'|trans }}
    {% elseif s == 'On Hold' %}{{ 'On Hold'|trans }}
    {% elseif s == 'Open' %}{{ 'Open'|trans }}
    {% elseif s == 'Closed' %}{{ 'Closed'|trans }}
    {% else %}{{ s|trans }}{% endif %}
{% endmacro %}

{% macro markdown_quote(text) %}
{% for line in text|split('\n') %}
> {{ line }}
{% endfor %}
{% endmacro %}
