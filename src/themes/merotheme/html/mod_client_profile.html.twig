{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}Account Settings{% endblock %}
{% block page_header %}Account Settings{% endblock %}

{% import "macro_functions.html.twig" as mf %}

{% block content %}
{# profile is already set by layout_default (with deep=true balance) — no need to re-fetch #}
{% set active_orders = client.order_get_list({'status': 'active', 'per_page': 100}) %}
{% set countries = guest.system_countries %}
{% set currency_pairs = guest.currency_get_pairs %}
{% set custom_fields = guest.client_custom_fields %}

{# Page Header #}
<div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Account Settings</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Manage your personal information, billing preferences, and security.</p>
    </div>
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 bg-green-100 text-green-700 rounded-full self-start sm:self-auto">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
        Account Verified
    </span>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

    {# ── LEFT SIDEBAR (col-4) ── #}
    <div class="lg:col-span-4 space-y-4">

        {# Profile Card #}
        <div class="bg-white dark:bg-white/[0.03] rounded-xl border border-slate-200 dark:border-white/[0.08] shadow-sm p-6 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 rounded-full -mr-16 -mt-16 opacity-[0.06]" style="background: var(--color-primary);"></div>
            <div class="relative z-10 flex flex-col items-center text-center">
                <div class="w-20 h-20 rounded-full flex items-center justify-center text-white text-2xl font-bold shadow-md mb-4 ring-4 ring-white dark:ring-white/10"
                     style="background: var(--color-primary);">
                    {{ profile.first_name|first|upper }}{{ profile.last_name|first|upper }}
                </div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">{{ profile.first_name }} {{ profile.last_name }}</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Client since {{ profile.created_at|date('Y') }}</p>
                <div class="mt-5 w-full grid grid-cols-2 gap-3">
                    <div class="bg-slate-50 dark:bg-white/[0.04] rounded-lg p-3 text-left">
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 mb-1">Balance</p>
                        <p class="text-sm font-bold text-slate-900 dark:text-white">{{ profile.balance|money(profile.currency) }}</p>
                    </div>
                    <div class="bg-slate-50 dark:bg-white/[0.04] rounded-lg p-3 text-left">
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 mb-1">Services</p>
                        <p class="text-sm font-bold text-slate-900 dark:text-white">{{ '%02d'|format(active_orders.total) }} Active</p>
                    </div>
                </div>
            </div>
        </div>

        {# Side Navigation #}
        <div class="bg-white dark:bg-white/[0.03] rounded-xl border border-slate-200 dark:border-white/[0.08] shadow-sm py-2">
            <a href="/client/profile"
               class="flex items-center gap-3 px-5 py-3.5 font-semibold text-sm border-r-4 transition-colors"
               style="color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 8%, transparent); border-color: var(--color-primary);">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                Personal Information
            </a>

            <a href="/invoice"
               class="flex items-center gap-3 px-5 py-3.5 text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-white/[0.04] transition-colors">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                </svg>
                Invoices
            </a>
            <a href="/email"
               class="flex items-center gap-3 px-5 py-3.5 text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-white/[0.04] transition-colors">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                </svg>
                Email History
            </a>
            <div class="border-t border-slate-100 dark:border-white/[0.06] my-2"></div>
            <a href="/logout"
               class="flex items-center gap-3 px-5 py-3.5 text-sm text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
                Log Out
            </a>
        </div>

    </div>

    {# ── RIGHT CONTENT (col-8) ── #}
    <div class="lg:col-span-8 space-y-6">

        {# Personal Information #}
        <section class="bg-white dark:bg-white/[0.03] rounded-xl border border-slate-200 dark:border-white/[0.08] shadow-sm"
                 x-data="{ editing: false }">
            <div class="px-6 py-5 border-b border-slate-100 dark:border-white/[0.06] flex items-center justify-between">
                <h3 class="text-base font-semibold text-slate-900 dark:text-white">Personal Information</h3>
                {# Edit button — visible in view mode #}
                <button type="button" x-show="!editing" @click="editing = true"
                        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 dark:border-white/[0.10] text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/[0.05] transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    Edit
                </button>
                {# Editing indicator — visible in edit mode #}
                <span x-show="editing" style="display:none"
                      class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 bg-amber-50 text-amber-700 dark:bg-amber-900/20 dark:text-amber-400 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                    Editing
                </span>
            </div>

            {# ── VIEW MODE ── #}
            <div x-show="!editing" class="p-6">
                <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5">
                    <div>
                        <dt class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">First Name</dt>
                        <dd class="text-sm font-medium text-slate-900 dark:text-white">{{ profile.first_name|default('—') }}</dd>
                    </div>
                    <div>
                        <dt class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Last Name</dt>
                        <dd class="text-sm font-medium text-slate-900 dark:text-white">{{ profile.last_name|default('—') }}</dd>
                    </div>
                    <div class="sm:col-span-2">
                        <dt class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Email Address</dt>
                        <dd class="text-sm font-medium text-slate-900 dark:text-white">{{ profile.email|default('—') }}</dd>
                    </div>
                    <div>
                        <dt class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Phone</dt>
                        <dd class="text-sm font-medium text-slate-900 dark:text-white">{{ profile.phone|default('—') }}</dd>
                    </div>
                    <div>
                        <dt class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Company</dt>
                        <dd class="text-sm font-medium text-slate-900 dark:text-white">{{ profile.company|default('—') }}</dd>
                    </div>
                    {% if profile.address_1 or profile.city or profile.country %}
                    <div class="sm:col-span-2">
                        <dt class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Address</dt>
                        <dd class="text-sm font-medium text-slate-900 dark:text-white leading-relaxed">
                            {% if profile.address_1 %}{{ profile.address_1 }}{% if profile.address_2 %}, {{ profile.address_2 }}{% endif %}{% endif %}
                            {% if profile.city or profile.state or profile.postcode %}
                            <br>{{ [profile.city, profile.state, profile.postcode]|filter(v => v is not empty)|join(', ') }}
                            {% endif %}
                            {% if profile.country %}
                            <br>{{ countries[profile.country]|default(profile.country) }}
                            {% endif %}
                        </dd>
                    </div>
                    {% endif %}
                    {% for i in 1..10 %}
                        {% set custom = 'custom_' ~ i %}
                        {% set current = custom_fields[custom] %}
                        {% if current.active %}
                        <div>
                            <dt class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">{{ current.title }}</dt>
                            <dd class="text-sm font-medium text-slate-900 dark:text-white">{{ profile[custom]|default('—') }}</dd>
                        </div>
                        {% endif %}
                    {% endfor %}
                    {% if profile.currency %}
                    <div class="sm:col-span-2">
                        <dt class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Billing Currency</dt>
                        <dd class="text-sm font-medium text-slate-900 dark:text-white">
                            <span class="font-mono font-bold">{{ profile.currency }}</span>
                            {% if currency_pairs[profile.currency] %}<span class="text-slate-400 font-normal ml-2">{{ currency_pairs[profile.currency] }}</span>{% endif %}
                        </dd>
                    </div>
                    {% endif %}
                </dl>
            </div>

            {# ── EDIT MODE ── #}
            <div x-show="editing" style="display:none" class="p-6">
                <form id="form-profile-update" class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">

                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">First Name <span class="text-red-400">*</span></label>
                        <input type="text" name="first_name" value="{{ profile.first_name }}" required
                               class="w-full px-4 py-2.5 rounded-lg border border-slate-200 dark:border-white/[0.10] bg-white dark:bg-white/[0.03] text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 transition-all"
                               onfocus="this.style.borderColor='var(--color-primary)'" onblur="this.style.borderColor=''">
                    </div>

                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Last Name <span class="text-red-400">*</span></label>
                        <input type="text" name="last_name" value="{{ profile.last_name }}" required
                               class="w-full px-4 py-2.5 rounded-lg border border-slate-200 dark:border-white/[0.10] bg-white dark:bg-white/[0.03] text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 transition-all"
                               onfocus="this.style.borderColor='var(--color-primary)'" onblur="this.style.borderColor=''">
                    </div>

                    <div class="space-y-1.5 sm:col-span-2">
                        <div class="flex items-center justify-between">
                            <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Email Address <span class="text-red-400">*</span></label>
                            <span class="text-[10px] uppercase tracking-widest bg-slate-100 dark:bg-white/[0.06] text-slate-500 px-2 py-0.5 rounded font-semibold">Cannot be changed</span>
                        </div>
                        <input type="email" value="{{ profile.email }}" readonly
                               class="w-full px-4 py-2.5 rounded-lg border border-slate-100 dark:border-white/[0.05] bg-slate-50 dark:bg-white/[0.02] text-slate-400 text-sm cursor-not-allowed">
                    </div>

                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Phone</label>
                        <input type="tel" name="phone" value="{{ profile.phone }}"
                               inputmode="tel" pattern="^\+?[\d\s\-\.\(\)]{5,30}$" placeholder="+1 555 000 0000"
                               class="w-full px-4 py-2.5 rounded-lg border border-slate-200 dark:border-white/[0.10] bg-white dark:bg-white/[0.03] text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 transition-all"
                               onfocus="this.style.borderColor='var(--color-primary)'" onblur="this.style.borderColor=''">
                    </div>

                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Company</label>
                        <input type="text" name="company" value="{{ profile.company }}"
                               class="w-full px-4 py-2.5 rounded-lg border border-slate-200 dark:border-white/[0.10] bg-white dark:bg-white/[0.03] text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 transition-all"
                               onfocus="this.style.borderColor='var(--color-primary)'" onblur="this.style.borderColor=''">
                    </div>

                    <div class="space-y-1.5 sm:col-span-2">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Address</label>
                        <input type="text" name="address_1" value="{{ profile.address_1 }}" placeholder="Street address"
                               class="w-full px-4 py-2.5 rounded-lg border border-slate-200 dark:border-white/[0.10] bg-white dark:bg-white/[0.03] text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 transition-all mb-2"
                               onfocus="this.style.borderColor='var(--color-primary)'" onblur="this.style.borderColor=''">
                        <input type="text" name="address_2" value="{{ profile.address_2 }}" placeholder="Apartment, suite, etc. (optional)"
                               class="w-full px-4 py-2.5 rounded-lg border border-slate-200 dark:border-white/[0.10] bg-white dark:bg-white/[0.03] text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 transition-all"
                               onfocus="this.style.borderColor='var(--color-primary)'" onblur="this.style.borderColor=''">
                    </div>

                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">City</label>
                        <input type="text" name="city" value="{{ profile.city }}"
                               class="w-full px-4 py-2.5 rounded-lg border border-slate-200 dark:border-white/[0.10] bg-white dark:bg-white/[0.03] text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 transition-all"
                               onfocus="this.style.borderColor='var(--color-primary)'" onblur="this.style.borderColor=''">
                    </div>

                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">State</label>
                        <input type="text" name="state" value="{{ profile.state }}"
                               class="w-full px-4 py-2.5 rounded-lg border border-slate-200 dark:border-white/[0.10] bg-white dark:bg-white/[0.03] text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 transition-all"
                               onfocus="this.style.borderColor='var(--color-primary)'" onblur="this.style.borderColor=''">
                    </div>

                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Postal Code</label>
                        <input type="text" name="postcode" value="{{ profile.postcode }}"
                               class="w-full px-4 py-2.5 rounded-lg border border-slate-200 dark:border-white/[0.10] bg-white dark:bg-white/[0.03] text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 transition-all"
                               onfocus="this.style.borderColor='var(--color-primary)'" onblur="this.style.borderColor=''">
                    </div>

                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Country</label>
                        <select name="country"
                                class="w-full px-4 py-2.5 rounded-lg border border-slate-200 dark:border-white/[0.10] bg-white dark:bg-white/[0.03] text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 transition-all"
                                onfocus="this.style.borderColor='var(--color-primary)'" onblur="this.style.borderColor=''">
                            <option value="">Select country…</option>
                            {% for code, name in countries %}
                                <option value="{{ code }}" {% if profile.country == code %}selected{% endif %}>{{ name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    {# Custom Fields #}
                    {% for i in 1..10 %}
                        {% set custom = 'custom_' ~ i %}
                        {% set current = custom_fields[custom] %}
                        {% if current.active %}
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                                {{ current.title }}{% if current.required %} <span class="text-red-400">*</span>{% endif %}
                            </label>
                            <input type="text" name="{{ custom }}" value="{{ profile[custom] }}"
                                   {% if current.required %}required{% endif %}
                                   class="w-full px-4 py-2.5 rounded-lg border border-slate-200 dark:border-white/[0.10] bg-white dark:bg-white/[0.03] text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 transition-all"
                                   onfocus="this.style.borderColor='var(--color-primary)'" onblur="this.style.borderColor=''">
                        </div>
                        {% endif %}
                    {% endfor %}

                    {# Billing Currency #}
                    {% if profile.currency %}
                    <div class="space-y-1.5 sm:col-span-2">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Billing Currency</label>
                        <div class="flex items-center gap-3 px-4 py-2.5 rounded-lg bg-slate-50 dark:bg-white/[0.02] border border-slate-100 dark:border-white/[0.05]">
                            <span class="text-sm font-bold text-slate-900 dark:text-white font-mono">{{ profile.currency }}</span>
                            <span class="text-sm text-slate-400">{{ currency_pairs[profile.currency]|default('') }}</span>
                            <span class="ml-auto text-xs text-slate-400 flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                Set during registration
                            </span>
                        </div>
                    </div>
                    {% endif %}

                </form>
            </div>

            {# Footer — only shown in edit mode #}
            <div x-show="editing" style="display:none"
                 class="px-6 py-4 bg-slate-50 dark:bg-white/[0.02] border-t border-slate-100 dark:border-white/[0.06] flex items-center gap-4">
                <span id="profile-inline-msg" class="hidden text-xs font-medium flex items-center gap-1.5"></span>
                <div class="ml-auto flex items-center gap-3">
                    <button type="button" @click="editing = false"
                            class="px-5 py-2.5 rounded-lg text-sm font-semibold border border-slate-200 dark:border-white/[0.10] text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/[0.05] transition-colors">
                        Cancel
                    </button>
                    <button type="submit" form="form-profile-update" id="btn-save-profile"
                            class="inline-flex items-center gap-2 px-7 py-2.5 rounded-lg text-white text-sm font-semibold hover:opacity-90 active:scale-95 transition-all disabled:opacity-60"
                            style="background: var(--color-primary); box-shadow: 0 4px 14px color-mix(in srgb, var(--color-primary) 25%, transparent);">
                        <svg id="btn-save-profile-spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                        </svg>
                        <span id="btn-save-profile-label">Save Changes</span>
                    </button>
                </div>
            </div>
        </section>

        {# Change Password #}
        <section class="bg-white dark:bg-white/[0.03] rounded-xl border border-slate-200 dark:border-white/[0.08] shadow-sm">
            <div class="px-6 py-5 border-b border-slate-100 dark:border-white/[0.06]">
                <h3 class="text-base font-semibold text-slate-900 dark:text-white">Change Password</h3>
            </div>
            <div class="p-6">
                <form id="form-change-password" class="space-y-5 max-w-lg">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">

                    {% if profile.is_social %}
                    <div class="rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-800 dark:border-sky-700/60 dark:bg-sky-900/20 dark:text-sky-300">
                        {{ 'You are signed in using Google. Set a backup password below to also use email login.'|trans }}
                    </div>
                    {% endif %}

                    {% if not profile.is_social %}
                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Current Password <span class="text-red-400">*</span></label>
                        <div class="relative">
                            <input type="password" name="current_password" id="pw-current" required autocomplete="current-password" placeholder="••••••••"
                                   class="w-full px-4 py-2.5 pr-11 rounded-lg border border-slate-200 dark:border-white/[0.10] bg-white dark:bg-white/[0.03] text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 transition-all"
                                   onfocus="this.style.borderColor='var(--color-primary)'" onblur="this.style.borderColor=''">
                            <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-white transition-colors" onclick="togglePw('pw-current', this)">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            </button>
                        </div>
                    </div>
                    {% endif %}

                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">New Password <span class="text-red-400">*</span></label>
                        <div class="relative">
                            <input type="password" name="new_password" id="pw-new" required autocomplete="new-password" placeholder="Enter new password"
                                   class="w-full px-4 py-2.5 pr-11 rounded-lg border border-slate-200 dark:border-white/[0.10] bg-white dark:bg-white/[0.03] text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 transition-all"
                                   onfocus="this.style.borderColor='var(--color-primary)'" onblur="this.style.borderColor=''">
                            <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-white transition-colors" onclick="togglePw('pw-new', this)">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            </button>
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Confirm New Password <span class="text-red-400">*</span></label>
                        <div class="relative">
                            <input type="password" name="confirm_password" id="pw-confirm" required autocomplete="new-password" placeholder="Confirm new password"
                                   class="w-full px-4 py-2.5 pr-11 rounded-lg border border-slate-200 dark:border-white/[0.10] bg-white dark:bg-white/[0.03] text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 transition-all"
                                   onfocus="this.style.borderColor='var(--color-primary)'" onblur="this.style.borderColor=''">
                            <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-white transition-colors" onclick="togglePw('pw-confirm', this)">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            </button>
                        </div>
                    </div>

                    <div class="pt-2 flex items-center gap-3">
                        <button type="submit" id="btn-change-password"
                                class="inline-flex items-center gap-2 px-7 py-2.5 rounded-lg text-white text-sm font-semibold hover:opacity-90 active:scale-95 transition-all disabled:opacity-60"
                                style="background: var(--color-primary);">
                            <svg id="btn-change-password-spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                            </svg>
                            Update Password
                        </button>
                        <span id="password-inline-msg" class="hidden text-xs font-medium"></span>
                    </div>
                </form>
            </div>
        </section>

        {% if guest.extension_is_on({'mod': 'supportpin'}) %}
        {# ── Support PIN ── #}
        {% set _pin = client.supportpin_get %}
        <section class="bg-white dark:bg-white/[0.03] rounded-xl border border-slate-200 dark:border-white/[0.08] shadow-sm"
                 x-data="{ pinRevealed: false, newPin: null, copying: false }">
            <div class="px-6 py-5 border-b border-slate-100 dark:border-white/[0.06] flex items-center justify-between">
                <div>
                    <h3 class="text-base font-semibold text-slate-900 dark:text-white">{{ 'Support PIN'|trans }}</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">{{ 'Use this PIN when contacting our support team to verify your identity.'|trans }}</p>
                </div>
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 bg-green-50 text-green-700 dark:bg-green-900/20 dark:text-green-400 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>{{ 'Active'|trans }}
                </span>
            </div>
            <div class="p-6 space-y-5">

                {# PIN display #}
                <div class="flex items-center gap-4">
                    <div class="flex-1 bg-slate-50 dark:bg-white/[0.04] rounded-lg px-5 py-3 flex items-center justify-between">
                        <span class="font-mono text-2xl font-bold tracking-[0.3em] text-slate-900 dark:text-white select-none"
                              x-text="pinRevealed ? (newPin || '{{ _pin.pin }}') : '● ● ● ● ● ●'">● ● ● ● ● ●</span>
                        <button @click="pinRevealed = !pinRevealed" type="button"
                                class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors ml-4"
                                :title="pinRevealed ? '{{ 'Hide PIN'|trans }}' : '{{ 'Show PIN'|trans }}'">
                            <svg x-show="!pinRevealed" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                            <svg x-show="pinRevealed" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:none">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
                            </svg>
                        </button>
                    </div>
                    <button @click="navigator.clipboard.writeText(newPin || '{{ _pin.pin }}').then(function(){ copying = true; setTimeout(function(){ copying = false; }, 2000); })"
                            type="button"
                            class="flex items-center gap-1.5 px-4 py-3 rounded-lg border border-slate-200 dark:border-white/[0.10] text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/[0.04] transition-colors"
                            :class="copying ? 'text-green-600 border-green-300' : ''">
                        <svg x-show="!copying" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                        </svg>
                        <svg x-show="copying" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:none">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span x-text="copying ? '{{ 'Copied!'|trans }}' : '{{ 'Copy'|trans }}'">{{ 'Copy'|trans }}</span>
                    </button>
                </div>

                {# New PIN success banner (shown after regeneration) #}
                <div x-show="newPin !== null" style="display:none"
                     class="flex items-center gap-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-lg px-4 py-3">
                    <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold text-green-800 dark:text-green-300">{{ 'New PIN generated'|trans }}</p>
                        <p class="text-xs text-green-700 dark:text-green-400 mt-0.5">
                            {{ 'Your new PIN is'|trans }}: <span class="font-mono font-bold tracking-widest" x-text="newPin"></span>
                        </p>
                    </div>
                    <button @click="newPin = null" type="button" class="text-green-500 hover:text-green-700">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>

                {# Last changed + Regenerate #}
                <div class="flex items-center justify-between pt-1">
                    {% if _pin.changed_at %}
                    <p class="text-xs text-slate-400 dark:text-slate-500">
                        {{ 'Last changed'|trans }}: {{ _pin.changed_at|date('M d, Y') }}
                    </p>
                    {% else %}
                    <span></span>
                    {% endif %}
                    <div x-data="{ confirming: false, working: false }" class="flex items-center gap-2">
                        {# Confirmation strip — shown when confirming=true #}
                        <template x-if="confirming">
                            <div class="flex items-center gap-2">
                                <span class="text-xs text-amber-700 dark:text-amber-400 font-medium">{{ 'Replace current PIN?'|trans }}</span>
                                <button type="button"
                                        :disabled="working"
                                        @click="working = true; API.client.post('supportpin/regenerate', {}, function(r){ working = false; confirming = false; newPin = r.pin; pinRevealed = true; }, function(e){ working = false; alert(e.message); })"
                                        class="px-3 py-1.5 rounded-lg text-xs font-semibold text-white bg-amber-500 hover:bg-amber-600 transition-colors disabled:opacity-50">
                                    <span x-text="working ? '{{ 'Working…'|trans }}' : '{{ 'Yes'|trans }}'"></span>
                                </button>
                                <button type="button" @click="confirming = false" :disabled="working"
                                        class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors disabled:opacity-50">
                                    {{ 'No'|trans }}
                                </button>
                            </div>
                        </template>
                        <template x-if="!confirming">
                            <button type="button" @click="confirming = true"
                                    class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold text-white bg-primary transition-all hover:opacity-90 active:scale-95">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                </svg>
                                {{ 'Regenerate PIN'|trans }}
                            </button>
                        </template>
                    </div>
                </div>

            </div>
        </section>
        {% endif %}

    </div>
</div>
{% endblock %}

{% block js %}
<script>
(function () {
    function togglePw(id, btn) {
        var input = document.getElementById(id);
        input.type = input.type === 'password' ? 'text' : 'password';
        var svg = btn.querySelector('svg');
        if (input.type === 'text') {
            svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>';
        } else {
            svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>';
        }
    }
    window.togglePw = togglePw;

    function setLoading(btn, spinner, loading, label, savingText) {
        btn.disabled = loading;
        spinner.classList.toggle('hidden', !loading);
        if (label) label.textContent = loading ? (savingText || 'Saving…') : label.dataset.idle;
    }

    function showInlineMsg(el, text, isSuccess, autoHideMs) {
        el.textContent = text;
        el.className = 'text-xs font-medium ' + (isSuccess ? 'text-green-600' : 'text-red-500');
        el.classList.remove('hidden');
        clearTimeout(el._timer);
        el._timer = setTimeout(function () {
            el.classList.add('hidden');
            el.textContent = '';
        }, autoHideMs || 4000);
    }

    function collectForm(form) {
        var data = {};
        new FormData(form).forEach(function (v, k) { data[k] = v; });
        return data;
    }

    // ── Profile update ────────────────────────────────────────────────────
    var profileLabel     = document.getElementById('btn-save-profile-label');
    var profileInlineMsg = document.getElementById('profile-inline-msg');
    profileLabel.dataset.idle = profileLabel.textContent;
    document.getElementById('form-profile-update').addEventListener('submit', function (e) {
        e.preventDefault();
        var btn     = document.getElementById('btn-save-profile');
        var spinner = document.getElementById('btn-save-profile-spinner');
        setLoading(btn, spinner, true, profileLabel);
        API.client.post('profile/update', collectForm(this), function () {
            setLoading(btn, spinner, false, profileLabel);
            showInlineMsg(profileInlineMsg, '✓ Saved successfully', true);
            // Exit edit mode — find the Alpine section and set editing=false
            var section = document.getElementById('form-profile-update').closest('[x-data]');
            if (section && section._x_dataStack) {
                section._x_dataStack[0].editing = false;
            }
        }, function (err) {
            setLoading(btn, spinner, false, profileLabel);
            showInlineMsg(profileInlineMsg, (err && err.message ? err.message : 'Failed to save'), false);
        });
    });

    // ── Change password ───────────────────────────────────────────────────
    var pwInlineMsg = document.getElementById('password-inline-msg');
    document.getElementById('form-change-password').addEventListener('submit', function (e) {
        e.preventDefault();
        var btn     = document.getElementById('btn-change-password');
        var spinner = document.getElementById('btn-change-password-spinner');
        var data    = collectForm(this);
        if (data.new_password !== data.confirm_password) {
            showInlineMsg(pwInlineMsg, 'Passwords do not match', false);
            return;
        }
        setLoading(btn, spinner, true);
        API.client.post('profile/change_password', data, function () {
            setLoading(btn, spinner, false);
            showInlineMsg(pwInlineMsg, '✓ Password updated', true);
            document.getElementById('form-change-password').reset();
        }, function (err) {
            setLoading(btn, spinner, false);
            showInlineMsg(pwInlineMsg, (err && err.message ? err.message : 'Failed to update password'), false);
        });
    });
}());
</script>
{% endblock %}
