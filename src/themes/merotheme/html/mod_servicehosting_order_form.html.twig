{% set tlds = guest.serviceDomain_tlds({ 'allow_register': 1 }) %}
{% set transfer_tlds = guest.serviceDomain_tlds({ 'allow_transfer': 1 }) %}

{% set allow_register = product.config.allow_domain_register ?? true %}
{% set allow_transfer = product.config.allow_domain_transfer ?? true %}
{% set allow_own = product.config.allow_domain_own ?? true %}
{% set allow_subdomain = product.config.allow_subdomain ?? false %}
{% set subdomain_base_domain = product.config.subdomain_base_domain ?? null %}

{% set can_register = allow_register and tlds is not empty %}
{% set can_transfer = allow_transfer and transfer_tlds is not empty %}
{% set can_own = allow_own %}
{% set can_subdomain = allow_subdomain and subdomain_base_domain %}
{% set default_action = can_register ? 'register' : (can_transfer ? 'transfer' : (can_own ? 'owndomain' : (can_subdomain ? 'subdomain' : ''))) %}
{% set currency = guest.cart_get_currency %}

{% if default_action %}
<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden" id="domain-config-card">
  <div class="p-6">

    {# ── Header row: globe+title left, period selector top-right (stacks on mobile) ── #}
    <div class="flex flex-col sm:flex-row justify-between items-start gap-4 mb-4">

      {# Left: globe icon + title + subtitle #}
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-lg flex items-center justify-center flex-shrink-0"
             style="background:rgba(var(--color-primary-rgb),0.06); color:var(--color-primary);">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"
                  d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-bold text-slate-900">Secure your domain</h3>
          <p class="text-sm text-slate-500">Get your domain right away and publish your website faster</p>
        </div>
      </div>

      {# Right: period selector + price (only for recurrent products with enabled periods) #}
      {% if _opf_enabled is defined and _opf_enabled|length > 0 %}
      <div class="shrink-0 text-right">
        {% if _opf_enabled|length > 1 %}
        <label class="block text-xs font-medium text-slate-500 mb-1">Billing Period</label>
        <div class="relative inline-block mb-2">
          <select x-model="selectedPeriod" name="period"
                  class="pl-3 pr-8 py-2 border rounded-lg bg-white text-slate-900 text-sm font-medium appearance-none focus:outline-none"
                  style="border-color:rgba(var(--color-primary-rgb),0.3);">
            {% for pk in _opf_enabled %}
            <option value="{{ pk }}">{{ _opf_pk_labels[pk] }}</option>
            {% endfor %}
          </select>
          <div class="absolute inset-y-0 right-0 flex items-center pr-2 pointer-events-none"
               style="color:var(--color-primary);">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>
        </div>
        {% else %}
        <input type="hidden" name="period" :value="selectedPeriod">
        {% endif %}

        {# Savings badge #}
        <template x-if="getPeriodSavingsRaw(selectedPeriod) > 0">
          <div>
            <span class="inline-block px-2 py-0.5 bg-green-100 text-green-700 text-xs font-bold rounded mb-1"
                  x-text="'Save ' + formatMoney(getPeriodSavingsRaw(selectedPeriod))"></span>
          </div>
        </template>

        {# Monthly price + strikethrough #}
        <div x-show="selectedPeriod">
          <div class="text-2xl font-bold text-slate-900 leading-tight">
            <span x-text="formatMoney(getPeriodMonthly(selectedPeriod))"></span><span class="text-sm font-normal text-slate-500">/mo</span>
          </div>
          <template x-if="(periodMonthsMap[selectedPeriod] || 1) > 1 && productRawPrices['1M']">
            <div class="text-sm text-slate-400 line-through"
                 x-text="formatMoney(productRawPrices['1M']) + '/mo'"></div>
          </template>
        </div>
      </div>
      {% endif %}

    </div>

    {# Renewal text (below header, left-aligned) #}
    {% if _opf_enabled is defined and _opf_enabled|length > 0 %}
    <p class="text-sm text-slate-500 mb-4" x-show="selectedPeriod">
      Renews at
      <span x-text="formatMoney(productRawPrices[selectedPeriod] || 0)"></span>
      for a <span x-text="getPeriodLabel(selectedPeriod)"></span>. Cancel anytime.
    </p>
    {% endif %}

    {# FREE domain notice — shown when domain price is 0 #}
    <div x-show="domainRawPrice === 0"
         class="flex items-center gap-2 text-sm text-slate-600 bg-slate-50 p-3 rounded-lg border border-dashed border-slate-200 mb-6">
      <svg class="w-5 h-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      <span>Great news! You get a <span class="font-bold">FREE domain</span> included with this order.</span>
      <button type="button" class="ml-auto text-slate-400 hover:text-slate-600 flex-shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </button>
    </div>

    <hr class="border-slate-100 mb-6">

    {# Hidden domain action field — updated by JS on tab switch #}
    <input type="hidden" name="domain[action]" id="domain-action-input" value="{{ default_action }}">
    {% if can_subdomain %}
      <input type="hidden" name="domain[subdomain_base_domain]" value="{{ subdomain_base_domain }}">
    {% endif %}

    {# ── Mode tabs — Stitch: rounded-full pill buttons, gap-2, "Free" badges ── #}
    <div class="flex flex-wrap gap-2 mb-6">
      {% if can_register %}
      <button type="button"
              class="domain-tab flex items-center gap-2 px-4 py-2 rounded-full border text-sm font-medium transition-all"
              data-mode="register" data-active="{{ default_action == 'register' ? 'true' : 'false' }}">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Register New
        <span class="bg-green-100 text-green-700 px-1.5 py-0.5 rounded text-[10px] font-bold">Free</span>
      </button>
      {% endif %}
      {% if can_transfer %}
      <button type="button"
              class="domain-tab flex items-center gap-2 px-4 py-2 rounded-full border text-sm font-medium transition-all"
              data-mode="transfer" data-active="{{ default_action == 'transfer' ? 'true' : 'false' }}">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
        </svg>
        Transfer Domain
        <span class="bg-green-100 text-green-700 px-1.5 py-0.5 rounded text-[10px] font-bold">Free</span>
      </button>
      {% endif %}
      {% if can_own %}
      <button type="button"
              class="domain-tab flex items-center gap-2 px-4 py-2 rounded-full border text-sm font-medium transition-all"
              data-mode="owndomain" data-active="{{ default_action == 'owndomain' ? 'true' : 'false' }}">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
        </svg>
        Use Own Domain
      </button>
      {% endif %}
      {% if can_subdomain %}
      <button type="button"
              class="domain-tab flex items-center gap-2 px-4 py-2 rounded-full border text-sm font-medium transition-all"
              data-mode="subdomain" data-active="{{ default_action == 'subdomain' ? 'true' : 'false' }}">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
        </svg>
        Subdomain
      </button>
      {% endif %}
    </div>

    {# ── Register panel — Stitch-exact search row ── #}
    <div id="domain-panel-register" class="space-y-4"
         style="{{ default_action != 'register' ? 'display:none' : '' }}">
      <label class="block text-sm font-medium text-slate-700">Domain name</label>

      {# Main search row: input container + Check button attached (rounded-l + rounded-r) #}
      <div class="flex">
        <div class="relative flex-1">
          {# Search icon — absolute left #}
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
          {# Text input #}
          <input type="text" name="domain[register_sld]" id="register-sld"
                 value="{{ request.register_sld|default('') }}"
                 class="w-full pl-10 pr-24 py-3 border border-slate-200 rounded-l-lg text-slate-900 outline-none focus:border-opacity-60"
                 style="border-right:none;"
                 placeholder="yourdomain">
          {# TLD selector — absolute right inside input #}
          <div class="absolute inset-y-0 right-0 flex items-center pr-2 border-l border-slate-200">
            <select name="domain[register_tld]" id="register-tld"
                    class="px-2 py-1 text-sm font-semibold text-slate-700 bg-transparent appearance-none outline-none cursor-pointer"
                    style="min-width:4.5rem;">
              {% for tld in tlds %}
                <option value="{{ tld.tld }}"
                        {% if request.register_tld is defined and request.register_tld == tld.tld %}selected{% endif %}>
                  {{ tld.tld }}
                </option>
              {% endfor %}
            </select>
          </div>
        </div>
        {# Check button — attached right, matches Stitch bg-brand-300 (lighter primary) #}
        <button type="button" id="domain-check-btn"
                class="text-white px-8 py-3 rounded-r-lg font-bold transition-all whitespace-nowrap disabled:opacity-60"
                style="background:color-mix(in srgb, var(--color-primary) 65%, white);">
          Check
        </button>
      </div>

      {# Years select — subtle row below, matches functional need not in Stitch design #}
      <div class="flex items-center gap-2">
        <label class="text-xs text-slate-500">Registration period:</label>
        <select name="domain[register_years]" id="register-years-select"
                class="text-xs text-slate-600 border border-slate-200 rounded px-2 py-1 bg-white outline-none"
                style="width:auto;">
          <option value="1">1 year</option>
          <option value="2">2 years</option>
          <option value="3">3 years</option>
          <option value="4">4 years</option>
          <option value="5">5 years</option>
        </select>
      </div>

      {# Helper text — Stitch-exact with clock icon, Enter kbd, star mark #}
      <p class="text-xs text-slate-500 flex items-center gap-1">
        <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Type a name and press
        <kbd class="px-1.5 py-0.5 bg-slate-100 border border-slate-300 rounded text-[10px]">Enter</kbd>
        or click Check.
        <span class="text-orange-500 ml-1">★</span> marks free TLDs.
      </p>
    </div>

    {# ── Transfer panel ── #}
    <div id="domain-panel-transfer" class="space-y-4"
         style="{{ default_action != 'transfer' ? 'display:none' : '' }}">
      <label class="block text-sm font-medium text-slate-700">Domain name</label>
      <div class="flex">
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
          <input type="text" name="domain[transfer_sld]" id="transfer-sld"
                 value="{{ request.transfer_sld|default('') }}"
                 class="w-full pl-10 pr-24 py-3 border border-slate-200 rounded-l-lg text-slate-900 outline-none"
                 style="border-right:none;"
                 placeholder="yourdomain">
          <div class="absolute inset-y-0 right-0 flex items-center pr-2 border-l border-slate-200">
            <select name="domain[transfer_tld]" id="transfer-tld"
                    class="px-2 py-1 text-sm font-semibold text-slate-700 bg-transparent appearance-none outline-none cursor-pointer"
                    style="min-width:4.5rem;">
              {% for tld in transfer_tlds %}
                <option value="{{ tld.tld }}"
                        {% if request.transfer_tld is defined and request.transfer_tld == tld.tld %}selected{% endif %}>
                  {{ tld.tld }}
                </option>
              {% endfor %}
            </select>
          </div>
        </div>
        <button type="button" id="transfer-check-btn"
                class="text-white px-8 py-3 rounded-r-lg font-bold transition-all whitespace-nowrap disabled:opacity-60"
                style="background:color-mix(in srgb, var(--color-primary) 65%, white);">
          Check
        </button>
      </div>
      <div id="transfer-price-row" style="display:none;" class="text-sm text-slate-700">
        Transfer price: <strong id="transfer-price-value" style="color:var(--color-primary);"></strong>
      </div>
      <p class="text-xs text-slate-500">Enter the domain you want to transfer. Your current registrar will provide an EPP / Auth code.</p>
    </div>

    {# ── Own domain panel ── #}
    <div id="domain-panel-owndomain" class="space-y-4"
         style="{{ default_action != 'owndomain' ? 'display:none' : '' }}">
      <label class="block text-sm font-medium text-slate-700">Domain name</label>
      <div class="flex h-12 rounded-lg border border-slate-200 bg-white overflow-hidden">
        <input type="text" name="domain[owndomain_sld]"
               value="{{ request.owndomain_sld|default('') }}"
               class="min-w-0 flex-1 bg-transparent px-4 h-full text-slate-900 outline-none"
               placeholder="yourdomain">
        <input type="text" name="domain[owndomain_tld]"
               value="{{ request.owndomain_tld|default('.com') }}"
               class="border-l border-slate-200 bg-white px-3 h-full text-sm font-semibold outline-none"
               style="color:var(--color-primary); min-width:5rem;"
               placeholder=".com">
      </div>
      <p class="text-xs text-slate-500">You will need to update your nameservers to point to our servers after ordering.</p>
    </div>

    {# ── Subdomain panel ── #}
    {% if can_subdomain %}
    <div id="domain-panel-subdomain" class="space-y-4"
         style="{{ default_action != 'subdomain' ? 'display:none' : '' }}">
      <label class="block text-sm font-medium text-slate-700">Choose your free subdomain</label>
      <div class="flex h-12 rounded-lg border border-slate-200 bg-white overflow-hidden">
        <input type="text" name="domain[subdomain_sld]"
               value="{{ request.subdomain_sld|default('') }}"
               class="min-w-0 flex-1 bg-transparent px-4 h-full text-slate-900 outline-none"
               placeholder="name">
        <span class="flex items-center border-l border-slate-200 bg-slate-50 px-3 text-sm font-semibold whitespace-nowrap"
              style="color:var(--color-primary);">.{{ subdomain_base_domain|trim('.') }}</span>
      </div>
    </div>
    {% endif %}

    {# ── Availability result ── #}
    <div id="domain-availability-msg" style="display:none;"
         class="rounded-xl border px-4 py-3 text-sm font-medium mt-4"></div>

  </div>
</div>

<script>
(function () {
    var card = document.getElementById('domain-config-card');
    if (!card) return;

    var actionInput = document.getElementById('domain-action-input');
    var tabs        = card.querySelectorAll('.domain-tab');
    var availMsg    = document.getElementById('domain-availability-msg');
    var transferPriceRow = document.getElementById('transfer-price-row');

    // ── Tab styling — Stitch: bg-brand-50 text-brand-700 border-brand-200 for active ──
    function refreshTabStyles() {
        tabs.forEach(function (tab) {
            if (tab.dataset.active === 'true') {
                tab.style.cssText = 'background:rgba(var(--color-primary-rgb),0.07);border-color:rgba(var(--color-primary-rgb),0.30);color:var(--color-primary);';
            } else {
                tab.style.cssText = 'background:transparent;border-color:#e2e8f0;color:#475569;';
            }
        });
    }

    function switchMode(mode) {
        if (actionInput) actionInput.value = mode;

        card.querySelectorAll('[id^="domain-panel-"]').forEach(function (panel) {
            panel.style.display = 'none';
        });
        var active = document.getElementById('domain-panel-' + mode);
        if (active) active.style.display = '';

        tabs.forEach(function (tab) {
            tab.dataset.active = (tab.dataset.mode === mode) ? 'true' : 'false';
        });
        refreshTabStyles();

        showAvailability(null, '');
        if (transferPriceRow) transferPriceRow.style.display = 'none';
    }

    refreshTabStyles();
    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () { switchMode(tab.dataset.mode); });
    });

    // ── Currency ──
    var currencyCode = '{{ currency.code|default('USD')|escape('js') }}';
    var currencyRate = {{ currency.conversion_rate|default(1) }};

    function formatPrice(amount) {
        return new Intl.NumberFormat(undefined, {
            style: 'currency', currency: currencyCode, currencyDisplay: 'narrowSymbol'
        }).format(parseFloat(amount) * currencyRate);
    }

    // ── Availability banner ──
    function showAvailability(available, message) {
        if (!availMsg) return;
        if (!message) { availMsg.style.display = 'none'; availMsg.textContent = ''; return; }
        availMsg.textContent = message;
        availMsg.style.display = '';
        availMsg.className = 'rounded-xl border px-4 py-3 text-sm font-medium mt-4 ' + (
            available
                ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
                : 'border-red-200 bg-red-50 text-red-600'
        );
    }

    // ── Register check ──
    var registerBtn   = document.getElementById('domain-check-btn');
    var registerSld   = document.getElementById('register-sld');
    var registerTld   = document.getElementById('register-tld');
    var registerYears = document.getElementById('register-years-select');

    function resetYearOptions() {
        if (!registerYears) return;
        registerYears.innerHTML = '';
        for (var i = 1; i <= 5; i++) {
            registerYears.append(new Option(i + (i === 1 ? ' year' : ' years'), i));
        }
    }

    if (registerSld) {
        registerSld.addEventListener('input', function () { showAvailability(null, ''); resetYearOptions(); });
        registerSld.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') { e.preventDefault(); if (registerBtn) registerBtn.click(); }
        });
    }
    if (registerTld) registerTld.addEventListener('change', function () { showAvailability(null, ''); resetYearOptions(); });

    if (registerBtn) {
        registerBtn.addEventListener('click', function () {
            var sld = registerSld ? registerSld.value.trim().toLowerCase() : '';
            var tld = registerTld ? registerTld.value : '.com';
            if (!sld) return;

            registerBtn.disabled = true;
            registerBtn.textContent = 'Checking…';
            showAvailability(null, '');

            FOSSBilling.api.guest.post('servicedomain/check', { sld: sld, tld: tld },
                function () {
                    registerBtn.disabled = false;
                    registerBtn.textContent = 'Check';
                    showAvailability(true, sld + tld + ' is available.');

                    FOSSBilling.api.guest.post('servicedomain/pricing', { tld: tld },
                        function (result) {
                            if (!registerYears) return;
                            registerYears.innerHTML = '';
                            var regPrice   = Number(result.price_registration);
                            var renewPrice = Number(result.price_renew);
                            if (!result.price_renew || isNaN(renewPrice)) renewPrice = regPrice;
                            for (var i = 1; i <= 5; i++) {
                                var total = (i === 1) ? regPrice : regPrice + (i - 1) * renewPrice;
                                registerYears.append(new Option(i + (i === 1 ? ' year @ ' : ' years @ ') + formatPrice(total), i));
                            }
                            document.dispatchEvent(new CustomEvent('domainPriceUpdated', { detail: { rawPrice: regPrice } }));
                        }
                    );
                },
                function () {
                    registerBtn.disabled = false;
                    registerBtn.textContent = 'Check';
                    showAvailability(false, 'This domain is not available.');
                }
            );
        });
    }

    // ── Transfer check ──
    var transferBtn  = document.getElementById('transfer-check-btn');
    var transferSld  = document.getElementById('transfer-sld');
    var transferTld  = document.getElementById('transfer-tld');
    var transferPriceVal = document.getElementById('transfer-price-value');

    if (transferSld) transferSld.addEventListener('input', function () {
        showAvailability(null, '');
        if (transferPriceRow) transferPriceRow.style.display = 'none';
    });
    if (transferTld) transferTld.addEventListener('change', function () {
        showAvailability(null, '');
        if (transferPriceRow) transferPriceRow.style.display = 'none';
    });

    if (transferBtn) {
        transferBtn.addEventListener('click', function () {
            var sld = transferSld ? transferSld.value.trim().toLowerCase() : '';
            var tld = transferTld ? transferTld.value : '.com';
            if (!sld) return;

            transferBtn.disabled = true;
            transferBtn.textContent = 'Checking…';
            showAvailability(null, '');

            FOSSBilling.api.guest.post('servicedomain/can_be_transferred', { sld: sld, tld: tld },
                function () {
                    transferBtn.disabled = false;
                    transferBtn.textContent = 'Check';
                    showAvailability(true, sld + tld + ' can be transferred.');

                    FOSSBilling.api.guest.post('servicedomain/pricing', { tld: tld },
                        function (result) {
                            if (result.price_transfer && transferPriceVal && transferPriceRow) {
                                transferPriceVal.textContent = formatPrice(result.price_transfer);
                                transferPriceRow.style.display = '';
                                document.dispatchEvent(new CustomEvent('domainPriceUpdated', { detail: { rawPrice: result.price_transfer } }));
                            }
                        }
                    );
                },
                function () {
                    transferBtn.disabled = false;
                    transferBtn.textContent = 'Check';
                    showAvailability(false, 'This domain cannot be transferred.');
                }
            );
        });
    }

}());
</script>
{% endif %}
