</style>
<script>
(function () {
    var revEls = document.querySelectorAll('.reveal-up, .reveal-left, .reveal-right');
    var revObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
            if (e.isIntersecting) { e.target.classList.add('visible'); revObs.unobserve(e.target); }
        });
    }, { threshold: 0.1 });
    revEls.forEach(function(el) { revObs.observe(el); });

    var bars = document.querySelectorAll('.perf-bar');
    if (bars.length) {
        var barObs = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) {
                    var w = e.target.getAttribute('data-width');
                    e.target.style.transition = 'width 1.1s cubic-bezier(0.16,1,0.3,1)';
                    e.target.style.width = w;
                    barObs.unobserve(e.target);
                }
            });
        }, { threshold: 0.3 });
        bars.forEach(function(b) { barObs.observe(b); });
    }

    var uptimeBars = document.querySelectorAll('.uptime-bar');
    if (uptimeBars.length) {
        var uObs = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) {
                    uptimeBars.forEach(function(b) { b.style.opacity = '1'; b.style.transform = 'scaleY(1)'; });
                    uObs.disconnect();
                }
            });
        }, { threshold: 0.2 });
        if (uptimeBars[0]) uObs.observe(uptimeBars[0]);
    }

    function runCounter(el, target, ms) {
        var start = performance.now();
        (function tick(now) {
            var p = Math.min((now - start) / ms, 1);
            var eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.floor(eased * target).toLocaleString();
            if (p < 1) requestAnimationFrame(tick);
            else el.textContent = target.toLocaleString();
        })(start);
    }

    var counters = document.querySelectorAll('.counter');
    if (counters.length) {
        var cObs = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) {
                    runCounter(e.target, parseInt(e.target.dataset.target, 10), 1400);
                    cObs.unobserve(e.target);
                }
            });
        }, { threshold: 0.4 });
        counters.forEach(function(c) { cObs.observe(c); });
    }
}());
</script>
{% if request.product and product %}
{% if not guest.system_template_exists({ 'file': 'mod_service' ~ product.type ~ '_order_form.html.twig' }) %}
{% autoescape false %}
<script>
function orderProduct(productId, defaultPeriod) {
    return {
        productId: productId,
        selectedPeriod: defaultPeriod || null,
        loading: false,
        errorMsg: null,
        addons: {},
        couponCode: '',
        couponApplied: false,
        couponDiscount: 0,
        couponOpen: false,
        couponError: null,
        couponLoading: false,
        promoType: null,
        promoValue: 0,
        promoPeriods: [],
        periodLabels: { '1W': 'Weekly', '1M': 'Monthly', '3M': '3-Month', '6M': '6-Month', '1Y': 'Annual', '2Y': '2-Year', '3Y': '3-Year' },
        addonPrices: {
            {% for addon in product.addons %}{% if addon.pricing.type == 'recurrent' %}
            '{{ addon.id }}': { {% set _pf = true %}{% for code, prices in addon.pricing.recurrent %}{% if prices.enabled %}{% if not _pf %}, {% endif %}'{{ code }}': '{{ prices.price | money_convert }}'{% set _pf = false %}{% endif %}{% endfor %} },
            {% endif %}{% endfor %}
        },
        addonPricingTypes: {
            {% for addon in product.addons %}
            '{{ addon.id }}': '{{ addon.pricing.type }}',
            {% endfor %}
        },
        addonPeriodLabels: { '1W': 'week', '1M': 'mo', '3M': 'qtr', '6M': '6mo', '1Y': 'yr', '2Y': '2yr', '3Y': '3yr' },

        addonRawPrices: {
            {% for addon in product.addons %}{% if addon.pricing.type == 'recurrent' %}
            '{{ addon.id }}': { {% set _rf = true %}{% for code, prices in addon.pricing.recurrent %}{% if prices.enabled %}{% if not _rf %}, {% endif %}'{{ code }}': {{ prices.price|default(0) }}{% set _rf = false %}{% endif %}{% endfor %} },
            {% endif %}{% endfor %}
        },
        addonOnceRawPrices: {
            {% for addon in product.addons %}{% if addon.pricing.type == 'once' %}
            '{{ addon.id }}': {{ addon.pricing.once.price|default(0) }},
            {% endif %}{% endfor %}
        },
        productRawPrices: {
            {% if product.pricing.type == 'recurrent' %}{% for code, prices in product.pricing.recurrent %}{% if prices.enabled %}'{{ code }}': {{ prices.price|default(0) }}, {% endif %}{% endfor %}{% endif %}
        },
        productOnceRawPrice: {% if product.pricing.type == 'once' %}{{ product.pricing.once.price|default(0) }}{% else %}0{% endif %},
        currencyRate: {{ currency.conversion_rate|default(1) }},
        currencyPriceFormat: {{ currency.price_format|default(2)|json_encode(constant('JSON_HEX_TAG'))|raw }},
        currencyFormat: {{ (currency.symbol|default(currency.code|default('')) ~ '__PRICE__')|json_encode(constant('JSON_HEX_TAG'))|raw }},

        formatMoney(rawPrice) {
            const p = parseFloat(rawPrice) * this.currencyRate;
            const fmt = parseInt(this.currencyPriceFormat);
            let s;
            const addThousands = (str, sep) => str.replace(/\B(?=(\d{3})+(?!\d))/g, sep);
            if (fmt === 1) {
                s = p.toFixed(2);
            } else if (fmt === 2) {
                const pts = p.toFixed(2).split('.');
                pts[0] = addThousands(pts[0], ',');
                s = pts.join('.');
            } else if (fmt === 3) {
                const pts = p.toFixed(2).split('.');
                pts[0] = addThousands(pts[0], '.');
                s = pts.join(',');
            } else if (fmt === 4) {
                s = addThousands(Math.round(p).toString(), ',');
            } else if (fmt === 5) {
                s = Math.round(p).toString();
            } else {
                const pts = p.toFixed(2).split('.');
                pts[0] = addThousands(pts[0], ',');
                s = pts.join('.');
            }
            return this.currencyFormat.replace('__PRICE__', s);
        },

        calcTotal(period) {
            if (!period) return '';
            let base = 0;
            if (period === 'once') {
                base = this.productOnceRawPrice;
            } else if (period && this.productRawPrices[period] !== undefined) {
                base = this.productRawPrices[period];
            }
            Object.entries(this.addons).forEach(([id, state]) => {
                if (!state.selected) return;
                const type = this.addonPricingTypes[id];
                if (type === 'recurrent') {
                    const addonPeriod = state.period || period;
                    if (this.addonRawPrices[id] && this.addonRawPrices[id][addonPeriod] !== undefined) {
                        base += this.addonRawPrices[id][addonPeriod];
                    }
                } else if (type === 'once') {
                    if (this.addonOnceRawPrices[id] !== undefined) {
                        base += this.addonOnceRawPrices[id];
                    }
                }
            });
            // Apply promo discount if code is validated and period is not restricted
            let discount = 0;
            if (this.couponApplied && this.promoType && base > 0) {
                const periodOk = this.promoPeriods.length === 0 || period === 'once' || this.promoPeriods.includes(period);
                if (periodOk) {
                    if (this.promoType === 'percentage') {
                        discount = Math.round(base * this.promoValue / 100 * 100) / 100;
                    } else if (this.promoType === 'absolute') {
                        discount = Math.min(this.promoValue, base);
                    }
                }
            }
            this.couponDiscount = discount;
            return this.formatMoney(Math.max(0, base - discount));
        },

        init() {
            if (!this.selectedPeriod) {
                const firstRadio = this.$el.querySelector('input[name="period"]');
                if (firstRadio) {
                    this.selectedPeriod = firstRadio.value;
                }
            }
            const addonIds = Object.keys(this.addonPricingTypes);
            addonIds.forEach(id => {
                const ep = this.addonPrices[id] ? Object.keys(this.addonPrices[id]) : [];
                const resolve = (p) => (ep.length === 0 || ep.includes(p)) ? p : (ep[0] || p);
                if (!this.addons[id]) {
                    this.addons[id] = { selected: false, period: resolve(this.selectedPeriod || '') };
                }
            });
            this.$watch('selectedPeriod', (v) => {
                addonIds.forEach(id => {
                    const ep = this.addonPrices[id] ? Object.keys(this.addonPrices[id]) : [];
                    const resolve = (p) => (ep.length === 0 || ep.includes(p)) ? p : (ep[0] || p);
                    if (this.addons[id]) this.addons[id].period = resolve(v || '');
                });
            });
        },

        applyCoupon() {
            const code = this.couponCode.trim();
            if (!code || this.couponLoading || this.couponApplied) return;
            this.couponLoading = true;
            this.couponError   = null;
            API.guest.post('cart/validate_promo', { promocode: code, product_id: this.productId, period: this.selectedPeriod || '' },
                (promo) => {
                    this.couponLoading = false;
                    this.couponApplied = true;
                    this.promoType     = promo.type    || null;
                    this.promoValue    = promo.value   || 0;
                    this.promoPeriods  = promo.periods || [];
                },
                (err) => {
                    this.couponLoading = false;
                    this.couponApplied = false;
                    this.couponError   = err.message || 'Invalid promo code.';
                }
            );
        },

        toggleAddon(addonId, pricingType) {
            const key = String(addonId);
            if (!this.addons[key]) {
                let addonPeriod = '';
                if (pricingType === 'recurrent' || this.addonPricingTypes[key] === 'recurrent') {
                    const enabledPeriods = this.addonPrices[key] ? Object.keys(this.addonPrices[key]) : [];
                    if (this.selectedPeriod && enabledPeriods.includes(this.selectedPeriod)) {
                        addonPeriod = this.selectedPeriod;
                    } else if (enabledPeriods.length > 0) {
                        addonPeriod = enabledPeriods[0];
                    }
                }
                this.addons[key] = { selected: false, period: addonPeriod };
            }
            this.addons[key].selected = !this.addons[key].selected;
        },

        addToCart(period) {
            if (!period) return;
            this.loading = true;
            this.errorMsg = null;

            const data = { id: this.productId, multiple: 1 };
            if (period !== 'once' && period !== 'free') {
                data.period = period;
            }

            // Collect formbuilder fields if present
            const fbSection = this.$refs.formbuilderSection;
            if (fbSection) {
                const inputs = fbSection.querySelectorAll('input[name], select[name], textarea[name]');
                inputs.forEach(el => {
                    if (el.name === 'form_id' || el.name === 'id') {
                        data[el.name] = el.value;
                    } else if (el.type === 'checkbox') {
                        if (!data[el.name]) data[el.name] = [];
                        if (el.checked) data[el.name].push(el.value);
                    } else if (el.type === 'radio') {
                        if (el.checked) data[el.name] = el.value;
                    } else {
                        data[el.name] = el.value;
                    }
                });
                const required = fbSection.querySelectorAll('[required]');
                for (const el of required) {
                    if (!el.value || !el.value.trim()) {
                        this.loading = false;
                        this.errorMsg = 'Please fill in all required fields.';
                        el.focus();
                        return;
                    }
                }
            }

            // Attach selected addons
            const addonPayload = {};
            let hasAddons = false;
            Object.entries(this.addons).forEach(([id, state]) => {
                addonPayload[id] = { selected: state.selected };
                if (state.selected) {
                    if (this.addonPricingTypes[id] === 'recurrent') {
                        let addonPeriod = state.period;
                        if (!addonPeriod) {
                            const enabledPeriods = this.addonPrices[id] ? Object.keys(this.addonPrices[id]) : [];
                            if (period && enabledPeriods.includes(period)) {
                                addonPeriod = period;
                            } else if (enabledPeriods.length > 0) {
                                addonPeriod = enabledPeriods[0];
                            }
                        }
                        if (!addonPeriod) {
                            this.loading = false;
                            this.errorMsg = 'Selected add-on has no valid billing period. Please deselect it or contact support.';
                            return;
                        }
                        addonPayload[id].period = addonPeriod;
                    } else if (state.period) {
                        addonPayload[id].period = state.period;
                    }
                }
                hasAddons = true;
            });
            if (hasAddons) {
                data.addons = addonPayload;
            }

            API.guest.post('cart/add_item', data,
                (response) => {
                    document.dispatchEvent(new CustomEvent('stablepanel:cartUpdated'));
                    const goCheckout = () => { window.location.href = '{{ "/order/checkout"|url }}'; };
                    if (this.couponCode && this.couponApplied) {
                        API.guest.post('cart/apply_promo', { promocode: this.couponCode },
                            goCheckout,
                            (err) => {
                                this.loading = false;
                                this.couponApplied = false;
                                this.couponError   = err.message || 'Promo code could not be applied.';
                            }
                        );
                    } else {
                        goCheckout();
                    }
                },
                (error) => {
                    this.loading = false;
                    this.errorMsg = error.message || 'Failed to add to cart. Please try again.';
                }
            );
        }
    }
}
</script>
{% endautoescape %}
{% endif %}
{% endif %}
{% endblock %}
