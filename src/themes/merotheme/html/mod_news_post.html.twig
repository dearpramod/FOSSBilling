{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ post.title }}{% endblock %}
{% block meta_description %}{{ post.description }}{% endblock %}
{% block page_header %}{% endblock %}

{% block opengraph %}
    <meta property="og:title" content="{{ post.title }}" />
    <meta property="og:type" content="article" />
    <meta property="og:description" content="{{ post.description }}" />
    <meta property="og:url" content="{{ guest.system_current_url }}" />
    <meta property="og:image" content="{{ post.image }}" />
    <meta property="article:author" content="{{ post.author.name }}" />
    {% if post.published_at %}<meta property="article:published_time" content="{{ post.published_at }}" />{% endif %}
    {% if post.updated_at %}<meta property="article:modified_time" content="{{ post.updated_at }}" />{% endif %}
    {% if post.expires_at %}<meta property="article:expiration_time" content="{{ post.expires_at }}" />{% endif %}
    {% if post.section %}<meta property="article:section" content="{{ post.section }}" />{% endif %}
    {% if post.tags %}<meta property="article:tag" content="{{ post.tags|join(', ') }}" />{% endif %}
{% endblock %}

{% block content %}

{# ── Fetch related posts (exclude current) ── #}
{% set all_posts = guest.news_get_list({ "per_page": 20 }).list %}

{# ── Breadcrumbs ── #}
<nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-500 mb-8 flex-wrap">
    <a href="{{ '/news'|url }}" class="hover:text-[color:var(--color-primary)] transition-colors">{{ 'News & Announcements'|trans }}</a>
    <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-slate-900 dark:text-white font-medium line-clamp-1 max-w-xs">{{ post.title }}</span>
</nav>

{# ── 12-col grid ── #}
<div class="flex flex-col lg:flex-row gap-6 items-start max-w-6xl mx-auto">

    {# ── Main article column ── #}
    <article class="flex-1 min-w-0 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm overflow-hidden">

        {# Hero image with title overlay #}
        {% if post.image %}
        <div class="aspect-video w-full bg-slate-900 relative overflow-hidden">
            <img src="{{ post.image }}" alt="{{ post.title|e }}" class="w-full h-full object-cover opacity-80">
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[color:var(--color-primary)] text-white rounded-full text-xs font-medium mb-3">
                    <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                    {{ 'Update'|trans }}
                </span>
                <h1 class="text-[30px] leading-[38px] tracking-[-0.02em] font-bold text-white max-w-2xl">{{ post.title }}</h1>
            </div>
        </div>
        {% endif %}

        <div class="p-8">
            {# Author & meta row #}
            {% if not post.image %}
            <h1 class="text-[30px] leading-[38px] tracking-[-0.02em] font-bold text-slate-900 dark:text-white mb-6">{{ post.title }}</h1>
            {% endif %}

            <div class="flex items-center justify-between pb-8 mb-8 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-slate-100 dark:bg-white/[0.06] border border-slate-200 dark:border-white/[0.08] flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-slate-900 dark:text-white">{{ post.author.name ?: 'Platform Team' }}</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400">{{ 'Announcement'|trans }}</p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.05em] text-slate-400 dark:text-slate-500">{{ 'Published'|trans }}</p>
                    <p class="text-sm font-medium text-slate-900 dark:text-white">{{ post.updated_at|date('M j, Y') }}</p>
                </div>
            </div>

            {# Body content #}
            <div class="prose prose-slate dark:prose-invert max-w-none
                prose-headings:tracking-tight prose-headings:text-slate-900 dark:prose-headings:text-white
                prose-p:text-slate-600 dark:prose-p:text-slate-400 prose-p:leading-relaxed
                prose-a:text-[color:var(--color-primary)] prose-a:no-underline hover:prose-a:underline
                prose-strong:text-slate-900 dark:prose-strong:text-white
                prose-code:bg-slate-100 dark:prose-code:bg-white/[0.06] prose-code:rounded prose-code:px-1
                prose-table:border prose-table:border-slate-200 dark:prose-table:border-slate-700
                prose-th:bg-slate-50 dark:prose-th:bg-white/[0.03] prose-th:text-slate-600 dark:prose-th:text-slate-400
                prose-td:text-slate-700 dark:prose-td:text-slate-300">
                {{ post.content|markdown }}
            </div>

            {% if guest.extension_is_on({ "mod": "comment" }) %}
            <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800">
                {{ include('mod_comment_block.html.twig') }}
            </div>
            {% endif %}

            {# Footer bar: back + share #}
            <div class="flex flex-col sm:flex-row items-center justify-between pt-8 mt-8 border-t border-slate-100 dark:border-slate-800 gap-4">
                <a href="{{ '/news'|url }}"
                   class="inline-flex items-center gap-2 px-4 py-2 border border-slate-200 dark:border-slate-700 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/[0.04] transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    {{ 'Back to News'|trans }}
                </a>
                <div class="flex items-center gap-3">
                    <span class="text-[11px] font-semibold uppercase tracking-[0.05em] text-slate-400 dark:text-slate-500 mr-1">{{ 'Share'|trans }}</span>
                    <button onclick="navigator.clipboard.writeText(window.location.href)"
                            class="w-9 h-9 rounded-full border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center hover:bg-slate-50 dark:hover:bg-white/[0.05] transition-colors"
                            title="{{ 'Copy link'|trans }}">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </article>

    {# ── Sidebar ── #}
    <aside class="w-full lg:w-72 xl:w-80 shrink-0 space-y-6">

        {# Related announcements #}
        {% set related = [] %}
        {% for p in all_posts %}
            {% if p.slug != post.slug and related|length < 3 %}
                {% set related = related|merge([p]) %}
            {% endif %}
        {% endfor %}

        {% if related|length > 0 %}
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm">
            <h4 class="text-[11px] font-bold uppercase tracking-[0.05em] text-slate-400 dark:text-slate-500 mb-5">{{ 'Related Announcements'|trans }}</h4>
            <div class="space-y-5">
                {% for rel in related %}
                <a href="{{ ('news/' ~ rel.slug)|url }}" class="group block">
                    <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded border mb-2
                        text-[color:var(--color-primary)] bg-[color:var(--color-primary)]/[0.07] border-[color:var(--color-primary)]/20">
                        {{ 'Update'|trans }}
                    </span>
                    <h5 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-[color:var(--color-primary)] transition-colors line-clamp-2 leading-snug">{{ rel.title }}</h5>
                    <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">{{ rel.updated_at|date('M j, Y') }}</p>
                </a>
                {% endfor %}
            </div>
            <a href="{{ '/news'|url }}"
               class="block w-full mt-6 py-2 bg-slate-50 dark:bg-white/[0.04] border border-slate-200 dark:border-slate-700 rounded-lg text-sm font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/[0.07] transition-colors text-center">
                {{ 'View All News'|trans }}
            </a>
        </div>
        {% endif %}

        {# CTA card #}
        <div class="rounded-xl p-6 text-white relative overflow-hidden shadow-lg"
             style="background: var(--color-primary);">
            <div class="relative z-10">
                <h4 class="text-[18px] leading-7 font-semibold mb-2">{{ 'Need Technical Help?'|trans }}</h4>
                <p class="text-sm opacity-90 mb-5">{{ 'Our support engineers are available 24/7 to assist you.'|trans }}</p>
                <a href="{{ 'support'|url }}"
                   class="inline-flex items-center gap-2 px-4 py-2 bg-white text-[color:var(--color-primary)] rounded-lg text-sm font-bold hover:opacity-90 transition-all">
                    {{ 'Contact Support'|trans }}
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                </a>
            </div>
            {# Decorative icon #}
            <svg class="absolute -bottom-4 -right-4 w-28 h-28 text-white/10 rotate-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/>
            </svg>
        </div>

    </aside>

</div>
{% endblock %}
