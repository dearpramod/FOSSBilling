<script>
function hostingDash() {
  return {
    activePanel: null,
    copiedKey: null,
    renewModal: false,
    cancelModal: false,
    ticketModal: false,
    stats: null,
    statsLoading: true,
    init() {
      const orderId = this.$el.dataset.orderId;
      API.client.get(
        'servicehosting/get_hosting_stats',
        { order_id: orderId },
        (d) => {
          this.stats = (d && typeof d === 'object' && ('disk' in d || 'bandwidth' in d)) ? d : null;
          this.statsLoading = false;
        },
        () => { this.statsLoading = false; },
        false
      );
    },
    formatMB(mb) {
      if (mb === null || mb === undefined) return '\u2014';
      if (mb >= 1024) return (mb / 1024).toFixed(1) + ' GB';
      return Math.round(mb) + ' MB';
    },
    toggle(panel) {
      this.activePanel = this.activePanel === panel ? null : panel;
    },
    copy(text, key) {
      if (!text || text === '—') return;
      navigator.clipboard.writeText(text).then(() => {
        this.copiedKey = key || true;
        clearTimeout(this._copyTimer);
        this._copyTimer = setTimeout(() => { this.copiedKey = null; }, 2000);
      }).catch(() => {});
    }
  };
}

// ── Account Management: show processing state on submit (Issue 2) ──────────
document.querySelectorAll('.acct-form button[type="submit"]').forEach((btn) => {
  const originalHTML = btn.innerHTML;
  btn.closest('form').addEventListener('submit', () => {
    btn.innerHTML =
      '<svg class="animate-spin w-4 h-4 inline-block mr-1.5" fill="none" viewBox="0 0 24 24">' +
        '<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>' +
        '<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 14.627 0 20 12h-4a4 4 0 00-4 4c0 2.21-1.79 4-4 4S0 14.21 0 12z"></path>' +
      '</svg>Processing...';
  });
  // Reset text when api-form re-enables the button (on success or error)
  new MutationObserver((mutations) => {
    mutations.forEach((m) => {
      if (m.attributeName === 'disabled' && !btn.disabled) {
        btn.innerHTML = originalHTML;
      }
    });
  }).observe(btn, { attributes: true });
});

function onAfterLoginLinkCreated(url) {
  window.open(url, '_blank');
}
</script>
