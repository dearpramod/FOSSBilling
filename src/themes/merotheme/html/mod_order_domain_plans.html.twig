                       class="w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5 text-white text-sm outline-none focus:border-indigo-500/50 transition-colors" />
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-400 mb-1.5">Postcode</label>
                <input type="text" x-model="billingContact.postcode"
                       class="w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5 text-white text-sm outline-none focus:border-indigo-500/50 transition-colors" />
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-400 mb-1.5">Country Code</label>
                <input type="text" x-model="billingContact.country" maxlength="2" placeholder="US"
                       class="w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5 text-white text-sm outline-none focus:border-indigo-500/50 transition-colors" />
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-400 mb-1.5">Phone Country Code</label>
                <input type="text" x-model="billingContact.phone_cc" placeholder="1"
                       class="w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5 text-white text-sm outline-none focus:border-indigo-500/50 transition-colors" />
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-400 mb-1.5">Phone Number</label>
                <input type="text" x-model="billingContact.phone"
                       class="w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5 text-white text-sm outline-none focus:border-indigo-500/50 transition-colors" />
              </div>
            </div>
          </div>
        </div>

      </div>{# /isLoggedIn contact cards #}

      {# ── Promo Code ── #}
      <div x-show="isLoggedIn" class="mt-4">
        <div class="rounded-2xl border border-white/[0.08] p-4" style="background:rgba(255,255,255,0.02);">
          <div class="flex items-start justify-between gap-3 mb-3">
            <div class="flex items-center gap-2 min-w-0">
              <div class="w-8 h-8 rounded-xl flex items-center justify-center" style="background:rgba(var(--color-primary-rgb),0.12);">
                <svg class="w-4 h-4 text-indigo-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-white">Promo code</p>
                <p class="text-xs text-gray-500">Add your coupon before checkout</p>
              </div>
            </div>
            <span x-show="promoCode" class="px-2.5 py-0.5 rounded-lg text-xs font-mono font-bold bg-emerald-500/10 border border-emerald-500/25 text-emerald-300 uppercase" x-text="promoCode"></span>
          </div>

          <div x-show="!promoCode" class="flex items-center gap-2">
            <div class="relative flex-1">
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-600 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
              </svg>
              <input type="text"
                     x-model="promoInput"
                     @keydown.enter.prevent="applyCoupon()"
                     placeholder="PROMO2026"
                     autocomplete="off"
                     class="w-full pl-9 pr-4 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-indigo-500/50 uppercase tracking-wider transition-colors">
            </div>
            <button @click="applyCoupon()"
                    :disabled="!promoInput.trim() || promoLoading"
                    class="px-4 py-2.5 rounded-xl text-sm font-semibold text-white transition-all disabled:opacity-40 disabled:cursor-not-allowed whitespace-nowrap"
                    style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
              <span x-show="!promoLoading">Apply</span>
              <span x-show="promoLoading" x-cloak>Checking…</span>
            </button>
          </div>

          <div x-show="promoCode" class="flex items-center justify-between gap-3 py-1">
            <div class="flex items-center gap-2 min-w-0">
              <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span class="text-sm text-emerald-400">Promo code applied.</span>
              <span class="px-2 py-0.5 rounded-md text-xs font-mono font-bold bg-emerald-500/10 border border-emerald-500/25 text-emerald-300 uppercase" x-text="promoCode"></span>
            </div>
            <button @click="promoCode = ''; promoError = ''; promoDiscount = 0; promoType = null; promoValue = 0;"
                    class="flex-shrink-0 px-2 py-1 rounded-lg text-xs text-gray-500 hover:text-red-400 border border-white/10 hover:border-red-500/30 transition-colors"
                    title="Remove code">
              Remove
            </button>
          </div>
          <div x-show="promoDiscount > 0" x-cloak class="mt-1.5 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span class="text-xs text-emerald-400" x-text="'Discount: −' + '{{ currPrefix|escape('js') }}' + promoDiscount.toFixed(2) + '{{ currSuffix|escape('js') }}'"></span>
          </div>
        </div>
        <p x-show="promoError" class="mt-1.5 text-xs text-red-400" x-text="promoError"></p>
      </div>

      {# ── Order Summary ── #}
      <div x-show="isLoggedIn" class="mt-4 rounded-2xl border border-white/[0.08] overflow-hidden"
           style="background: rgba(255,255,255,0.025);">
        <div class="px-6 pt-5 pb-4 border-b border-white/[0.06]">
          <h3 class="text-sm font-bold text-white">Order Summary</h3>
        </div>
        <div class="divide-y divide-white/[0.06]">

          {# Domain row #}
          <div class="px-6 py-4 flex items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2 mb-0.5">
                <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/>
                </svg>
                <span class="text-white font-semibold" x-text="selSld + selTld"></span>
              </div>
              <p class="text-xs text-gray-500 ml-6"
                 x-text="selYears + ' year' + (selYears > 1 ? 's' : '') + ' — Domain Registration'"></p>
            </div>
            <span class="text-white font-bold flex-shrink-0" x-text="fmtPrice(selPriceRaw * selYears)"></span>
          </div>

          {# Nameservers row #}
          <div class="px-6 py-4">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/>
              </svg>
              <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Nameservers</span>
            </div>
            <div x-show="useDefaultNs" class="ml-6 text-sm text-gray-300">Default nameservers</div>
            <div x-show="!useDefaultNs" class="ml-6 space-y-0.5">
              <p class="text-sm text-gray-300" x-text="ns1"></p>
              <p class="text-sm text-gray-300" x-text="ns2"></p>
              <p x-show="ns3" class="text-sm text-gray-300" x-text="ns3"></p>
              <p x-show="ns4" class="text-sm text-gray-300" x-text="ns4"></p>
            </div>
          </div>

          {# Registrant row #}
          <div class="px-6 py-4">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Registrant</span>
            </div>
            <div class="ml-6">
              <p class="text-sm text-gray-300" x-text="(contact.first_name || '') + ' ' + (contact.last_name || '')"></p>
              <p class="text-xs text-gray-500 mt-0.5" x-text="contact.email"></p>
              <p class="text-xs text-gray-500 mt-0.5"
                 x-text="[contact.address_1, contact.city, contact.country].filter(Boolean).join(', ')"></p>
            </div>
          </div>

          {# Add-ons row — only shown when at least one addon is selected #}
          <template x-if="DOMAIN_ADDONS.length > 0 && Object.values(addons).some(a => a.selected)">
            <div class="px-6 py-4">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                </svg>
                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Add-ons</span>
              </div>
              <div class="ml-6 space-y-1.5">
                <template x-for="addon in DOMAIN_ADDONS.filter(a => addons[String(a.id)] && addons[String(a.id)].selected)" :key="addon.id">
                  <div class="flex items-center justify-between">
                    <p class="text-sm text-gray-300" x-text="addon.title"></p>
                    <span class="text-sm font-semibold text-white" x-text="addon.isFree ? 'Free' : (addon.priceFormatted || '—')"></span>
                  </div>
                </template>
              </div>
            </div>
          </template>

          {# Promo row — shown when a code has been entered #}
          <template x-if="promoCode">
            <div class="px-6 py-3 flex items-center justify-between gap-4 border-t border-white/[0.06]">
              <div class="flex items-center gap-2 min-w-0">
                <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="text-xs text-gray-400">Promo</span>
                <span class="px-2 py-0.5 rounded-md text-xs font-mono font-bold bg-emerald-500/10 border border-emerald-500/25 text-emerald-300 uppercase" x-text="promoCode"></span>
              </div>
              <span class="text-sm font-semibold text-emerald-400 flex-shrink-0">Discount applied</span>
            </div>
          </template>

          {# Total row #}
          <div class="px-6 py-5" style="background: rgba(var(--color-primary-rgb),0.06);">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-semibold text-white">Total Due Today</p>
                <p x-show="promoCode" class="text-xs text-emerald-500 mt-0.5 flex items-center gap-1">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                  Promo discount applied at checkout
                </p>
                <p x-show="selRenewPrice > 0 && !promoCode"
                   class="text-xs text-gray-500 mt-0.5"
                   x-text="'Renews at ' + fmtPrice(selRenewPrice) + '/year'"></p>
              </div>
              <div class="text-right">
                <p class="text-2xl font-extrabold"
                   :class="promoCode ? 'text-emerald-300' : 'text-white'"
                   x-text="fmtPrice(selPriceRaw * selYears + addonPriceTotal())"></p>
                <p x-show="promoCode" class="text-xs text-emerald-500/70 mt-0.5">Before promo discount</p>
              </div>
            </div>
          </div>

        </div>
      </div>

      {# Error #}
      <div x-show="orderError"
           class="mt-4 flex items-start gap-3 p-4 rounded-xl bg-red-500/8 border border-red-500/25 text-red-300 text-sm" x-cloak>
        <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
        <span x-text="orderError"></span>
      </div>

      <div class="flex items-center justify-between mt-4">
        <button @click="wizardStep = 1"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-white/10 text-gray-400 text-sm hover:border-white/20 hover:text-white transition-all">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Back
        </button>
        <button x-show="isLoggedIn"
                @click="placeOrder()"
                :disabled="ordering || !contact.first_name || !contact.last_name || !contact.email || !contact.address_1 || !contact.city"
                class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-xl font-bold text-white text-sm transition-all disabled:opacity-40 disabled:cursor-not-allowed hover:brightness-110 shadow-lg"
                style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 4px 20px rgba(var(--color-primary-rgb),0.25);">
          <svg x-show="ordering" class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <svg x-show="!ordering" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span x-text="ordering ? 'Processing…' : 'Complete Order & Pay'"></span>
        </button>
      </div>
    </div>{# /Step 2 #}

  </div>{# /Phase 2 #}

  {# ══════════════════════════════════════════════════════════════
     Login Modal Overlay
  ══════════════════════════════════════════════════════════════ #}
  <div x-show="showLoginModal"
       x-cloak
       @keydown.escape.window="showLoginModal = false"
       class="fixed inset-0 z-50 flex items-center justify-center p-4"
       style="background: rgba(0,0,0,0.7); backdrop-filter: blur(6px);">

    <div @click.outside="showLoginModal = false"
         class="login-modal w-full max-w-md rounded-2xl border border-white/[0.1] shadow-2xl shadow-black/60 overflow-hidden"
         style="background: #0a0f1e;">

      {# Modal header #}
      <div class="flex items-center justify-between px-6 py-5 border-b border-white/[0.07]">
        <div>
          <h2 class="login-modal-title text-base font-bold text-white">Sign In to Continue</h2>
          <p class="text-xs text-gray-500 mt-0.5">Log in to load your contact details</p>
        </div>
        <button @click="showLoginModal = false"
                class="w-8 h-8 rounded-lg border border-white/10 flex items-center justify-center text-gray-500 hover:text-white hover:border-white/20 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      {# Modal body #}
      <div class="px-6 py-6 space-y-4">

        {# Google sign-in #}
        {% if social.google_enabled|default(false) %}
        <a href="{{ ('sociallogin/google?context=login&return_to=' ~ request.uri|default('/')|url_encode)|url }}"
           class="flex items-center justify-center gap-2.5 w-full py-3 px-4 rounded-xl border border-white/[0.12] text-gray-200 text-sm font-semibold hover:bg-white/[0.08] transition-all"
           style="background:rgba(255,255,255,0.05);">
          <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
          Continue with Google
        </a>
        <div class="flex items-center gap-3">
          <div class="flex-1 h-px bg-white/[0.08]"></div>
          <span class="text-xs text-gray-600">or sign in with email</span>
          <div class="flex-1 h-px bg-white/[0.08]"></div>
        </div>
        {% endif %}

        {# Error #}
        <div x-show="loginError"
             class="flex items-center gap-2 p-3 rounded-xl bg-red-500/8 border border-red-500/25 text-red-300 text-xs">
          <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
          <span x-text="loginError"></span>
        </div>

        {# Email #}
        <div>
          <label class="login-modal-label block text-xs font-medium text-gray-400 mb-1.5">Email address</label>
          <input type="email"
                 x-model="loginEmail"
                 @keydown.enter="submitLogin()"
                 placeholder="you@example.com"
                 autofocus
                 class="login-modal-input w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-white text-sm outline-none transition-colors focus:border-indigo-500/50 placeholder-gray-600" />
        </div>

        {# Password #}
        <div>
          <label class="login-modal-label block text-xs font-medium text-gray-400 mb-1.5">Password</label>
          <input type="password"
                 x-model="loginPassword"
                 @keydown.enter="submitLogin()"
                 placeholder="••••••••"
                 class="login-modal-input w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-white text-sm outline-none transition-colors focus:border-indigo-500/50 placeholder-gray-600" />
        </div>

        {# Submit #}
        <button @click="submitLogin()"
                :disabled="loginLoading || !loginEmail || !loginPassword"
                class="w-full flex items-center justify-center gap-2 py-3 rounded-xl font-semibold text-white text-sm transition-all disabled:opacity-50 hover:brightness-110"
                style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
          <svg x-show="loginLoading" class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <span x-text="loginLoading ? 'Signing in…' : 'Sign In & Continue'"></span>
        </button>

        <p class="text-center text-xs text-gray-600">
          <a href="{{ 'password-reset'|url }}" class="text-indigo-400 hover:text-indigo-300 transition-colors">Forgot password?</a>
        </p>
      </div>
    </div>
  </div>

</div>{# /x-data #}
<div style="margin-bottom: 3rem;"></div>
{% endblock %}

{% block js %}
{% if _rc.enabled and _rc.captcha_provider|default('recaptcha_v2') == 'recaptcha_v3' and _rc.publickey %}
<script src="https://www.google.com/recaptcha/api.js?render={{ _rc.publickey }}" async defer></script>
{% endif %}
<script>
(function () {
  const PRODUCT_ID        = {{ domain_product_id|default('null') }};
  const CURR_CODE         = '{{ currencyCode|escape('js') }}';
  const CURR_PREFIX       = '{{ currPrefix|escape('js') }}';
  const CURR_SUFFIX       = '{{ currSuffix|escape('js') }}';
  const CURR_RATE         = {{ currency.conversion_rate|default(1)|number_format(10, '.', '') }};
  {% set _priceFormat = currency.price_format|default(1) %}
  const CURR_PRICE_FORMAT = {{ _priceFormat in [1,2,3,4,5] ? _priceFormat : 1 }};
  const CURRENCIES        = {{ currencies|json_encode|raw }};
  const CLIENT_CURRENCY   = '{{ clientCurrencyCode|escape('js') }}';
  const CHECKOUT          = '{{ '/order/checkout'|url }}';
  const TLD_DATA          = {{ tlds|json_encode|raw }};
  const IS_LOGGED_IN      = {{ clientLoggedIn ? 'true' : 'false' }};
  const SIGNUP_URL        = '{{ 'signup'|url }}';
  const DOMAIN_ADDONS = (function () {
    const _raw = [
      {% for addon in domain_addons %}
      {% set _oncePx   = (addon.pricing.type == 'once') ? addon.pricing.once.price : 0 %}
      {% set _onceSetup = (addon.pricing.type == 'once' and addon.pricing.once.setup is defined) ? addon.pricing.once.setup : 0 %}
      {% set _isFree  = addon.pricing.type == 'free' or (addon.pricing.type == 'once' and _oncePx == 0) %}
      {# For recurrent: find first enabled period price using same pattern as legacy templates #}
      {% set _firstEnabledPrice = null %}
      {% set _firstEnabledCode  = '' %}
      {% if addon.pricing.type == 'recurrent' %}
        {% for code, prices in addon.pricing.recurrent %}
          {% if _firstEnabledPrice is null and prices.enabled %}
            {% set _firstEnabledPrice = prices.price %}
            {% set _firstEnabledCode  = code %}
          {% endif %}
        {% endfor %}
      {% endif %}
      {
        id: {{ addon.id }},
        title: {{ addon.title|json_encode|raw }},
        description: {{ ((addon.description ?? '')|markdown ~ '')|json_encode|raw }},
        pricingType: {{ addon.pricing.type|json_encode|raw }},
        isFree: {{ _isFree ? 'true' : 'false' }},
        priceRaw: {% if addon.pricing.type == 'recurrent' and _firstEnabledPrice is not null %}{{ _firstEnabledPrice|number_format(10, '.', '') }}{% elseif addon.pricing.type == 'once' and not _isFree %}{{ (_oncePx + _onceSetup)|number_format(10, '.', '') }}{% else %}0{% endif %},
        priceFormatted: {% if addon.pricing.type == 'recurrent' and _firstEnabledPrice is not null %}{{ (_firstEnabledPrice)|money_convert|json_encode|raw }}{% elseif addon.pricing.type == 'once' and not _isFree %}{{ (_oncePx + _onceSetup)|money_convert|json_encode|raw }}{% else %}''{% endif %},
        priceSubLabel: {% if addon.pricing.type == 'recurrent' and _firstEnabledCode != '' %}{{ ('/' ~ (periods[_firstEnabledCode] ?? _firstEnabledCode))|json_encode|raw }}{% elseif addon.pricing.type == 'once' and not _isFree %}'one-time'{% else %}''{% endif %},
        priceLabel: {% if _isFree %}'No extra cost'{% elseif addon.pricing.type == 'once' %}'One-time charge'{% else %}'Add-on charge'{% endif %},
        firstPeriodCode: {{ _firstEnabledCode|json_encode|raw }},
      },
      {% endfor %}
    ];
    // Deduplicate by id — prefer the isFree entry over a paid entry for the same id
    const _map = {};
    for (const _a of _raw) { if (!_map[_a.id] || _a.isFree) _map[_a.id] = _a; }
    return Object.values(_map);
  })();

  function fmtPrice(amount) {
    const raw = parseFloat(amount || 0) * CURR_RATE;
    let n;
    const fmt = parseInt(CURR_PRICE_FORMAT);
    if (fmt === 2) {
      n = raw.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    } else if (fmt === 3) {
      const p = raw.toFixed(2).split('.');
      n = p[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ',' + p[1];
    } else if (fmt === 4) {
      n = Math.round(raw).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    } else if (fmt === 5) {
      n = Math.round(raw).toString();
    } else {
      n = raw.toFixed(2);
    }
    return CURR_PREFIX + n + CURR_SUFFIX;
  }

  function tldGradient(tld) {
    const p = [
      ['var(--color-primary)','var(--color-secondary)'], ['#0ea5e9','#0284c7'], ['#10b981','#059669'],
      ['#f59e0b','#d97706'], ['#ef4444','#dc2626'], ['#ec4899','#db2777'],
      ['#14b8a6','#0d9488'], ['var(--color-secondary)','#6d28d9'], ['#06b6d4','#0891b2'],
      ['#84cc16','#65a30d'],
    ];
    let h = 0;
    for (let i = 0; i < tld.length; i++) h = (Math.imul(h, 31) + tld.charCodeAt(i)) | 0;
    const [a, b] = p[Math.abs(h) % p.length];
    return `linear-gradient(135deg, ${a}bb, ${b}ee)`;
  }

  function tldMeta(tld) {
    const t = TLD_DATA.find(x => x.tld === tld);
    return t ? {
      price:      parseFloat(t.price_registration) || 0,
      renewPrice: parseFloat(t.price_renew)         || 0,
      minYears:   parseInt(t.min_years, 10)         || 1,
    } : { price: 0, renewPrice: 0, minYears: 1 };
  }

  window.domainFlow = function () {
    return {
      /* ── Data exposed for Alpine expressions ── */
      DOMAIN_ADDONS,

      /* ── Search state ── */
      query:            '',
      results:               [],
      suggestions:           [],
      suggestionQueue:       [],
      searching:             false,
      searched:              false,
      suggestionsLoading:    false,
      suggestionsLoadingMore: false,
      error:            '',
      registrarError:   false,
      authError:        false,
      parsedSld:        '',
      parsedTld:        '',

      /* ── Wizard state ── */
      wizardActive:  false,
      wizardStep:    1,
      selSld:        '',
      selTld:        '',
      selYears:      1,
      selPriceRaw:   0,
      selRenewPrice: 0,

      /* ── Nameservers ── */
      useDefaultNs: true,
      ns1: '', ns2: '', ns3: '', ns4: '',

      /* ── Auth ── */
      isLoggedIn:    IS_LOGGED_IN,
      showLoginModal: false,
      loginEmail:    '',
      loginPassword: '',
      loginLoading:  false,
      loginError:    '',

      /* ── Contact ── */
      registrantEnabled: false,
      adminEnabled: false,
      techEnabled: false,
      billingEnabled: false,
      contactLoading: false,
      contact: {
        first_name: '', last_name: '', email: '',
        company: '', address_1: '', city: '',
        state: '', country: '', postcode: '',
        phone_cc: '', phone: ''
      },
      adminContact: {
        first_name: '', last_name: '', email: '',
        company: '', address_1: '', city: '',
        state: '', country: '', postcode: '',
        phone_cc: '', phone: ''
      },
      techContact: {
        first_name: '', last_name: '', email: '',
        company: '', address_1: '', city: '',
        state: '', country: '', postcode: '',
        phone_cc: '', phone: ''
      },
      billingContact: {
        first_name: '', last_name: '', email: '',
        company: '', address_1: '', city: '',
        state: '', country: '', postcode: '',
        phone_cc: '', phone: ''
      },

      /* ── URLs (must be data props — Alpine evaluates :href in data scope) ── */
      signupUrl:   SIGNUP_URL,
      checkoutUrl: CHECKOUT,

      /* ── Currency ── */
      currencyCode:     CURR_CODE,
      changingCurrency: false,

      /* ── Order ── */
      ordering:   false,
      orderError: '',

      /* ── Promo code ── */
      promoInput: '',
      promoCode:  '',
      promoError: '',
      promoLoading: false,
      promoDiscount: 0,
      promoType: null,
      promoValue: 0,

      /* ── Addons ── */
      addons: {},  // { addonId: { selected: bool } }

      /* ──────────────────────────────── */
      init() {
        const params = new URLSearchParams(window.location.search);
        const sld    = params.get('register_sld');
        const tld    = params.get('register_tld');
        if (sld) {
          this.query = sld + (tld || '');
          this.$nextTick(() => this.search());
        }
      },

      onInput() {
        this.error = '';
        const raw  = this.query.trim();
        const dot  = raw.lastIndexOf('.');
        this.parsedSld = dot > 0 ? raw.slice(0, dot) : raw;
        this.parsedTld = dot > 0 ? raw.slice(dot)    : '';
        if (!raw) {
          this.results = [];
          this.suggestions = [];
          this.searched = false;
        }
      },

      clearSearch() {
        this.query                = '';
        this.results              = [];
        this.suggestions          = [];
        this.suggestionQueue      = [];
        this.searched             = false;
        this.suggestionsLoading   = false;
        this.suggestionsLoadingMore = false;
        this.error                = '';
        this.registrarError       = false;
        this.authError            = false;
      },

      async search() {
        const raw = this.query.trim();
        if (raw.length < 2) return;

        const dot = raw.lastIndexOf('.');
        this.parsedSld = dot > 0 ? raw.slice(0, dot) : raw;
        this.parsedTld = dot > 0 ? raw.slice(dot)    : '';

        // Determine the one primary TLD to check first
        const primaryTld = this.parsedTld || this._pickPrimaryTld();

        this.searching          = true;
        this.searched           = false;
        this.error              = '';
        this.registrarError     = false;
        this.authError          = false;
        this.results            = [];
        this.suggestions        = [];
        this.suggestionQueue    = [];
        this.suggestionsLoading = false;
        this.suggestionsLoadingMore = false;

        // Step 1: Check primary domain only — show result immediately
        {% if _rc.enabled and _rc.captcha_provider|default('recaptcha_v2') == 'recaptcha_v3' and _rc.publickey %}
        // reCAPTCHA v3: get a token for the primary domain availability check
        const primaryRcToken = await new Promise(function(resolve) {
          if (typeof grecaptcha !== 'undefined') {
            grecaptcha.ready(function() {
              grecaptcha.execute('{{ _rc.publickey }}', { action: 'DOMAIN_SEARCH' })
                .then(resolve).catch(function() { resolve(''); });
            });
          } else { resolve(''); }
        });
        const primary = await this._checkOneTld(primaryTld, this.parsedSld, true, {'g-recaptcha-response': primaryRcToken});
        {% else %}
        const primary = await this._checkOneTld(primaryTld, this.parsedSld, true);
        {% endif %}
        this.results   = [primary];
        this.searching = false;
        this.searched  = true;

        // Scroll results into view
        this.$nextTick(() => {
          const el = document.getElementById('searchResults');
          if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });

        // Step 2: Lazily check alternative TLDs in the background
        this._startSuggestionsLoad(this.parsedSld, primaryTld);
      },

      _pickPrimaryTld() {
        const popular = ['.com', '.net', '.org', '.io', '.co'];
        const avail = TLD_DATA.filter(t => t.allow_register);
        for (const p of popular) {
          if (avail.find(t => t.tld === p)) return p;
        }
        return avail.length > 0 ? avail[0].tld : '.com';
      },

      _checkOneTld(tld, sld, updateErrors, extraParams = {}) {
        return new Promise(resolve => {
          API.guest.post(
            'servicedomain/check',
            Object.assign({ sld, tld }, extraParams),
            () => {
              const meta = tldMeta(tld);
              resolve({
                tld,
                sld,
                domain:        sld + tld,
                available:     true,
                price:         meta.price,
                renewPrice:    meta.renewPrice,
                minYears:      meta.minYears,
                registerYears: Math.max(1, meta.minYears),
              });
            },
            (err) => {
              const msg = (err && (err.message || err)) + '';
              const m = msg.toLowerCase();
              const isAuth  = m.includes('unauthenticated user') || m.includes('unauthorized') || m.includes('invalid api key') || m.includes('credentials are invalid') || m.includes('whitelisted') || m.includes('api credentials');
              const isTaken = !isAuth && (m.includes('not available') || m.includes('already') ||
                              m.includes('cannot be registered') || m.includes('not active') ||
                              m.includes('is invalid') || m.includes('no registrar') ||
                              m.includes('not configured') || m.includes('tld is not'));
              if (updateErrors) {
                if (isAuth) this.authError = true;
                else if (!isTaken) this.registrarError = true;
              }
              resolve({ tld, sld, domain: sld + tld, available: false, price: 0, renewPrice: 0, minYears: 1, registerYears: 1 });
            },
            false
          );
        });
      },

      _startSuggestionsLoad(sld, excludeTld) {
        // Huraga-aligned: suggestions show configured pricing only — availability is
        // checked on demand (per-row Check button), not auto-fired. This keeps registrar
        // API usage and the per-IP rate-limit budget at one lookup per explicit action.
        if (!sld || sld.length < 2) return;
        const altTlds = TLD_DATA.filter(t => t.allow_register && t.tld !== excludeTld);
        if (altTlds.length === 0) return;

        const firstBatch = altTlds.slice(0, 3);
        this.suggestionQueue = altTlds.slice(3, 6);

        this.suggestions = firstBatch.map(t => {
          const meta = tldMeta(t.tld);
          return {
            tld: t.tld, sld, domain: sld + t.tld,
            checking: false, available: null,
            price: meta.price, renewPrice: meta.renewPrice,
            minYears: meta.minYears, registerYears: Math.max(1, meta.minYears),
          };
        });
      },

      async checkSuggestion(idx) {
        const s = this.suggestions[idx];
        if (!s || s.checking || s.available !== null) return;
        this.suggestions.splice(idx, 1, { ...s, checking: true });
        const r = await this._checkOneTld(s.tld, s.sld, false);
        this.suggestions.splice(idx, 1, { ...r, checking: false });
      },

      showMoreSuggestions() {
        if (!this.suggestionQueue.length) return;
        const batch = this.suggestionQueue.splice(0, 3);

        // Append rows with pricing only — availability stays on-demand per row
        batch.forEach(t => {
          const meta = tldMeta(t.tld);
          this.suggestions.push({
            tld: t.tld, sld: this.parsedSld, domain: this.parsedSld + t.tld,
            checking: false, available: null,
            price: meta.price, renewPrice: meta.renewPrice,
            minYears: meta.minYears, registerYears: Math.max(1, meta.minYears),
          });
        });
      },

      startWizard(r) {
        this.selSld        = r.sld   || this.parsedSld;
        this.selTld        = r.tld;
        this.selYears      = r.registerYears || Math.max(1, r.minYears || 1);
        this.selPriceRaw   = r.price;
        this.selRenewPrice = r.renewPrice;
        this.useDefaultNs  = true;
        this.ns1 = this.ns2 = this.ns3 = this.ns4 = '';
        this.registrantEnabled = false;
        this.adminEnabled      = false;
        this.techEnabled       = false;
        this.billingEnabled    = false;
        this.orderError    = '';
        this.wizardStep    = 1;
        this.wizardActive  = true;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      },

      exitWizard() {
        this.wizardActive = false;
        this.wizardStep   = 1;
      },

      goToStep2() {
        this.wizardStep = 2;
        if (this.isLoggedIn) this.loadContactFromAccount();
      },

      changeCurrency(code) {
        if (code === this.currencyCode || this.changingCurrency) return;
        if (window.stablepanel && typeof window.stablepanel.switchCurrency === 'function') {
          window.stablepanel.switchCurrency(code);
          return;
        }
        this.changingCurrency = true;
        API.guest.post(
          'cart/set_currency',
          { currency: code },
          () => { window.location.reload(); },
          () => { this.changingCurrency = false; },
          false
        );
      },

      submitLogin() {
        if (!this.loginEmail || !this.loginPassword) return;
        this.loginLoading = true;
        this.loginError   = '';
        API.guest.post(
          'client/login',
          { email: this.loginEmail, password: this.loginPassword },
          () => {
            // After login the server calls session_regenerate_id(), so the session ID
            // changes. The CSRF token embedded in the page meta tag was computed from
            // the old session ID and is now stale — any subsequent client API call will
            // fail with a CSRF 403. Fix: re-fetch the current page and pull the fresh
            // csrf-token out of its <meta> tag before calling loadContactFromAccount().
            fetch(window.location.href, { credentials: 'same-origin' })
              .then(r => r.text())
              .then(html => {
                const doc = new DOMParser().parseFromString(html, 'text/html');
                const freshToken = doc.querySelector('meta[name="csrf-token"]')
                                      ?.getAttribute('content');
                if (freshToken) {
                  const metaEl = document.querySelector('meta[name="csrf-token"]');
                  if (metaEl) metaEl.setAttribute('content', freshToken);
                }
              })
              .catch(() => { /* non-fatal — profile fetch may still work */ })
              .finally(() => {
                this.isLoggedIn     = true;
                this.showLoginModal  = false;
                this.loginPassword   = '';
                this.loginError      = '';
                this.loginLoading    = false;
                this.loadContactFromAccount();
              });
          },
          (err) => {
            this.loginError  = (err && (err.message || err)) || 'Invalid email or password.';
            this.loginLoading = false;
          },
          false
        );
      },

      loadContactFromAccount() {
        if (this.contact.email) return; // already loaded
        this.registrantEnabled = true; // open card so loading spinner is visible
        this.contactLoading = true;
        API.client.post(
          'profile/get',
          {},
          (data) => {
            this.contact = {
              first_name: data.first_name || '',
              last_name:  data.last_name  || '',
              email:      data.email      || '',
              company:    data.company    || '',
              address_1:  data.address_1  || '',
              city:       data.city       || '',
              state:      data.state      || '',
              country:    data.country    || '',
              postcode:   data.postcode   || '',
              phone_cc:   data.phone_cc   || '',
              phone:      data.phone      || '',
            };
            this.contactLoading = false;
          },
          () => {
            this.contactLoading = false;
          },
          false
        );
      },

      toggleAddon(addonId) {
        const key = String(addonId);
        if (!this.addons[key]) this.addons[key] = { selected: false };
        this.addons[key].selected = !this.addons[key].selected;
      },

      addonPriceTotal() {
        return DOMAIN_ADDONS.reduce((sum, a) => {
          const s = this.addons[String(a.id)];
          return s && s.selected ? sum + (parseFloat(a.priceRaw) || 0) : sum;
        }, 0);
      },

      placeOrder() {
        if (!PRODUCT_ID) {
          this.orderError = 'Domain product not configured. Please contact support.';
          return;
        }
        this.ordering   = true;
        this.orderError = '';

        const params = {
          id:            PRODUCT_ID,
          multiple:      1,
          action:        'register',
          register_sld:  this.selSld,
          register_tld:  this.selTld,
          register_years: this.selYears,
        };

        if (!this.useDefaultNs && this.ns1.trim() && this.ns2.trim()) {
          params.ns1 = this.ns1.trim();
          params.ns2 = this.ns2.trim();
          if (this.ns3.trim()) params.ns3 = this.ns3.trim();
          if (this.ns4.trim()) params.ns4 = this.ns4.trim();
        }

        // Attach selected addons
        const addonPayload = {};
        Object.entries(this.addons).forEach(([id, state]) => {
          if (state.selected) {
            const meta = DOMAIN_ADDONS.find(a => String(a.id) === id);
            const entry = { selected: true };
            if (meta && meta.pricingType === 'recurrent' && meta.firstPeriodCode) {
              entry.period = meta.firstPeriodCode;
            }
            addonPayload[id] = entry;
          }
        });
        if (Object.keys(addonPayload).length > 0) {
          params.addons = addonPayload;
        }

        const afterAdd = () => {
          if (this.promoCode) {
            API.guest.post(
              'cart/apply_promo',
              { promocode: this.promoCode },
              () => {
                window.location.href = CHECKOUT;
              },
              (err) => {
                const msg = (err && (err.message || err)) || 'Promo code is invalid or has expired.';
                this.promoError = msg;
                this.orderError = 'Promo code error: ' + msg + ' Please remove it or try a different code.';
                this.promoCode  = '';
                this.promoDiscount = 0;
                this.ordering   = false;
              },
              true
            );
          } else {
            window.location.href = CHECKOUT;
          }
        };

        API.guest.post(
          'cart/add_item',
          params,
          afterAdd,
          (err) => {
            this.orderError = (err && (err.message || err)) || 'Failed to add domain to cart. Please try again.';
            this.ordering   = false;
          },
          true
        );
      },

      applyCoupon() {
        const code = this.promoInput.trim();
        if (!code || this.promoLoading || this.promoCode) return;
        this.promoLoading = true;
        this.promoError   = '';
        const payload = PRODUCT_ID
          ? { promocode: code, product_id: PRODUCT_ID }
          : { promocode: code };
        API.guest.post('cart/validate_promo', payload,
          (promo) => {
            this.promoLoading  = false;
            this.promoCode     = code.toUpperCase();
            this.promoInput    = '';
            this.promoError    = '';
            this.promoType     = promo.type  || null;
            this.promoValue    = promo.value || 0;
            // Compute discount preview against the currently selected price
            const base = parseFloat(this.selRegPrice) || 0;
            if (base > 0 && this.promoType) {
              if (this.promoType === 'percentage') {
                this.promoDiscount = Math.round(base * this.promoValue / 100 * 100) / 100;
              } else if (this.promoType === 'absolute') {
                this.promoDiscount = Math.min(this.promoValue, base);
              }
            }
          },
          (err) => {
            this.promoLoading = false;
            this.promoError   = (err && err.message) ? err.message : (typeof err === 'string' ? err : 'Invalid or expired promo code.');
          },
          true
        );
      },

      // expose helpers for Alpine x-text / x-style bindings
      fmtPrice,
      tldGradient,
    };
  };
})();
</script>
{% endblock %}

