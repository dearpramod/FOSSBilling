        {# ══ ALPINE PRICING CONTEXT + POPULAR + TABLE ══ #}
        <div x-data="{
                period: '{{ _dom_default_period }}',
                currencyFormat: {{ currency_fmt_js|json_encode }},
                currencyRate: {{ currency.conversion_rate|default(1) }},
                currencyPriceFormat: {{ currency.price_format|default(2)|json_encode }},
                fmt(price) {
                    const converted = parseFloat(price) * this.currencyRate;
                    if (isNaN(converted)) return this.currencyFormat.replace('__PRICE__', '0.00');
                    let num;
                    switch (parseInt(this.currencyPriceFormat)) {
                        case 2: num = converted.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}); break;
                        case 3: num = converted.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.'); break;
                        case 4: num = Math.round(converted).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ','); break;
                        case 5: num = Math.round(converted).toString(); break;
                        default: num = converted.toFixed(2);
                    }
                    return this.currencyFormat.replace('__PRICE__', num);
                },
                fmtNum(price) {
                    const converted = parseFloat(price) * this.currencyRate;
                    if (isNaN(converted)) return '0.00';
                    switch (parseInt(this.currencyPriceFormat)) {
                        case 2: return converted.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
                        case 3: return converted.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                        case 4: return Math.round(converted).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
                        case 5: return Math.round(converted).toString();
                        default: return converted.toFixed(2);
                    }
                },
                getPrice(pricing, key) {
                    if (!pricing) return null;
                    if (pricing.type === 'free') return 0;
                    if (pricing.type === 'once' && pricing.once) {
                        const op = parseFloat(pricing.once.price);
                        return isNaN(op) ? null : op;
                    }
                    if (pricing.type === 'recurrent' && pricing.recurrent) {
                        if (pricing.recurrent[key] && pricing.recurrent[key].enabled) {
                            const p = parseFloat(pricing.recurrent[key].price);
                            return isNaN(p) ? null : p;
                        }
                        if (pricing.recurrent['1Y'] && pricing.recurrent['1Y'].enabled) {
                            const p1y = parseFloat(pricing.recurrent['1Y'].price);
                            return isNaN(p1y) ? null : p1y;
                        }
                    }
                    return null;
                },
                getRenewalPrice(pricing, key) {
                    if (!pricing) return null;
                    if (pricing.renewal && typeof pricing.renewal === 'object') {
                        if (pricing.renewal[key] !== undefined) return parseFloat(pricing.renewal[key]);
                        if (pricing.renewal.price !== undefined) return parseFloat(pricing.renewal.price);
                    }
                    const yearly = this.getPrice(pricing, '1Y');
                    return yearly !== null ? yearly : this.getPrice(pricing, key);
                },
                getTransferPrice(pricing, key) {
                    if (!pricing) return null;
                    if (pricing.transfer && typeof pricing.transfer === 'object') {
                        if (pricing.transfer[key] !== undefined) return parseFloat(pricing.transfer[key]);
                        if (pricing.transfer.price !== undefined) return parseFloat(pricing.transfer.price);
                    }
                    if (pricing.transfer && !isNaN(parseFloat(pricing.transfer))) return parseFloat(pricing.transfer);
                    return this.getPrice(pricing, key);
                },
                isPromo(pricing, key) {
                    const yearly = this.getPrice(pricing, '1Y');
                    const selected = this.getPrice(pricing, key);
                    return yearly !== null && selected !== null && selected < yearly;
                },
                periodLabel(key) {
                    return ({ '1Y': '1 Year', '2Y': '2 Years', '3Y': '3 Years', '4Y': '4 Years', '5Y': '5 Years', '6Y': '6 Years', '7Y': '7 Years', '8Y': '8 Years', '9Y': '9 Years', '10Y': '10 Years' }[key] || key);
                }
            }">

            {# ── Popular Extensions ── #}
            {% if _dom_featured|length > 0 %}
            <section class="max-w-5xl mx-auto px-4 mb-16">
                <h3 class="text-xl font-bold mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">stars</span> Popular Extensions
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    {% for i, p in _dom_featured %}
                    {% set _dom_desc = p.description|striptags|trim|replace({'\r\n': ' ', '\n': ' ', '\r': ' '})|replace({'  ': ' '}) %}
                    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 hover:shadow-lg transition-shadow {% if i == 0 %}border-t-4 border-t-primary{% endif %}"
                         x-data="{ pricing: {{ p.pricing|json_encode }} }">
                        <div class="flex justify-between items-start mb-4">
                            <span class="text-3xl font-bold text-slate-900 dark:text-white">{{ p.title }}</span>
                            {% if i == 0 %}<span class="px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-[10px] font-bold rounded uppercase">Top Seller</span>{% endif %}
                        </div>
                        <p class="text-slate-500 dark:text-slate-400 text-sm mb-6">{{ _dom_desc ? (_dom_desc|length > 88 ? _dom_desc|slice(0, 88) ~ '...' : _dom_desc) : 'Reliable domain extension for your project and brand presence.' }}</p>

                        <template x-if="getPrice(pricing, period) !== null && getPrice(pricing, period) > 0">
                            <div class="flex items-end gap-1 mb-6">
                                <span class="text-2xl font-bold text-slate-900 dark:text-white" x-text="fmtNum(getPrice(pricing, period))"></span>
                                <span class="text-slate-400 dark:text-slate-500 text-sm pb-1" x-text="'/' + periodLabel(period)"></span>
                            </div>
                        </template>
                        <template x-if="getPrice(pricing, period) === 0">
                            <div class="text-2xl font-bold text-emerald-600 mb-6">Free</div>
                        </template>

                        <a href="{{ ('/order/' ~ p.slug)|url }}"
                           class="w-full py-2.5 bg-slate-100 dark:bg-slate-700 hover:bg-primary hover:text-white transition-all rounded-lg font-semibold text-primary dark:text-primary inline-flex items-center justify-center gap-2">
                            Register <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                        </a>
                    </div>
                    {% endfor %}
                </div>
            </section>
            {% endif %}

            {# ── All Extensions table ── #}
            <section id="dom-all-extensions" class="max-w-5xl mx-auto px-4 pb-10">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-xl font-bold flex items-center gap-2">
                        All Extensions
                        <span class="bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-400 text-xs px-2 py-0.5 rounded-full">{{ _domain_products|length }}+</span>
                    </h3>
                    {% if _dom_enabled_periods|length > 1 %}
                    <div class="flex items-center gap-3">
                        <span class="text-sm text-slate-500 dark:text-slate-400">Billing:</span>
                        <select x-model="period" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-sm px-3 pr-8 h-10 focus:ring-primary text-slate-900 dark:text-white">
                            {% for pk in _dom_enabled_periods %}
                            <option value="{{ pk }}">{{ _dom_period_meta[pk].label|default(pk) }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    {% endif %}
                </div>

                <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 dark:bg-slate-900/50 border-b border-slate-200 dark:border-slate-700">
                                <th class="px-6 py-4 text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Extension</th>
                                <th class="px-6 py-4 text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider text-right">Registration (1st yr)</th>
                                <th class="px-6 py-4 text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider text-right">Renewal</th>
                                <th class="px-6 py-4 text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider text-right">Transfer</th>
                                <th class="px-6 py-4 text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                            {% for p in _domain_products %}
                            {% set _dom_cell = p.title|replace({' ': ''})|lower %}
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors" x-data="{ pricing: {{ p.pricing|json_encode }} }">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <span class="w-10 h-10 bg-slate-100 dark:bg-slate-700 rounded-lg flex items-center justify-center font-bold text-xs text-slate-700 dark:text-slate-300 flex-shrink-0">{{ _dom_cell }}</span>
                                        <span class="font-semibold text-slate-900 dark:text-white">{{ p.title }}</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <template x-if="getPrice(pricing, period) !== null">
                                        <div>
                                            <div class="font-bold text-primary" x-text="fmt(getPrice(pricing, period))"></div>
                                            <div class="text-[10px] text-slate-400 uppercase tracking-wide" x-show="isPromo(pricing, period)">PROMO PRICE</div>
                                        </div>
                                    </template>
                                    <template x-if="getPrice(pricing, period) === null">
                                        <span class="text-slate-400">—</span>
                                    </template>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <template x-if="getRenewalPrice(pricing, period) !== null">
                                        <span class="font-medium text-slate-700 dark:text-slate-300" x-text="fmt(getRenewalPrice(pricing, period))"></span>
                                    </template>
                                    <template x-if="getRenewalPrice(pricing, period) === null">
                                        <span class="text-slate-400">—</span>
                                    </template>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <template x-if="getTransferPrice(pricing, period) !== null">
                                        <span class="font-medium text-slate-700 dark:text-slate-300" x-text="fmt(getTransferPrice(pricing, period))"></span>
                                    </template>
                                    <template x-if="getTransferPrice(pricing, period) === null">
                                        <span class="text-slate-400">—</span>
                                    </template>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <a href="{{ ('/order/' ~ p.slug)|url }}"
                                       class="px-4 py-1.5 border border-primary text-primary hover:bg-primary hover:text-white rounded-lg text-sm font-semibold transition-all inline-flex items-center justify-center">Register</a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

        </div>

        {% elseif _type == 'custom' %}
        {# ══════════════════════════════════════════════════════
           CUSTOM SERVICES category — full-featured card layout
           ══════════════════════════════════════════════════════ #}

        {# ── Discover which periods are actually available ── #}
        {% set _cust_period_order = ['1W', '1M', '3M', '6M', '1Y', '2Y', '3Y'] %}
        {% set _cust_period_meta = {
            '1W': {'label': 'Weekly',   'months': 0.25},
            '1M': {'label': 'Monthly',  'months': 1},
            '3M': {'label': '3 Months', 'months': 3},
            '6M': {'label': '6 Months', 'months': 6},
            '1Y': {'label': '1 Year',   'months': 12},
            '2Y': {'label': '2 Years',  'months': 24},
            '3Y': {'label': '3 Years',  'months': 36}
        } %}
        {% set _cust_enabled_periods = [] %}
        {% for pk in _cust_period_order %}
            {% set pk_on = false %}
            {% for p in cat_products %}
                {# Only count periods from recurrent-type products; once/free products always have
                   recurrent DB columns but they carry no meaningful pricing for the switcher. #}
                {% if p.pricing.type == 'recurrent' and p.pricing.recurrent[pk] is defined and p.pricing.recurrent[pk].enabled %}
                    {% set pk_on = true %}
                {% endif %}
            {% endfor %}
            {% if pk_on %}{% set _cust_enabled_periods = _cust_enabled_periods|merge([pk]) %}{% endif %}
        {% endfor %}
        {# Default = first actually-enabled period; no forced injection of 1M #}
        {% set _cust_default_period = _cust_enabled_periods|first|default('1M') %}
        {% set _cust_all_pricings = [] %}
        {% for p in cat_products %}{% set _cust_all_pricings = _cust_all_pricings|merge([p.pricing]) %}{% endfor %}
        {# Detect if ANY product in this category has recurrent pricing #}
        {% set _cust_has_recurrent = false %}
        {% for p in cat_products %}{% if p.pricing.type == 'recurrent' %}{% set _cust_has_recurrent = true %}{% endif %}{% endfor %}

        <div x-data="{
            period: '{{ _cust_default_period }}',
            showAllFeaturesGlobal: false,
            currencyFormat: {{ currency_fmt_js|json_encode }},
            currencyRate: {{ currency.conversion_rate|default(1) }},
            currencyPriceFormat: {{ currency.price_format|default(2)|json_encode }},
            fmt(price) {
                const converted = parseFloat(price) * this.currencyRate;
                if (isNaN(converted)) return this.currencyFormat.replace('__PRICE__', '0.00');
                let num;
                switch (parseInt(this.currencyPriceFormat)) {
                    case 2: num = converted.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}); break;
                    case 3: num = converted.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.'); break;
                    case 4: num = Math.round(converted).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ','); break;
                    case 5: num = Math.round(converted).toString(); break;
                    default: num = converted.toFixed(2);
                }
                return this.currencyFormat.replace('__PRICE__', num);
            },
            fmtNum(price) {
                const converted = parseFloat(price) * this.currencyRate;
                if (isNaN(converted)) return '0.00';
                switch (parseInt(this.currencyPriceFormat)) {
                    case 2: return converted.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
                    case 3: return converted.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                    case 4: return Math.round(converted).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
                    case 5: return Math.round(converted).toString();
                    default: return converted.toFixed(2);
                }
            },
            getPrice(pricing, key) {
                if (!pricing) return null;
                if (pricing.type === 'free') return 0;
                if (pricing.type === 'once') {
                    if (!pricing.once) return null;
                    const op = parseFloat(pricing.once.price);
                    return isNaN(op) ? null : op;
                }
                if (!pricing.recurrent) return null;
                const p = pricing.recurrent[key];
                if (!(p && p.enabled)) return null;
                const price = parseFloat(p.price);
                return isNaN(price) ? null : price;
            },
            monthlyEquiv(price, key) {
                const m = { '1W': 0.25, '1M': 1, '3M': 3, '6M': 6, '1Y': 12, '2Y': 24, '3Y': 36 }[key] || 1;
                return price / m;
            },
            periodLabel(key) {
                return ({ '1W': 'Weekly', '1M': 'Monthly', '3M': '3 Months', '6M': '6 Months', '1Y': '1 Year', '2Y': '2 Years', '3Y': '3 Years' }[key] || key);
            }
        }">

            {# ── Section heading ── #}
            <div class="text-center mb-10" id="ord-plans">
                <div class="flex items-center justify-center gap-3 mb-3">
                    <span class="block h-px w-10 bg-primary/40 rounded-full"></span>
                    <span class="text-primary text-[11px] font-bold uppercase tracking-widest">{{ _tagline ?: 'Custom Services' }}</span>
                    <span class="block h-px w-10 bg-primary/40 rounded-full"></span>
                </div>
                <h2 class="font-h2 text-h2 text-on-background mb-3">Pick the Right Plan for You</h2>
                <p class="text-tertiary text-sm max-w-xl mx-auto">Flexible service options built around your needs. Transparent pricing, no hidden fees.</p>
            </div>

            {# ── Subscription period selector — only for recurrent products ── #}
            {% if _cust_has_recurrent and _cust_enabled_periods|length > 1 %}
            <div class="max-w-[360px] mx-auto mb-8">
                <label class="block text-sm font-medium text-on-surface mb-2">Subscription length</label>
                <div class="relative">
                    <select x-model="period" class="ord-period-select w-full h-11 rounded-xl border border-outline-variant bg-white px-4 pr-10 text-sm text-on-surface appearance-none">
                        {% for pk in _cust_enabled_periods %}
                        <option value="{{ pk }}">{{ _cust_period_meta[pk].label }}</option>
                        {% endfor %}
                    </select>
                    <span class="material-symbols-outlined pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-slate-500">expand_more</span>
                </div>
            </div>
            {% endif %}

            {# ── Card slider ── #}
            <div x-data="{
                scrollEl: null,
                canPrev: false,
                canNext: true,
                init() {
                    this.scrollEl = this.$refs.scroller;
                    this.updateArrows();
                    this.scrollEl.addEventListener('scroll', () => this.updateArrows(), { passive: true });
                },
                updateArrows() {
                    this.canPrev = this.scrollEl.scrollLeft > 4;
                    this.canNext = this.scrollEl.scrollLeft + this.scrollEl.clientWidth < this.scrollEl.scrollWidth - 4;
                },
                scrollBy(dir) {
                    const card = this.scrollEl.querySelector('[data-custom-pricing-card]');
                    const step = card ? card.offsetWidth + 24 : 352;
                    this.scrollEl.scrollBy({ left: dir * step, behavior: 'smooth' });
                }
            }" class="relative max-w-[1120px] mx-auto px-4 pb-16">

                <button @click="scrollBy(-1)" x-show="canPrev"
                        class="ord-cat-scroll-btn absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 z-20 w-10 h-10 rounded-full flex items-center justify-center transition-all"
                        style="display:none" aria-label="Previous plans">
                    <span class="material-symbols-outlined text-lg">chevron_left</span>
                </button>
                <button @click="scrollBy(1)" x-show="canNext"
                        class="ord-cat-scroll-btn absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 z-20 w-10 h-10 rounded-full flex items-center justify-center transition-all"
                        aria-label="Next plans">
                    <span class="material-symbols-outlined text-lg">chevron_right</span>
                </button>

                <div x-ref="scroller" class="flex items-start gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden pb-2">
                {% for i, p in cat_products %}
                {% set _cust_pricing_json = p.pricing|json_encode %}
                {# ── Feature extraction (handles HTML, bullets, checkmarks) ── #}
                {% set _cust_raw_feats = p.description|replace({'<br>': '|||', '<br/>': '|||', '<br />': '|||', '</p>': '|||', '</li>': '|||'})|striptags|trim|split('|||')|filter(l => l|trim != '') %}
                {% if _cust_raw_feats|length <= 1 and p.description %}
                    {% set _cust_raw_feats = [] %}
                    {% for item in p.description|striptags|trim|split('*') %}
                        {% set feat = item|trim %}
                        {% if feat %}{% set _cust_raw_feats = _cust_raw_feats|merge([feat]) %}{% endif %}
                    {% endfor %}
                {% endif %}
                {% set _cust_features = [] %}
                {% for _f in _cust_raw_feats %}
                    {% set _fc = _f|replace({'✔️': '|||', '✅': '|||', '✓': '|||', '•': '|||', '&nbsp;': ' '})|trim %}
                    {% for _fp in _fc|split('|||') %}
                        {% set _ft = _fp|trim|trim(',') %}
                        {# Strip leading Material Symbols ligature names (e.g. check_circle, verified) #}
                        {% for _icon in ['check_circle', 'check_fill', 'check_circle_outline', 'verified', 'done_all', 'done', 'star_rate', 'star', 'arrow_forward', 'arrow_right'] %}
                            {% if _ft starts with _icon %}{% set _ft = _ft[_icon|length:]|trim %}{% endif %}
                        {% endfor %}
                        {% if _ft and _ft|lower != 'check' and _ft not in _cust_features %}
                            {% set _cust_features = _cust_features|merge([_ft]) %}
                        {% endif %}
                    {% endfor %}
                {% endfor %}
                {% set _cust_is_popular = (i == 1) %}

                <div data-custom-pricing-card
                     class="ord-product-card relative bg-white rounded-3xl flex flex-col pricing-card-shadow transition-all duration-200 border border-slate-200 overflow-hidden snap-start flex-shrink-0 w-full sm:!w-[340px] lg:!w-[349px] {% if _cust_is_popular %}ord-plan-popular ring-2 ring-primary/20 ring-offset-0{% endif %}"
                     x-data="{ pricing: {{ _cust_pricing_json }} }">

                    {% if _cust_is_popular %}
                    <div class="ord-plan-popular-ribbon absolute top-0 left-0 right-0 h-12 bg-primary text-white text-center text-[11px] font-black uppercase tracking-widest flex items-center justify-center z-20">
                        MOST POPULAR
                    </div>
                    {% endif %}

                    <div class="p-7 pb-4 {% if _cust_is_popular %}pt-16 ord-plan-popular-body{% endif %}">
                        <h3 class="font-h2 text-h2 text-on-surface mb-1">{{ p.title }}</h3>

                        {# ── Recurrent pricing ── #}
                        <template x-if="pricing.type === 'recurrent'">
                            <div class="mt-4">
                                <template x-if="getPrice(pricing, period) !== null">
                                    <div>
                                        <template x-if="getPrice(pricing, '1M') !== null && getPrice(pricing, '1M') > 0 && monthlyEquiv(getPrice(pricing, period), period) < getPrice(pricing, '1M')">
                                            <div class="flex items-center justify-between gap-2 mb-3">
                                                <span class="text-slate-400 text-sm line-through" x-text="fmt(getPrice(pricing, '1M'))"></span>
                                                <span class="px-2 py-0.5 rounded-full bg-primary/10 text-primary text-[12px] font-bold"
                                                      x-text="Math.round((1 - monthlyEquiv(getPrice(pricing, period), period) / getPrice(pricing, '1M')) * 100) + '% OFF'"></span>
                                            </div>
                                        </template>
                                        <div class="flex items-baseline gap-1 mb-2">
                                            <span class="text-slate-500 text-sm mr-1" x-text="currencyFormat.split('__PRICE__')[0].trim()"></span>
                                            <span class="text-[36px] font-bold text-on-surface tracking-tight tabular-nums"
                                                  x-text="fmtNum(getPrice(pricing, '1M') !== null ? (period === '1M' ? getPrice(pricing, period) : monthlyEquiv(getPrice(pricing, period), period)) : getPrice(pricing, period))"></span>
                                            <span class="text-slate-500 font-medium text-sm" x-text="currencyFormat.split('__PRICE__')[1].trim()"></span>
                                            <span class="text-slate-500 font-medium text-sm"
                                                  x-text="getPrice(pricing, '1M') !== null ? '/mo' : ({ '1W': '/wk', '1M': '/mo', '3M': '/3mo', '6M': '/6mo', '1Y': '/yr', '2Y': '/2yr', '3Y': '/3yr' }[period] || '')"></span>
                                        </div>
                                    </div>
                                </template>
                                <template x-if="getPrice(pricing, period) === null">
                                    <p class="text-sm text-slate-400 italic py-3">Not available for this period</p>
                                </template>
                            </div>
                        </template>

                        {# ── One-time / free pricing ── #}
                        {% if p.pricing.type == 'once' %}
                        <div class="flex items-baseline gap-1 mt-4 mb-2">
                            <span class="text-slate-500 text-sm mr-1" x-text="currencyFormat.split('__PRICE__')[0].trim()"></span>
                            <span class="text-5xl font-black text-on-surface tracking-tight tabular-nums" x-text="fmtNum(getPrice(pricing, period))"></span>
                            <span class="text-slate-500 text-sm" x-text="currencyFormat.split('__PRICE__')[1].trim()"></span>
                            <span class="text-slate-500 text-sm">one-time</span>
                        </div>
                        {% elseif p.pricing.type == 'free' %}
                        <div class="mt-4 mb-2">
                            <span class="text-5xl font-black text-on-surface tracking-tight">Free</span>
                        </div>
                        {% endif %}

                        {# ── Billing descriptor ── #}
                        <p class="text-xs text-slate-500 leading-relaxed mb-5">
                            {% if p.pricing.type == 'free' %}
                                Free plan &mdash; no charge ever.
                            {% elseif p.pricing.type == 'once' %}
                                One-time payment &mdash; no subscription required.
                            {% else %}
                                <span x-show="pricing.type !== 'recurrent' || getPrice(pricing, period) !== null">
                                    Billed <strong x-text="fmt(getPrice(pricing, period))"></strong>
                                    <span x-text="periodLabel(period)"></span>.
                                    <span x-show="getPrice(pricing, '1M') !== null">
                                        Renews at <strong x-text="fmt(getPrice(pricing, '1M'))"></strong>/mo.
                                    </span>
                                </span>
                            {% endif %}
                        </p>

                        {# ── CTA ── #}
                        <template x-if="pricing.type !== 'recurrent' || getPrice(pricing, period) !== null">
                            <a href="{{ ('/order/' ~ p.slug)|url }}"
                               class="block w-full text-center font-bold text-base transition-all active:scale-[0.98] mb-4 {% if _cust_is_popular %}ord-cat-btn-primary py-4 bg-primary text-white rounded-xl shadow-lg shadow-primary/20{% else %}ord-cat-btn-secondary py-3.5 border-2 border-primary text-primary rounded-xl hover:bg-primary/5{% endif %}">
                                {{ _cust_is_popular ? 'Get Started' : 'Choose Plan' }}
                            </a>
                        </template>
                        <template x-if="pricing.type === 'recurrent' && getPrice(pricing, period) === null">
                            <span class="block w-full text-center py-3.5 rounded-xl text-sm font-bold border border-slate-200 text-slate-400 cursor-not-allowed mb-4">Not Available</span>
                        </template>
                    </div>

                    {# ── Features list ── #}
                    {% if _cust_features|length > 0 %}
                    <div class="ord-price-row px-7 pb-8 border-t border-slate-200 pt-6 mt-auto">
                        <p class="text-[11px] font-bold uppercase tracking-widest text-slate-500 mb-3">What's Included</p>
                        <div class="space-y-3.5">
                        {% for feat in _cust_features|slice(0, 6) %}
                        <div class="flex items-center text-[13px] text-slate-700">
                            <span class="material-symbols-outlined text-[#1a8a47] text-lg mr-2 flex-shrink-0" style="font-variation-settings:'wght' 600;">check</span>
                            <span>{{ feat }}</span>
                        </div>
                        {% endfor %}
                        </div>

                        {% if _cust_features|length > 6 %}
                        <div class="overflow-hidden"
                             style="max-height: 0px; transition: max-height 0.35s ease-in-out;"
                             x-effect="$el.style.maxHeight = showAllFeaturesGlobal ? $el.scrollHeight + 'px' : '0px'">
                            <div class="space-y-3.5 pt-3.5">
                            {% for feat in _cust_features|slice(6) %}
                            <div class="flex items-center text-[13px] text-slate-700">
                                <span class="material-symbols-outlined text-[#1a8a47] text-lg mr-2 flex-shrink-0" style="font-variation-settings:'wght' 600;">check</span>
                                <span>{{ feat }}</span>
                            </div>
                            {% endfor %}
                            </div>
                        </div>
                        <button type="button"
                                @click="showAllFeaturesGlobal = !showAllFeaturesGlobal"
                                class="mt-4 flex items-center gap-1 text-sm font-semibold text-primary hover:underline">
                            <span x-text="showAllFeaturesGlobal ? 'See less' : 'See more'">See more</span>
                            <span class="material-symbols-outlined text-base"
                                  style="font-variation-settings:'wght' 600; display: inline-block; transition: transform 0.35s ease-in-out;"
                                  x-effect="$el.style.transform = showAllFeaturesGlobal ? 'rotate(180deg)' : 'rotate(0deg)'">expand_more</span>
                        </button>
                        {% endif %}
                    </div>
                    {% endif %}
                </div>
                {% endfor %}
                </div>
            </div>{# end card slider #}

        </div>{# end x-data pricing #}

        {# ── Service highlights ── #}
        <div class="mt-8 max-w-[1100px] mx-auto px-4 mb-12 ord-why-shell">
            <div class="bg-surface-container-low rounded-3xl p-10 ord-why-surface">
                <div class="text-center mb-10">
                    <span class="text-[11px] font-bold text-primary uppercase tracking-widest mb-2 block">WHY CHOOSE US</span>
                    <h2 class="text-xl font-bold text-on-surface">Tailored Services, Real Results</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {% set _cust_highlights = [
                        {'icon': 'support_agent', 'title': 'Dedicated Support',     'text': 'Every plan includes direct access to our expert team for setup, configuration, and ongoing assistance.'},
                        {'icon': 'tune',           'title': 'Fully Customisable',    'text': 'Services are scoped to your exact requirements — no rigid templates, just what you actually need.'},
                        {'icon': 'verified',       'title': 'Trusted & Reliable',    'text': 'Backed by proven infrastructure and a commitment to quality delivery and service continuity.'}
                    ] %}
                    {% for _h in _cust_highlights %}
                    <div class="flex flex-col items-center text-center gap-3">
                        <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center">
                            <span class="material-symbols-outlined text-primary text-2xl">{{ _h.icon }}</span>
                        </div>
                        <h3 class="font-bold text-on-surface text-base">{{ _h.title }}</h3>
                        <p class="text-sm text-tertiary leading-relaxed">{{ _h.text }}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        {% else %}{# not hosting/server/custom — generic product grid fallback #}

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-[1100px] mx-auto px-4 pb-10">
            {% for p in cat_products %}
            {% set desc_short = p.description|striptags|trim|slice(0, 160) %}
            <a href="{{ ('/order/' ~ p.slug)|url }}"
               class="group flex flex-col rounded-2xl border border-outline-variant bg-surface-container-low hover:border-primary/40 hover:shadow-md transition-all duration-200 p-6 no-underline">
                <h3 class="text-base font-bold text-on-surface mb-1 group-hover:text-primary transition-colors">{{ p.title }}</h3>
                {% if p.pricing.type == 'free' %}
                    <p class="text-sm font-semibold text-emerald-600 mb-3">Free</p>
                {% elseif p.pricing.type == 'once' and p.pricing.once %}
                    <p class="text-sm font-semibold text-on-surface mb-3">{{ p.pricing.once.price|money_without_currency }} {{ currency.code }}</p>
                {% elseif p.price_starting_from is defined and p.price_starting_from > 0 %}
                    <p class="text-sm font-semibold text-on-surface mb-3">From {{ p.price_starting_from|money_without_currency }} {{ currency.code }}/mo</p>
                {% endif %}
                {% if desc_short %}
                <p class="text-xs text-tertiary leading-relaxed flex-1">{{ desc_short }}{% if p.description|striptags|trim|length > 160 %}&hellip;{% endif %}</p>
                {% endif %}
                <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-primary">
                    Get Started
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                </span>
            </a>
            {% endfor %}
        </div>

        {% endif %}{# end _type == 'hosting' #}

    {% else %}
        <div class="text-center py-20 text-tertiary">
            <span class="material-symbols-outlined text-5xl opacity-30 mb-4 block">inbox</span>
            <p class="text-sm">No plans available in this category yet. Check back soon.</p>
        </div>
    {% endif %}

</div>{# end ord-cat-page #}

{% endif %}{# end request.product #}

{% endif %}{# end category check #}

{% endblock %}
