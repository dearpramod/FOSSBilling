{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}Dashboard{% endblock %}
{% block page_header %}Client Dashboard{% endblock %}

{% import "macro_functions.html.twig" as mf %}

{% block content %}
    {# Single API call — balance, recent_invoices, recent_emails, recent_tickets all bundled #}
    {% set dashboard = client.index_get_dashboard %}
    {% set profile = dashboard.profile %}
    {% set client_currency = profile.currency|default(guest.cart_get_currency.code) %}
    {% set bal = dashboard.balance %}

    {# === EMAIL VERIFICATION MODAL + BANNER === #}
    {% if guest.client_is_email_validation_required and not profile.email_approved %}
        <div x-data="{
                open: false,
                dismissed: false,
                loading: false,
                sent: false,
                error: '',
                skip() { this.open = false; },
                reopen() { this.open = true; }
             }">

            {# ── Compact banner shown inline like Stitch ── #}
            <div x-show="!dismissed"
                 x-cloak
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 -translate-y-2"
                 x-transition:enter-end="opacity-100 translate-y-0"
                 class="mb-6 flex items-start gap-4 rounded-lg border border-red-200 bg-[#feeceb] px-4 py-4 text-sm shadow-[0_1px_0_rgba(255,255,255,0.7)_inset]">
                <div class="mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-red-50 text-red-500">
                    <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-bold text-red-700">Account Verification Required</p>
                    <p class="mt-1 text-sm text-red-500">Please complete your identity verification to ensure uninterrupted service.
                        <button @click="reopen()" class="font-semibold text-indigo-500 underline decoration-indigo-300 underline-offset-2 hover:text-indigo-600">Verify Now</button>
                    </p>
                </div>
                <button @click="dismissed = true"
                        class="flex-shrink-0 p-1 rounded text-red-300 hover:text-red-500 transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            {# ── Full-screen modal (shown until skipped for this session) ── #}
            <div x-show="open"
                 x-cloak
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0"
                 x-transition:enter-end="opacity-100"
                 x-transition:leave="transition ease-in duration-150"
                 x-transition:leave-start="opacity-100"
                 x-transition:leave-end="opacity-0"
                 class="fixed inset-0 z-50 flex items-center justify-center p-4">

                {# Backdrop — clicking outside skips the modal for this session #}
                <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" @click="skip()"></div>

                {# Glass panel #}
                <div class="relative w-full max-w-xl"
                     x-transition:enter="transition ease-out duration-300"
                     x-transition:enter-start="opacity-0 scale-95"
                     x-transition:enter-end="opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-200"
                     x-transition:leave-start="opacity-100 scale-100"
                     x-transition:leave-end="opacity-0 scale-95">

                    <div class="rounded-2xl border border-amber-500/30
                                bg-white/95 dark:bg-gray-950/90
                                backdrop-blur-xl
                                shadow-2xl shadow-amber-900/20
                                overflow-hidden">

                        {# Amber accent top bar #}
                        <div class="h-1 w-full bg-gradient-to-r from-amber-500 via-orange-400 to-amber-600"></div>

                        <div class="p-7">
                            {# Icon + dismiss row #}
                            <div class="flex items-start justify-between mb-5">
                                <div class="flex items-center gap-3">
                                    <div class="w-12 h-12 rounded-xl bg-amber-500/15 border border-amber-500/25 flex items-center justify-center flex-shrink-0">
                                        <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="text-base font-semibold text-gray-900 dark:text-white">Verify your email address</h3>
                                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Action required to activate your account</p>
                                    </div>
                                </div>
                                <button @click="skip()"
                                        class="text-gray-400 hover:text-gray-600 dark:text-gray-600 dark:hover:text-gray-400 transition-colors p-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 flex-shrink-0"
                                        aria-label="Dismiss">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                    </svg>
                                </button>
                            </div>

                            {# Email chip #}
                            <div class="flex items-center gap-2.5 px-4 py-3 rounded-xl bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 mb-5">
                                <svg class="w-4 h-4 text-amber-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/>
                                </svg>
                                <span class="text-sm text-amber-700 dark:text-amber-300">A confirmation link was sent to&nbsp;<strong class="font-semibold">{{ profile.email }}</strong></span>
                            </div>

                            {# Steps hint #}
                            <div class="grid grid-cols-3 gap-3 mb-5">
                                <div class="rounded-xl bg-gray-50 dark:bg-white/[0.03] border border-gray-200 dark:border-white/[0.06] p-3.5 text-center">
                                    <span class="w-7 h-7 rounded-full bg-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold flex items-center justify-center mx-auto mb-2">1</span>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 leading-snug">Open your inbox</p>
                                </div>
                                <div class="rounded-xl bg-gray-50 dark:bg-white/[0.03] border border-gray-200 dark:border-white/[0.06] p-3.5 text-center">
                                    <span class="w-7 h-7 rounded-full bg-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold flex items-center justify-center mx-auto mb-2">2</span>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 leading-snug">Click the confirmation link</p>
                                </div>
                                <div class="rounded-xl bg-gray-50 dark:bg-white/[0.03] border border-gray-200 dark:border-white/[0.06] p-3.5 text-center">
                                    <span class="w-7 h-7 rounded-full bg-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold flex items-center justify-center mx-auto mb-2">3</span>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 leading-snug">Reload — banner disappears</p>
                                </div>
                            </div>

                            {# Error message #}
                            <p x-show="error" x-text="error" x-cloak class="text-xs text-red-500 mb-3 text-center"></p>

                            {# Actions #}
                            <div class="flex items-center gap-3">
                                <button @click="
                                            loading = true; error = '';
                                            API.client.post(
                                                'client/resend_email_verification',
                                                {},
                                                function() { sent = true; loading = false; },
                                                function(err) { error = err || 'Failed to send. Please try again.'; loading = false; }
                                            )"
                                        :disabled="sent || loading"
                                        class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-white text-sm font-semibold transition-all disabled:opacity-60 disabled:cursor-not-allowed shadow-lg shadow-amber-500/20">
                                    <svg x-show="loading" class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                                    </svg>
                                    <span x-text="loading ? 'Sending…' : (sent ? '✓ Email sent!' : 'Resend verification email')"></span>
                                </button>
                                <button @click="skip()"
                                        class="px-5 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 dark:bg-white/5 dark:hover:bg-white/10 border border-gray-200 dark:border-white/10 text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-300 text-sm font-medium transition-all">
                                    Skip for now
                                </button>
                            </div>

                            <p class="text-xs text-gray-400 dark:text-gray-600 text-center mt-4">Didn't get the email? Check your spam folder or resend above.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# === ON-HOLD TICKET ALERTS === #}
    {% if dashboard.tickets.on_hold > 0 %}
        <div class="mb-6 space-y-2">
            {% for i, ticket in dashboard.recent_tickets %}
                {% if ticket.status == 'on_hold' %}
                    <div class="flex items-center gap-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">
                        <svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span>Ticket <strong>#{{ ticket.id }}</strong> was replied to {{ ticket.updated_at|timeago }} ago.</span>
                        <a href="{{ 'support/ticket'|url }}/{{ ticket.id }}"
                           class="ml-auto text-xs font-semibold text-amber-700 underline decoration-amber-300 underline-offset-2 hover:text-amber-800">
                            Reply
                        </a>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}

    {# === STAT CARDS === #}
    <div class="mob-stat-grid grid grid-cols-2 xl:grid-cols-4 gap-3 sm:gap-6 mb-6 sm:mb-8">

        {# Active Services #}
        <a href="{{ 'order/service'|url }}" class="group block bg-white border border-slate-200 p-6 rounded-lg shadow-[0_4px_20px_rgba(0,0,0,0.02)] hover:border-[rgba(var(--color-primary-rgb),0.3)] hover:shadow-[0_8px_30px_rgba(0,0,0,0.06)] hover:-translate-y-0.5 transition-all">
            <div class="flex justify-between items-start mb-4">
                <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
                    </svg>
                </div>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Services</span>
            </div>
            <div class="space-y-1">
                <h3 class="text-2xl font-bold text-slate-900">{{ "%02d"|format(dashboard.orders.active|default(0)) }}</h3>
                <p class="text-sm text-slate-500 font-medium">Active Services</p>
            </div>
        </a>

        {# Unpaid Invoices #}
        <a href="{{ 'invoice'|url }}" class="group block bg-white border border-slate-200 p-6 rounded-lg shadow-[0_4px_20px_rgba(0,0,0,0.02)] hover:border-[rgba(var(--color-primary-rgb),0.3)] hover:shadow-[0_8px_30px_rgba(0,0,0,0.06)] hover:-translate-y-0.5 transition-all">
            <div class="flex justify-between items-start mb-4">
                <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                    </svg>
                </div>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Invoices</span>
            </div>
            <div class="space-y-1">
                <h3 class="text-2xl font-bold text-slate-900">{{ "%02d"|format(dashboard.invoices.unpaid|default(0)) }}</h3>
                <p class="text-sm text-slate-500 font-medium">Unpaid Invoices</p>
            </div>
        </a>

        {# Open Tickets #}
        <a href="{{ 'support'|url }}" class="group block bg-white border border-slate-200 p-6 rounded-lg shadow-[0_4px_20px_rgba(0,0,0,0.02)] hover:border-[rgba(var(--color-primary-rgb),0.3)] hover:shadow-[0_8px_30px_rgba(0,0,0,0.06)] hover:-translate-y-0.5 transition-all">
            <div class="flex justify-between items-start mb-4">
                <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                </div>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Support</span>
            </div>
            <div class="space-y-1">
                <h3 class="text-2xl font-bold text-slate-900">{{ "%02d"|format(dashboard.tickets.open|default(0)) }}</h3>
                <p class="text-sm text-slate-500 font-medium">Active Tickets</p>
            </div>
        </a>

        {# Account Balance #}
        <a href="{{ 'client/balance'|url }}" class="group block bg-white border border-slate-200 p-6 rounded-lg shadow-[0_4px_20px_rgba(0,0,0,0.02)] hover:border-[rgba(var(--color-primary-rgb),0.3)] hover:shadow-[0_8px_30px_rgba(0,0,0,0.06)] hover:-translate-y-0.5 transition-all">
            <div class="flex justify-between items-start mb-4">
                <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                    </svg>
                </div>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Balance</span>
            </div>
            <div class="space-y-1">
                <h3 class="text-2xl font-bold text-slate-900">{{ bal | money(client_currency) }}</h3>
                <p class="text-sm text-slate-500 font-medium">Account Credits</p>
            </div>
        </a>

    </div>

    {# === MAIN CONTENT GRID — matches Stitch lg:grid-cols-3 structure === #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        {# ── LEFT COLUMN: Invoices + Emails/News sub-grid ── #}
        <div class="lg:col-span-2 space-y-6">

            {# Recent Invoices #}
            <div class="bg-white border border-slate-200 rounded-lg shadow-[0_4px_20px_rgba(0,0,0,0.02)] overflow-hidden">
                <div class="p-6 border-b border-slate-100 flex items-center justify-between">
                    <h3 class="text-lg font-semibold text-slate-900 tracking-tight">Recent Invoices</h3>
                    <a href="{{ '/invoice'|url }}" class="text-sm font-semibold text-indigo-400 hover:text-indigo-500 hover:underline transition-colors">View All</a>
                </div>
                {% if dashboard.recent_invoices is not empty %}
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50/50">
                            <tr>
                                <th class="px-3 sm:px-6 py-3 sm:py-4 text-xs font-bold text-slate-400 uppercase tracking-widest">Invoice ID</th>
                                <th class="hidden sm:table-cell px-3 sm:px-6 py-3 sm:py-4 text-xs font-bold text-slate-400 uppercase tracking-widest">Date</th>
                                <th class="px-3 sm:px-6 py-3 sm:py-4 text-xs font-bold text-slate-400 uppercase tracking-widest">Amount</th>
                                <th class="px-3 sm:px-6 py-3 sm:py-4 text-xs font-bold text-slate-400 uppercase tracking-widest">Status</th>
                                <th class="px-3 sm:px-6 py-3 sm:py-4 text-xs font-bold text-slate-400 uppercase tracking-widest text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            {% for invoice in dashboard.recent_invoices %}
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-3 sm:px-6 py-3 sm:py-4">
                                    <a href="{{ 'invoice'|url }}/{{ invoice.hash }}" class="text-sm font-bold text-slate-900 hover:text-indigo-500 transition-colors tabular-nums">#{{ invoice.serie }}{{ invoice.nr }}</a>
                                </td>
                                <td class="hidden sm:table-cell px-3 sm:px-6 py-3 sm:py-4 text-sm font-medium text-slate-600">{{ invoice.created_at|date("M j, Y") }}</td>
                                <td class="px-3 sm:px-6 py-3 sm:py-4 text-sm font-bold text-slate-900 tabular-nums tracking-tight">{{ invoice.total | money(invoice.currency) }}</td>
                                <td class="px-3 sm:px-6 py-3 sm:py-4">
                                    {% if invoice.status == 'paid' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                                        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full mr-1.5"></span>Paid
                                    </span>
                                    {% elseif invoice.status == 'unpaid' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                                        <span class="w-1.5 h-1.5 bg-amber-500 rounded-full mr-1.5"></span>Pending
                                    </span>
                                    {% elseif invoice.status == 'cancelled' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        <span class="w-1.5 h-1.5 bg-red-500 rounded-full mr-1.5"></span>Cancelled
                                    </span>
                                    {% else %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600">
                                        <span class="w-1.5 h-1.5 bg-slate-400 rounded-full mr-1.5"></span>{{ invoice.status|title }}
                                    </span>
                                    {% endif %}
                                </td>
                                <td class="px-3 sm:px-6 py-3 sm:py-4 text-right">
                                    {% if invoice.status == 'unpaid' %}
                                    <a href="{{ 'invoice'|url }}/{{ invoice.hash }}" class="text-slate-400 hover:text-indigo-500 transition-colors" title="Pay invoice">
                                        <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                                    </a>
                                    {% else %}
                                    <a href="{{ 'invoice'|url }}/{{ invoice.hash }}" class="text-slate-400 hover:text-indigo-500 transition-colors" title="Download invoice">
                                        <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                                    </a>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                    <div class="px-6 py-10 text-center">
                        <p class="text-slate-400 text-sm">No invoices yet</p>
                    </div>
                {% endif %}
            </div>

            {# Emails + News sub-grid #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                {# Recent Emails #}
                <div class="bg-white rounded-lg border border-slate-200 shadow-[0_4px_20px_rgba(0,0,0,0.02)] overflow-hidden">
                    <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                        <h3 class="text-xs font-bold text-slate-900 uppercase tracking-widest">Recent Emails</h3>
                        <a href="{{ '/email'|url }}" class="text-xs font-bold text-indigo-400 hover:text-indigo-500 hover:underline transition-colors">View all</a>
                    </div>
                    <div class="divide-y divide-slate-100">
                        {% if dashboard.recent_emails is defined and dashboard.recent_emails|length > 0 %}
                            {% for email in dashboard.recent_emails %}
                                <a href="{{ 'email'|url }}/{{ email.id }}" class="group flex items-center justify-between px-6 py-4 hover:bg-slate-50 transition-colors cursor-pointer">
                                    <div class="flex flex-col min-w-0 flex-1 mr-3">
                                        <span class="text-sm font-bold text-slate-800 group-hover:text-indigo-600 transition-colors truncate">{{ email.subject|default('(No Subject)') }}</span>
                                        <span class="text-xs font-medium text-slate-500 mt-1">Sent on {{ email.created_at|date("M j, Y") }}</span>
                                    </div>
                                    <svg class="w-5 h-5 text-slate-400 group-hover:text-indigo-400 transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                </a>
                            {% endfor %}
                        {% else %}
                            <div class="px-6 py-8 text-center">
                                <p class="text-slate-400 text-sm">No emails yet</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# News & Announcements #}
                <div class="bg-white rounded-lg border border-slate-200 shadow-[0_4px_20px_rgba(0,0,0,0.02)] overflow-hidden">
                    <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                        <h3 class="text-xs font-bold text-slate-900 uppercase tracking-widest">News &amp; Announcements</h3>
                        <a href="{{ '/news'|url }}" class="text-xs font-bold text-indigo-400 hover:text-indigo-500 hover:underline transition-colors">View all</a>
                    </div>
                    <div class="divide-y divide-slate-100">
                        {% if _notif_news.list is defined and _notif_news.list|length > 0 %}
                            {% for post in _notif_news.list %}
                                <div class="flex gap-4 items-start px-6 py-4 hover:bg-slate-50 transition-colors cursor-pointer">
                                    <div class="flex-shrink-0 w-12 h-12 {% if loop.index is odd %}bg-indigo-50{% else %}bg-violet-50{% endif %} rounded-lg flex items-center justify-center">
                                        {% if loop.index is odd %}
                                        <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                                        {% else %}
                                        <svg class="w-5 h-5 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                        {% endif %}
                                    </div>
                                    <div class="flex flex-col min-w-0 flex-1">
                                        <a href="{{ '/news'|url }}/{{ post.slug }}" class="text-sm font-bold text-slate-800 hover:text-indigo-600 transition-colors truncate">{{ post.title }}</a>
                                        <span class="text-xs font-medium text-slate-500 mb-1.5 mt-0.5">{{ post.created_at|timeago }} ago</span>
                                        {% if post.content is defined and post.content %}
                                        <p class="text-xs text-slate-500 leading-relaxed line-clamp-2">{{ post.content|striptags }}</p>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="px-6 py-8 text-center">
                                <p class="text-slate-400 text-sm">No announcements yet</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

            </div>{# end emails+news sub-grid #}

        </div>{# end left col #}

        {# ── RIGHT SIDEBAR: Active Tickets ── #}
        <div class="space-y-6">
            <div class="bg-white border border-slate-200 rounded-lg shadow-[0_4px_20px_rgba(0,0,0,0.02)] flex flex-col h-full">
                <div class="p-6 border-b border-slate-100 flex items-center justify-between">
                    <h3 class="text-lg font-semibold text-slate-900 tracking-tight">Active Tickets</h3>
                    <a href="{{ '/support'|url }}" class="text-xs font-bold text-indigo-400 hover:text-indigo-500 hover:underline transition-colors">View all</a>
                </div>
                <div class="p-4 space-y-4 flex-1">
                    {# Use tickets already fetched by index_get_dashboard — no extra API calls #}
                    {% set all_tickets = dashboard.recent_tickets is defined ? dashboard.recent_tickets : [] %}
                    {% if all_tickets %}
                        {% for ticket in all_tickets %}
                        <a href="{{ 'support/ticket'|url }}/{{ ticket.id }}" class="block rounded-lg border {% if ticket.status == 'closed' %}border-slate-200 opacity-60{% else %}border-slate-200{% endif %} bg-slate-50/30 p-4 transition-all hover:border-[rgba(var(--color-primary-rgb),0.3)] hover:bg-surface-container-low">
                            <div class="flex items-center justify-between gap-2 mb-2">
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    {# Helpdesk name — only shown when it exists and is not a generic fallback #}
                                    {% if ticket.helpdesk.name is defined and ticket.helpdesk.name %}
                                    <span class="rounded bg-slate-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-slate-500">{{ ticket.helpdesk.name }}</span>
                                    {% endif %}
                                    {# Status pill #}
                                    {% if ticket.status == 'open' %}
                                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-emerald-600"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Open</span>
                                    {% elseif ticket.status == 'on_hold' %}
                                    <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 border border-amber-200 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-amber-600"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>On Hold</span>
                                    {% elseif ticket.status == 'replied' %}
                                    <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 border border-blue-200 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-blue-600"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Replied</span>
                                    {% elseif ticket.status == 'closed' %}
                                    <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 border border-slate-200 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-slate-400"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Closed</span>
                                    {% endif %}
                                </div>
                                <span class="text-[10px] text-slate-400 flex-shrink-0">{{ ticket.updated_at|timeago }} ago</span>
                            </div>
                            <h4 class="mb-1.5 line-clamp-2 text-sm font-bold text-slate-800">{{ ticket.subject|default('No Subject') }}</h4>
                            {% if ticket.first.content is defined and ticket.first.content %}
                            <p class="line-clamp-2 text-[13px] text-slate-500 leading-relaxed">{{ ticket.first.content|striptags }}</p>
                            {% endif %}
                            <div class="mt-3 flex items-center justify-between">
                                <div class="flex -space-x-2">
                                    {% set initials = (ticket.client.first_name|slice(0,1)|upper) ~ (ticket.client.last_name|slice(0,1)|upper) %}
                                    <div class="flex h-6 w-6 items-center justify-center rounded-full border-2 border-white bg-slate-100 text-[8px] font-bold text-slate-500">{{ initials|default('?') }}</div>
                                    <div class="flex h-6 w-6 items-center justify-center rounded-full border-2 border-white bg-indigo-100 text-[8px] font-bold text-indigo-600">ST</div>
                                </div>
                                <span class="text-[10px] font-bold text-slate-400">#{{ ticket.id }}</span>
                            </div>
                        </a>
                        {% endfor %}
                    {% else %}
                        <div class="py-8 text-center">
                            <p class="text-slate-400 text-sm mb-3">No tickets yet</p>
                            <a href="{{ '/support'|url }}" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-50 text-indigo-500 text-xs font-semibold hover:bg-indigo-100 transition-all">Open a Ticket →</a>
                        </div>
                    {% endif %}
                </div>
                <div class="p-4 border-t border-slate-100 bg-slate-50/50">
                    <a href="{{ '/support'|url }}" class="block w-full rounded-lg border border-slate-200 bg-white py-2 text-center text-xs font-bold text-slate-500 transition-all hover:border-indigo-300 hover:bg-violet-50 hover:text-indigo-500">
                        Open New Ticket
                    </a>
                </div>
            </div>
        </div>

    </div>{# end main 3-col grid #}

{% endblock %}
