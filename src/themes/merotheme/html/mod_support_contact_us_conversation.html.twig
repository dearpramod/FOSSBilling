{% extends request.ajax ? "layout_blank.html.twig" : "layout_public.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ ticket.subject }}{% endblock %}

{% block head %}
    {{ mf.wysiwyg('#ticket-reply-text') }}
{% endblock %}

{% block content %}

<!-- ===== HERO ===== -->
<section class="relative overflow-hidden py-16 sm:py-20">
    <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] rounded-full opacity-10"
             style="background: radial-gradient(ellipse at center, var(--color-primary), transparent);"></div>
    </div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-medium mb-5">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
            Support Ticket
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-3 break-words">{{ ticket.subject }}</h1>
        <p class="text-sm text-gray-400">
            Opened by <span class="text-gray-300 font-medium">{{ ticket.author.name }}</span> on {{ ticket.created_at|format_date }}
        </p>
    </div>
</section>

<!-- ===== MAIN CONTENT ===== -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 pb-24 space-y-6">

    <!-- Ticket info bar -->
    <div class="rounded-2xl bg-white/[0.03] border border-white/[0.08] p-5 flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-5 text-sm">
            <div>
                <span class="text-gray-500 text-xs uppercase tracking-wide">Status</span>
                <div class="mt-0.5">{{ mf.status_badge(ticket.status) }}</div>
            </div>
            <div>
                <span class="text-gray-500 text-xs uppercase tracking-wide">Author</span>
                <div class="mt-0.5 text-gray-300 font-medium">{{ ticket.author.name }}</div>
            </div>
            <div>
                <span class="text-gray-500 text-xs uppercase tracking-wide">Email</span>
                <div class="mt-0.5 text-gray-300">{{ ticket.author.email }}</div>
            </div>
        </div>

        {% if ticket.status != 'closed' %}
        <div class="flex items-center gap-3">
            <a href="#reply-to"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white text-sm font-medium transition-all"
               style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
                </svg>
                Reply
            </a>
            <button id="btn-close-ticket"
                    type="button"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-gray-300 text-sm font-medium hover:bg-white/10 transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
                Close Ticket
            </button>
        </div>
        {% endif %}
    </div>

    <!-- Messages -->
    <div class="space-y-4">
        {% for i, message in ticket.messages %}
        <div class="rounded-2xl bg-white/[0.03] border border-white/[0.08] overflow-hidden">
            <!-- Message header -->
            <div class="px-5 py-3 border-b border-white/[0.06] flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <img src="{{ avatar(message.author.email, 36) }}"
                         alt="{{ message.author.name }}"
                         class="w-8 h-8 rounded-full flex-shrink-0">
                    <div>
                        <span class="text-sm font-medium text-white">{{ message.author.name }}</span>
                        <span class="text-xs text-gray-500 ml-2">{{ message.created_at|format_date }}</span>
                    </div>
                </div>
                <div class="flex items-center gap-2 text-xs text-gray-600">
                    <span>#{{ i + 1 }}</span>
                    {% if ticket.status != 'closed' %}
                    <button type="button"
                            class="reply-to-message inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-gray-400 hover:text-white hover:bg-white/10 transition-all text-xs"
                            data-message-id="{{ message.id }}">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
                        </svg>
                        Quote &amp; Reply
                    </button>
                    {% endif %}
                </div>
            </div>
            <!-- Message body -->
            <div class="px-5 py-4">
                <div id="message-{{ message.id }}" class="prose prose-invert prose-sm max-w-none text-gray-300 leading-relaxed">
                    {{ message.content|markdown }}
                </div>
            </div>
        </div>
        {# Store raw content for quoting — hidden #}
        {% if ticket.status != 'closed' %}
        <template id="quote-{{ message.id }}">{{ message.content }}</template>
        {% endif %}
        {% endfor %}
    </div>

    <!-- Reply form -->
    {% if ticket.status != 'closed' %}
    <div id="reply-to" class="rounded-2xl bg-white/[0.03] border border-white/[0.08] overflow-hidden">
        <div class="px-6 py-4 border-b border-white/[0.06]">
            <h3 class="text-sm font-semibold text-white">Post a reply</h3>
        </div>
        <form id="reply-form" class="p-6 space-y-4">
            <textarea id="ticket-reply-text"
                      name="message"
                      rows="6"
                      required
                      placeholder="Write your reply here…"
                      class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent resize-none transition-all"></textarea>
            <div class="flex items-center justify-end gap-3">
                <button type="submit"
                        id="btn-submit-reply"
                        class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg text-white text-sm font-semibold transition-all shadow-lg shadow-indigo-500/25"
                        style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                    </svg>
                    Post Reply
                </button>
            </div>
        </form>
    </div>
    {% else %}
    <div class="rounded-2xl bg-white/[0.03] border border-white/[0.08] p-6 text-center">
        <svg class="w-8 h-8 text-gray-600 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        <p class="text-sm text-gray-500">{{ 'Ticket was closed and cannot be reopened.'|trans }}</p>
    </div>
    {% endif %}

</section>

{% endblock %}

{% block js %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    var ticketHash = '{{ ticket.hash|e('js') }}';

    // Quote & Reply buttons
    document.querySelectorAll('.reply-to-message').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id = this.dataset.messageId;
            var tpl = document.getElementById('quote-' + id);
            if (!tpl) return;
            var raw = tpl.content ? tpl.content.textContent : tpl.innerHTML;
            var quoted = raw.trim().split('\n').map(function (l) { return '> ' + l; }).join('\n') + '\n\n';
            var ta = document.getElementById('ticket-reply-text');
            if (ta) {
                ta.value = quoted;
                ta.focus();
            }
            var replySection = document.getElementById('reply-to');
            if (replySection) replySection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });

    // Reply form submit
    var replyForm = document.getElementById('reply-form');
    if (replyForm) {
        replyForm.addEventListener('submit', function (e) {
            e.preventDefault();
            var ta = document.getElementById('ticket-reply-text');
            var msg = ta ? ta.value.trim() : '';
            if (!msg) return;

            var btn = document.getElementById('btn-submit-reply');
            var original = btn ? btn.innerHTML : '';
            if (btn) { btn.disabled = true; btn.innerHTML = '…'; }

            API.guest.post('support/ticket_reply', { hash: ticketHash, message: msg }, function () {
                window.location.reload();
            }, function (err) {
                FOSSBilling.message(err || 'Failed to post reply. Please try again.', 'error');
                if (btn) { btn.disabled = false; btn.innerHTML = original; }
            });
        });
    }

    // Close ticket button
    var closeBtn = document.getElementById('btn-close-ticket');
    if (closeBtn) {
        closeBtn.addEventListener('click', function () {
            if (!confirm('Close this ticket?')) return;
            closeBtn.disabled = true;
            API.guest.post('support/ticket_close', { hash: ticketHash }, function () {
                window.location.reload();
            }, function (err) {
                FOSSBilling.message(err || 'Failed to close ticket.', 'error');
                closeBtn.disabled = false;
            });
        });
    }
});
</script>
{% endblock %}
