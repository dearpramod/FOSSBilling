{# ── Formbuilder form – merovps glassmorphism theme ── #}
<style>
/* ── Base card ── */
.fb-option-card { transition: border-color 0.15s ease, background 0.15s ease; }
.fb-option-card:hover:not(:has(input:checked)) { border-color: rgba(255,255,255,0.18) !important; }
.fb-option-card:has(input:checked) { border-color: rgba(var(--color-primary-rgb),0.50) !important; background: rgba(var(--color-primary-rgb),0.08) !important; }
.fb-option-card:has(input:checked) .fb-opt-radio { border-color: var(--color-primary) !important; }
.fb-option-card:has(input:checked) .fb-opt-radio-dot { transform: scale(1) !important; }
.fb-option-card:has(input:checked) .fb-opt-label { color: #fff; }
.fb-option-card:has(input:checked) .fb-opt-check { opacity: 1 !important; }
.fb-option-card:has(input[type="checkbox"]:checked) .fb-opt-cb-box { background: var(--color-primary) !important; border-color: var(--color-primary) !important; }
.fb-option-card:has(input[type="checkbox"]:checked) .fb-opt-cb-check { display: block !important; }

/* ── Light mode overrides ── */
html[data-theme="light"] .fb-option-card {
    border-color: rgba(var(--color-primary-rgb),0.15) !important;
    background: rgba(255,255,255,0.55) !important;
    backdrop-filter: blur(8px);
}
html[data-theme="light"] .fb-option-card:hover:not(:has(input:checked)) {
    border-color: rgba(var(--color-primary-rgb),0.30) !important;
    background: rgba(255,255,255,0.70) !important;
}
html[data-theme="light"] .fb-option-card:has(input:checked) {
    border-color: rgba(var(--color-primary-rgb),0.55) !important;
    background: rgba(var(--color-primary-rgb),0.08) !important;
}
html[data-theme="light"] .fb-option-card .fb-opt-label { color: #334155; }
html[data-theme="light"] .fb-option-card:has(input:checked) .fb-opt-label { color: #1e1b4b !important; }
html[data-theme="light"] .fb-option-card .fb-opt-radio { border-color: rgba(var(--color-primary-rgb),0.35) !important; }
html[data-theme="light"] .fb-option-card .fb-opt-cb-box { border-color: rgba(var(--color-primary-rgb),0.35) !important; }

/* ── Light mode: form inputs / selects ── */
html[data-theme="light"] .fb-field-input,
html[data-theme="light"] .fb-field-select,
html[data-theme="light"] .fb-field-textarea {
    background: rgba(255,255,255,0.70) !important;
    border-color: rgba(var(--color-primary-rgb),0.20) !important;
    color: #0f172a !important;
}
html[data-theme="light"] .fb-field-input:focus,
html[data-theme="light"] .fb-field-select:focus,
html[data-theme="light"] .fb-field-textarea:focus {
    border-color: rgba(var(--color-primary-rgb),0.50) !important;
    box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb),0.10) !important;
}
html[data-theme="light"] .fb-field-wrap {
    background: rgba(255,255,255,0.70) !important;
    border-color: rgba(var(--color-primary-rgb),0.20) !important;
}
html[data-theme="light"] .fb-field-wrap:focus-within {
    border-color: rgba(var(--color-primary-rgb),0.50) !important;
}
html[data-theme="light"] .fb-field-affix {
    background: rgba(248,250,252,0.90) !important;
    border-color: rgba(var(--color-primary-rgb),0.15) !important;
    color: #475569 !important;
}

/* ── Light mode: configuration card wrapper ── */
html[data-theme="light"] .fb-config-card {
    border-color: rgba(0,0,0,0.09) !important;
    background: rgba(255,255,255,0.70) !important;
    backdrop-filter: blur(8px);
}
html[data-theme="light"] .fb-config-card > div:first-child {
    border-color: rgba(0,0,0,0.06) !important;
    background: rgba(248,250,252,0.60) !important;
}
</style>
{% if form is defined and form.fields is defined %}
<div class="space-y-5">

    {% if (hide_form_title is not defined or not hide_form_title) and form.style.show_title is defined and form.style.show_title != "0" %}
    <div class="flex items-center gap-4 p-4 rounded-xl border mb-1"
         style="background:rgba(var(--color-primary-rgb),0.06); border-color:rgba(var(--color-primary-rgb),0.18);">
        <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0"
             style="background:rgba(var(--color-primary-rgb),0.12); border:1px solid rgba(var(--color-primary-rgb),0.20);">
            <svg class="w-5 h-5" style="color:var(--color-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
        </div>
        <div>
            <p class="text-sm font-bold text-gray-700 dark:text-white">{{ form.name }}</p>
            <p class="text-xs text-gray-500 mt-0.5">Fill in the details below to configure your order</p>
        </div>
    </div>
    {% endif %}

    {% set is_horizontal = form.style.type is defined and form.style.type == 'horizontal' %}

    {% for field in form.fields %}
    {% if field.hidden is not defined or field.hidden != 1 %}
    <div class="{% if is_horizontal %}grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-2 items-start{% endif %}">

        {# ── Label ── #}
        {% if field.hide_label is not defined or field.hide_label != 1 %}
        <label for="ff_{{ field.name }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300 {% if is_horizontal %}pt-2.5{% else %}mb-1.5{% endif %}">
            {{ field.label }}
            {% if field.required == 1 %}<span class="text-red-400/80 ml-0.5">*</span>{% endif %}
        </label>
        {% endif %}

        <div>
            {# ── Text input ── #}
            {% if field.type == "text" %}
                {% if field.prefix is not empty or field.suffix is not empty %}
                <div class="fb-field-wrap flex items-stretch rounded-xl border border-white/[0.08] overflow-hidden focus-within:border-indigo-500/40 transition-colors" style="background:rgba(255,255,255,0.03);">
                    {% if field.prefix is not empty %}
                    <span class="fb-field-affix flex items-center px-3 text-xs text-gray-500 border-r border-white/[0.06]" style="background:rgba(255,255,255,0.02);">{{ field.prefix }}</span>
                    {% endif %}
                    <input type="text"
                           id="ff_{{ field.name }}"
                           name="{{ field.name }}"
                           value="{{ field.default_value }}"
                           {% if field.required == 1 %}required{% endif %}
                           {% if field.readonly == 1 %}readonly{% endif %}
                           class="fb-field-input flex-1 bg-transparent px-3.5 py-2.5 text-sm text-white placeholder-gray-600 focus:outline-none border-0">
                    {% if field.suffix is not empty %}
                    <span class="fb-field-affix flex items-center px-3 text-xs text-gray-500 border-l border-white/[0.06]" style="background:rgba(255,255,255,0.02);">{{ field.suffix }}</span>
                    {% endif %}
                </div>
                {% else %}
                <input type="text"
                       id="ff_{{ field.name }}"
                       name="{{ field.name }}"
                       value="{{ field.default_value }}"
                       {% if field.required == 1 %}required{% endif %}
                       {% if field.readonly == 1 %}readonly{% endif %}
                       class="fb-field-input w-full rounded-xl border border-white/[0.08] bg-transparent px-3.5 py-2.5 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-indigo-500/40 transition-colors"
                       style="background:rgba(255,255,255,0.03);">
                {% endif %}

            {# ── Select dropdown ── #}
            {% elseif field.type == "select" %}
                <select id="ff_{{ field.name }}"
                        name="{{ field.name }}"
                        {% if field.required == 1 %}required{% endif %}
                        class="fb-field-select w-full rounded-xl border border-white/[0.08] px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500/40 transition-colors appearance-none"
                        style="background:rgba(255,255,255,0.03); background-image:url(&quot;data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3E%3Cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3E%3C/svg%3E&quot;); background-position:right 0.75rem center; background-repeat:no-repeat; background-size:1.25em 1.25em;">
                    {% for k, v in field.options %}
                    <option value="{{ v }}" {% if v == field.default_value %}selected{% endif %}>{{ k }}</option>
                    {% endfor %}
                </select>

            {# ── Checkbox ── #}
            {% elseif field.type == "checkbox" %}
                <div class="grid grid-cols-1 gap-2{% if field.options|length > 1 %} sm:grid-cols-2{% endif %}">
                    {% for k, v in field.options %}
                    <label class="fb-option-card relative flex items-center gap-3 p-3.5 rounded-xl border cursor-pointer"
                           style="border-color:rgba(255,255,255,0.08);background:rgba(255,255,255,0.02);">
                        <input type="checkbox"
                               name="{{ field.name }}[]"
                               value="{{ v }}"
                               {% if field.readonly == 1 %}readonly{% endif %}
                               {% if v in field.default_value %}checked{% endif %}
                               class="sr-only">
                        <div class="w-4 h-4 rounded flex items-center justify-center flex-shrink-0 border-2 fb-opt-cb-box"
                             style="border-color:rgba(255,255,255,0.25);transition:background 0.15s ease,border-color 0.15s ease;">
                            <svg class="w-3 h-3 fb-opt-cb-check" style="color:#fff;display:none;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                            </svg>
                        </div>
                        <span class="text-sm text-gray-300 fb-opt-label transition-colors">{{ k }}</span>
                    </label>
                    {% endfor %}
                </div>

            {# ── Radio ── #}
            {% elseif field.type == "radio" %}
                <div class="grid grid-cols-1 gap-2{% if field.options|length > 1 %} sm:grid-cols-2{% endif %}">
                    {% for k, v in field.options %}
                    <label class="fb-option-card relative flex items-center gap-3 p-3.5 rounded-xl border cursor-pointer"
                           style="border-color:rgba(255,255,255,0.08);background:rgba(255,255,255,0.02);">
                        <input type="radio"
                               name="{{ field.name }}"
                               value="{{ v }}"
                               {% if field.default_value == v %}checked{% endif %}
                               {% if field.required == 1 %}required{% endif %}
                               {% if field.readonly == 1 %}readonly{% endif %}
                               class="sr-only">
                        <div class="w-4 h-4 rounded-full border-2 flex items-center justify-center flex-shrink-0 fb-opt-radio"
                             style="border-color:rgba(255,255,255,0.25);transition:border-color 0.15s ease;">
                            <div class="w-2 h-2 rounded-full fb-opt-radio-dot"
                                 style="background:var(--color-primary);transform:scale(0);transition:transform 0.15s ease;"></div>
                        </div>
                        <span class="text-sm text-gray-300 fb-opt-label transition-colors">{{ k }}</span>
                        <span class="ml-auto w-5 h-5 rounded-full flex-shrink-0 flex items-center justify-center fb-opt-check"
                              style="background:rgba(var(--color-primary-rgb),0.15);opacity:0;transition:opacity 0.15s ease;">
                            <svg class="w-3 h-3" style="color:var(--color-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                            </svg>
                        </span>
                    </label>
                    {% endfor %}
                </div>

            {# ── Textarea ── #}
            {% elseif field.type == "textarea" %}
                <textarea id="ff_{{ field.name }}"
                          name="{{ field.name }}"
                          cols="{{ field.options.cols|default(40) }}"
                          rows="{{ field.options.rows|default(4) }}"
                          {% if field.required == 1 %}required{% endif %}
                          {% if field.readonly == 1 %}readonly{% endif %}
                          class="fb-field-textarea w-full rounded-xl border border-white/[0.08] bg-transparent px-3.5 py-2.5 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-indigo-500/40 transition-colors resize-y"
                          style="background:rgba(255,255,255,0.03);">{{ field.default_value }}</textarea>
            {% endif %}

            {# ── Help text ── #}
            {% if field.description is defined and field.description is not empty %}
            <p class="text-xs text-gray-500 mt-1.5">{{ field.description }}</p>
            {% endif %}
        </div>
    </div>
    {% endif %}
    {% endfor %}

    <input type="hidden" name="form_id" value="{{ form.id }}">
</div>
{% endif %}
