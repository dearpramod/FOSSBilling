{% extends "layout_public.html.twig" %}

{% set company = guest.system_company %}

{% block meta_title %}Set New Password{% endblock %}

{% block content %}
<div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

        {# Logo / brand #}
        <div class="text-center mb-8">
            {% if settings.login_logo_url %}
                <img src="{{ settings.login_logo_url }}" alt="{{ company.name }}" class="h-12 mx-auto mb-4 object-contain">
            {% else %}
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center mx-auto mb-4 shadow-lg shadow-indigo-500/30">
                <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
            </div>
            {% endif %}
            <h1 class="text-2xl font-bold text-white">Set new password</h1>
            <p class="text-sm text-gray-500 mt-1">Choose a strong password for your account</p>
        </div>

        {# Card #}
        <div class="rounded-2xl bg-white/[0.04] border border-white/[0.08] p-8 shadow-2xl shadow-black/50 backdrop-blur-sm"
             x-data="setNewPassword('{{ hash|default('')|e('js') }}', {{ expired|default(false) ? 'true' : 'false' }})" x-cloak>

            {# Success state #}
            <div x-show="done" x-transition class="text-center py-4">
                <div class="w-14 h-14 rounded-full bg-green-500/10 border border-green-500/20 flex items-center justify-center mx-auto mb-4">
                    <svg class="w-7 h-7 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                </div>
                <h2 class="text-lg font-semibold text-white mb-2">Password updated!</h2>
                <p class="text-sm text-gray-400">Your password has been changed successfully.</p>
                <a href="{{ 'login'|url }}"
                   class="mt-6 inline-block w-full py-3 px-4 rounded-xl bg-indigo-500 hover:bg-indigo-600 text-white text-sm font-semibold text-center transition-all shadow-lg shadow-indigo-500/30">
                    Sign In
                </a>
            </div>

            {# Expired / invalid state #}
            <div x-show="expired" x-transition class="text-center py-4">
                <div class="w-14 h-14 rounded-full bg-red-500/10 border border-red-500/20 flex items-center justify-center mx-auto mb-4">
                    <svg class="w-7 h-7 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <h2 class="text-lg font-semibold text-white mb-2">Link expired or invalid</h2>
                <p class="text-sm text-gray-400">This password reset link has expired or has already been used. Please request a new one.</p>
                <a href="{{ 'password-reset'|url }}"
                   class="mt-6 inline-block w-full py-3 px-4 rounded-xl bg-indigo-500 hover:bg-indigo-600 text-white text-sm font-semibold text-center transition-all shadow-lg shadow-indigo-500/30">
                    Request New Link
                </a>
            </div>

            {# Form state #}
            <form x-show="!done && !expired" @submit.prevent="submit" autocomplete="off" novalidate>
                <div class="space-y-5">

                    <div class="space-y-1.5">
                        <label for="new-password" class="block text-sm font-medium text-gray-300">New password</label>
                        <div class="relative">
                            <input id="new-password"
                                   :type="showPwd ? 'text' : 'password'"
                                   x-model="password"
                                   :disabled="loading"
                                   required autofocus
                                   placeholder="••••••••"
                                   class="w-full px-4 py-3 pr-11 rounded-xl bg-white/[0.05] border border-white/[0.10] text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all disabled:opacity-50">
                            <button type="button" @click="showPwd = !showPwd"
                                    class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-500 hover:text-gray-300 transition-colors">
                                <svg x-show="!showPwd" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                                <svg x-show="showPwd" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <label for="confirm-password" class="block text-sm font-medium text-gray-300">Confirm new password</label>
                        <input id="confirm-password"
                               :type="showPwd ? 'text' : 'password'"
                               x-model="passwordConfirm"
                               :disabled="loading"
                               required
                               placeholder="••••••••"
                               class="w-full px-4 py-3 rounded-xl bg-white/[0.05] border border-white/[0.10] text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all disabled:opacity-50">
                        <p x-show="passwordConfirm && password !== passwordConfirm"
                           class="text-xs text-red-400 mt-1">Passwords do not match</p>
                    </div>

                    <button type="submit"
                            :disabled="loading || !password || !passwordConfirm || password !== passwordConfirm"
                            class="w-full py-3 px-4 rounded-xl bg-indigo-500 hover:bg-indigo-600 text-white text-sm font-semibold transition-all shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/50 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2">
                        <svg x-show="loading" class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                        </svg>
                        <span x-text="loading ? 'Updating…' : 'Set New Password'"></span>
                    </button>
                </div>
            </form>

            {# Back to login (form state only) #}
            <div class="mt-6 text-center" x-show="!done && !expired">
                <a href="{{ 'login'|url }}" class="text-sm text-indigo-400 hover:text-indigo-300 font-medium transition-colors">← Back to Sign In</a>
            </div>

        </div>

        {# Back to home #}
        <div class="text-center mt-6">
            <a href="{{ '/'|url }}" class="text-xs text-gray-600 hover:text-gray-400 transition-colors">← Back to {{ company.name }}</a>
        </div>

    </div>
</div>
{% endblock %}

{% block js %}
<script>
function setNewPassword(templateHash, initialExpired) {
    return {
        // Hash comes from template var (set by Client controller) or fallback to URL last segment
        hash: templateHash || window.location.pathname.split('/').filter(Boolean).pop(),
        password: '',
        passwordConfirm: '',
        showPwd: false,
        loading: false,
        done: false,
        expired: initialExpired || false,

        submit() {
            if (!this.password || this.password !== this.passwordConfirm || this.loading) return;
            this.loading = true;
            API.guest.post(
                'client/update_password',
                {
                    hash: this.hash,
                    password: this.password,
                    password_confirm: this.passwordConfirm
                },
                () => {
                    this.loading = false;
                    this.done = true;
                },
                (res) => {
                    this.loading = false;
                    const msg = (res && res.message) ? res.message : 'Something went wrong. Please try again.';
                    // Treat expiry/invalid hash as expired state
                    if (/expired|invalid|already|not found/i.test(msg)) {
                        this.expired = true;
                    } else {
                        StablePanel.message(msg, 'error');
                    }
                },
                false
            );
        }
    };
}
</script>
{% endblock %}
