                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"
                                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-white mb-1">{{ 'Request Already Submitted'|trans }}</p>
                        <p class="text-xs text-gray-400 leading-relaxed">
                            {{ 'We already have a cancellation request on file for this service. Our team is reviewing it and will get back to you soon — no need to submit again.'|trans }}
                        </p>
                    </div>
                    <button type="button" onclick="document.getElementById('cancel-already-service').classList.add('hidden'); document.getElementById('cancel-request-form-service').classList.remove('hidden');"
                            class="text-xs text-gray-500 hover:text-gray-300 transition-colors underline underline-offset-2">
                        {{ 'Close'|trans }}
                    </button>
                </div>

                <form id="cancel-request-form-service" class="px-6 py-5 space-y-4">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                    <input type="hidden" name="rel_type" value="order"/>
                    <input type="hidden" name="rel_id" value="{{ order.id }}"/>
                    <input type="hidden" name="rel_task" value="cancel"/>
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1.5">{{ 'Help Desk'|trans }}</label>
                        <select name="support_helpdesk_id"
                                class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all">
                            {% for id, name in client.support_helpdesk_get_pairs %}
                                <option value="{{ id }}" class="bg-gray-900">{{ name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1.5">{{ 'Subject'|trans }}</label>
                        <input type="text" name="subject" required
                               class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all"
                               placeholder="{{ 'Cancellation request for'|trans }} {{ order.title }}"/>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1.5">{{ 'Reason'|trans }}</label>
                        <textarea name="content" rows="4" required
                                  class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all resize-none"
                                  placeholder="{{ 'Please describe why you wish to cancel this service…'|trans }}"></textarea>
                    </div>
                    <div id="cancel-error-service" class="hidden px-4 py-3 rounded-lg border border-red-500/20 bg-red-500/10 text-red-400 text-xs"></div>
                    <button type="submit" id="btn-submit-cancel-service"
                            class="w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg text-white text-sm font-semibold transition-all focus:outline-none focus:ring-2 focus:ring-red-500"
                            style="background: linear-gradient(135deg, #ef4444, #b91c1c);">
                        {{ 'Submit Request'|trans }}
                    </button>
                </form>
            </div>
        </div>
        {% endif %}

        {# Service partial inside x-data scope — Alpine state available to partial buttons #}
        {% if guest.system_template_exists({'file': 'mod_service' ~ order.service_type ~ '_manage.html.twig'}) %}
            {{ include('mod_service' ~ order.service_type ~ '_manage.html.twig', {'order': order, 'service': service}) }}
        {% endif %}
    </div>{# /x-data: renewModal, cancelModal #}

    {% else %}

    {# ── Non-active order state card (pending_setup / failed / suspended / canceled / fraud) ── #}
    {% if order.status != 'active' %}
    {% set _statusColor = {
        'pending_setup': {'bg': 'rgba(var(--color-primary-rgb),0.08)',  'border': 'rgba(var(--color-primary-rgb),0.20)',  'icon': 'rgb(var(--brand-400))', 'label': 'Pending Activation'},
        'failed_setup':  {'bg': 'rgba(239,68,68,0.08)',   'border': 'rgba(239,68,68,0.22)',   'icon': '#f87171', 'label': 'Setup Failed'},
        'failed_renew':  {'bg': 'rgba(239,68,68,0.08)',   'border': 'rgba(239,68,68,0.22)',   'icon': '#f87171', 'label': 'Renewal Failed'},
        'suspended':     {'bg': 'rgba(245,158,11,0.08)',  'border': 'rgba(245,158,11,0.22)',  'icon': '#fbbf24', 'label': 'Suspended'},
        'canceled':      {'bg': 'rgba(100,116,139,0.08)', 'border': 'rgba(100,116,139,0.20)', 'icon': '#94a3b8', 'label': 'Cancelled'},
        'fraud':         {'bg': 'rgba(239,68,68,0.08)',   'border': 'rgba(239,68,68,0.22)',   'icon': '#f87171', 'label': 'Fraud Hold'}
    } %}
    {% set _sc = _statusColor[order.status] ?? {'bg': 'rgba(var(--color-primary-rgb),0.08)', 'border': 'rgba(var(--color-primary-rgb),0.20)', 'icon': 'rgb(var(--brand-400))', 'label': order.status|capitalize} %}

    <div class="rounded-2xl p-6" style="background: {{ _sc.bg }}; border: 1px solid {{ _sc.border }};">
        <div class="flex items-start gap-4">
            {# Icon #}
            <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0"
                 style="background: {{ _sc.bg }}; border: 1px solid {{ _sc.border }};">
                {% if order.status in ['pending_setup', 'failed_setup', 'failed_renew'] %}
                <svg class="w-6 h-6" style="color: {{ _sc.icon }};" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                {% elseif order.status == 'suspended' %}
                <svg class="w-6 h-6" style="color: {{ _sc.icon }};" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                {% elseif order.status == 'canceled' %}
                <svg class="w-6 h-6" style="color: {{ _sc.icon }};" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                </svg>
                {% else %}
                <svg class="w-6 h-6" style="color: {{ _sc.icon }};" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                {% endif %}
            </div>

            {# Text #}
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2.5 mb-1">
                    <h2 class="text-sm font-bold" style="color: {{ _sc.icon }};">{{ _sc.label }}</h2>
                    {{ mf.status_badge(order.status) }}
                </div>
                <p class="text-sm text-gray-400 leading-relaxed mb-4">
                    {% if order.status == 'pending_setup' %}
                        Your order for <strong class="text-gray-200">{{ order.title }}</strong> has been received and is awaiting activation. This usually completes within a few minutes.
                        {% if order.invoice_id %}
                            If payment is required, please complete it using the link below.
                        {% endif %}
                    {% elseif order.status == 'failed_setup' %}
                        We encountered an issue setting up <strong class="text-gray-200">{{ order.title }}</strong>. Please contact support and we will resolve this as soon as possible.
                    {% elseif order.status == 'failed_renew' %}
                        Renewal failed for <strong class="text-gray-200">{{ order.title }}</strong>. Please update your payment details or contact support to restore your service.
                    {% elseif order.status == 'suspended' %}
                        Your service <strong class="text-gray-200">{{ order.title }}</strong> has been suspended. This may be due to an outstanding invoice or a policy violation. Please contact support to restore access.
                    {% elseif order.status == 'canceled' %}
                        Your order for <strong class="text-gray-200">{{ order.title }}</strong> has been cancelled. If you believe this is an error, please open a support ticket.
                    {% else %}
                        Your order for <strong class="text-gray-200">{{ order.title }}</strong> is currently on hold. Please contact support for assistance.
                    {% endif %}
                </p>

                {# Action row #}
                <div class="flex flex-wrap items-center gap-3">
                    {% if order.status in ['pending_setup', 'failed_setup', 'failed_renew'] and order.invoice_id %}
                    <a href="{{ 'invoice'|url }}/{{ order.invoice_id }}"
                       class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white text-sm font-semibold transition-all"
                       style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                        </svg>
                        Pay Invoice
                    </a>
                    {% endif %}
                    <a href="{{ '/support'|url }}"
                       class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-all"
                       style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.10); color: #9ca3af;">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                        Contact Support
                    </a>
                </div>
            </div>
        </div>

        {# Order meta row #}
        <div class="mt-5 pt-4 grid grid-cols-2 sm:grid-cols-4 gap-4" style="border-top: 1px solid {{ _sc.border }};">
            <div>
                <p class="text-xs text-gray-600 uppercase tracking-wider mb-0.5">Order #</p>
                <p class="text-sm font-mono font-medium text-gray-300">#{{ order.id }}</p>
            </div>
            <div>
                <p class="text-xs text-gray-600 uppercase tracking-wider mb-0.5">Product</p>
                <p class="text-sm font-medium text-gray-300 truncate">{{ order.title }}</p>
            </div>
            {% if order.price %}
            <div>
                <p class="text-xs text-gray-600 uppercase tracking-wider mb-0.5">Price</p>
                <p class="text-sm font-medium text-gray-300">{{ order.price|money(order.currency) }}{% if order.period %} / {{ order.period|period_title }}{% endif %}</p>
            </div>
            {% endif %}
            <div>
                <p class="text-xs text-gray-600 uppercase tracking-wider mb-0.5">Created</p>
                <p class="text-sm font-medium text-gray-300">{{ order.created_at|date('M j, Y') }}</p>
            </div>
        </div>
    </div>

    {% endif %}{# /order.status != 'active' #}

    {% endif %}{# /isActive #}

    {# Fallback: render service partial for non-domain services excluded from the
         isActive+price guard above (e.g. hosting, custom, free services).
         Mirrors the outer include that existed before the 2026-05-13 refactor. #}
    {% if guest.system_template_exists({'file': 'mod_service' ~ order.service_type ~ '_manage.html.twig'})
        and (not isActive or order.price == 0 or order.service_type in ['hosting', 'custom']) %}
        {{ include('mod_service' ~ order.service_type ~ '_manage.html.twig', {'order': order, 'service': service}) }}
    {% endif %}

    {% endif %}{# /not isDomain #}
</div>{# /space-y-5 #}
{% endblock %}

{% block js %}
<script>
var orderId = {{ order.id }};
var contactFetched = false;

// ── Contact management helpers ──────────────────────────────────────────────
var CONTACT_FIELDS = ['first_name','last_name','email','company','address1','address2',
                      'city','state','postcode','country','phone_cc','phone'];
var CONTACT_ROLE_MAP = { registrant: 'r', admin: 'a', tech: 't', billing: 'b' };

/** Read all 12 contact field values from the form with the given id prefix. */
function snapshotContact(prefix) {
    var snap = {};
    CONTACT_FIELDS.forEach(function(f) {
        var el = document.getElementById(prefix + '_' + f);
        snap[f] = el ? (el.value || '') : '';
    });
    return snap;
}

/** Fill form inputs for the given prefix with data from a contact object. */
function fillContact(prefix, data) {
    CONTACT_FIELDS.forEach(function(f) {
        var el = document.getElementById(prefix + '_' + f);
        if (el) { el.value = (data && data[f] != null) ? data[f] : ''; }
    });
}

/** Count fields that differ between two snapshots (empty-normalised). */
function countDiffs(snap, live) {
    return CONTACT_FIELDS.filter(function(f) {
        return (snap[f] || '').trim() !== ((live && live[f]) || '').trim();
    }).length;
}

/** Update the sync badge element for the given prefix. */
function setSyncBadge(prefix, changed) {
    var badge = document.getElementById('sync-badge-' + prefix);
    if (!badge) return;
    if (changed === null) {
        badge.textContent = '';
        badge.className = 'sync-status-badge';
    } else if (changed === 0) {
        badge.textContent = '\u2713 Matches registrar';
        badge.className = 'sync-status-badge text-xs text-green-400';
    } else {
        badge.textContent = changed + ' field' + (changed !== 1 ? 's' : '') + ' differ from registrar — review and save';
        badge.className = 'sync-status-badge text-xs text-amber-400';
    }
}

/** Enable or disable the Save button of the form with the given id prefix. */
function setSaveEnabled(prefix, enabled) {
    // Never enable save for a secondary role whose separate-contact toggle is OFF.
    if (enabled && prefix !== 'r') {
        var toggleBtn = document.getElementById('toggle-' + prefix);
        if (toggleBtn && toggleBtn.dataset.enabled !== '1') { enabled = false; }
    }
    var form = document.getElementById('form-whois-' + prefix);
    if (!form) return;
    var btn = form.querySelector('button[type="submit"]');
    if (!btn) return;
    btn.disabled = !enabled;
    if (enabled) {
        btn.classList.remove('opacity-40', 'cursor-not-allowed');
    } else {
        btn.classList.add('opacity-40', 'cursor-not-allowed');
    }
}
// ────────────────────────────────────────────────────────────────────────────

/**
 * Load contact details from the DATABASE (no registrar API call).
 * Fast read-only — called on every tab activation.
 * Disables all Save buttons and clears sync badges after populating forms.
 */
function loadContactDetails(force) {
    if (contactFetched && !force) return;
    var loading    = document.getElementById('contact-loading');
    var loadingTxt = document.getElementById('contact-loading-text');
    var errorEl    = document.getElementById('contact-error');
    var wrapper    = document.getElementById('contact-form-wrapper');
    if (!wrapper) return;
    if (errorEl) { errorEl.style.display = 'none'; errorEl.textContent = ''; }
    if (loading) { loading.style.display = 'flex'; }
    if (loadingTxt) { loadingTxt.textContent = 'Loading contact details\u2026'; }
    wrapper.style.opacity = '0.4';
    wrapper.style.pointerEvents = 'none';

    function hideLoading() {
        if (loading) loading.style.display = 'none';
        wrapper.style.opacity = '';
        wrapper.style.pointerEvents = '';
    }

    // DB-only read — get_whois_info never calls the registrar.
    API.client.post('servicedomain/get_whois_info', { order_id: orderId }, function (info) {
        contactFetched = true;
        Object.keys(CONTACT_ROLE_MAP).forEach(function (role) {
            var pfx = CONTACT_ROLE_MAP[role];
            fillContact(pfx, info[role]);
            setSaveEnabled(pfx, false);
            setSyncBadge(pfx, null);
        });
        hideLoading();
    }, function (err) {
        hideLoading();
        if (errorEl) {
            errorEl.textContent = (err && err.message) ? err.message : 'Failed to load contact details.';
            errorEl.style.display = 'flex';
        }
    });
}

/**
 * Fetch live contact data from the REGISTRAR, update the forms,
 * then compare against the current form values (DB state).
 * Enables Save buttons on roles where the registrar data differs.
 */
function syncWhoisContacts() {
    var loading    = document.getElementById('contact-loading');
    var loadingTxt = document.getElementById('contact-loading-text');
    var errorEl    = document.getElementById('contact-error');
    var wrapper    = document.getElementById('contact-form-wrapper');
    var syncBtn    = document.getElementById('btn-refresh-contacts');
    if (!wrapper) return;
    if (errorEl) { errorEl.style.display = 'none'; errorEl.textContent = ''; }
    if (loading)    { loading.style.display = 'flex'; }
    if (loadingTxt) { loadingTxt.textContent = 'Fetching live data from registrar\u2026'; }
    wrapper.style.opacity = '0.4';
    wrapper.style.pointerEvents = 'none';
    if (syncBtn) { syncBtn.disabled = true; syncBtn.classList.add('opacity-50'); }

    // Snapshot current form values (DB state) before overwriting.
    var snapshots = {};
    Object.keys(CONTACT_ROLE_MAP).forEach(function (role) {
        snapshots[role] = snapshotContact(CONTACT_ROLE_MAP[role]);
    });

    function hideLoading() {
        if (loading) loading.style.display = 'none';
        wrapper.style.opacity = '';
        wrapper.style.pointerEvents = '';
        if (syncBtn) { syncBtn.disabled = false; syncBtn.classList.remove('opacity-50'); }
    }

    // sync_whois_info fetches from the registrar, saves to DB, returns live values.
    API.client.post('servicedomain/sync_whois_info', { order_id: orderId }, function (info) {
        var totalDiffs = 0;
        Object.keys(CONTACT_ROLE_MAP).forEach(function (role) {
            var pfx  = CONTACT_ROLE_MAP[role];
            var live = info[role];
            fillContact(pfx, live);
            var diffs = countDiffs(snapshots[role], live);
            totalDiffs += diffs;
            setSyncBadge(pfx, diffs);
            setSaveEnabled(pfx, diffs > 0);
        });
        hideLoading();
        if (totalDiffs === 0) {
            StablePanel.message('All contacts already match the registrar \u2014 no changes detected.', 'success');
        } else {
            StablePanel.message('WHOIS synced. ' + totalDiffs + ' field' + (totalDiffs !== 1 ? 's' : '') + ' updated. Review and save.', 'success');
        }
    }, function (err) {
        hideLoading();
        if (errorEl) {
            errorEl.textContent = (err && err.message) ? err.message : 'Failed to sync from registrar.';
            errorEl.style.display = 'flex';
        }
    });
}

/**
 * Refresh domain protection status from the local DB cache and update the
 * protection tab UI. Reads from DB only — no registrar call is made.
 *
 * The DB is always authoritative here because every mutation action (lock,
 * unlock, privacy/thief toggle) writes its result back to the DB on success,
 * and syncWhois() (cron / activation / renewal) keeps all fields in sync.
 *
 * Call this after a protection toggle completes to ensure the UI reflects
 * the latest DB state without waiting for a page reload.
 */
function fetchProtectionStatus() {
    var lockH = document.getElementById('lock-status-heading');
    var lockD = document.getElementById('lock-status-desc');
    var ppH   = document.getElementById('pp-status-heading');
    var ppD   = document.getElementById('pp-status-desc');
    var tpH   = document.getElementById('tp-status-heading');
    var tpD   = document.getElementById('tp-status-desc');

    // Snapshot current content so we can restore it on error.
    var orig = {
        lockH: lockH ? lockH.innerHTML : '',
        lockD: lockD ? lockD.textContent : '',
        ppH:   ppH   ? ppH.textContent  : '',
        ppD:   ppD   ? ppD.textContent  : '',
        tpH:   tpH   ? tpH.innerHTML    : '',
        tpD:   tpD   ? tpD.textContent  : '',
    };

    var allBtns = ['btn-lock', 'btn-unlock', 'btn-enable-pp', 'btn-disable-pp', 'btn-enable-tp', 'btn-disable-tp']
        .map(function(id) { return document.getElementById(id); })
        .filter(Boolean);

    allBtns.forEach(function(b) { b.disabled = true; b.classList.add('opacity-50', 'cursor-not-allowed'); });
    var loading = '<span class="text-gray-400 animate-pulse">Loading…</span>';
    if (lockH) lockH.innerHTML = loading;
    if (ppH)   ppH.innerHTML   = loading;
    if (tpH)   tpH.innerHTML   = loading;

    API.client.post('servicedomain/get_domain_status', { order_id: orderId }, function(result) {
        allBtns.forEach(function(b) { b.disabled = false; b.classList.remove('opacity-50', 'cursor-not-allowed'); });

        // Lock
        if (lockH) lockH.textContent = result.locked ? 'Domain is Locked' : 'Domain is Unlocked';
        if (lockD) lockD.textContent = result.locked
            ? 'Your domain is protected from unauthorized transfers.'
            : 'Your domain can be transferred to another registrar.';
        var bLock   = document.getElementById('btn-lock');
        var bUnlock = document.getElementById('btn-unlock');
        if (bLock)   bLock.style.display   = result.locked ? 'none' : '';
        if (bUnlock) bUnlock.style.display  = result.locked ? '' : 'none';

        // Privacy
        if (ppH) ppH.textContent = 'Privacy Protection is ' + result.privacy_status;
        if (ppD) ppD.textContent = result.privacy
            ? 'Your WHOIS contact info is hidden from the public.'
            : 'Your WHOIS contact info is publicly visible.';
        var bEnPP  = document.getElementById('btn-enable-pp');
        var bDisPP = document.getElementById('btn-disable-pp');
        if (bEnPP)  bEnPP.style.display  = result.privacy ? 'none' : '';
        if (bDisPP) bDisPP.style.display = result.privacy ? '' : 'none';

        // Thief protection
        var tpColor = result.thief_protected ? 'text-green-400' : 'text-gray-400';
        if (tpH) {
            tpH.textContent = '';
            tpH.appendChild(document.createTextNode('Thief Protection is '));
            var tpSpan = document.createElement('span');
            tpSpan.className = tpColor;
            tpSpan.textContent = result.thief_protection_status;
            tpH.appendChild(tpSpan);
        }
        if (tpD) tpD.textContent = result.thief_protected
            ? 'Your domain has an extra theft guard enabled. Disable it first if you need to change privacy protection.'
            : 'No active theft guard on this domain.';
        var bEnTP  = document.getElementById('btn-enable-tp');
        var bDisTP = document.getElementById('btn-disable-tp');
        if (bEnTP)  bEnTP.style.display  = result.thief_protected ? 'none' : '';
        if (bDisTP) bDisTP.style.display = result.thief_protected ? '' : 'none';

    }, function() {
        // Restore original state and re-enable controls on failure.
        allBtns.forEach(function(b) { b.disabled = false; b.classList.remove('opacity-50', 'cursor-not-allowed'); })
        if (lockH) lockH.innerHTML   = orig.lockH;
        if (lockD) lockD.textContent = orig.lockD;
        if (ppH)   ppH.textContent   = orig.ppH;
        if (ppD)   ppD.textContent   = orig.ppD;
        if (tpH)   tpH.innerHTML     = orig.tpH;
        if (tpD)   tpD.textContent   = orig.tpD;
    });
}

/**
 * Populate nameserver form inputs from the local DB cache.
 * Inputs already have server-rendered values via Twig; call this only if you
 * need to re-read from the DB after an NS update without a full page reload.
 */
function fetchNameservers() {
    var form = document.getElementById('form-nameservers');
    if (!form) return;

    API.client.post('servicedomain/get_nameservers', { order_id: orderId }, function (result) {
        ['ns1', 'ns2', 'ns3', 'ns4'].forEach(function (ns) {
            var el = document.getElementById(ns);
            if (el && result[ns] !== undefined) { el.value = result[ns]; }
        });
    });
}

document.addEventListener('DOMContentLoaded', function () {

    // Spinner SVG injected into buttons while a request is in-flight.
    var SPINNER = '<svg class="btn-spinner w-4 h-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>';

    // Disable a button and swap its first SVG for a spinner.
    function btnSetLoading(btn) {
        btn.disabled = true;
        btn.classList.add('opacity-60', 'cursor-not-allowed');
        btn.classList.remove('hover:bg-indigo-500/25', 'hover:bg-red-500/20', 'hover:bg-orange-500/20');
        var icon = btn.querySelector('svg:not(.btn-spinner)');
        if (icon) { icon.style.display = 'none'; }
        btn.insertAdjacentHTML('afterbegin', SPINNER);
    }

    // Re-enable a button and restore its original icon.
    function btnClearLoading(btn) {
        btn.disabled = false;
        btn.classList.remove('opacity-60', 'cursor-not-allowed');
        btn.classList.add('hover:bg-indigo-500/25');
        var spinner = btn.querySelector('.btn-spinner');
        if (spinner) { spinner.remove(); }
        var icon = btn.querySelector('svg:not(.btn-spinner)');
        if (icon) { icon.style.display = ''; }
    }

    // Generic API post — disables `btn` while in-flight, restores on completion.
    // onSuccess receives the result; onAfter(success:bool) fires regardless.
    function apiPost(endpoint, params, successMsg, btn, onAfter) {
        params = Object.assign({ order_id: orderId }, params);
        if (btn) btnSetLoading(btn);
        API.client.post(endpoint, params, function (result) {
            if (btn) btnClearLoading(btn);
            StablePanel.message(successMsg, 'success');
            if (onAfter) onAfter(true, result);
        }, function (err) {
            if (btn) btnClearLoading(btn);
            StablePanel.message((err && err.message) ? err.message : 'An error occurred.', 'error');
            if (onAfter) onAfter(false, null);
        });
    }

    // Renew Domain — modal-based invoice generation
    (function () {
        var periodSelect  = document.getElementById('renew-period-select');
        var renewTotal    = document.getElementById('renew-total');
        var renewError    = document.getElementById('renew-error');
        var btnConfirm    = document.getElementById('btn-confirm-renew');
        var basePrice     = {{ order.price|default(0) }};
        var currency      = '{{ order.currency|default('') }}';
        var invoiceBase   = '{{ 'invoice'|url }}';

        function formatMoney(amount) {
            return currency + ' ' + parseFloat(amount).toFixed(2);
        }

        if (periodSelect && renewTotal) {
            periodSelect.addEventListener('change', function () {
                renewTotal.textContent = formatMoney(basePrice * parseInt(this.value, 10));
            });
        }

        if (btnConfirm) {
            var _renewBtnHTML = btnConfirm.innerHTML;
            btnConfirm.addEventListener('click', function () {
                var period = periodSelect ? parseInt(periodSelect.value, 10) : 1;
                btnConfirm.disabled = true;
                btnConfirm.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg> Generating\u2026';
                if (renewError) { renewError.classList.add('hidden'); renewError.textContent = ''; }

                API.client.post('invoice/renewal_invoice', { order_id: {{ order.id }}, period: period }, function (hash) {
                    window.location.href = invoiceBase + '/' + hash;
                }, function (result) {
                    if (renewError) {
                        renewError.textContent = result.message || 'Failed to generate invoice. Please try again.';
                        renewError.classList.remove('hidden');
                    }
                    btnConfirm.disabled = false;
                    btnConfirm.innerHTML = _renewBtnHTML;
                });
            });
        }
    }());

    // Lock / Unlock
    var btnLock   = document.getElementById('btn-lock');
    var btnUnlock = document.getElementById('btn-unlock');
    if (btnLock) {
        btnLock.addEventListener('click', function () {
            apiPost('servicedomain/lock', {}, 'Domain locked successfully.', btnLock, function (ok) {
                if (ok) {
                    btnLock.style.display = 'none';
                    if (btnUnlock) btnUnlock.style.display = '';
                }
            });
        });
    }
    if (btnUnlock) {
        btnUnlock.addEventListener('click', function () {
            apiPost('servicedomain/unlock', {}, 'Domain unlocked successfully.', btnUnlock, function (ok) {
                if (ok) {
                    btnUnlock.style.display = 'none';
                    if (btnLock) btnLock.style.display = '';
                }
            });
        });
    }

    // Enable / Disable Privacy Protection
    var btnEnablePP  = document.getElementById('btn-enable-pp');
    var btnDisablePP = document.getElementById('btn-disable-pp');
    if (btnEnablePP) {
        btnEnablePP.addEventListener('click', function () {
            apiPost('servicedomain/enable_privacy_protection', {}, 'Privacy protection enabled.', btnEnablePP, function (ok) {
                if (ok) {
                    btnEnablePP.style.display = 'none';
                    if (btnDisablePP) btnDisablePP.style.display = '';
                }
            });
        });
    }
    if (btnDisablePP) {
        btnDisablePP.addEventListener('click', function () {
            apiPost('servicedomain/disable_privacy_protection', {}, 'Privacy protection disabled.', btnDisablePP, function (ok) {
                if (ok) {
                    btnDisablePP.style.display = 'none';
                    if (btnEnablePP) btnEnablePP.style.display = '';
                }
            });
        });
    }

    // Enable / Disable Thief Protection (maps to registrar lock)
    var btnEnableTP  = document.getElementById('btn-enable-tp');
    var btnDisableTP = document.getElementById('btn-disable-tp');
    if (btnEnableTP) {
        btnEnableTP.addEventListener('click', function () {
            apiPost('servicedomain/lock', {}, 'Thief protection enabled.', btnEnableTP, function (ok) {
                if (ok) {
                    btnEnableTP.style.display = 'none';
                    if (btnDisableTP) btnDisableTP.style.display = '';
                }
            });
        });
    }
    if (btnDisableTP) {
        btnDisableTP.addEventListener('click', function () {
            apiPost('servicedomain/unlock', {}, 'Thief protection disabled.', btnDisableTP, function (ok) {
                if (ok) {
                    btnDisableTP.style.display = 'none';
                    if (btnEnableTP) btnEnableTP.style.display = '';
                }
            });
        });
    }

    // Nameservers form
    var formNs   = document.getElementById('form-nameservers');
    var btnNsSub = document.getElementById('btn-update-ns');
    if (formNs) {
        formNs.addEventListener('submit', function (e) {
            e.preventDefault();
            var data = {
                order_id: orderId,
                ns1: document.getElementById('ns1').value,
                ns2: document.getElementById('ns2').value,
                ns3: document.getElementById('ns3').value,
                ns4: document.getElementById('ns4').value
            };
            if (btnNsSub) btnSetLoading(btnNsSub);
            API.client.post('servicedomain/update_nameservers', data, function () {
                if (btnNsSub) btnClearLoading(btnNsSub);
                StablePanel.message('Nameservers updated successfully.', 'success');
            }, function (err) {
                if (btnNsSub) btnClearLoading(btnNsSub);
                StablePanel.message((err && err.message) ? err.message : 'Failed to update nameservers.', 'error');
            });
        });
    }

    // Sync WHOIS button — fetch from registrar and compare with DB values.
    var btnRefreshContacts = document.getElementById('btn-refresh-contacts');
    if (btnRefreshContacts) {
        btnRefreshContacts.addEventListener('click', function () {
            syncWhoisContacts();
        });
    }

    // WHOIS / Contact forms — one delegated handler for all 4 role forms.
    var contactWrapper = document.getElementById('contact-form-wrapper');
    if (contactWrapper) {

        /** True when the secondary role's separate-contact toggle is ON (registrant always true). */
        function isSeparateContactEnabled(prefix) {
            if (prefix === 'r') return true;
            var tb = document.getElementById('toggle-' + prefix);
            return tb ? (tb.dataset.enabled === '1') : false;
        }

        /**
         * Apply visual + functional state for a secondary contact toggle.
         * @param {string}  prefix    - role id prefix (a / t / b)
         * @param {boolean} isEnabled
         */
        function applyContactToggleState(prefix, isEnabled) {
            var btn     = document.getElementById('toggle-' + prefix);
            var lock    = document.getElementById('form-lock-' + prefix);
            var actions = document.getElementById('form-actions-' + prefix);
            var form    = document.getElementById('form-whois-' + prefix);
            if (!form) return;

            if (btn) {
                btn.dataset.enabled = isEnabled ? '1' : '0';
                btn.setAttribute('aria-checked', isEnabled ? 'true' : 'false');
                var thumb = btn.querySelector('span');
                if (isEnabled) {
                    btn.classList.remove('bg-gray-700'); btn.classList.add('bg-indigo-600');
                    if (thumb) { thumb.classList.remove('translate-x-0.5'); thumb.classList.add('translate-x-[1.1rem]'); }
                } else {
                    btn.classList.remove('bg-indigo-600'); btn.classList.add('bg-gray-700');
                    if (thumb) { thumb.classList.remove('translate-x-[1.1rem]'); thumb.classList.add('translate-x-0.5'); }
                }
            }
            if (lock)    { lock.style.display    = isEnabled ? 'none' : 'flex'; }
            if (actions) { actions.style.display = isEnabled ? ''     : 'none'; }
            form.querySelectorAll('input[name]').forEach(function (inp) { inp.disabled = !isEnabled; });
            if (!isEnabled) { setSaveEnabled(prefix, false); setSyncBadge(prefix, null); }
        }

        // Toggle click — enable/disable a secondary role's own contact.
        contactWrapper.addEventListener('click', function (e) {
            var btn = e.target.closest('.contact-role-toggle');
            if (!btn) return;
            var prefix     = btn.dataset.prefix;
            var role       = btn.dataset.role;
            var nowEnabled = btn.dataset.enabled !== '1';

            if (!nowEnabled) {
                // Turning OFF: wipe own contact from DB — this role reverts to registrant data.
                applyContactToggleState(prefix, false); // optimistic UI update
                API.client.post('servicedomain/update_contacts', {
                    order_id: orderId, role: role, clear_own_contact: true
                }, function () {
                    StablePanel.message('Contact reverted to Registrant data.', 'success');
                }, function (err) {
                    applyContactToggleState(prefix, true); // revert toggle on API failure
                    StablePanel.message((err && err.message) ? err.message : 'Failed to revert contact.', 'error');
                });
            } else {
                // Turning ON: unlock the form — user edits and saves independently.
                applyContactToggleState(prefix, true);
            }
        });

        // Enable Save when the user manually edits a field (only when toggle is ON).
        contactWrapper.addEventListener('input', function (e) {
            var form = e.target.closest('form[data-role]');
            if (!form) return;
            var prefix = form.id.replace('form-whois-', '');
            if (!isSeparateContactEnabled(prefix)) return;
            setSaveEnabled(prefix, true);
        });

        contactWrapper.addEventListener('submit', function (e) {
            if (!e.target.matches('form[data-role]')) return;
            e.preventDefault();
            var form       = e.target;
            var role       = form.dataset.role;
            var contactKey = form.dataset.contactKey;
            var prefix     = form.id.replace('form-whois-', '');
            var btnSub     = form.querySelector('button[type="submit"]');

            // Guard: never submit for a locked secondary contact form.
            if (!isSeparateContactEnabled(prefix)) return;

            var data = { order_id: orderId, role: role };
            data[contactKey] = {};
            form.querySelectorAll('input[name]').forEach(function (input) {
                var m = input.name.match(/^\w+\[(\w+)\]$/);
                if (m) { data[contactKey][m[1]] = input.value; }
            });
            if (btnSub) btnSetLoading(btnSub);
            API.client.post('servicedomain/update_contacts', data, function () {
                if (btnSub) btnClearLoading(btnSub);
                // Save succeeded — disable button and clear diff badge.
                setSaveEnabled(prefix, false);
                setSyncBadge(prefix, null);
                StablePanel.message('Contact details updated successfully.', 'success');
            }, function (err) {
                if (btnSub) btnClearLoading(btnSub);
                StablePanel.message((err && err.message) ? err.message : 'Failed to update contacts.', 'error');
            });
        });
    }

    // EPP Code — OTP-gated retrieval
    var btnGetEpp          = document.getElementById('btn-get-epp');
    var eppResult          = document.getElementById('epp-result');
    var eppCodeEl          = document.getElementById('epp-code');
    var btnCopyEpp         = document.getElementById('btn-copy-epp');
    var btnSendOtp         = document.getElementById('btn-send-otp');
    var btnVerifyOtp       = document.getElementById('btn-verify-otp');
    var eppOtpInput        = document.getElementById('epp-otp-input');
    var eppCountdownLabel  = document.getElementById('epp-otp-countdown-label');
    var eppSecondsEl       = document.getElementById('epp-otp-seconds');
    var eppCountdownTimer  = null;

    /** Reset modal UI to its initial state (called each time the modal opens). */
    function initEppModal() {
        if (eppCountdownTimer) { clearInterval(eppCountdownTimer); eppCountdownTimer = null; }
        if (btnSendOtp) {
            btnSendOtp.disabled = false;
            btnSendOtp.classList.remove('opacity-60', 'cursor-not-allowed');
        }
        if (btnVerifyOtp) {
            btnVerifyOtp.disabled = true;
            btnVerifyOtp.classList.add('opacity-40', 'cursor-not-allowed');
        }
        if (eppOtpInput) { eppOtpInput.value = ''; eppOtpInput.disabled = true; }
        if (eppCountdownLabel) eppCountdownLabel.classList.add('hidden');
    }

    /** Start the 60-second resend cooldown after an OTP is dispatched. */
    function startOtpCooldown() {
        var remaining = 60;
        if (eppSecondsEl) eppSecondsEl.textContent = remaining;
        if (eppCountdownLabel) eppCountdownLabel.classList.remove('hidden');
        if (btnSendOtp) { btnSendOtp.disabled = true; btnSendOtp.classList.add('opacity-60', 'cursor-not-allowed'); }
        eppCountdownTimer = setInterval(function () {
            remaining--;
            if (eppSecondsEl) eppSecondsEl.textContent = remaining;
            if (remaining <= 0) {
                clearInterval(eppCountdownTimer);
                eppCountdownTimer = null;
                if (eppCountdownLabel) eppCountdownLabel.classList.add('hidden');
                if (btnSendOtp) { btnSendOtp.disabled = false; btnSendOtp.classList.remove('opacity-60', 'cursor-not-allowed'); }
            }
        }, 1000);
    }

    if (btnSendOtp) {
        btnSendOtp.addEventListener('click', function () {
            btnSetLoading(btnSendOtp);
            API.client.post('servicedomain/send_epp_otp', { order_id: orderId }, function () {
                btnClearLoading(btnSendOtp);
                startOtpCooldown();
                if (eppOtpInput) { eppOtpInput.disabled = false; eppOtpInput.focus(); }
                StablePanel.message('OTP sent to your registered email address.', 'success');
            }, function (err) {
                btnClearLoading(btnSendOtp);
                StablePanel.message((err && err.message) ? err.message : 'Failed to send OTP. Please try again.', 'error');
            });
        });
    }

    if (eppOtpInput) {
        eppOtpInput.addEventListener('input', function () {
            // Strip non-digits and enforce max length.
            eppOtpInput.value = eppOtpInput.value.replace(/\D/g, '').slice(0, 6);
            var ready = eppOtpInput.value.length === 6;
            if (btnVerifyOtp) {
                btnVerifyOtp.disabled = !ready;
                if (ready) {
                    btnVerifyOtp.classList.remove('opacity-40', 'cursor-not-allowed');
                } else {
                    btnVerifyOtp.classList.add('opacity-40', 'cursor-not-allowed');
                }
            }
        });
    }

    if (btnVerifyOtp) {
        btnVerifyOtp.addEventListener('click', function () {
            var otp = eppOtpInput ? eppOtpInput.value.trim() : '';
            if (otp.length !== 6) return;
            btnSetLoading(btnVerifyOtp);
            API.client.post('servicedomain/get_transfer_code', { order_id: orderId, otp: otp }, function (result) {
                btnClearLoading(btnVerifyOtp);
                // Close the modal.
                window.dispatchEvent(new Event('epp-modal-close'));
                if (eppCountdownTimer) { clearInterval(eppCountdownTimer); eppCountdownTimer = null; }
                // Display the EPP code in the panel.
                if (eppCodeEl)  eppCodeEl.textContent = result;
                if (eppResult)  eppResult.style.display = 'flex';
                // Lock the trigger button to prevent re-fetching.
                if (btnGetEpp) {
                    btnGetEpp.disabled = true;
                    btnGetEpp.classList.add('opacity-60', 'cursor-not-allowed');
                    var svgIcon = btnGetEpp.querySelector('svg');
                    btnGetEpp.innerHTML = '';
                    if (svgIcon) btnGetEpp.appendChild(svgIcon);
                    btnGetEpp.insertAdjacentText('beforeend', ' EPP Code Retrieved');
                }
                StablePanel.message('EPP code retrieved successfully.', 'success');
            }, function (err) {
                btnClearLoading(btnVerifyOtp);
                StablePanel.message((err && err.message) ? err.message : 'Invalid OTP. Please try again.', 'error');
            });
        });
    }

    if (btnCopyEpp) {
        var eppIconCopy  = document.getElementById('epp-icon-copy');
        var eppIconCheck = document.getElementById('epp-icon-check');
        var eppCopied    = document.getElementById('epp-copied');
        var eppCopyTimer = null;

        btnCopyEpp.addEventListener('click', function () {
            if (!eppCodeEl || !navigator.clipboard) return;
            navigator.clipboard.writeText(eppCodeEl.textContent.trim()).then(function () {
                // Show check icon + label
                eppIconCopy.classList.add('hidden');
                eppIconCheck.classList.remove('hidden');
                eppCopied.classList.remove('hidden');
                btnCopyEpp.classList.add('text-emerald-400');
                btnCopyEpp.classList.remove('text-gray-400');

                clearTimeout(eppCopyTimer);
                eppCopyTimer = setTimeout(function () {
                    eppIconCheck.classList.add('hidden');
                    eppIconCopy.classList.remove('hidden');
                    eppCopied.classList.add('hidden');
                    btnCopyEpp.classList.remove('text-emerald-400');
                    btnCopyEpp.classList.add('text-gray-400');
                }, 2000);
            });
        });
    }

    // SSL certificate info via crt.sh (public Certificate Transparency log)
    {% if isDomain and service %}
    (function () {
        var domain = {{ service.domain|json_encode|raw }};
        var fmt = function (d) {
            if (!d) return '—';
            return d.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        };
        fetch('https://crt.sh/?CN=' + encodeURIComponent(domain) + '&output=json')
            .then(function (res) {
                if (!res.ok) throw new Error('HTTP ' + res.status);
                return res.json();
            })
            .then(function (certs) {
                if (!certs || !certs.length) throw new Error('none');
                // Pick the most recently issued certificate
                certs.sort(function (a, b) { return b.id - a.id; });
                var c = certs[0];
                var now    = new Date();
                var start  = c.not_before ? new Date(c.not_before) : null;
                var expiry = c.not_after  ? new Date(c.not_after)  : null;

                var statusEl = document.getElementById('ssl-status');
                if (statusEl) {
                    if (expiry && expiry > now) {
                        statusEl.textContent = 'Active';
                        statusEl.className = 'text-sm font-medium text-green-400';
                    } else {
                        statusEl.textContent = 'Expired';
                        statusEl.className = 'text-sm font-medium text-red-400';
                    }
                }
                var startEl = document.getElementById('ssl-start');
                if (startEl) startEl.textContent = fmt(start);

                var issuerEl = document.getElementById('ssl-issuer');
                if (issuerEl) {
                    var raw = c.issuer_name || '';
                    var m = raw.match(/CN\s*=\s*([^,]+)/);
                    issuerEl.textContent = m ? m[1].trim() : (raw || '—');
                }
                var expiryEl = document.getElementById('ssl-expiry');
                if (expiryEl) expiryEl.textContent = fmt(expiry);
            })
            .catch(function () {
                var el = document.getElementById('ssl-status');
                if (el) el.textContent = 'Unavailable';
                ['ssl-start', 'ssl-issuer', 'ssl-expiry'].forEach(function (id) {
                    var e = document.getElementById(id);
                    if (e) e.textContent = '—';
                });
            });
    }());
    {% endif %}

    // Cancellation Request — submits a support ticket with rel_task=cancel
    (function () {
        var ALREADY_RECEIVED_PHRASES = [
            'we have already received this request',
            'already received this request',
            'already received'
        ];

        function isAlreadyReceivedError(msg) {
            if (!msg) return false;
            var lower = msg.toLowerCase();
            return ALREADY_RECEIVED_PHRASES.some(function (phrase) { return lower.indexOf(phrase) !== -1; });
        }

        function showAlreadyReceived(formId, alreadyId) {
            var form = document.getElementById(formId);
            var already = document.getElementById(alreadyId);
            if (form) form.classList.add('hidden');
            if (already) already.classList.remove('hidden');
        }

        function bindCancelForm(formId, errorId, btnId, alreadyId) {
            var form = document.getElementById(formId);
            if (!form) return;
            var errorEl = document.getElementById(errorId);
            var btn = document.getElementById(btnId);
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (btn) { btn.disabled = true; btn.textContent = '{{ 'Submitting…'|trans }}'; }
                if (errorEl) { errorEl.classList.add('hidden'); errorEl.textContent = ''; }
                var data = {};
                new FormData(form).forEach(function (v, k) { data[k] = v; });
                API.client.post('support/ticket_create', data,
                    function () {
                        StablePanel.message('{{ 'Your cancellation request has been received. We will review it shortly.'|trans }}', 'success');
                        form.reset();
                        // Close the Alpine modal
                        document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
                    },
                    function (res) {
                        var msg = (res && res.message) ? res.message : '{{ 'An error occurred. Please try again.'|trans }}';
                        if (btn) { btn.disabled = false; btn.textContent = '{{ 'Submit Request'|trans }}'; }
                        if (isAlreadyReceivedError(msg)) {
                            showAlreadyReceived(formId, alreadyId);
                        } else {
                            if (errorEl) { errorEl.textContent = msg; errorEl.classList.remove('hidden'); }
                        }
                    }
                );
            });
        }
        bindCancelForm('cancel-request-form-domain',  'cancel-error-domain',  'btn-submit-cancel-domain',  'cancel-already-domain');
        bindCancelForm('cancel-request-form-service', 'cancel-error-service', 'btn-submit-cancel-service', 'cancel-already-service');
    }());

});
</script>
{% endblock %}

