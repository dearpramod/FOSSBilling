{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}Managing {{ order.title }}{% endblock %}
{% block page_header %}Managing {{ order.title }}{% endblock %}

{% set isDomain = order.service_type == 'domain' %}
{% set isActive = order.status == 'active' %}
{% set service = client.order_service({'id': order.id}) %}
{% set daysLeft = order.expires_at ? ((order.expires_at|date('U') - 'now'|date('U')) / 86400)|round : null %}
{% set clientProfile = client.profile_get %}

{% block content %}
<div class="space-y-5">

    {# Expiry warning #}
    {% if daysLeft is not null and daysLeft <= 7 and order.status == 'active' %}
        <div class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium
                    {% if daysLeft <= 3 %}bg-red-500/10 border border-red-500/20 text-red-400{% else %}bg-amber-500/10 border border-amber-500/20 text-amber-400{% endif %}">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            {% if isDomain %}Domain{% else %}Service{% endif %} expires in {{ daysLeft }} day{% if daysLeft != 1 %}s{% endif %} — renew now to avoid interruption.
        </div>
    {% endif %}

    {# Status notices #}
    {% if isDomain and not isActive %}
        <div class="rounded-xl border border-amber-500/20 bg-amber-500/10 px-5 py-4 text-sm text-amber-400">
            This domain order is not yet active. Domain management options are unavailable until the order is activated.
        </div>
    {% elseif isDomain and isActive and not service %}
        <div class="rounded-xl border border-blue-500/20 bg-blue-500/10 px-5 py-4 text-sm text-blue-400">
            This domain order is active but the domain registration has not been fully provisioned yet. Contact support if this issue persists.
        </div>
    {% endif %}

    {# Domain management panel — shown for all domain orders #}
    {% if isDomain %}
    <div class="flex flex-col lg:flex-row gap-5" x-data="{ tab: 'overview', eppModal: false, renewModal: false, cancelModal: false }" x-init="$watch('tab', function(t){ if (t === 'dns') { contactFetched = false; loadContactDetails(); } })">

        {# ===== SIDEBAR NAV ===== #}
        <aside class="lg:w-52 flex-shrink-0">

            {# Manage group #}
            <div class="rounded-xl border border-white/[0.08] overflow-hidden mb-3" style="background: rgba(255,255,255,0.02);">
                <div class="px-4 py-2.5 border-b border-white/[0.06]">
                    <p class="text-xs font-semibold uppercase tracking-widest text-gray-600 flex items-center gap-1.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/></svg>
                        Manage
                    </p>
                </div>
                <nav class="py-1">
                    {% set navItems = [
                        { key: 'overview',   label: 'Overview',           icon: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
                        { key: 'autorenew',  label: 'Auto Renew',         icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15' },
                        { key: 'protection', label: 'Registrar Lock',     icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z' },
                        { key: 'addons',     label: 'Addons',             icon: 'M12 6v6m0 0v6m0-6h6m-6 0H6' },
                        { key: 'privatens',  label: 'Nameservers',        icon: 'M5 12h14M12 5l7 7-7 7' },
                        { key: 'dns',        label: 'Contact Management',  icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
                        { key: 'epp',        label: 'Get EPP Code',       icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' }
                    ] %}
                    {% for item in navItems %}
                    <button @click="tab = '{{ item.key }}'"
                            :class="tab === '{{ item.key }}' ? 'bg-indigo-500/15 text-indigo-400 border-l-2 border-indigo-500' : 'text-gray-400 hover:text-white hover:bg-white/5 border-l-2 border-transparent'"
                            class="w-full flex items-center gap-2.5 px-4 py-2.5 text-sm transition-all text-left">
                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="{{ item.icon }}"/>
                        </svg>
                        <span>{{ item.label }}</span>
                    </button>
                    {% endfor %}
                </nav>
            </div>

            {# Actions group #}
            <div class="rounded-xl border border-white/[0.08] overflow-hidden" style="background: rgba(255,255,255,0.02);">
                <div class="px-4 py-2.5 border-b border-white/[0.06]">
                    <p class="text-xs font-semibold uppercase tracking-widest text-gray-600 flex items-center gap-1.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        Actions
                    </p>
                </div>
                <nav class="py-1">
                    <button type="button" @click="renewModal = true"
                            class="w-full flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all text-left">
                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                        </svg>
                        Renew Domain
                    </button>
                    <a href="{{ '/order/domain-registration'|url }}"
                       class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all">
                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Register a New Domain
                    </a>
                </nav>
            </div>

        </aside>

        {# ===== MAIN CONTENT ===== #}
        <div class="flex-1 min-w-0">

            {# ── OVERVIEW ── #}
            <div x-show="tab === 'overview'" x-cloak>
                <div class="rounded-xl border border-white/[0.08] p-6" style="background: rgba(255,255,255,0.02);">
                    <h2 class="text-sm font-semibold text-white mb-5">Overview</h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-5">
                        <div>
                            <p class="text-xs text-gray-500 mb-1">Domain Name</p>
                            {% if service and service.domain %}
                            <a href="http://{{ service.domain }}" target="_blank" rel="noopener noreferrer"
                               class="text-sm text-indigo-400 hover:text-indigo-300 font-medium transition-colors">
                                {{ service.domain }}
                            </a>
                            {% else %}
                            <p class="text-sm text-white font-medium">{{ order.title }}</p>
                            {% endif %}
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 mb-1">First Payment Amount</p>
                            <p class="text-sm text-white font-medium">{{ order.total|money(order.currency) }}</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 mb-1">Registration Date</p>
                            <p class="text-sm text-white font-medium">
                                {{ (service and service.registered_at) ? service.registered_at|date('l, F jS, Y') : '—' }}
                            </p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 mb-1">Recurring Amount</p>
                            <p class="text-sm text-white font-medium">
                                {% if order.price %}{{ order.price|money(order.currency) }} Every {{ order.period|period_title }}{% else %}—{% endif %}
                            </p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 mb-1">Next Due Date</p>
                            <p class="text-sm font-medium {% if daysLeft is not null and daysLeft <= 14 %}text-amber-400{% else %}text-white{% endif %}">
                                {{ (service and service.expires_at) ? service.expires_at|date('l, F jS, Y') : (order.expires_at ? order.expires_at|date('l, F jS, Y') : '—') }}
                            </p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 mb-1">Payment Method</p>
                            <p class="text-sm text-white font-medium">{{ order.invoice_option|default('—') }}</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 mb-1">Status</p>
                            {{ mf.status_badge(order.status) }}
                        </div>
                        {% if service %}
                        <div>
                            <p class="text-xs text-gray-500 mb-1">Nameserver 1</p>
                            <p class="text-sm text-white font-medium font-mono">{{ service.ns1 ?: '—' }}</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 mb-1">Nameserver 2</p>
                            <p class="text-sm text-white font-medium font-mono">{{ service.ns2 ?: '—' }}</p>
                        </div>
                        {% if service.ns3 %}
                        <div>
                            <p class="text-xs text-gray-500 mb-1">Nameserver 3</p>
                            <p class="text-sm text-white font-medium font-mono">{{ service.ns3 }}</p>
                        </div>
                        {% endif %}
                        {% if service.ns4 %}
                        <div>
                            <p class="text-xs text-gray-500 mb-1">Nameserver 4</p>
                            <p class="text-sm text-white font-medium font-mono">{{ service.ns4 }}</p>
                        </div>
                        {% endif %}
                        <div>
                            <p class="text-xs text-gray-500 mb-1">Registrar Lock</p>
                            <p class="text-sm font-medium {% if service.locked %}text-green-400{% else %}text-amber-400{% endif %}">
                                {% if service.locked %}
                                <span class="inline-flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg> Locked</span>
                                {% else %}
                                <span class="inline-flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/></svg> Unlocked</span>
                                {% endif %}
                            </p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 mb-1">Privacy Protection</p>
                            <p class="text-sm font-medium {% if service.privacy %}text-green-400{% else %}text-gray-400{% endif %}">
                                {{ service.privacy ? 'Enabled' : 'Disabled' }}
                            </p>
                        </div>
                        {% endif %}
                    </div>

                    {# SSL info #}
                    <div class="mt-6 pt-6 border-t border-white/[0.06]">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-5">
                            <div>
                                <p class="text-xs text-gray-500 mb-1">SSL Status</p>
                                <p class="text-sm text-white font-medium" id="ssl-status">Loading…</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500 mb-1">SSL Start Date</p>
                                <p class="text-sm text-white font-medium" id="ssl-start">Loading…</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500 mb-1">SSL Issuer Name</p>
                                <p class="text-sm text-white font-medium" id="ssl-issuer">Loading…</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500 mb-1">SSL Expiry Date</p>
                                <p class="text-sm text-white font-medium" id="ssl-expiry">Loading…</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── AUTO RENEW ── #}
            <div x-show="tab === 'autorenew'" x-cloak>
                <div class="rounded-xl border border-white/[0.08] p-6" style="background: rgba(255,255,255,0.02);">
                    <h2 class="text-sm font-semibold text-white mb-2">Auto Renew</h2>
                    <p class="text-sm text-gray-400 mb-6">
                        When automatic renewal is enabled, your domain will be renewed automatically before the expiry date, ensuring no interruption to your service.
                    </p>
                    <div class="flex items-center gap-3">
                        <span class="text-sm text-gray-400">Auto-renewal is managed through your invoice settings.</span>
                    </div>
                </div>
            </div>

            {# ── REGISTRAR LOCK (protection) ── #}
            <div x-show="tab === 'protection'" x-cloak>
                <div class="rounded-xl border border-white/[0.08] p-6 space-y-6" style="background: rgba(255,255,255,0.02);">

                    {% if not isActive or not service %}
                    <div class="flex items-center gap-3 px-4 py-3 rounded-lg border {% if isActive %}border-blue-500/20 bg-blue-500/10 text-blue-400{% else %}border-amber-500/20 bg-amber-500/10 text-amber-400{% endif %} text-sm">
                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        {% if isActive %}Domain service is not yet provisioned. Contact support if this persists.{% else %}Available once the domain order is active.{% endif %}
                    </div>
                    {% else %}
                    <div>
                        <h2 class="text-sm font-semibold text-white mb-2">Registrar Lock</h2>
                        <p class="text-sm text-gray-400 mb-5">
                            Domain locking is a security feature which prevents your domain from being transferred without first unlocking it.
                            When enabled, a domain cannot be transferred even with the transfer code.
                        </p>
                        <div class="flex flex-wrap items-center gap-3 p-4 rounded-xl border border-white/[0.08]" style="background: rgba(255,255,255,0.03);">
                            <div class="flex-1 min-w-0">
                                <p id="lock-status-heading" class="text-sm font-medium text-white mb-0.5">
                                    {% if service.locked %}Domain is Locked{% else %}Domain is Unlocked{% endif %}
                                </p>
                                <p id="lock-status-desc" class="text-xs text-gray-500">
                                    {% if service.locked %}Your domain is protected from unauthorized transfers.{% else %}Your domain can be transferred to another registrar.{% endif %}
                                </p>
                            </div>
                            <div class="flex gap-2">
                                <button id="btn-lock"
                                        {% if service.locked %}style="display:none;"{% endif %}
                                        class="flex items-center gap-2 px-4 py-2 rounded-lg bg-indigo-500/15 hover:bg-indigo-500/25 text-indigo-400 text-sm border border-indigo-500/25 transition-all">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                    Lock Domain
                                </button>
                                <button id="btn-unlock"
                                        {% if not service.locked %}style="display:none;"{% endif %}
                                        class="flex items-center gap-2 px-4 py-2 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 text-sm border border-red-500/20 transition-all">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/></svg>
                                    Unlock Domain
                                </button>
                            </div>
                        </div>
                    </div>

                    {# Privacy Protection #}
                    <div class="pt-4 border-t border-white/[0.06]">
                        <h2 class="text-sm font-semibold text-white mb-2">Privacy Protection</h2>
                        <p class="text-sm text-gray-400 mb-5">
                            When privacy protection is enabled, your personal contact information is hidden from public WHOIS lookups.
                        </p>
                        <div class="flex flex-wrap items-center gap-3 p-4 rounded-xl border border-white/[0.08]" style="background: rgba(255,255,255,0.03);">
                            <div class="flex-1 min-w-0">
                                <p id="pp-status-heading" class="text-sm font-medium text-white mb-0.5">
                                    Privacy Protection is {% if service.privacy %}Enabled{% else %}Disabled{% endif %}
                                </p>
                                <p id="pp-status-desc" class="text-xs text-gray-500">
                                    {% if service.privacy %}Your WHOIS contact info is hidden from the public.{% else %}Your WHOIS contact info is publicly visible.{% endif %}
                                </p>
                            </div>
                            <div class="flex gap-2">
                                <button id="btn-enable-pp"
                                        {% if service.privacy %}style="display:none;"{% endif %}
                                        class="flex items-center gap-2 px-4 py-2 rounded-lg bg-indigo-500/15 hover:bg-indigo-500/25 text-indigo-400 text-sm border border-indigo-500/25 transition-all">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                    Enable Privacy
                                </button>
                                <button id="btn-disable-pp"
                                        {% if not service.privacy %}style="display:none;"{% endif %}
                                        class="flex items-center gap-2 px-4 py-2 rounded-lg bg-orange-500/10 hover:bg-orange-500/20 text-orange-400 text-sm border border-orange-500/20 transition-all">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
                                    Disable Privacy
                                </button>
                            </div>
                        </div>
                    </div>

                    {# Thief Protection #}
                    <div class="pt-4 border-t border-white/[0.06]">
                        <h2 class="text-sm font-semibold text-white mb-2">Thief Protection</h2>
                        <p class="text-sm text-gray-400 mb-5">
                            An additional domain-theft guard that prevents unauthorised transfers and
                            blocks changes to privacy protection while active.
                        </p>
                        <div class="flex flex-wrap items-center gap-3 p-4 rounded-xl border border-white/[0.08]" style="background: rgba(255,255,255,0.03);">
                            <div class="flex-1 min-w-0">
                                <p id="tp-status-heading" class="text-sm font-medium text-white mb-0.5">
                                    Thief Protection is {% if service.thief_protected %}<span class="text-green-400">Active</span>{% else %}<span class="text-gray-400">Inactive</span>{% endif %}
                                </p>
                                <p id="tp-status-desc" class="text-xs text-gray-500">
                                    {% if service.thief_protected %}
                                        Your domain has an extra theft guard enabled. Disable it first if you need to change privacy protection.
                                    {% else %}
                                        No active theft guard on this domain.
                                    {% endif %}
                                </p>
                            </div>
                            <div class="flex gap-2">
                                <button id="btn-enable-tp"
                                        {% if service.thief_protected %}style="display:none;"{% endif %}
                                        class="flex items-center gap-2 px-4 py-2 rounded-lg bg-indigo-500/15 hover:bg-indigo-500/25 text-indigo-400 text-sm border border-indigo-500/25 transition-all">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                    Enable Protection
                                </button>
                                <button id="btn-disable-tp"
                                        {% if not service.thief_protected %}style="display:none;"{% endif %}
                                        class="flex items-center gap-2 px-4 py-2 rounded-lg bg-orange-500/10 hover:bg-orange-500/20 text-orange-400 text-sm border border-orange-500/20 transition-all">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016zM12 9v2m0 4h.01"/></svg>
                                    Disable Protection
                                </button>
                            </div>
                        </div>
                    </div>

                    {% endif %}
                </div>
            </div>

            {# ── ADDONS ── #}
            <div x-show="tab === 'addons'" x-cloak>
                <div class="rounded-xl border border-white/[0.08] p-6" style="background: rgba(255,255,255,0.02);">
                    <h2 class="text-sm font-semibold text-white mb-5">Addons</h2>
                    {% set addons = client.order_addons({'id': order.id}) %}
                    {% if addons|length > 0 %}
                    <div class="space-y-3">
                        {% for addon in addons %}
                        <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 rounded-xl border border-white/[0.08]" style="background: rgba(255,255,255,0.03);">
                            <div>
                                <p class="text-sm font-medium text-white">{{ addon.title }}</p>
                                <p class="text-xs text-gray-500 mt-0.5">
                                    {{ addon.total|money(addon.currency) }}/{{ addon.period|period_title }}
                                    {% if addon.expires_at %} &middot; Renews {{ addon.expires_at|date('M j, Y') }}{% endif %}
                                </p>
                            </div>
                            <div class="flex items-center gap-3">
                                {{ mf.status_badge(addon.status) }}
                                <a href="{{ '/order/service/manage'|url }}/{{ addon.id }}"
                                   class="text-xs px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-gray-400 hover:text-white border border-white/10 transition-all">Manage</a>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="py-10 text-center">
                        <svg class="w-8 h-8 text-gray-600 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                        <p class="text-sm text-gray-500">No addons found for this domain.</p>
                    </div>
                    {% endif %}
                </div>
            </div>

            {# ── NAMESERVERS ── #}
            <div x-show="tab === 'privatens'" x-cloak>
                <div class="rounded-xl border border-white/[0.08] p-6" style="background: rgba(255,255,255,0.02);">
                    {% if not isActive or not service %}
                    <h2 class="text-sm font-semibold text-white mb-2">Update Nameservers</h2>
                    <div class="flex items-center gap-3 px-4 py-3 rounded-lg border {% if isActive %}border-blue-500/20 bg-blue-500/10 text-blue-400{% else %}border-amber-500/20 bg-amber-500/10 text-amber-400{% endif %} text-sm">
                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        {% if isActive %}Domain service is not yet provisioned. Contact support if this persists.{% else %}Available once the domain order is active.{% endif %}
                    </div>
                    {% else %}
                    <h2 class="text-sm font-semibold text-white mb-2">Update Nameservers</h2>
                    <p class="text-sm text-gray-400 mb-6">
                        If you would like to host this domain with another company, update the nameservers below.
                    </p>

                    <form id="form-nameservers" class="space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="space-y-1.5">
                                <label class="block text-xs font-medium text-gray-400" for="ns1">Nameserver 1 <span class="text-red-400">*</span></label>
                                <input type="text" id="ns1" name="ns1" value="{{ service.ns1 }}" required placeholder="ns1.example.com"
                                       class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
                            </div>
                            <div class="space-y-1.5">
                                <label class="block text-xs font-medium text-gray-400" for="ns2">Nameserver 2 <span class="text-red-400">*</span></label>
                                <input type="text" id="ns2" name="ns2" value="{{ service.ns2 }}" required placeholder="ns2.example.com"
                                       class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
                            </div>
                            <div class="space-y-1.5">
                                <label class="block text-xs font-medium text-gray-400" for="ns3">Nameserver 3</label>
                                <input type="text" id="ns3" name="ns3" value="{{ service.ns3 }}" placeholder="ns3.example.com"
                                       class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
                            </div>
                            <div class="space-y-1.5">
                                <label class="block text-xs font-medium text-gray-400" for="ns4">Nameserver 4</label>
                                <input type="text" id="ns4" name="ns4" value="{{ service.ns4 }}" placeholder="ns4.example.com"
                                       class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
                            </div>
                        </div>
                        <div class="pt-2">
                            <button type="submit" id="btn-update-ns"
                                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-white text-sm font-semibold transition-all shadow-lg shadow-indigo-500/20"
                                    style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                Save Nameservers
                            </button>
                        </div>
                    </form>
                    {% endif %}
                </div>
            </div>

            {# ── CONTACT MANAGEMENT ── #}
            <div x-show="tab === 'dns'" x-cloak>
                <div class="rounded-xl border border-white/[0.08] p-6" style="background: rgba(255,255,255,0.02);">
                    {% if not isActive or not service %}
                    <h2 class="text-sm font-semibold text-white mb-2">Contact Management</h2>
                    <div class="flex items-center gap-3 px-4 py-3 rounded-lg border {% if isActive %}border-blue-500/20 bg-blue-500/10 text-blue-400{% else %}border-amber-500/20 bg-amber-500/10 text-amber-400{% endif %} text-sm">
                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        {% if isActive %}Domain service is not yet provisioned. Contact support if this persists.{% else %}Available once the domain order is active.{% endif %}
                    </div>
                    {% else %}
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="text-sm font-semibold text-white">Contact Management</h2>
                        <button type="button" id="btn-refresh-contacts"
                                title="Fetch live contact data from the registrar and compare with saved values"
                                class="inline-flex items-center gap-1.5 text-xs text-indigo-400 hover:text-indigo-300 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            Sync WHOIS
                        </button>
                    </div>
                    <p class="text-sm text-gray-400 mb-4">
                        Domain contact details are displayed publicly in WHOIS lookups. This updates the Registrant, Technical, Billing and Admin contacts. Enable privacy protection to hide your information.
                    </p>
                    <div id="contact-loading" style="display:none;" class="flex items-center gap-3 px-4 py-3 mb-4 rounded-lg border border-indigo-500/20 bg-indigo-500/10 text-indigo-400 text-sm">
                        <svg class="w-4 h-4 animate-spin flex-shrink-0" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                        <span id="contact-loading-text">Loading contact details…</span>
                    </div>
                    <div id="contact-error" style="display:none;" class="flex items-center gap-3 px-4 py-3 mb-4 rounded-lg border border-red-500/20 bg-red-500/10 text-red-400 text-sm"></div>

                    <div id="contact-form-wrapper">

                    {# ── Helper macro: renders a 12-field contact form ── #}
                    {% macro contact_form(id_prefix, role, contact_key, label, data, clientProfile, is_independent) %}
                    <details class="group rounded-lg border border-white/[0.06] mb-3" open>
                        <summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none text-sm font-semibold text-white hover:text-indigo-300 transition-colors list-none">
                            <span class="flex items-center gap-2">
                                {{ label }}
                                {% if role != 'registrant' %}
                                    {% if is_independent %}
                                        <span class="text-xs font-normal px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-400">Custom</span>
                                    {% else %}
                                        <span class="text-xs font-normal px-1.5 py-0.5 rounded bg-white/5 text-gray-500">Using Registrant</span>
                                    {% endif %}
                                {% endif %}
                            </span>
                            <svg class="w-4 h-4 text-gray-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                        </summary>
                        <div class="px-4 pb-4 pt-1">

                        {% if role != 'registrant' %}
                        <div class="flex items-center justify-between mb-4 px-3 py-2.5 rounded-lg border border-white/[0.06] bg-white/[0.02]">
                            <div>
                                <span class="text-xs font-medium text-gray-300">Use separate contact for this role</span>
                                <p class="text-xs text-gray-600 mt-0.5">When off, the Registrant contact is submitted to the registry for this role</p>
                            </div>
                            <button type="button" role="switch" aria-checked="{{ is_independent ? 'true' : 'false' }}"
                                    id="toggle-{{ id_prefix }}"
                                    class="contact-role-toggle relative inline-flex h-5 w-9 flex-shrink-0 cursor-pointer items-center rounded-full border border-white/10 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 {{ is_independent ? 'bg-indigo-600' : 'bg-gray-700' }}"
                                    data-prefix="{{ id_prefix }}"
                                    data-role="{{ role }}"
                                    data-enabled="{{ is_independent ? '1' : '0' }}">
                                <span class="inline-block h-3.5 w-3.5 transform rounded-full bg-white shadow-sm transition-transform duration-200 {{ is_independent ? 'translate-x-[1.1rem]' : 'translate-x-0.5' }}"></span>
                            </button>
                        </div>
                        <div id="form-lock-{{ id_prefix }}" class="{% if is_independent %}hidden{% endif %} flex items-center gap-2 px-3 py-2 rounded-lg bg-white/[0.02] border border-white/[0.06] text-xs text-gray-500 mb-3">
                            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                            Fields locked — showing Registrant fallback values. Enable the toggle above to use a separate contact for this role.
                        </div>
                        {% endif %}

                        <form id="form-whois-{{ id_prefix }}" data-role="{{ role }}" data-contact-key="{{ contact_key }}" class="space-y-4">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div class="space-y-1.5">
                                    <label class="block text-xs font-medium text-gray-400" for="{{ id_prefix }}_first_name">First Name <span class="text-red-400">*</span></label>
                                    <input type="text" id="{{ id_prefix }}_first_name" name="{{ contact_key }}[first_name]" value="{{ data.first_name ?: clientProfile.first_name }}" required
                                           {% if role != 'registrant' and not is_independent %}disabled{% endif %}
                                           class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                                </div>
                                <div class="space-y-1.5">
                                    <label class="block text-xs font-medium text-gray-400" for="{{ id_prefix }}_last_name">Last Name <span class="text-red-400">*</span></label>
                                    <input type="text" id="{{ id_prefix }}_last_name" name="{{ contact_key }}[last_name]" value="{{ data.last_name ?: clientProfile.last_name }}" required
                                           {% if role != 'registrant' and not is_independent %}disabled{% endif %}
                                           class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                                </div>
                                <div class="space-y-1.5">
                                    <label class="block text-xs font-medium text-gray-400" for="{{ id_prefix }}_email">Email <span class="text-red-400">*</span></label>
                                    <input type="email" id="{{ id_prefix }}_email" name="{{ contact_key }}[email]" value="{{ data.email ?: clientProfile.email }}" required
                                           {% if role != 'registrant' and not is_independent %}disabled{% endif %}
                                           class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                                </div>
                                <div class="space-y-1.5">
                                    <label class="block text-xs font-medium text-gray-400" for="{{ id_prefix }}_company">Company</label>
                                    <input type="text" id="{{ id_prefix }}_company" name="{{ contact_key }}[company]" value="{{ data.company ?: clientProfile.company }}"
                                           {% if role != 'registrant' and not is_independent %}disabled{% endif %}
                                           class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                                </div>
                                <div class="space-y-1.5">
                                    <label class="block text-xs font-medium text-gray-400" for="{{ id_prefix }}_address1">Address Line 1 <span class="text-red-400">*</span></label>
                                    <input type="text" id="{{ id_prefix }}_address1" name="{{ contact_key }}[address1]" value="{{ data.address1 ?: clientProfile.address_1 }}" required
                                           {% if role != 'registrant' and not is_independent %}disabled{% endif %}
                                           class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                                </div>
                                <div class="space-y-1.5">
                                    <label class="block text-xs font-medium text-gray-400" for="{{ id_prefix }}_address2">Address Line 2</label>
                                    <input type="text" id="{{ id_prefix }}_address2" name="{{ contact_key }}[address2]" value="{{ data.address2 ?: clientProfile.address_2 }}"
                                           {% if role != 'registrant' and not is_independent %}disabled{% endif %}
                                           class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                                </div>
                                <div class="space-y-1.5">
                                    <label class="block text-xs font-medium text-gray-400" for="{{ id_prefix }}_city">City <span class="text-red-400">*</span></label>
                                    <input type="text" id="{{ id_prefix }}_city" name="{{ contact_key }}[city]" value="{{ data.city ?: clientProfile.city }}" required
                                           {% if role != 'registrant' and not is_independent %}disabled{% endif %}
                                           class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                                </div>
                                <div class="space-y-1.5">
                                    <label class="block text-xs font-medium text-gray-400" for="{{ id_prefix }}_state">State <span class="text-red-400">*</span></label>
                                    <input type="text" id="{{ id_prefix }}_state" name="{{ contact_key }}[state]" value="{{ data.state ?: clientProfile.state }}" required
                                           {% if role != 'registrant' and not is_independent %}disabled{% endif %}
                                           class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                                </div>
                                <div class="space-y-1.5">
                                    <label class="block text-xs font-medium text-gray-400" for="{{ id_prefix }}_postcode">Zip / Postcode <span class="text-red-400">*</span></label>
                                    <input type="text" id="{{ id_prefix }}_postcode" name="{{ contact_key }}[postcode]" value="{{ data.postcode ?: clientProfile.postcode }}" required
                                           {% if role != 'registrant' and not is_independent %}disabled{% endif %}
                                           class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                                </div>
                                <div class="space-y-1.5">
                                    <label class="block text-xs font-medium text-gray-400" for="{{ id_prefix }}_country">Country <span class="text-red-400">*</span></label>
                                    <input type="text" id="{{ id_prefix }}_country" name="{{ contact_key }}[country]" value="{{ data.country ?: clientProfile.country }}" required
                                           {% if role != 'registrant' and not is_independent %}disabled{% endif %}
                                           class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                                </div>
                                <div class="space-y-1.5">
                                    <label class="block text-xs font-medium text-gray-400" for="{{ id_prefix }}_phone_cc">Phone Country Code <span class="text-red-400">*</span></label>
                                    <input type="text" id="{{ id_prefix }}_phone_cc" name="{{ contact_key }}[phone_cc]" value="{{ data.phone_cc ?: clientProfile.phone_cc }}" required placeholder="+1"
                                           {% if role != 'registrant' and not is_independent %}disabled{% endif %}
                                           class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                                </div>
                                <div class="space-y-1.5">
                                    <label class="block text-xs font-medium text-gray-400" for="{{ id_prefix }}_phone">Phone Number <span class="text-red-400">*</span></label>
                                    <input type="text" id="{{ id_prefix }}_phone" name="{{ contact_key }}[phone]" value="{{ data.phone ?: clientProfile.phone }}" required
                                           {% if role != 'registrant' and not is_independent %}disabled{% endif %}
                                           class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                                </div>
                            </div>
                            <div class="pt-2 flex items-center gap-3 flex-wrap" id="form-actions-{{ id_prefix }}"
                                 {% if role != 'registrant' and not is_independent %}style="display:none"{% endif %}>
                                <button type="submit" disabled
                                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-white text-sm font-semibold transition-all shadow-lg shadow-indigo-500/20 opacity-40 cursor-not-allowed"
                                        style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                    Save {{ label }}
                                </button>
                                <span id="sync-badge-{{ id_prefix }}" class="sync-status-badge"></span>
                            </div>
                        </form>
                        </div>
                    </details>
                    {% endmacro %}

                    {% import _self as forms %}
                    {{ forms.contact_form('r', 'registrant', 'contact',        'Registrant Contact',     service.contact,         clientProfile, true) }}
                    {{ forms.contact_form('a', 'admin',      'admin_contact',   'Administrative Contact', service.admin_contact,    clientProfile, service.admin_contact_is_independent) }}
                    {{ forms.contact_form('t', 'tech',       'tech_contact',    'Technical Contact',      service.tech_contact,     clientProfile, service.tech_contact_is_independent) }}
                    {{ forms.contact_form('b', 'billing',    'billing_contact', 'Billing Contact',        service.billing_contact,  clientProfile, service.billing_contact_is_independent) }}

                    </div>{# /contact-form-wrapper #}
                    {% endif %}
                </div>
            </div>

            {# ── EPP / TRANSFER CODE ── #}
            <div x-show="tab === 'epp'" x-cloak>
                <div class="rounded-xl border border-white/[0.08] p-6" style="background: rgba(255,255,255,0.02);">
                    <h2 class="text-sm font-semibold text-white mb-2">Domain Secret (EPP Code)</h2>
                    {% if not isActive or not service %}
                    <div class="flex items-center gap-3 px-4 py-3 rounded-lg border {% if isActive %}border-blue-500/20 bg-blue-500/10 text-blue-400{% else %}border-amber-500/20 bg-amber-500/10 text-amber-400{% endif %} text-sm">
                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        {% if isActive %}Domain service is not yet provisioned. Contact support if this persists.{% else %}Available once the domain order is active.{% endif %}
                    </div>
                    {% else %}
