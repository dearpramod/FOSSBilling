{#
  partial_notifications.html.twig
  ─────────────────────────────────────────────────────────────────────────────
  Notification bell — invoice count fetched async on first open (no server-side
  invoice query per page load).

  Required variables:
    _notif_news       → result of guest.news_get_list({'per_page':3})
    _notif_dark       → true for dark/public layout, false for light/dashboard
    _notif_client     → true when a client is logged in, false for guests
  ─────────────────────────────────────────────────────────────────────────────
#}

{% set _nn_list = _notif_news.list is defined ? _notif_news.list : [] %}

{# Style tokens — dark (public navbar) vs light (dashboard header) #}
{% if _notif_dark %}
    {% set _btn_cls   = 'text-gray-400 hover:text-white hover:bg-white/5' %}
    {% set _panel_cls = 'bg-[#0d1424] border-white/[0.08] shadow-black/60' %}
    {% set _hdr_cls   = 'border-white/[0.06]' %}
    {% set _ttl_cls   = 'text-white' %}
    {% set _sub_cls   = 'text-gray-500' %}
    {% set _row_txt   = 'text-gray-300' %}
    {% set _ftr_cls   = 'border-white/[0.06] text-gray-500 hover:text-indigo-400' %}
    {% set _sep_cls   = 'border-white/[0.06]' %}
    {% set _empty_cls = 'text-gray-600' %}
    {% set _inv_hover = 'hover:bg-white/[0.04] hover:border-amber-400' %}
    {% set _inv_icon  = 'bg-amber-500/10' %}
    {% set _news_hover = 'hover:bg-white/[0.04] hover:border-indigo-400' %}
    {% set _news_icon  = 'bg-indigo-500/10' %}
    {% set _view_news_hover = 'hover:bg-white/[0.04]' %}
    {% set _view_inv_hover  = 'hover:bg-white/[0.04]' %}
{% else %}
    {% set _btn_cls   = 'text-slate-500 hover:text-indigo-500 hover:bg-indigo-50' %}
    {% set _panel_cls = 'bg-white border-slate-200 shadow-black/[0.08]' %}
    {% set _hdr_cls   = 'border-slate-100' %}
    {% set _ttl_cls   = 'text-slate-800' %}
    {% set _sub_cls   = 'text-slate-400' %}
    {% set _row_txt   = 'text-slate-700' %}
    {% set _ftr_cls   = 'border-slate-100 text-slate-400 hover:text-indigo-500' %}
    {% set _sep_cls   = 'border-slate-100' %}
    {% set _empty_cls = 'text-slate-400' %}
    {% set _inv_hover = 'hover:bg-amber-50 hover:border-amber-400' %}
    {% set _inv_icon  = 'bg-amber-100' %}
    {% set _news_hover = 'hover:bg-indigo-50 hover:border-indigo-400' %}
    {% set _news_icon  = 'bg-indigo-50' %}
    {% set _view_news_hover = 'hover:bg-indigo-50' %}
    {% set _view_inv_hover  = 'hover:bg-amber-50' %}
{% endif %}

{#
  Embed news list as JSON in a <script type="application/json"> element.
  json_encode flag 1 = JSON_HEX_TAG — converts < and > to </> so
  the string "</script>" inside a news title can never break the script block.
#}
<script type="application/json" id="notif-news-data">{{ _nn_list|json_encode(1)|raw }}</script>

<div class="relative" x-data="{
    notifOpen: false,
    loaded:    false,
    count:     0,
    invoices:  [],
    news:      [],
    init() {
        var el = document.getElementById('notif-news-data');
        try { this.news = el ? JSON.parse(el.textContent) : []; } catch(e) {}
    },
    toggle() {
        this.notifOpen = !this.notifOpen;
        if (this.notifOpen && !this.loaded) this.loadInvoices();
    },
    loadInvoices() {
        {% if _notif_client %}
        var self = this;
        FOSSBilling.api.client.get(
            'invoice/get_list',
            { status: 'unpaid', per_page: 5 },
            function(d) {
                self.count    = (d && d.total) ? parseInt(d.total, 10) : 0;
                self.invoices = (d && d.list)  ? d.list : [];
                self.loaded   = true;
            },
            function() { self.loaded = true; },
            false
        );
        {% else %}
        this.loaded = true;
        {% endif %}
    },
    fmtAmt(total, currency) {
        return (currency || '') + ' ' + parseFloat(total || 0).toFixed(2);
    },
    fmtDate(val) {
        if (!val) return '';
        var d = (typeof val === 'number')
              ? new Date(val * 1000)
              : new Date(String(val).replace(' ', 'T'));
        if (isNaN(d.getTime())) return '';
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    },
    isOverdue(due_at) {
        if (!due_at) return false;
        return new Date(String(due_at).replace(' ', 'T')) < new Date();
    }
}" @click.outside="notifOpen = false">

    {# ── Bell button ── #}
    <button @click="toggle()"
            class="relative rounded-lg p-2 transition-colors {{ _btn_cls }}"
            title="Notifications"
            :aria-expanded="notifOpen">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 17h5l-1.4-1.4a2 2 0 01-.6-1.4V11a6 6 0 10-12 0v3.2c0 .5-.2 1-.6 1.4L4 17h5m6 0a3 3 0 11-6 0h6z"/>
        </svg>
        <span x-show="count > 0"
              x-text="count > 99 ? '99+' : String(count)"
              class="absolute font-bold leading-none select-none {{ _notif_dark ? 'text-white' : 'text-gray-700' }}"
              style="top:3px;right:3px;font-size:9px;font-variant-numeric:tabular-nums;"></span>
    </button>

    {# ── Dropdown panel ── #}
    <div x-show="notifOpen"
         x-cloak
         x-transition:enter="transition ease-out duration-150"
         x-transition:enter-start="opacity-0 translate-y-1"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-100"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 translate-y-1"
         class="absolute right-0 top-full mt-1.5 w-80 {{ _panel_cls }} border rounded-xl shadow-2xl z-50 flex flex-col overflow-hidden"
         style="display:none; max-height: min(480px, calc(100vh - 5rem));">

        {# Fixed header #}
        <div class="flex items-center justify-between px-4 py-3 border-b {{ _hdr_cls }} flex-shrink-0">
            <h3 class="text-sm font-semibold {{ _ttl_cls }}">Notifications</h3>
            <span x-show="count > 0" x-text="count + ' unpaid'"
                  class="text-xs px-2 py-0.5 rounded-full bg-red-500/10 text-red-500 font-medium"></span>
            <span x-show="count === 0 && loaded" class="text-xs {{ _sub_cls }}">All up to date</span>
        </div>

        {# Scrollable body #}
        <div class="flex-1 overflow-y-auto overscroll-contain">

            {# Loading spinner — shown while waiting for async invoice fetch #}
            <div x-show="{{ _notif_client ? 'true' : 'false' }} && !loaded"
                 class="flex items-center justify-center py-8">
                <svg class="w-5 h-5 animate-spin {{ _sub_cls }} opacity-60" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                </svg>
            </div>

            {# ── Invoice alerts ── #}
            <div x-show="invoices.length > 0">
                <p class="px-4 pt-3 pb-1 text-[10px] font-semibold {{ _sub_cls }} uppercase tracking-wider flex items-center gap-1.5">
                    <svg class="w-3 h-3 text-amber-500 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                    </svg>
                    Invoice Alerts
                </p>
                <template x-for="invoice in invoices.slice(0, 4)" :key="invoice.id">
                    <a :href="'{{ '/invoice'|url }}/' + invoice.hash"
                       @click="notifOpen = false"
                       class="flex items-start gap-3 px-4 py-2.5 border-l-2 border-transparent transition-all group {{ _inv_hover }}">
                        <span class="w-7 h-7 rounded-lg {{ _inv_icon }} flex items-center justify-center flex-shrink-0 mt-0.5">
                            <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                        </span>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs font-semibold {{ _row_txt }} truncate"
                               x-text="'Invoice #' + invoice.serie + invoice.nr"></p>
                            <p class="text-[11px] font-medium"
                               :class="isOverdue(invoice.due_at) ? 'text-red-500' : 'text-amber-500'"
                               x-text="fmtAmt(invoice.total, invoice.currency) + ' — ' + (isOverdue(invoice.due_at) ? 'Overdue' : 'Unpaid')"></p>
                            <p x-show="invoice.due_at"
                               class="text-[10px] {{ _sub_cls }} mt-0.5"
                               x-text="'Due ' + fmtDate(invoice.due_at)"></p>
                        </div>
                        <svg class="w-3.5 h-3.5 {{ _sub_cls }} group-hover:text-amber-400 flex-shrink-0 mt-1 transition-colors"
                             fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                </template>
                <a x-show="count > 4"
                   href="{{ '/invoice'|url }}" @click="notifOpen = false"
                   class="flex items-center justify-center gap-1 px-4 py-2 text-xs text-amber-500 hover:text-amber-600 transition-colors font-medium {{ _view_inv_hover }}">
                    View all <span x-text="count"></span> unpaid invoices →
                </a>
            </div>

            {# ── Latest news ── #}
            <div x-show="news.length > 0"
                 :class="invoices.length > 0 ? 'border-t {{ _sep_cls }}' : ''">
                <p class="px-4 pt-3 pb-1 text-[10px] font-semibold {{ _sub_cls }} uppercase tracking-wider flex items-center gap-1.5">
                    <svg class="w-3 h-3 text-indigo-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                    </svg>
                    Latest News
                </p>
                <template x-for="post in news.slice(0, 3)" :key="post.slug || post.id">
                    <a :href="'{{ '/news'|url }}/' + post.slug"
                       @click="notifOpen = false"
                       class="flex items-start gap-3 px-4 py-2.5 border-l-2 border-transparent transition-all group {{ _news_hover }}">
                        <span class="w-7 h-7 rounded-lg {{ _news_icon }} flex items-center justify-center flex-shrink-0 mt-0.5">
                            <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                            </svg>
                        </span>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs font-semibold {{ _row_txt }} truncate" x-text="post.title"></p>
                            <p x-show="post.updated_at"
                               class="text-[10px] {{ _sub_cls }} mt-0.5"
                               x-text="fmtDate(post.updated_at)"></p>
                        </div>
                        <svg class="w-3.5 h-3.5 {{ _sub_cls }} group-hover:text-indigo-400 flex-shrink-0 mt-1 transition-colors"
                             fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                </template>
                <a href="{{ '/news'|url }}" @click="notifOpen = false"
                   class="flex items-center justify-center gap-1 px-4 py-2 text-xs text-indigo-500 hover:text-indigo-600 font-medium transition-colors {{ _view_news_hover }}">
                    View all news →
                </a>
            </div>

            {# ── Empty state (only shown after load completes) ── #}
            <div x-show="loaded && invoices.length === 0 && news.length === 0"
                 class="px-4 py-8 text-center">
                <svg class="w-9 h-9 {{ _sub_cls }} mx-auto mb-2 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M15 17h5l-1.4-1.4a2 2 0 01-.6-1.4V11a6 6 0 10-12 0v3.2c0 .5-.2 1-.6 1.4L4 17h5m6 0a3 3 0 11-6 0h6z"/>
                </svg>
                <p class="text-xs {{ _empty_cls }}">No notifications right now</p>
            </div>

        </div>

        {# Fixed footer #}
        <div class="border-t {{ _hdr_cls }} px-4 py-2.5 flex items-center justify-between flex-shrink-0">
            <a href="{{ '/invoice'|url }}" @click="notifOpen = false"
               class="text-xs {{ _ftr_cls }} transition-colors">All invoices</a>
            <a x-show="news.length > 0"
               href="{{ '/news'|url }}" @click="notifOpen = false"
               class="text-xs {{ _ftr_cls }} transition-colors">News</a>
        </div>

    </div>
</div>
