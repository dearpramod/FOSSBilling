{% set active_locale = guest.system_locale|default('en')|replace({'_': '-'}) %}
<!DOCTYPE html>
<html lang="{{ active_locale }}" class="h-full">
<head>
    <meta charset="utf-8">
    <title>{% block meta_title %}Welcome{% endblock %} — {{ guest.system_company.name }}</title>
    <meta name="description" content="{% block meta_description %}{% if settings.meta_description|default(false) %}{{ settings.meta_description }}{% else %}{{ guest.system_company.name }} — Nepal's trusted VPS hosting provider{% endif %}{% endblock %}">
    {% if settings.meta_keywords|default(false) %}<meta name="keywords" content="{{ settings.meta_keywords }}">{% endif %}
    {% if settings.meta_robots|default(false) %}<meta name="robots" content="{{ settings.meta_robots }}">{% endif %}
    {% if settings.meta_author|default(false) %}<meta name="author" content="{{ settings.meta_author }}">{% endif %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ CSRFToken }}">

    {# ── Theme color custom properties (shared partial: full brand scale) ── #}
    {% include 'partials/theme_colors.html.twig' %}
    <link rel="shortcut icon" href="{{ guest.system_company.favicon_url }}">
    <link rel="canonical" href="{% block canonical_url %}{{ constant('SYSTEM_URL') ~ request_path|trim('/') }}{% endblock %}">
    {% block opengraph %}
    <meta property="og:title" content="{{ (settings.meta_title_prefix|default('') ~ ' ' ~ block('meta_title') ~ ' ' ~ settings.meta_title_suffix|default(''))|trim }}">
    <meta property="og:type" content="website">
    <meta property="og:description" content="{{ block('meta_description') }}">
    <meta property="og:url" content="{{ constant('SYSTEM_URL') ~ request_path|trim('/') }}">
    {% if guest.system_company.logo_url %}<meta property="og:image" content="{{ guest.system_company.logo_url }}">{% endif %}
    {% endblock %}

    <!-- Vendor CSS (flag-icons, tom-select) -->
    <link rel="stylesheet" href="{{ 'build/css/vendor.css' | asset_url }}">
    <!-- Tailwind CSS (built via Tailwind CLI + esbuild pipeline) -->
    <link rel="stylesheet" href="{{ 'build/css/merotheme.css' | asset_url }}">
    <noscript>
        <style>[x-cloak],[x-show]{display:block!important}</style>
        <div style="position:fixed;top:0;left:0;right:0;padding:0.75rem 1rem;background:#f59e0b;color:#1c1917;font-size:0.875rem;z-index:9999;text-align:center;">{{ 'JavaScript is required for the full experience. Please enable JavaScript.'|trans }}</div>
    </noscript>

    {{ 'js/fossbilling.js' | public_asset_url | script_tag }}
    {{ 'js/api.js' | public_asset_url | script_tag }}
    <!-- Merotheme bundle: Alpine.js + @alpinejs/collapse + TomSelect (npm-bundled, no CDN) -->
    {{ 'build/js/merotheme.js' | asset_url | script_tag }}

    <!-- Panel utility shims (bb, FBPanel) -->
    <script>
    (function () {
        function getNotifContainer() {
            var c = document.getElementById('merovps-notif');
            if (!c) {
                c = document.createElement('div');
                c.id = 'merovps-notif';
                c.setAttribute('role', 'status');
                c.setAttribute('aria-live', 'polite');
                c.setAttribute('aria-atomic', 'true');
                // z-index 20 — below the sticky nav (z-30 = 30) so the header always sits on top
                c.style.cssText = 'position:fixed;bottom:1.5rem;right:1.5rem;z-index:20;display:flex;flex-direction:column;gap:0.625rem;max-width:22rem;pointer-events:none;';
                document.body.appendChild(c);
            }
            return c;
        }
        globalThis.FBPanel = {
            message: function (message, type) {
                var icons = {
                    error:   '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>',
                    success: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>',
                    warning: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>',
                    info:    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>'
                };
                var accent = { error: '#ef4444', success: '#22c55e', warning: '#f59e0b', info: '#6366f1' };
                var color = accent[type] || accent.info;
                var icon  = icons[type]  || icons.info;
                // Read live theme CSS vars (set by the theme's :root block)
                var rootStyle = getComputedStyle(document.documentElement);
                var primaryColor = rootStyle.getPropertyValue('--color-primary').trim() || '#6366f1';
                var usePrimary = (type === 'info') ? primaryColor : color;
                var el = document.createElement('div');
                el.style.cssText = [
                    'background:rgba(3,7,18,0.82)',
                    'border:1px solid rgba(255,255,255,0.07)',
                    'border-left:3px solid ' + usePrimary,
                    'backdrop-filter:blur(18px) saturate(1.5)',
                    '-webkit-backdrop-filter:blur(18px) saturate(1.5)',
                    'color:#f1f5f9',
                    'padding:0.875rem 1rem',
                    'border-radius:0.875rem',
                    'font-size:0.8125rem',
                    'display:flex',
                    'align-items:flex-start',
                    'gap:0.625rem',
                    'box-shadow:0 8px 32px rgba(0,0,0,0.5),0 2px 6px rgba(0,0,0,0.3),inset 0 1px 0 rgba(255,255,255,0.06)',
                    'pointer-events:auto',
                    'transform:translateY(16px) scale(0.97)',
                    'opacity:0',
                    'transition:transform 280ms cubic-bezier(0.34,1.3,0.64,1),opacity 220ms ease-out'
                ].join(';');
                el.innerHTML =
                    '<svg style="width:1rem;height:1rem;flex-shrink:0;color:' + usePrimary + ';margin-top:0.0625rem" fill="none" stroke="currentColor" viewBox="0 0 24 24">' + icon + '</svg>' +
                    '<span style="flex:1;line-height:1.5;font-weight:500">' + message.replace(/</g,'&lt;') + '</span>' +
                    '<button onclick="this.parentElement._rmToast()" style="background:none;border:none;color:#64748b;cursor:pointer;font-size:1.15rem;line-height:1;padding:0;margin-left:0.25rem;flex-shrink:0;pointer-events:auto" aria-label="Dismiss">&times;</button>';
                el._rmToast = function () {
                    el.style.transform = 'translateY(16px) scale(0.97)';
                    el.style.opacity = '0';
                    setTimeout(function () { el.remove(); }, 250);
                };
                getNotifContainer().appendChild(el);
                requestAnimationFrame(function () {
                    requestAnimationFrame(function () {
                        el.style.transform = 'translateY(0) scale(1)';
                        el.style.opacity = '1';
                    });
                });
                setTimeout(function () { if (el.parentElement) el._rmToast(); }, 7000);
            }
        };
        globalThis.bb = {
            redirect: function (url) { window.location = url; },
            reload: function () { window.location.reload(true); }
        };

        // Extend FOSSBilling with panel notification methods while preserving FOSSBilling.api.*
        globalThis.FOSSBilling = Object.assign(globalThis.FOSSBilling || {}, globalThis.FBPanel);
        // Shorthand alias used throughout templates: API.client.post(...) etc.
        globalThis.API = window.FOSSBilling.api;
        // StablePanel: thin alias used across templates for toast notifications.
        globalThis.StablePanel = { message: function(msg, type) { FOSSBilling.message(msg, type); } };
    })();
    </script>

    {# Prevent theme flash — runs synchronously before first paint #}
    <script>
    (function(){
        var t = localStorage.getItem('merovps_theme') || 'light';
        document.documentElement.setAttribute('data-theme', t);
    })();
    </script>

    {% if guest.extension_is_on({ "mod": "googletagmanager" }) %}
    {{ guest.googletagmanager_head_snippet|raw }}
    {% endif %}
    {{ debug_bar_render_head() }}
    {% block head %}{% endblock %}
</head>

<body class="bg-[#030712] text-white font-sans min-h-screen flex flex-col {% block body_class %}{% endblock %}"
      x-data="{ mobileMenuOpen: false, servicesOpen: false, darkMode: localStorage.getItem('merovps_theme') === 'dark' }"
      x-init="$watch('darkMode', function(v){ var t = v ? 'dark' : 'light'; localStorage.setItem('merovps_theme', t); document.documentElement.setAttribute('data-theme', t); });">
<div hidden aria-hidden="true">{{ svg_sprite()|raw }}</div>
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-white focus:text-indigo-600 focus:rounded-lg focus:ring-2 focus:ring-indigo-500 focus:shadow-lg">{{ 'Skip to main content'|trans }}</a>
{% if guest.extension_is_on({ "mod": "googletagmanager" }) %}
{{ guest.googletagmanager_body_snippet|raw }}
{% endif %}
{{ render_widgets('client.theme.body.start') }}
{% set company = guest.system_company %}

<!-- ========== NAVBAR ========== -->
{% set cart = guest.cart_get %}
{% set cartCount = cart.items is defined ? cart.items|length : 0 %}
{% set currencies = guest.currency_get_pairs %}
{% set currentCurrency = cart.currency %}
{% if client %}
    {% set profile = client.profile_get %}
    {# Auto-sync cart currency to client's billing currency #}
    {% set _clientCurrency = profile.currency|default(null) %}
    {% if _clientCurrency and currentCurrency.code != _clientCurrency %}
        {% set _sync = guest.cart_set_currency({'currency': _clientCurrency}) %}
        {% set currentCurrency = {'code': _clientCurrency} %}
    {% endif %}
{% endif %}

{# ── Notification data — only fetched for logged-in clients ── #}
{% set _news_on = guest.extension_is_on({'mod': 'news'}) %}
{% if client %}
    {% set _notif_news = _news_on ? guest.news_get_list({'per_page': 3}) : {'list': [], 'total': 0} %}
{% else %}
    {% set _notif_news = {'list': [], 'total': 0} %}
{% endif %}
{# Invoice data is fetched async via JS — no server-side query per page load #}

<header class="header-bar border-b border-white/[0.06] bg-[#030712]/95 backdrop-blur-md sticky top-0 z-30">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-14">

            <!-- ── Logo ── -->
            <a href="{{ '/'|url }}" class="flex items-center flex-shrink-0">
                <img src="{{ settings.logo_url|default(false) ?: 'branding/logo.svg'|public_asset_url }}" alt="{{ company.name }}" class="h-7 w-auto logo-img">
            </a>

            <!-- ── Desktop center nav ── -->
            <div class="hidden lg:flex items-center gap-1">
                {% if settings.nav_home_show|default('1') != '0' %}
                <a href="{{ (settings.nav_home_url|default('/'))|url }}" class="px-3 py-1.5 text-sm text-gray-400 hover:text-white hover:bg-white/5 rounded-lg transition-all nav-link">{{ settings.nav_home_label|default('Home') }}</a>
                {% endif %}

                <!-- Services dropdown -->
                {% set serviceCategories = guest.product_category_get_list({'per_page': 50, 'deep': 0}) %}
                <div class="relative" x-data="{ open: false }" @click.outside="open=false" @mouseenter="open=true" @mouseleave="open=false">
                    <button @click="open=!open" class="flex items-center gap-1 px-3 py-1.5 text-sm text-gray-400 hover:text-white hover:bg-white/5 rounded-lg transition-all nav-link">
                        Services
                        <svg class="w-3.5 h-3.5 opacity-50 transition-transform duration-150" :class="open ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    {# Transparent bridge fills the mt-1.5 gap so mouseleave never fires when crossing into the panel #}
                    <div class="absolute top-full left-0 right-0 h-2 z-40" x-show="open" style="display:none;"></div>
                    <div x-show="open"
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="opacity-0 translate-y-1"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         x-transition:leave="transition ease-in duration-75"
                         x-transition:leave-start="opacity-100 translate-y-0"
                         x-transition:leave-end="opacity-0 translate-y-1"
                         class="absolute top-full left-0 mt-1.5 w-72 dropdown-panel border border-white/[0.08] rounded-xl shadow-2xl shadow-black/60 py-1.5 z-50">
                        {# ── Categories sorted by product type: Hosting → Server → Custom → Domain ── #}
                        {%- set _nav_type_order = {'hosting': 0, 'server': 1, 'custom': 2, 'domain': 3, 'downloadable': 4, 'license': 5, 'membership': 6} -%}
                        {%- set _nav_type_icons = {
                            'hosting':      {'color': 'text-indigo-400',  'bg': 'bg-indigo-500/10',  'icon': 'server'},
                            'server':       {'color': 'text-amber-400',   'bg': 'bg-amber-500/10',   'icon': 'cpu'},
                            'custom':       {'color': 'text-purple-400',  'bg': 'bg-purple-500/10',  'icon': 'cube'},
                            'domain':       {'color': 'text-violet-400',  'bg': 'bg-violet-500/10',  'icon': 'world'},
                            'downloadable': {'color': 'text-emerald-400', 'bg': 'bg-emerald-500/10', 'icon': 'download'},
                            'license':      {'color': 'text-blue-400',    'bg': 'bg-blue-500/10',    'icon': 'certificate'},
                            'membership':   {'color': 'text-rose-400',    'bg': 'bg-rose-500/10',    'icon': 'users'}
                        } -%}
                        {% if serviceCategories.list %}
                            {%- set _sorted_nav_cats = serviceCategories.list|sort((a, b) => (_nav_type_order[a.type]|default(99)) <=> (_nav_type_order[b.type]|default(99))) -%}
                            {% for category in _sorted_nav_cats %}
                                {%- set _ci = _nav_type_icons[category.type]|default({'color': 'text-indigo-400', 'bg': 'bg-indigo-500/10', 'icon': 'apps'}) -%}
                                {# Categories have no slug in the API array — derive it from the title, matching Order\Controller\Client::titleToSlug() #}
                                {%- set catHref = ('/order/' ~ (category.title|lower|replace({' ': '-', '/': '-'})|trim('-')))|url -%}
                                <a href="{{ catHref }}" @click="open=false"
                                   class="dropdown-link flex items-center gap-3 px-4 py-2.5 text-sm transition-all">
                                    <span class="w-7 h-7 rounded-lg {{ _ci.bg }} {{ _ci.color }} flex items-center justify-center flex-shrink-0">
                                        <svg class="icon" style="width:0.875rem;height:0.875rem"><use href="#{{ _ci.icon }}" /></svg>
                                    </span>
                                    <span class="font-medium">{{ category.title }}</span>
                                </a>
                            {% endfor %}
                        {% else %}
                            <a href="{{ '/order'|url }}" @click="open=false"
                               class="dropdown-link flex items-center gap-3 px-4 py-2.5 text-sm transition-all">
                                <span class="block font-medium">All Plans</span>
                            </a>
                        {% endif %}
                        <div class="border-t border-white/[0.05] mt-1 pt-1">
                            <a href="{{ '/order/domain-tlds'|url }}" @click="open=false"
                               class="flex items-center gap-2 px-4 py-2 text-xs text-indigo-400 hover:text-indigo-300 hover:bg-white/[0.04] transition-all">
                                <svg class="icon" style="width:0.75rem;height:0.75rem"><use href="#arrows-exchange" /></svg>
                                Transfer a Domain
                            </a>
                            <a href="{{ '/order'|url }}" @click="open=false"
                               class="flex items-center px-4 py-2 text-xs text-gray-500 hover:text-gray-300 hover:bg-white/[0.04] transition-all">
                                Browse all products →
                            </a>
                        </div>
                    </div>
                </div>

                {% if settings is not empty %}{% for n in [1,2,3,4] %}
                {% set cLabel  = attribute(settings, 'nav_custom' ~ n ~ '_label') %}
                {% set cUrl    = attribute(settings, 'nav_custom' ~ n ~ '_url') %}
                {% set cHasSub = attribute(settings, 'nav_custom' ~ n ~ '_has_sub') %}
                {% if cLabel %}
                    {% if cHasSub == '1' %}
                    <div class="relative" x-data="{ open: false }" @click.outside="open=false" @mouseenter="open=true" @mouseleave="open=false">
                        <button @click="open=!open" class="flex items-center gap-1 px-3 py-1.5 text-sm text-gray-400 hover:text-white hover:bg-white/5 rounded-lg transition-all nav-link">
                            {{ cLabel }}
                            <svg class="w-3.5 h-3.5 opacity-50 transition-transform duration-150" :class="open ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                        </button>
                        <div class="absolute top-full left-0 right-0 h-2 z-40" x-show="open" style="display:none;"></div>
                        <div x-show="open"
                             x-transition:enter="transition ease-out duration-100"
                             x-transition:enter-start="opacity-0 translate-y-1"
                             x-transition:enter-end="opacity-100 translate-y-0"
                             x-transition:leave="transition ease-in duration-75"
                             x-transition:leave-start="opacity-100 translate-y-0"
                             x-transition:leave-end="opacity-0 translate-y-1"
                             class="absolute top-full left-0 mt-1.5 w-52 dropdown-panel border border-white/[0.08] rounded-xl shadow-2xl shadow-black/60 py-1.5 z-50">
                            {% for s in [1,2,3,4] %}
                            {% set sLabel = attribute(settings, 'nav_custom' ~ n ~ '_sub' ~ s ~ '_label') %}
                            {% set sUrl   = attribute(settings, 'nav_custom' ~ n ~ '_sub' ~ s ~ '_url') %}
                            {% if sLabel and sUrl %}
                            <a href="{{ sUrl|url }}" @click="open=false" class="dropdown-link flex items-center px-4 py-2.5 text-sm transition-all">
                                <span class="font-medium">{{ sLabel }}</span>
                            </a>
                            {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                    {% elseif cUrl %}
                    <a href="{{ cUrl|url }}" class="px-3 py-1.5 text-sm text-gray-400 hover:text-white hover:bg-white/5 rounded-lg transition-all nav-link">{{ cLabel }}</a>
                    {% endif %}
                {% endif %}
                {% endfor %}{% endif %}
                {% if settings.nav_contact_show|default('1') != '0' %}
                <a href="{{ (settings.nav_contact_url|default(settings.link_support|default('/support/contact')))|url }}" class="px-3 py-1.5 text-sm text-gray-400 hover:text-white hover:bg-white/5 rounded-lg transition-all nav-link">{{ settings.nav_contact_label|default('Contact') }}</a>
                {% endif %}
                {% if settings.nav_support_show|default('1') != '0' %}
                <a href="{{ (settings.nav_support_url|default('/support'))|url }}" class="px-3 py-1.5 text-sm text-gray-400 hover:text-white hover:bg-white/5 rounded-lg transition-all nav-link">{{ settings.nav_support_label|default('Support') }}</a>
                {% endif %}
                {% if settings.nav_news_show|default('1') != '0' %}
                <a href="{{ (settings.nav_news_url|default('/news'))|url }}" class="px-3 py-1.5 text-sm text-gray-400 hover:text-white hover:bg-white/5 rounded-lg transition-all nav-link">{{ settings.nav_news_label|default('News') }}</a>
                {% endif %}
            </div>

            <!-- ── Desktop right: Cart · Currency · Account · CTA ── -->
            <div class="hidden lg:flex items-center gap-1">

                {# Cart icon #}
                <a id="cart-link-desktop" href="{{ '/cart'|url }}" title="Cart"
                   class="relative p-2 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                    <span id="cart-badge-desktop"
                          class="absolute -top-0.5 -right-0.5 w-[18px] h-[18px] rounded-full text-white text-[9px] font-bold flex items-center justify-center leading-none"
                          style="background: linear-gradient(135deg,var(--color-primary),var(--color-secondary)); display:{{ cartCount > 0 ? 'flex' : 'none' }};">{{ cartCount > 0 ? cartCount : '' }}</span>
                </a>

                {# Currency: switcher for guests, static badge for logged-in #}
                {% if client and profile is defined and profile.currency %}
                <div class="flex items-center gap-1 px-2 py-2 rounded-lg text-gray-500" title="Billing currency (set during registration)">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span class="text-xs font-semibold">{{ currentCurrency.code }}</span>
                </div>
                {% elseif not client and currencies|length > 1 %}
                <div class="relative" x-data="{ open: false }" @click.outside="open=false">
                    <button @click="open=!open" title="Change currency"
                            class="flex items-center gap-1 px-2 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span class="text-xs font-semibold">{{ currentCurrency.code }}</span>
                        <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </button>
                    <div x-show="open"
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="opacity-0 translate-y-1"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         class="absolute right-0 top-full mt-1.5 w-44 bg-[#0d1424] border border-white/[0.08] rounded-xl shadow-2xl shadow-black/60 py-1.5 z-50">
                        <p class="px-4 pt-1.5 pb-1 text-[10px] font-semibold text-gray-600 uppercase tracking-wider">Currency</p>
                        {% for code, title in currencies %}
                                <button type="button" data-set-currency="{{ code }}"
                                    class="w-full flex items-center gap-2.5 px-4 py-2 text-sm hover:bg-white/[0.04] transition-all
                                           {{ currentCurrency.code == code ? 'text-indigo-400' : 'text-gray-400 hover:text-white' }}">
                                <span class="text-xs font-mono font-bold w-8 text-left {{ currentCurrency.code == code ? 'text-indigo-400' : 'text-gray-500' }}">{{ code }}</span>
                                <span class="text-xs truncate">{{ title }}</span>
                                {% if currentCurrency.code == code %}
                                    <svg class="w-3 h-3 text-indigo-400 ml-auto flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                {% endif %}
                            </button>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {# Notification bell (logged-in clients only) #}
                {% if client %}
                {% include 'partial_notifications.html.twig' with {
                    _notif_client: true,
                    _notif_news:   _notif_news,
                    _notif_dark:   true
                } only %}
                {% endif %}

                {# Account dropdown #}
                <div class="relative" x-data="{ open: false }" @click.outside="open=false">
                    <button @click="open=!open"
                            class="flex items-center gap-1.5 px-2 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all"
                            title="Account">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        {% if client %}
                            <span class="text-xs font-medium text-gray-300 max-w-[72px] truncate">{{ profile.first_name }}</span>
                        {% endif %}
                        <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </button>

                    <div x-show="open"
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="opacity-0 translate-y-1"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         class="absolute right-0 top-full mt-1.5 w-54 bg-[#0d1424] border border-white/[0.08] rounded-xl shadow-2xl shadow-black/60 z-50 overflow-hidden"
                         style="min-width:13rem;">
                        {% if client %}
                            <div class="px-4 py-3 border-b border-white/[0.06]">
                                <p class="text-xs font-semibold text-white truncate">{{ profile.first_name }} {{ profile.last_name }}</p>
                                <p class="text-[11px] text-gray-500 truncate mt-0.5">{{ profile.email }}</p>
                            </div>
                            <div class="py-1">
                                <a href="{{ '/dashboard'|url }}" class="flex items-center gap-3 px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/[0.04] transition-all">
                                    <svg class="w-4 h-4 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                                    Dashboard
                                </a>
                                <a href="{{ 'order'|url }}" class="flex items-center gap-3 px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/[0.04] transition-all">
                                    <svg class="w-4 h-4 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                                    My Orders
                                </a>
                                <a href="{{ 'invoice'|url }}" class="flex items-center gap-3 px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/[0.04] transition-all">
                                    <svg class="w-4 h-4 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                    Invoices
                                </a>
                                <a href="{{ 'client/profile'|url }}" class="flex items-center gap-3 px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/[0.04] transition-all">
                                    <svg class="w-4 h-4 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                    Profile Settings
                                </a>
                            </div>
                            <div class="border-t border-white/[0.06] py-1">
                                <a href="{{ 'client/logout'|url }}" class="flex items-center gap-3 px-4 py-2 text-sm text-red-400 hover:text-red-300 hover:bg-white/[0.04] transition-all">
                                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                                    Sign Out
                                </a>
                            </div>
                        {% else %}
                            <div class="py-1">
                                <a href="{{ 'login'|url }}" class="flex items-center gap-3 px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/[0.04] transition-all">
                                    <svg class="w-4 h-4 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
                                    Log in
                                </a>
                                <a href="{{ 'signup'|url }}" class="flex items-center gap-3 px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/[0.04] transition-all">
                                    <svg class="w-4 h-4 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                                    Create Account
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Theme toggle #}
                <button @click="darkMode = !darkMode"
                        :aria-label="darkMode ? 'Switch to light mode' : 'Switch to dark mode'"
                        title="Toggle theme"
                        class="p-2 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all theme-toggle-btn public-theme-toggle">
                    <svg x-show="darkMode" class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                    <svg x-show="!darkMode" class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/>
                    </svg>
                </button>

                {# Divider #}
                <div class="w-px h-5 bg-white/[0.08] mx-1"></div>

                {# Primary CTA #}
                <a href="{{ '/order'|url }}" class="text-sm px-4 py-1.5 rounded-lg btn-primary-gradient whitespace-nowrap">
                    Get Started
                </a>
            </div>

            <!-- ── Mobile right: dark/light · cart · hamburger ── -->
            <div class="flex lg:hidden items-center gap-0.5">
                {# Dark/light toggle — always visible on mobile #}
                <button @click="darkMode = !darkMode"
                        :aria-label="darkMode ? 'Switch to light mode' : 'Switch to dark mode'"
                        title="Toggle theme"
                        class="p-2.5 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all theme-toggle-btn public-theme-toggle">
                    <svg x-show="darkMode" class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                    <svg x-show="!darkMode" class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/>
                    </svg>
                </button>
                <a id="cart-link-mobile" href="{{ '/cart'|url }}" class="relative p-2.5 rounded-lg text-gray-400 hover:text-white hover:bg-white/5">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                    <span id="cart-badge-mobile"
                          class="absolute -top-0.5 -right-0.5 w-[18px] h-[18px] rounded-full text-white text-[9px] font-bold flex items-center justify-center"
                          style="background: linear-gradient(135deg,var(--color-primary),var(--color-secondary)); display:{{ cartCount > 0 ? 'flex' : 'none' }};">{{ cartCount > 0 ? cartCount : '' }}</span>
                </a>
                <button @click="mobileMenuOpen = !mobileMenuOpen" class="p-2.5 rounded-lg text-gray-400 hover:text-white hover:bg-white/5">
                    <svg x-show="!mobileMenuOpen" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                    <svg x-show="mobileMenuOpen" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- ── Mobile menu panel ── -->
        <div x-show="mobileMenuOpen"
             x-transition:enter="transition ease-out duration-150"
             x-transition:enter-start="opacity-0 -translate-y-2"
             x-transition:enter-end="opacity-100 translate-y-0"
             class="lg:hidden pb-5 border-t border-white/[0.06] pt-4 space-y-1 max-h-[80vh] overflow-y-auto"
             x-data="{ mSub: '' }">

            <!-- Home -->
            {% if settings.nav_home_show|default('1') != '0' %}
            <a href="{{ (settings.nav_home_url|default('/'))|url }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 nav-link">
                <span class="w-8 h-8 rounded-lg bg-gray-500/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4"/></svg>
                </span>
                {{ settings.nav_home_label|default('Home') }}
            </a>
            {% endif %}

            <!-- Services accordion -->
            <div>
                <button @click="mSub === 'services' ? mSub = '' : mSub = 'services'"
                        class="w-full flex items-center justify-between gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 transition-all">
                    <span class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center flex-shrink-0">
                            <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
                        </span>
                        Services
                    </span>
                    <svg class="w-4 h-4 text-gray-500 transition-transform duration-200" :class="mSub === 'services' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div x-show="mSub === 'services'"
                     x-transition:enter="transition ease-out duration-150"
                     x-transition:enter-start="opacity-0 -translate-y-1"
                     x-transition:enter-end="opacity-100 translate-y-0"
                     class="ml-11 mt-1 space-y-0.5 border-l border-white/[0.06] pl-3">
                    {% for category in serviceCategories.list %}
                        {%- set _mci = _nav_type_icons[category.type]|default({'color': 'text-indigo-400', 'icon': 'apps'}) -%}
                        {%- set mobileCatHref = (category.type == 'domain') ? ('/order/domain-tlds'|url) : (('/order/' ~ (category.title|lower|replace({' ': '-', '/': '-'})|trim('-')))|url) -%}
                    <a href="{{ mobileCatHref }}" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 nav-link">
                        <svg class="icon {{ _mci.color }} flex-shrink-0" style="width:0.875rem;height:0.875rem"><use href="#{{ _mci.icon }}" /></svg>
                        {{ category.title }}
                    </a>
                    {% else %}
                    <a href="{{ '/order'|url }}" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 nav-link">
                        <svg class="icon text-indigo-400 flex-shrink-0" style="width:0.875rem;height:0.875rem"><use href="#apps" /></svg>
                        All Plans
                    </a>
                    {% endfor %}
                    <a href="{{ '/order/domain-tlds'|url }}" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-indigo-400 hover:text-indigo-300 hover:bg-white/5">
                        <svg class="icon flex-shrink-0" style="width:0.875rem;height:0.875rem"><use href="#arrows-exchange" /></svg>
                        Transfer a Domain
                    </a>
                    <a href="{{ '/order'|url }}" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs text-gray-500 hover:text-gray-300 hover:bg-white/5">
                        Browse all products →
                    </a>
                </div>
            </div>

            <!-- Contact -->
            {% if settings.nav_contact_show|default('1') != '0' %}
            <a href="{{ (settings.nav_contact_url|default(settings.link_support|default('/support/contact')))|url }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 nav-link">
                <span class="w-8 h-8 rounded-lg bg-cyan-500/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                </span>
                {{ settings.nav_contact_label|default('Contact') }}
            </a>
            {% endif %}

            <!-- Support -->
            {% if settings.nav_support_show|default('1') != '0' %}
            <a href="{{ (settings.nav_support_url|default('/support'))|url }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 nav-link">
                <span class="w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                </span>
                {{ settings.nav_support_label|default('Support') }}
            </a>
            {% endif %}

            <!-- News -->
            {% if settings.nav_news_show|default('1') != '0' %}
            <a href="{{ (settings.nav_news_url|default('/news'))|url }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 nav-link">
                <span class="w-8 h-8 rounded-lg bg-violet-500/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                </span>
                {{ settings.nav_news_label|default('News') }}
            </a>
            {% endif %}

            <!-- Custom nav links -->
            {% if settings is not empty %}{% for n in [1,2,3,4] %}
            {% set cLabel  = attribute(settings, 'nav_custom' ~ n ~ '_label') %}
            {% set cUrl    = attribute(settings, 'nav_custom' ~ n ~ '_url') %}
            {% set cHasSub = attribute(settings, 'nav_custom' ~ n ~ '_has_sub') %}
            {% if cLabel %}
                {% if cHasSub == '1' %}
                <div>
                    <button @click="mSub === 'custom{{ n }}' ? mSub = '' : mSub = 'custom{{ n }}'"
                            class="w-full flex items-center justify-between gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 transition-all">
                        <span class="flex items-center gap-3">
                            <span class="w-8 h-8 rounded-lg bg-gray-500/10 flex items-center justify-center flex-shrink-0">
                                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                            </span>
                            {{ cLabel }}
                        </span>
                        <svg class="w-4 h-4 text-gray-500 transition-transform duration-200" :class="mSub === 'custom{{ n }}' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </button>
                    <div x-show="mSub === 'custom{{ n }}'"
                         x-transition:enter="transition ease-out duration-150"
                         x-transition:enter-start="opacity-0 -translate-y-1"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         class="ml-11 mt-1 space-y-0.5 border-l border-white/[0.06] pl-3">
                        {% for s in [1,2,3,4] %}
                        {% set sLabel = attribute(settings, 'nav_custom' ~ n ~ '_sub' ~ s ~ '_label') %}
                        {% set sUrl   = attribute(settings, 'nav_custom' ~ n ~ '_sub' ~ s ~ '_url') %}
                        {% if sLabel and sUrl %}
                        <a href="{{ sUrl|url }}" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 nav-link">
                            <span class="w-1.5 h-1.5 rounded-full bg-gray-400 flex-shrink-0"></span>
                            {{ sLabel }}
                        </a>
                        {% endif %}
                        {% endfor %}
                    </div>
                </div>
                {% elseif cUrl %}
                <a href="{{ cUrl|url }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 nav-link">
                    <span class="w-8 h-8 rounded-lg bg-gray-500/10 flex items-center justify-center flex-shrink-0">
                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                    </span>
                    {{ cLabel }}
                </a>
                {% endif %}
            {% endif %}
            {% endfor %}{% endif %}

            <!-- Contact -->
            {% if settings.nav_contact_show|default('1') != '0' %}
            <a href="{{ (settings.nav_contact_url|default(settings.link_support|default('/support/contact')))|url }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 nav-link">
                <span class="w-8 h-8 rounded-lg bg-cyan-500/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                </span>
                {{ settings.nav_contact_label|default('Contact') }}
            </a>
            {% endif %}

            <!-- Support -->
            {% if settings.nav_support_show|default('1') != '0' %}
            <a href="{{ (settings.nav_support_url|default('/support'))|url }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 nav-link">
                <span class="w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                </span>
                {{ settings.nav_support_label|default('Support') }}
            </a>
            {% endif %}

            <!-- News -->
            {% if settings.nav_news_show|default('1') != '0' %}
            <a href="{{ (settings.nav_news_url|default('/news'))|url }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 nav-link">
                <span class="w-8 h-8 rounded-lg bg-violet-500/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                </span>
                {{ settings.nav_news_label|default('News') }}
            </a>
            {% endif %}

            {# Mobile utilities: cart, currency, dark/light #}
            <div class="border-t border-white/[0.06] pt-2 mt-2 space-y-0.5">

                {# Notification row (logged-in clients) — invoice count loaded async #}
                {% if client %}
                {% set _mob_nn_list = _notif_news.list is defined ? _notif_news.list : [] %}
                <div x-data="{
                    mNotifOpen: false,
                    mLoaded:    false,
                    mCount:     0,
                    mInvoices:  [],
                    mToggle() {
                        this.mNotifOpen = !this.mNotifOpen;
                        if (this.mNotifOpen && !this.mLoaded) this.mLoad();
                    },
                    mLoad() {
                        var self = this;
                        FOSSBilling.api.client.get(
                            'invoice/get_list',
                            { status: 'unpaid', per_page: 5 },
                            function(d) {
                                self.mCount    = (d && d.total) ? parseInt(d.total, 10) : 0;
                                self.mInvoices = (d && d.list)  ? d.list : [];
                                self.mLoaded   = true;
                            },
                            function() { self.mLoaded = true; },
                            false
                        );
                    }
                }">
                    <button @click="mToggle()"
                            class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 transition-all">
                        <span class="relative w-8 h-8 rounded-lg bg-red-500/10 flex items-center justify-center flex-shrink-0">
                            <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 17h5l-1.4-1.4a2 2 0 01-.6-1.4V11a6 6 0 10-12 0v3.2c0 .5-.2 1-.6 1.4L4 17h5m6 0a3 3 0 11-6 0h6z"/>
                            </svg>
                            <span x-show="mCount > 0" x-text="mCount"
                                  class="absolute -top-0.5 -right-0.5 w-4 h-4 rounded-full bg-red-500 text-white text-[9px] font-bold flex items-center justify-center leading-none"></span>
                        </span>
                        <span>Notifications</span>
                        <span x-show="mCount > 0" x-text="mCount + ' unpaid'"
                              class="ml-auto text-xs font-bold px-2 py-0.5 rounded-full bg-red-500/10 text-red-400"></span>
                        <svg class="w-4 h-4 text-gray-500 transition-transform duration-200"
                             :class="{ 'rotate-180': mNotifOpen, 'ml-auto': mCount === 0 }"
                             fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div x-show="mNotifOpen"
                         x-transition:enter="transition ease-out duration-150"
                         x-transition:enter-start="opacity-0 -translate-y-1"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         class="ml-11 mt-0.5 space-y-0.5 border-l border-white/[0.06] pl-3">
                        {# Invoice rows — fetched async on first open #}
                        <template x-for="invoice in mInvoices.slice(0, 4)" :key="invoice.id">
                            <a :href="'{{ 'invoice'|url }}/' + invoice.hash"
                               class="flex items-center gap-2 px-3 py-2 rounded-lg text-xs text-amber-400 hover:text-amber-300 hover:bg-white/5 nav-link">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 flex-shrink-0"></span>
                                <span class="flex-1 truncate"
                                      x-text="'Invoice #' + invoice.serie + invoice.nr + ' — ' + invoice.currency + ' ' + parseFloat(invoice.total || 0).toFixed(2)"></span>
                            </a>
                        </template>
                        {# News rows — already server-side from layout, no extra cost #}
                        {% for post in _mob_nn_list|slice(0, 2) %}
                        <a href="{{ '/news'|url }}/{{ post.slug }}"
                           class="flex items-center gap-2 px-3 py-2 rounded-lg text-xs text-indigo-400 hover:text-indigo-300 hover:bg-white/5 nav-link">
                            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 flex-shrink-0"></span>
                            <span class="flex-1 truncate">{{ post.title }}</span>
                        </a>
                        {% endfor %}
                        {% if _mob_nn_list|length == 0 %}
                        <p x-show="mLoaded && mInvoices.length === 0"
                           class="px-3 py-2 text-xs text-gray-600">No notifications</p>
                        {% endif %}
                        <a href="{{ '/invoice'|url }}"
                           class="flex items-center gap-2 px-3 py-2 text-xs text-gray-500 hover:text-gray-300 hover:bg-white/5">
                            View all invoices →
                        </a>
                    </div>
                </div>
                {% endif %}

                {# Cart row #}
                <a href="{{ '/cart'|url }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 nav-link">
                    <span class="w-8 h-8 rounded-lg bg-amber-500/10 flex items-center justify-center flex-shrink-0">
                        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                    </span>
                    <span>Cart</span>
                    {% if cartCount > 0 %}
                    <span class="ml-auto text-xs font-bold px-2 py-0.5 rounded-full text-white" style="background: linear-gradient(135deg,var(--color-primary),var(--color-secondary));">{{ cartCount }}</span>
                    {% endif %}
                </a>

                {# Currency (guest only) #}
                {% if not client and currencies|length > 1 %}
                <div x-data="{ mCurrOpen: false }">
                    <button @click="mCurrOpen = !mCurrOpen"
                            class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 transition-all">
                        <span class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center flex-shrink-0">
                            <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </span>
                        <span>Currency</span>
                        <span class="ml-auto flex items-center gap-1.5 flex-shrink-0">
                            <span class="text-xs font-mono font-bold text-indigo-400">{{ currentCurrency.code }}</span>
                            <svg class="w-4 h-4 text-gray-500 transition-transform duration-200" :class="mCurrOpen ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                        </span>
                    </button>
                    <div x-show="mCurrOpen"
                         x-transition:enter="transition ease-out duration-150"
                         x-transition:enter-start="opacity-0 -translate-y-1"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         class="ml-11 mt-0.5 space-y-0.5 border-l border-white/[0.06] pl-3">
                        {% for code, title in currencies %}
                        <button type="button" data-set-currency="{{ code }}"
                                class="w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm transition-all text-left
                                       {{ currentCurrency.code == code ? 'text-indigo-400' : 'text-gray-400 hover:text-white hover:bg-white/5' }}">
                            <span class="font-mono font-bold text-xs w-8">{{ code }}</span>
                            <span>{{ title }}</span>
                            {% if currentCurrency.code == code %}
                                <svg class="w-3.5 h-3.5 ml-auto" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                            {% endif %}
                        </button>
                        {% endfor %}
                    </div>
                </div>
                {% elseif client and profile is defined and profile.currency %}
                <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300">
                    <span class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center flex-shrink-0">
                        <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </span>
                    <span>Currency</span>
                    <span class="ml-auto text-xs font-mono font-bold text-indigo-400">{{ currentCurrency.code }}</span>
                </div>
                {% endif %}

                {# Dark / Light mode toggle #}
                <button @click="darkMode = !darkMode"
                        class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 transition-all">
                    <span class="w-8 h-8 rounded-lg bg-gray-500/10 flex items-center justify-center flex-shrink-0">
                        <svg x-show="darkMode" class="w-4 h-4 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                        <svg x-show="!darkMode" class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                        </svg>
                    </span>
                    <span x-text="darkMode ? 'Switch to Light Mode' : 'Switch to Dark Mode'"></span>
                </button>

            </div>

            {# Mobile account #}
            <div class="border-t border-white/[0.06] pt-3 mt-3 space-y-1">
                {% if client %}
                    <div class="flex items-center gap-3 px-3 py-2">
                        <span class="w-8 h-8 rounded-full bg-indigo-500/20 flex items-center justify-center flex-shrink-0 text-xs font-bold text-indigo-300">{{ profile.first_name|slice(0,1)|upper }}</span>
                        <div>
                            <p class="text-xs font-semibold text-white">{{ profile.first_name }} {{ profile.last_name }}</p>
                            <p class="text-[11px] text-gray-500 truncate">{{ profile.email }}</p>
                        </div>
                    </div>
                    <a href="{{ '/dashboard'|url }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 nav-link">
                        <span class="w-8 h-8 rounded-lg bg-gray-500/10 flex items-center justify-center flex-shrink-0"><svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4"/></svg></span>
                        Dashboard
                    </a>
                    <a href="{{ 'order'|url }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 nav-link">
                        <span class="w-8 h-8 rounded-lg bg-gray-500/10 flex items-center justify-center flex-shrink-0"><svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg></span>
                        My Orders
                    </a>
                    <a href="{{ 'client/profile'|url }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 nav-link">
                        <span class="w-8 h-8 rounded-lg bg-gray-500/10 flex items-center justify-center flex-shrink-0"><svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg></span>
                        Profile Settings
                    </a>
                    <a href="{{ 'client/logout'|url }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-red-400 hover:text-red-300 hover:bg-white/5">
                        <span class="w-8 h-8 rounded-lg bg-red-500/10 flex items-center justify-center flex-shrink-0"><svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg></span>
                        Sign Out
                    </a>
                {% else %}
                    <a href="{{ 'login'|url }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-300 hover:text-white hover:bg-white/5 nav-link">
                        <span class="w-8 h-8 rounded-lg bg-gray-500/10 flex items-center justify-center flex-shrink-0"><svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></span>
                        Log in
                    </a>
                    <a href="{{ '/order'|url }}" class="block px-3 py-3 rounded-xl text-sm text-white font-semibold text-center btn-primary-gradient mt-1">Get Started</a>
                {% endif %}
            </div>
        </div>
    </nav>
</header>

<!-- Flash messages -->
{{ include('partial_message.html.twig') }}

<!-- Page content -->
<main id="main-content" class="flex-1">
    {% block content_before %}{% endblock %}
    {% block content %}{% endblock %}
</main>

<!-- ========== FOOTER ========== -->
{% if settings.footer_enabled|default('1') != '0' %}
<footer class="footer-bar border-t border-white/[0.06]" style="background: #030712;">

    <!-- Newsletter CTA strip -->
    <div class="border-b border-white/[0.06]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <h3 class="text-base font-semibold footer-heading">Stay in the loop</h3>
                    <p class="text-sm text-gray-500 mt-0.5">Get the latest deals, updates, and hosting tips from {{ company.name }}.</p>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    {% set _footerPhone = settings.footer_phone|default(company.tel|default('')) %}
                    {% if _footerPhone %}
                    <a href="tel:{{ _footerPhone }}" class="inline-flex items-center gap-2 btn-outline px-5 py-2.5 rounded-xl text-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                        {{ _footerPhone }}
                    </a>
                    {% endif %}
                    <a href="{{ (settings.link_support|default('/support/contact'))|url }}"
                       class="inline-flex items-center gap-2 btn-primary-gradient px-5 py-2.5 rounded-xl text-sm">
                        Contact Us
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main footer columns -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-8 lg:gap-12">

            <!-- Brand col -->
            <div class="col-span-2 md:col-span-1">
                <a href="{{ '/'|url }}" class="flex items-center mb-4">
                    <img src="{{ settings.logo_url|default(false) ?: 'branding/logo.svg'|public_asset_url }}" alt="{{ company.name }}" class="h-6 w-auto logo-img">
                </a>
                <p class="text-xs text-gray-500 leading-relaxed mb-5">{{ company.signature|default('') }}</p>
                <!-- Social icons -->
                <div class="flex items-center gap-2">
                    <a href="{{ settings.social_facebook|default('#') }}" aria-label="Facebook" class="w-8 h-8 rounded-lg bg-white/5 hover:bg-white/10 border border-white/[0.07] flex items-center justify-center transition-all group">
                        <svg class="w-3.5 h-3.5 text-gray-500 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
                        </svg>
                    </a>
                    <a href="{{ settings.social_twitter|default('#') }}" aria-label="Twitter / X" class="w-8 h-8 rounded-lg bg-white/5 hover:bg-white/10 border border-white/[0.07] flex items-center justify-center transition-all group">
                        <svg class="w-3.5 h-3.5 text-gray-500 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                        </svg>
                    </a>
                    <a href="{{ settings.social_instagram|default('#') }}" aria-label="Instagram" class="w-8 h-8 rounded-lg bg-white/5 hover:bg-white/10 border border-white/[0.07] flex items-center justify-center transition-all group">
                        <svg class="w-3.5 h-3.5 text-gray-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Services col -->
            <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider mb-4 footer-col-title">Services</h4>
                <ul class="space-y-2.5">
                    <li><a href="{{ '/order/server'|url }}" class="text-sm font-medium footer-link">VPS Hosting</a></li>
                    <li><a href="{{ '/order/server'|url }}" class="text-sm font-medium footer-link">Dedicated Servers</a></li>
                    <li><a href="{{ '/order'|url }}" class="text-sm font-medium footer-link">Cloud Servers</a></li>
                    <li><a href="{{ '/order'|url }}" class="text-sm font-medium footer-link">All Plans</a></li>
                </ul>
            </div>

            <!-- Account col -->
            <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider mb-4 footer-col-title">Account</h4>
                <ul class="space-y-2.5">
                    {% if client %}
                    <li><a href="{{ '/dashboard'|url }}" class="text-sm font-medium footer-link">Dashboard</a></li>
                    <li><a href="{{ 'order'|url }}" class="text-sm font-medium footer-link">My Orders</a></li>
                    <li><a href="{{ 'client/profile'|url }}" class="text-sm font-medium footer-link">Profile</a></li>
                    <li><a href="{{ '/invoice'|url }}" class="text-sm font-medium footer-link">Invoices</a></li>
                    {% else %}
                    <li><a href="{{ '/login'|url }}" class="text-sm font-medium footer-link">Login</a></li>
                    <li><a href="{{ '/signup'|url }}" class="text-sm font-medium footer-link">Sign Up</a></li>
                    <li><a href="{{ '/cart'|url }}" class="text-sm font-medium footer-link">Cart</a></li>
                    {% endif %}
                </ul>
            </div>

            <!-- Support col -->
            <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider mb-4 footer-col-title">Support</h4>
                <ul class="space-y-2.5">
                    <li><a href="{{ (settings.link_support|default('/support/contact'))|url }}" class="text-sm font-medium footer-link">Contact Us</a></li>
                    <li><a href="{{ '/support'|url }}" class="text-sm font-medium footer-link">Open a Ticket</a></li>
                    <li><a href="{{ '/support/kb'|url }}" class="text-sm font-medium footer-link">Knowledge Base</a></li>
                    <li><a href="{{ (settings.link_support|default('/support/contact'))|url }}" class="text-sm font-medium footer-link">Live Chat</a></li>
                </ul>
            </div>

            <!-- Contact col -->
            {% set _footerAddress = settings.footer_address|default(company.address_1|default('') ~ (company.address_2|default('') ? ', ' ~ company.address_2|default('')) ~ (company.address_3|default('') ? ', ' ~ company.address_3|default(''))) %}
            {% set _footerEmail   = settings.footer_email|default(company.email|default('')) %}
            <div class="col-span-2 md:col-span-1">
                <h4 class="text-xs font-semibold uppercase tracking-wider mb-4 footer-col-title">Contact</h4>
                <ul class="space-y-3">
