{% set tlds = guest.serviceDomain_tlds({ 'allow_register': 1 }) %}
{% set transfer_tlds = guest.serviceDomain_tlds({ 'allow_transfer': 1 }) %}

{% set allow_register = product.config.allow_domain_register ?? true %}
{% set allow_transfer = product.config.allow_domain_transfer ?? true %}
{% set allow_own = product.config.allow_domain_own ?? true %}
{% set allow_subdomain = product.config.allow_subdomain ?? false %}
{% set subdomain_base_domain = product.config.subdomain_base_domain ?? null %}

{% set can_register = allow_register and tlds is not empty %}
{% set can_transfer = allow_transfer and transfer_tlds is not empty %}
{% set can_own = allow_own %}
{% set can_subdomain = allow_subdomain and subdomain_base_domain %}
{% set default_action = can_register ? 'register' : (can_transfer ? 'transfer' : (can_own ? 'owndomain' : (can_subdomain ? 'subdomain' : ''))) %}
{% set currency = guest.cart_get_currency %}

{% if default_action %}

{# ══ Card 1 — Billing period (own card, recurrent products only) ══ #}
{% if _opf_enabled is defined and _opf_enabled|length > 0 %}
<div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6" id="period-card">

  {# ── Plan header row — icon + title + type (Stitch style) ── #}
  <div class="flex items-start justify-between mb-6">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 bg-slate-50 rounded-xl flex items-center justify-center flex-shrink-0">
        <svg class="w-6 h-6 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
      </div>
      <div>
        <h3 class="font-bold text-lg text-slate-900 leading-tight">{{ product.title }}</h3>
        <p class="text-sm text-slate-500 mt-0.5">{{ product.type == 'hosting' ? 'Hosting plan' : 'Subscription' }}</p>
      </div>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">

    {# Left: label + period select #}
    <div>
      <label class="block text-sm font-medium text-slate-500 mb-2">Period</label>
      {% if _opf_enabled|length > 1 %}
      <div class="relative inline-block">
        <select x-model="selectedPeriod" name="period"
                class="pl-4 pr-10 py-2.5 border-2 rounded-xl bg-white text-slate-900 text-sm font-semibold appearance-none focus:outline-none cursor-pointer"
                style="border-color:var(--color-primary);">
          {% for pk in _opf_enabled %}
          <option value="{{ pk }}">{{ _opf_pk_labels[pk] }}</option>
          {% endfor %}
        </select>
        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-slate-500">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </div>
      </div>
      {% else %}
      <input type="hidden" name="period" :value="selectedPeriod">
      <p class="text-sm font-semibold text-slate-900" x-text="getPeriodLabel(selectedPeriod)"></p>
      {% endif %}
    </div>

    {# Middle: savings badge #}
    <template x-if="getPeriodSavingsRaw(selectedPeriod) > 0">
      <span class="inline-block px-3 py-1.5 bg-green-100 text-green-700 text-sm font-bold rounded-lg self-start sm:self-center"
            x-text="'Save ' + formatMoney(getPeriodSavingsRaw(selectedPeriod))"></span>
    </template>

    {# Right: effective monthly price + strikethrough #}
    <div class="text-right" x-show="selectedPeriod">
      <div class="text-2xl font-bold text-slate-900 leading-tight">
        <span x-text="formatMoney(getPeriodMonthly(selectedPeriod))"></span><span class="text-sm font-normal text-slate-500"> /mo</span>
      </div>
      <template x-if="(periodMonthsMap[selectedPeriod] || 1) > 1 && productRawPrices['1M']">
        <div class="text-sm text-slate-400 line-through"
             x-text="formatMoney(productRawPrices['1M']) + '/mo'"></div>
      </template>
    </div>

  </div>

  {# Renewal text #}
  <p class="text-sm text-slate-500 mt-3" x-show="selectedPeriod && (productRawPrices[selectedPeriod] || 0) > 0">
    Renews at
    <span x-text="formatMoney(productRawPrices[selectedPeriod] || 0)"></span>
    <span x-text="getPeriodLabel(selectedPeriod).toLowerCase()"></span>. Cancel anytime.
  </p>

</div>
{% endif %}

<style>
  .domain-tab-active { background:#fff; box-shadow:0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.04); color:#0f172a; }
  .domain-tab-idle   { color:#64748b; }
  .domain-tab-idle:hover { background:rgba(255,255,255,.55); color:#334155; }
  /* Left-border divider used in the "Use Own Domain" TLD extension input */
  .dsg-divider { border-left:1px solid rgb(226 232 240); }
  /* Fallback for color-mix() on Safari <16.2 — action buttons inherit --color-primary at 65% opacity */
  .domain-action-btn { background:var(--color-primary); }
  @supports (background:color-mix(in srgb,red 1%,white)) {
    .domain-action-btn { background:color-mix(in srgb, var(--color-primary) 65%, white); }
  }
</style>

{# ══ Card 2 — Domain configuration ══ #}
<div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden" id="domain-config-card">

  {# Header — icon + title + subtitle, divided from the body #}
  <div class="flex items-center gap-4 px-6 py-4 border-b border-slate-100">
    <div class="domain-card-icon w-11 h-11 rounded-lg flex items-center justify-center flex-shrink-0"
         style="background:rgba(var(--color-primary-rgb),0.06); color:var(--color-primary);">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"
              d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
      </svg>
    </div>
    <div>
      <h3 class="text-base font-bold text-slate-900">Secure your domain</h3>
      <p class="text-sm text-slate-500">Get your domain right away and publish your website faster</p>
    </div>
  </div>

  <div class="p-6">

    {# Hidden domain action field — updated by JS on tab switch #}
    <input type="hidden" name="domain[action]" id="domain-action-input" value="{{ default_action }}">
    {% if can_subdomain %}
      <input type="hidden" name="domain[subdomain_base_domain]" value="{{ subdomain_base_domain }}">
    {% endif %}

    {# ── Mode tabs — segmented control (Stitch style) ── #}
    <div class="flex gap-1 p-1 bg-slate-100 border border-slate-200/60 rounded-xl mb-6">
      {% if can_register %}
      <button type="button"
              class="domain-tab flex-1 flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg text-sm font-semibold transition-all"
              data-mode="register" data-active="{{ default_action == 'register' ? 'true' : 'false' }}">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        <span>Register New</span>
      </button>
      {% endif %}
      {% if can_transfer %}
      <button type="button"
              class="domain-tab flex-1 flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg text-sm font-semibold transition-all"
              data-mode="transfer" data-active="{{ default_action == 'transfer' ? 'true' : 'false' }}">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
        </svg>
        <span>Transfer Domain</span>
      </button>
      {% endif %}
      {% if can_own %}
      <button type="button"
              class="domain-tab flex-1 flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg text-sm font-semibold transition-all"
              data-mode="owndomain" data-active="{{ default_action == 'owndomain' ? 'true' : 'false' }}">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
        </svg>
        <span>Use Own Domain</span>
      </button>
      {% endif %}
      {% if can_subdomain %}
      <button type="button"
              class="domain-tab flex-1 flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg text-sm font-semibold transition-all"
              data-mode="subdomain" data-active="{{ default_action == 'subdomain' ? 'true' : 'false' }}">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
        </svg>
        <span>Subdomain</span>
      </button>
      {% endif %}
    </div>

    {# ── Register panel — Stitch-exact search row ── #}
    <div id="domain-panel-register" class="space-y-4"
         style="{{ default_action != 'register' ? 'display:none' : '' }}">
      <label class="block text-sm font-medium text-slate-700">Domain name</label>

      {# Main search row: bordered input group + detached Check button #}
      <div class="flex items-stretch gap-3">
        <div class="domain-search-group relative flex-1 flex rounded-lg border border-slate-200 bg-white focus-within:border-slate-400 transition-colors">
          {# Search icon — absolute left #}
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
          {# Text input #}
          <input type="text" name="domain[register_sld]" id="register-sld"
                 value="{{ request.register_sld|default('') }}"
                 class="min-w-0 flex-1 pl-11 pr-3 py-3 bg-transparent border-0 text-slate-900 outline-none"
                 placeholder="yourdomain">
          {# TLD selector — right side, with its own chevron #}
          <div class="domain-tld-select relative flex items-center">
            <select name="domain[register_tld]" id="register-tld"
                    class="pl-3 pr-8 py-1 h-full text-sm font-semibold text-slate-700 bg-transparent appearance-none outline-none cursor-pointer border-0"
                    style="min-width:5.5rem;">
              {% for tld in tlds %}
                <option value="{{ tld.tld }}"
                        {% if request.register_tld is defined and request.register_tld == tld.tld %}selected{% endif %}>
                  {{ tld.tld }}
                </option>
              {% endfor %}
            </select>
            <div class="absolute inset-y-0 right-0 flex items-center pr-2.5 pointer-events-none text-slate-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
          </div>
        </div>
        {# Check button — detached, with search icon #}
        <button type="button" id="domain-check-btn"
                class="domain-action-btn flex items-center gap-2 text-white px-6 py-3 rounded-lg font-bold transition-all whitespace-nowrap hover:opacity-90 disabled:opacity-60">
          <svg data-action-spinner class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3"/>
            <path class="opacity-90" fill="currentColor" d="M12 3a9 9 0 00-9 9h3a6 6 0 016-6V3z"/>
          </svg>
          <svg data-action-icon class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <span id="domain-check-btn-label">Check</span>
        </button>
      </div>

      {# Years select — appears only after a successful availability check #}
      <div class="flex items-center gap-2" id="register-years-row" style="display:none;">
        <label class="text-xs text-slate-500">Registration period:</label>
        <select name="domain[register_years]" id="register-years-select"
                class="text-xs text-slate-600 border border-slate-200 rounded px-2 py-1 bg-white outline-none"
                style="width:auto;">
          <option value="1">1 year</option>
          <option value="2">2 years</option>
          <option value="3">3 years</option>
          <option value="4">4 years</option>
          <option value="5">5 years</option>
        </select>
      </div>

      {# Helper text — Stitch-exact with clock icon, Enter kbd, star mark #}
      <p class="text-xs text-slate-500 flex items-center gap-1">
        <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Type a name and press
        <kbd class="px-1.5 py-0.5 bg-slate-100 border border-slate-300 rounded text-[10px]">Enter</kbd>
        or click Check.
        <span class="text-orange-500 ml-1">★</span> marks free TLDs.
      </p>
    </div>

    {# ── Transfer panel ── #}
    <div id="domain-panel-transfer" class="space-y-4"
         style="{{ default_action != 'transfer' ? 'display:none' : '' }}">
      <label class="block text-sm font-medium text-slate-700">Domain name</label>
      <div class="flex items-stretch gap-3">
        <div class="domain-search-group relative flex-1 flex rounded-lg border border-slate-200 bg-white focus-within:border-slate-400 transition-colors">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
            </svg>
          </div>
          <input type="text" name="domain[transfer_sld]" id="transfer-sld"
                 value="{{ request.transfer_sld|default('') }}"
                 class="min-w-0 flex-1 pl-11 pr-3 py-3 bg-transparent border-0 text-slate-900 outline-none"
                 placeholder="yourdomain">
          <div class="domain-tld-select relative flex items-center">
            <select name="domain[transfer_tld]" id="transfer-tld"
                    class="pl-3 pr-8 py-1 h-full text-sm font-semibold text-slate-700 bg-transparent appearance-none outline-none cursor-pointer border-0"
                    style="min-width:5.5rem;">
              {% for tld in transfer_tlds %}
                <option value="{{ tld.tld }}"
                        {% if request.transfer_tld is defined and request.transfer_tld == tld.tld %}selected{% endif %}>
                  {{ tld.tld }}
                </option>
              {% endfor %}
            </select>
            <div class="absolute inset-y-0 right-0 flex items-center pr-2.5 pointer-events-none text-slate-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
          </div>
        </div>
        <button type="button" id="transfer-check-btn"
                class="domain-action-btn flex items-center gap-2 text-white px-6 py-3 rounded-lg font-bold transition-all whitespace-nowrap hover:opacity-90 disabled:opacity-60">
          <svg data-action-spinner class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3"/>
            <path class="opacity-90" fill="currentColor" d="M12 3a9 9 0 00-9 9h3a6 6 0 016-6V3z"/>
          </svg>
          <svg data-action-icon class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <span id="transfer-check-btn-label">Check</span>
        </button>
      </div>
      <div id="transfer-price-row" style="display:none;" class="text-sm text-slate-700">
        Transfer price: <strong id="transfer-price-value" style="color:var(--color-primary);"></strong>
      </div>

      {# EPP / Auth code — stored on the domain service and handed to the registrar
         (Servicedomain sets it via setEpp on the transfer). Optional server-side,
         but the transfer stalls at the registrar without it, so collect it here. #}
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">EPP / Auth code</label>
        <input type="text" name="domain[transfer_code]" id="transfer-code"
               value="{{ request.transfer_code|default('') }}"
               autocomplete="off" spellcheck="false"
               class="w-full rounded-lg border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none focus:border-slate-400 transition-colors"
               placeholder="e.g. Ab3#Xy9!kL2…">
        <p class="text-xs text-slate-500 mt-1.5">The authorization code (also called EPP code or transfer key) from your current registrar. Case-sensitive — you can find it in your registrar's control panel.</p>
      </div>
    </div>

    {# ── Own domain panel ── #}
    <div id="domain-panel-owndomain" class="space-y-4"
         style="{{ default_action != 'owndomain' ? 'display:none' : '' }}">
      <label class="block text-sm font-medium text-slate-700">Domain name</label>
      <div class="own-domain-entry flex items-stretch gap-3">
        <div class="domain-search-group own-domain-input-group relative flex-1 flex h-12 rounded-lg border border-slate-200 bg-white overflow-hidden focus-within:border-slate-400 transition-colors">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 21a9 9 0 100-18 9 9 0 000 18zm0 0c2.1-2.4 3.2-5.4 3.2-9S14.1 5.4 12 3m0 18c-2.1-2.4-3.2-5.4-3.2-9S9.9 5.4 12 3M3 12h18"/>
            </svg>
          </div>
          <input type="text" name="domain[owndomain_sld]" id="owndomain-sld"
                 value="{{ request.owndomain_sld|default('') }}"
                 class="min-w-0 flex-1 pl-11 pr-3 h-full bg-transparent border-0 text-slate-900 outline-none"
                 placeholder="yourdomain">
          <input type="text" name="domain[owndomain_tld]" id="owndomain-tld"
                 value="{{ request.owndomain_tld|default('.com') }}"
                 aria-label="Domain extension"
                 autocomplete="off"
                 spellcheck="false"
                 class="domain-tld-input flex-none px-3 text-sm font-semibold outline-none"
                 style="color:var(--color-primary);"
                 placeholder=".com">
        </div>
        {# Use button — confirms the domain, mirrors the Check button pattern #}
        <button type="button" id="owndomain-use-btn"
                class="domain-action-btn flex items-center gap-2 text-white px-6 py-3 rounded-lg font-bold transition-all whitespace-nowrap hover:opacity-90 disabled:opacity-60">
          <svg data-action-spinner class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3"/>
            <path class="opacity-90" fill="currentColor" d="M12 3a9 9 0 00-9 9h3a6 6 0 016-6V3z"/>
          </svg>
          <svg data-action-icon class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
          <span id="owndomain-use-btn-label">Use</span>
        </button>
      </div>
      <p class="text-xs text-slate-500">You will need to update your nameservers to point to our servers after ordering.</p>
    </div>

    {# ── Subdomain panel ── #}
    {% if can_subdomain %}
    <div id="domain-panel-subdomain" class="space-y-4"
         style="{{ default_action != 'subdomain' ? 'display:none' : '' }}">
      <label class="block text-sm font-medium text-slate-700">Choose your free subdomain</label>
      <div class="domain-search-group flex h-12 rounded-lg border border-slate-200 bg-white overflow-hidden focus-within:border-slate-400 transition-colors">
        <input type="text" name="domain[subdomain_sld]" id="subdomain-sld"
               value="{{ request.subdomain_sld|default('') }}"
               class="min-w-0 flex-1 bg-transparent px-4 h-full text-slate-900 outline-none"
               placeholder="name">
        <span class="flex items-center border-l border-slate-200 bg-slate-50 px-3 text-sm font-semibold whitespace-nowrap"
              style="color:var(--color-primary);">.{{ subdomain_base_domain|trim('.') }}</span>
      </div>
    </div>
    {% endif %}

    {# ── Availability result ── #}
    <div id="domain-availability-msg" style="display:none;"
         class="rounded-xl border px-4 py-3 text-sm font-medium mt-4"></div>

  </div>
</div>

<script>
(function () {
    var card = document.getElementById('domain-config-card');
    if (!card) return;

    var actionInput = document.getElementById('domain-action-input');
    var tabs        = card.querySelectorAll('.domain-tab');
    var availMsg    = document.getElementById('domain-availability-msg');
    var transferPriceRow = document.getElementById('transfer-price-row');

    // ── Tab styling — Stitch: bg-brand-50 text-brand-700 border-brand-200 for active ──
    function refreshTabStyles() {
        tabs.forEach(function (tab) {
            var active = tab.dataset.active === 'true';
            tab.classList.toggle('domain-tab-active', active);
            tab.classList.toggle('domain-tab-idle', !active);
        });
    }

    function switchMode(mode) {
        if (actionInput) actionInput.value = mode;

        card.querySelectorAll('[id^="domain-panel-"]').forEach(function (panel) {
            panel.style.display = 'none';
        });
        var active = document.getElementById('domain-panel-' + mode);
        if (active) active.style.display = '';

        tabs.forEach(function (tab) {
            tab.dataset.active = (tab.dataset.mode === mode) ? 'true' : 'false';
        });
        refreshTabStyles();

        showAvailability(null, '');
        if (transferPriceRow) transferPriceRow.style.display = 'none';
        document.dispatchEvent(new CustomEvent('domainSelected', { detail: { domain: '' } }));
        document.dispatchEvent(new CustomEvent('domainPriceUpdated', { detail: { rawPrice: 0 } }));
    }

    refreshTabStyles();
    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () { switchMode(tab.dataset.mode); });
    });

    // ── Currency ──
    var currencyCode = '{{ currency.code|default('USD')|escape('js') }}';
    var currencyRate = {{ currency.conversion_rate|default(1) }};

    function formatPrice(amount) {
        return new Intl.NumberFormat(undefined, {
            style: 'currency', currency: currencyCode, currencyDisplay: 'narrowSymbol'
        }).format(parseFloat(amount) * currencyRate);
    }

    // ── Availability banner ──
    function showAvailability(available, message) {
        if (!availMsg) return;
        if (!message) { availMsg.style.display = 'none'; availMsg.textContent = ''; return; }
        availMsg.textContent = message;
        availMsg.style.display = '';
        availMsg.className = 'rounded-xl border px-4 py-3 text-sm font-medium mt-4 ' + (
            available
                ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
                : 'border-red-200 bg-red-50 text-red-600'
        );
    }

    function clearDomainSelection() {
        document.dispatchEvent(new CustomEvent('domainSelected', { detail: { domain: '' } }));
        document.dispatchEvent(new CustomEvent('domainPriceUpdated', { detail: { rawPrice: 0 } }));
    }

    function setDomainActionState(button, labelElement, label, state) {
        if (!button) return;
        if (labelElement) labelElement.textContent = label;
        button.disabled = state === 'loading';
        button.classList.toggle('is-loading', state === 'loading');
        button.classList.toggle('is-success', state === 'success');
        var spinner = button.querySelector('[data-action-spinner]');
        var icon = button.querySelector('[data-action-icon]');
        if (spinner) spinner.classList.toggle('hidden', state !== 'loading');
        if (icon) icon.classList.toggle('hidden', state === 'loading');
        button.setAttribute('aria-busy', state === 'loading' ? 'true' : 'false');
    }

    // ── Register check ──
    var registerBtn      = document.getElementById('domain-check-btn');
    var registerBtnLabel = document.getElementById('domain-check-btn-label');
    var registerSld      = document.getElementById('register-sld');
    var registerTld      = document.getElementById('register-tld');
    var registerYears    = document.getElementById('register-years-select');
    var registerYearsRow = document.getElementById('register-years-row');
    var registerBasePrice = 0;
    var registerRenewPrice = 0;

    function setRegisterBtn(label, disabled) {
        setDomainActionState(registerBtn, registerBtnLabel, label, disabled ? 'loading' : 'idle');
    }

    function resetYearOptions() {
        if (registerYearsRow) registerYearsRow.style.display = 'none';
        if (!registerYears) return;
        registerYears.innerHTML = '';
        for (var i = 1; i <= 5; i++) {
            registerYears.append(new Option(i + (i === 1 ? ' year' : ' years'), i));
        }
    }

    if (registerSld) {
        registerSld.addEventListener('input', function () { showAvailability(null, ''); resetYearOptions(); clearDomainSelection(); setDomainActionState(registerBtn, registerBtnLabel, 'Check', 'idle'); });
        registerSld.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') { e.preventDefault(); if (registerBtn) registerBtn.click(); }
        });
    }
    if (registerTld) registerTld.addEventListener('change', function () { showAvailability(null, ''); resetYearOptions(); clearDomainSelection(); setDomainActionState(registerBtn, registerBtnLabel, 'Check', 'idle'); });
    if (registerYears) registerYears.addEventListener('change', function () {
        var years = Math.max(1, parseInt(registerYears.value, 10) || 1);
        var total = registerBasePrice + Math.max(0, years - 1) * registerRenewPrice;
        document.dispatchEvent(new CustomEvent('domainPriceUpdated', { detail: { rawPrice: total } }));
    });

    if (registerBtn) {
        registerBtn.addEventListener('click', function () {
            var sld = registerSld ? registerSld.value.trim().toLowerCase() : '';
            var tld = registerTld ? registerTld.value : '.com';
            if (!sld) return;

            setRegisterBtn('Checking…', true);
            showAvailability(null, '');

            FOSSBilling.api.guest.post('servicedomain/check', { sld: sld, tld: tld },
                function () {
                    showAvailability(true, sld + tld + ' is available.');
                    document.dispatchEvent(new CustomEvent('domainSelected', { detail: { domain: sld + tld } }));

                    FOSSBilling.api.guest.post('servicedomain/pricing', { tld: tld },
                        function (result) {
                            if (!registerYears) return;
                            registerYears.innerHTML = '';
                            var regPrice   = Number(result.price_registration);
                            var renewPrice = Number(result.price_renew);
                            if (!result.price_renew || isNaN(renewPrice)) renewPrice = regPrice;
                            registerBasePrice = regPrice;
                            registerRenewPrice = renewPrice;
                            for (var i = 1; i <= 5; i++) {
                                var total = (i === 1) ? regPrice : regPrice + (i - 1) * renewPrice;
                                registerYears.append(new Option(i + (i === 1 ? ' year @ ' : ' years @ ') + formatPrice(total), i));
                            }
                            if (registerYearsRow) registerYearsRow.style.display = '';
                            document.dispatchEvent(new CustomEvent('domainPriceUpdated', { detail: { rawPrice: regPrice } }));
                            setDomainActionState(registerBtn, registerBtnLabel, 'Available', 'success');
                        },
                        function () {
                            setDomainActionState(registerBtn, registerBtnLabel, 'Available', 'success');
                        }
                    );
                },
                function (error) {
                    // Show the actual reason from the API — a taken domain, a registrar
                    // outage/misconfig ("could not be determined"), or a rate limit are
                    // different situations and must not all read as "not available".
                    setRegisterBtn('Check', false);
                    showAvailability(false, (error && error.message) ? error.message : 'This domain is not available.');
                    clearDomainSelection();
                }
            );
        });
    }

    // ── Transfer check ──
    var transferBtn      = document.getElementById('transfer-check-btn');
    var transferBtnLabel = document.getElementById('transfer-check-btn-label');
    var transferSld      = document.getElementById('transfer-sld');
    var transferTld      = document.getElementById('transfer-tld');
    var transferPriceVal = document.getElementById('transfer-price-value');

    function setTransferBtn(label, disabled) {
        setDomainActionState(transferBtn, transferBtnLabel, label, disabled ? 'loading' : 'idle');
    }

    if (transferSld) transferSld.addEventListener('input', function () {
        showAvailability(null, '');
        if (transferPriceRow) transferPriceRow.style.display = 'none';
        clearDomainSelection();
        setDomainActionState(transferBtn, transferBtnLabel, 'Check', 'idle');
    });
    if (transferTld) transferTld.addEventListener('change', function () {
        showAvailability(null, '');
        if (transferPriceRow) transferPriceRow.style.display = 'none';
        clearDomainSelection();
        setDomainActionState(transferBtn, transferBtnLabel, 'Check', 'idle');
    });

    if (transferBtn) {
        transferBtn.addEventListener('click', function () {
            var sld = transferSld ? transferSld.value.trim().toLowerCase() : '';
            var tld = transferTld ? transferTld.value : '.com';
            if (!sld) return;

            setTransferBtn('Checking…', true);
            showAvailability(null, '');

            FOSSBilling.api.guest.post('servicedomain/can_be_transferred', { sld: sld, tld: tld },
                function () {
                    showAvailability(true, sld + tld + ' can be transferred.');
                    document.dispatchEvent(new CustomEvent('domainSelected', { detail: { domain: sld + tld } }));

                    FOSSBilling.api.guest.post('servicedomain/pricing', { tld: tld },
                        function (result) {
                            if (result.price_transfer && transferPriceVal && transferPriceRow) {
                                transferPriceVal.textContent = formatPrice(result.price_transfer);
                                transferPriceRow.style.display = '';
                                document.dispatchEvent(new CustomEvent('domainPriceUpdated', { detail: { rawPrice: result.price_transfer } }));
                            }
                            setDomainActionState(transferBtn, transferBtnLabel, 'Transferable', 'success');
                        },
                        function () {
                            setDomainActionState(transferBtn, transferBtnLabel, 'Transferable', 'success');
                        }
                    );
                },
                function (error) {
                    // Surface the real reason (ineligible, registrar unreachable, rate limit)
                    // instead of always claiming the domain cannot be transferred.
                    setTransferBtn('Check', false);
                    showAvailability(false, (error && error.message) ? error.message : 'This domain cannot be transferred.');
                    clearDomainSelection();
                }
            );
        });
    }

    // ── Own domain: Use button ──
    var ownBtn = document.getElementById('owndomain-use-btn');
    var ownBtnLabel = document.getElementById('owndomain-use-btn-label');
    var ownSld = document.getElementById('owndomain-sld');
    var ownTld = document.getElementById('owndomain-tld');

    function clearOwnSelection() {
        showAvailability(null, '');
        clearDomainSelection();
        setDomainActionState(ownBtn, ownBtnLabel, 'Use', 'idle');
    }

    if (ownSld) ownSld.addEventListener('input', clearOwnSelection);
    if (ownTld) ownTld.addEventListener('input', clearOwnSelection);
    if (ownSld) ownSld.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); if (ownBtn) ownBtn.click(); }
    });

    if (ownBtn) {
        ownBtn.addEventListener('click', function () {
            var sld = ownSld ? ownSld.value.trim().toLowerCase() : '';
            var tld = ownTld ? ownTld.value.trim().toLowerCase() : '';

            // Accept a full domain typed into the name field (e.g. "mybusiness.com")
            if (sld.indexOf('.') > 0) {
                var dot = sld.indexOf('.');
                tld = sld.slice(dot);
                sld = sld.slice(0, dot);
                if (ownSld) ownSld.value = sld;
                if (ownTld) ownTld.value = tld;
            }

            if (!sld) {
                showAvailability(false, 'Please enter your domain name.');
                return;
            }
            if (!tld || tld.charAt(0) !== '.' || tld.length < 2) {
                showAvailability(false, 'Please enter the domain extension with a leading dot, e.g. .com');
                return;
            }
            if (!/^[a-z0-9]([a-z0-9-]*[a-z0-9])?$/.test(sld)) {
                showAvailability(false, 'The domain name contains invalid characters.');
                return;
            }

            setDomainActionState(ownBtn, ownBtnLabel, 'Using…', 'loading');
            window.setTimeout(function () {
                showAvailability(true, sld + tld + ' will be used with this order.');
                document.dispatchEvent(new CustomEvent('domainSelected', { detail: { domain: sld + tld } }));
                document.dispatchEvent(new CustomEvent('domainPriceUpdated', { detail: { rawPrice: 0 } }));
                setDomainActionState(ownBtn, ownBtnLabel, 'Used', 'success');
            }, 260);
        });
    }

    // ── Free subdomain: update the summary as the value changes ──
    var subdomainSld = document.getElementById('subdomain-sld');
    if (subdomainSld) {
        subdomainSld.addEventListener('input', function () {
            var sld = subdomainSld.value.trim().toLowerCase();
            if (/^[a-z0-9]([a-z0-9-]*[a-z0-9])?$/.test(sld)) {
                document.dispatchEvent(new CustomEvent('domainSelected', {
                    detail: { domain: sld + '.{{ subdomain_base_domain|default('')|trim('.')|escape('js') }}' }
                }));
                document.dispatchEvent(new CustomEvent('domainPriceUpdated', { detail: { rawPrice: 0 } }));
            } else {
                clearDomainSelection();
            }
        });
    }

}());
</script>
{% endif %}
