{# ═══════════════════════════════════════════════════════════════════════════
   Shared orderProduct() Alpine component — single source of truth.

   Superset of every order page's needs: period helpers, addon carousel,
   domain price listener, coupon validation, add-to-cart with domain +
   formbuilder field collection.

   Usage (product must be set in the including template's context):
       {% include 'partial_order_product_component.html.twig' %}
       <div x-data="orderProduct({{ product.id }}, '{{ first_period }}')"> …

   Must be included INSIDE the content block, BEFORE the x-data element,
   because Alpine (deferred in <head>) boots right after DOM parse.
═══════════════════════════════════════════════════════════════════════════ #}
{% if product %}
{% set _op_currency = guest.cart_get_currency %}
<script>
function orderProduct(productId, defaultPeriod) {
    return {
        productId: productId,
        selectedPeriod: defaultPeriod || null,
        loading: false,
        errorMsg: null,
        domainInCart: false,
        itemAdded: false,
        addons: {},
        addonIndex: 0,
        addonCount: {{ product.addons|length }},

        // Coupon state
        couponDiscount: 0,
        couponOpen: false,
        couponCode: '',
        couponLoading: false,
        couponError: null,
        couponApplied: false,
        promoType: null,
        promoValue: 0,
        promoPeriods: [],

        // Period metadata
        periodMonthsMap: { '1W': 0.25, '1M': 1, '3M': 3, '6M': 6, '1Y': 12, '2Y': 24, '3Y': 36 },
        periodLabelMap: { '1W': 'Every week', '1M': 'Monthly', '3M': 'Quarterly', '6M': 'Every 6 months', '1Y': 'Every year', '2Y': 'Every 2 years', '3Y': 'Every 3 years' },
        periodLabels: { '1W': 'Weekly', '1M': 'Monthly', '3M': '3-Month', '6M': '6-Month', '1Y': 'Annual', '2Y': '2-Year', '3Y': '3-Year' },
        addonPeriodLabels: { '1W': 'week', '1M': 'mo', '3M': 'qtr', '6M': '6mo', '1Y': 'yr', '2Y': '2yr', '3Y': '3yr' },

        // Twig-injected pricing data
        addonPrices: {
            {% for addon in product.addons %}{% if addon.pricing.type == 'recurrent' %}
            '{{ addon.id }}': { {% set _pf = true %}{% for code, prices in addon.pricing.recurrent %}{% if prices.enabled %}{% if not _pf %}, {% endif %}'{{ code }}': '{{ prices.price|money_convert }}'{% set _pf = false %}{% endif %}{% endfor %} },
            {% endif %}{% endfor %}
        },
        addonPricingTypes: { {% for addon in product.addons %}'{{ addon.id }}': '{{ addon.pricing.type }}', {% endfor %} },
        addonRawPrices: {
            {% for addon in product.addons %}{% if addon.pricing.type == 'recurrent' %}
            '{{ addon.id }}': { {% set _rf = true %}{% for code, prices in addon.pricing.recurrent %}{% if prices.enabled %}{% if not _rf %}, {% endif %}'{{ code }}': {{ prices.price|default(0) }}{% set _rf = false %}{% endif %}{% endfor %} },
            {% endif %}{% endfor %}
        },
        addonOnceRawPrices: { {% for addon in product.addons %}{% if addon.pricing.type == 'once' %}'{{ addon.id }}': {{ addon.pricing.once.price|default(0) }}, {% endif %}{% endfor %} },
        productRawPrices: {
            {% if product.pricing.type == 'recurrent' %}{% for code, prices in product.pricing.recurrent %}{% if prices.enabled %}'{{ code }}': {{ prices.price|default(0) }}, {% endif %}{% endfor %}{% endif %}
        },
        productOnceRawPrice: {% if product.pricing.type == 'once' %}{{ product.pricing.once.price|default(0) }}{% else %}0{% endif %},
        domainRawPrice: 0,
        domainName: '',
        srvFieldPrices: {},
        srvFieldLabels: {},
        srvFieldSelections: {},
        {# Order pages show pre-tax totals — VAT is added on /order/checkout only #}
        taxRate: 0,

        formatMoney(rawPrice) {
            return Alpine.store('fbCurrency').formatMoney(rawPrice);
        },

        getPeriodMonthly(p) {
            const m = this.periodMonthsMap[p] || 1;
            return m > 0 ? (this.productRawPrices[p] || 0) / m : (this.productRawPrices[p] || 0);
        },
        getPeriodSavingsRaw(p) {
            const base = this.productRawPrices['1M'] || 0;
            if (!base || !p) return 0;
            const m = this.periodMonthsMap[p] || 1;
            if (m <= 1) return 0;
            return Math.max(0, base * m - (this.productRawPrices[p] || 0));
        },
        getPeriodLabel(p) {
            return this.periodLabelMap[p] || p || '';
        },
        resolveAddonPeriod(id, requestedPeriod) {
            const prices = this.addonRawPrices[String(id)] || {};
            const enabled = Object.keys(prices);
            if (!enabled.length) return requestedPeriod || '';
            if (requestedPeriod && enabled.includes(requestedPeriod)) return requestedPeriod;

            const requestedMonths = this.periodMonthsMap[requestedPeriod] || 0;
            const ranked = enabled
                .map(period => ({ period, months: this.periodMonthsMap[period] || 0 }))
                .filter(item => !requestedMonths || item.months <= requestedMonths)
                .sort((a, b) => b.months - a.months);

            return ranked.length ? ranked[0].period : enabled[0];
        },
        getAddonPeriod(id) {
            const key = String(id);
            return this.addons[key] && this.addons[key].period
                ? this.addons[key].period
                : this.resolveAddonPeriod(key, this.selectedPeriod || '');
        },
        getAddonRawPrice(id) {
            const key = String(id);
            const period = this.getAddonPeriod(key);
            return this.addonRawPrices[key] && this.addonRawPrices[key][period] !== undefined
                ? this.addonRawPrices[key][period]
                : null;
        },
        getAddonDisplayPrice(id) {
            const key = String(id);
            const type = this.addonPricingTypes[key];
            if (type === 'free') return 'Free';
            if (type === 'once') {
                const price = Number(this.addonOnceRawPrices[key]);
                return Number.isFinite(price) ? this.formatMoney(price) : 'Unavailable';
            }
            const rawPrice = this.getAddonRawPrice(key);
            if (rawPrice === null || rawPrice === undefined || rawPrice === '') return 'Unavailable';
            const price = Number(rawPrice);
            return Number.isFinite(price) ? this.formatMoney(price) : 'Unavailable';
        },
        getAddonPeriodLabel(id) {
            const period = this.getAddonPeriod(id);
            return this.periodLabels[period] || period || 'Recurring';
        },
        getOriginalTotal(period) {
            if (!period) return '';
            const base = this.productRawPrices['1M'] || 0;
            if (!base) return '';
            const m = this.periodMonthsMap[period] || 1;
            if (m <= 1) return '';
            const raw = base * m + this.domainRawPrice;
            const withTax = this.taxRate > 0 ? raw * (1 + this.taxRate / 100) : raw;
            return this.formatMoney(Math.round(withTax * 100) / 100);
        },

        calcTotal(period) {
            if (!period) return '';
            let base = 0;
            if (period === 'once') { base = this.productOnceRawPrice; }
            else if (period === 'free') { base = 0; }
            else if (this.productRawPrices[period] !== undefined) { base = this.productRawPrices[period]; }
            base += this.domainRawPrice;
            // Server option surcharges are tracked separately from the discountable
            // base: the backend applies PERCENTAGE promos to the product base price
            // only (Product::getProductDiscount uses getProductPrice, which excludes
            // server-option surcharges added later in Cart::cartProductToApiArray).
            // Keeping them out of the percentage base keeps the previewed discount
            // aligned with what checkout actually charges.
            let serverSurcharge = 0;
            if (period !== 'once' && period !== 'free') {
                const months = this.periodMonthsMap[period] || 1;
                Object.values(this.srvFieldPrices).forEach(p => { serverSurcharge += (parseFloat(p) || 0) * months; });
            }
            base += serverSurcharge;
            Object.entries(this.addons).forEach(([id, state]) => {
                if (!state.selected) return;
                const type = this.addonPricingTypes[id];
                if (type === 'recurrent') {
                    const ap = state.period || period;
                    if (this.addonRawPrices[id] && this.addonRawPrices[id][ap] !== undefined) base += this.addonRawPrices[id][ap];
                } else if (type === 'once' && this.addonOnceRawPrices[id] !== undefined) {
                    base += this.addonOnceRawPrices[id];
                }
            });
            let discount = 0;
            if (this.couponApplied && this.promoType && base > 0) {
                const periodOk = this.promoPeriods.length === 0 || period === 'once' || this.promoPeriods.includes(period);
                if (periodOk) {
                    if (this.promoType === 'percentage') {
                        // Percentage applies to the base excluding server surcharges (backend parity).
                        const pctBase = Math.max(0, base - serverSurcharge);
                        discount = Math.round(pctBase * this.promoValue / 100 * 100) / 100;
                    } else if (this.promoType === 'absolute') {
                        // Absolute value is capped at the full line subtotal, matching the
                        // backend cap in Cart::cartProductToApiArray.
                        discount = Math.min(this.promoValue, base);
                    }
                }
            }
            this.couponDiscount = discount;
            const afterDiscount = Math.max(0, base - discount);
            const withTax = this.taxRate > 0 ? afterDiscount * (1 + this.taxRate / 100) : afterDiscount;
            return this.formatMoney(Math.round(withTax * 100) / 100);
        },

        prevAddon() { if (this.addonIndex > 0) this.addonIndex--; },
        nextAddon() { if (this.addonIndex < this.addonCount - 1) this.addonIndex++; },

        init() {
            if (!this.selectedPeriod) {
                const el = this.$el.querySelector('select[name="period"], input[name="period"]');
                if (el && el.value) this.selectedPeriod = el.value;
                else {
                    const keys = Object.keys(this.productRawPrices);
                    if (keys.length) this.selectedPeriod = keys[0];
                }
            }
            const addonIds = Object.keys(this.addonPricingTypes);
            addonIds.forEach(id => {
                if (!this.addons[id]) this.addons[id] = { selected: false, period: this.resolveAddonPeriod(id, this.selectedPeriod || '') };
            });
            this.$watch('selectedPeriod', v => {
                addonIds.forEach(id => {
                    if (this.addons[id]) this.addons[id].period = this.resolveAddonPeriod(id, v || '');
                });
            });
            document.addEventListener('domainPriceUpdated', e => {
                this.domainRawPrice = parseFloat(e.detail.rawPrice) || 0;
            });
            document.addEventListener('domainSelected', e => {
                this.domainName = (e.detail && e.detail.domain) || '';
            });
            document.addEventListener('srvFieldPriceUpdated', e => {
                if (!e.detail.fieldId) return;
                const fieldId = e.detail.fieldId;
                this.srvFieldPrices = { ...this.srvFieldPrices, [fieldId]: parseFloat(e.detail.monthlyPrice) || 0 };
                if (e.detail.fieldLabel) this.srvFieldLabels = { ...this.srvFieldLabels, [fieldId]: e.detail.fieldLabel };
                const nextSelections = { ...this.srvFieldSelections };
                if (e.detail.optionValue) {
                    nextSelections[fieldId] = {
                        id: fieldId,
                        label: e.detail.fieldLabel || fieldId,
                        value: e.detail.optionValue,
                        optionLabel: e.detail.optionLabel || e.detail.optionValue,
                        price: parseFloat(e.detail.monthlyPrice) || 0,
                    };
                } else {
                    delete nextSelections[fieldId];
                }
                this.srvFieldSelections = nextSelections;
            });
        },

        applyCoupon() {
            const code = this.couponCode.trim();
            if (!code || this.couponLoading || this.couponApplied) return;
            this.couponLoading = true;
            this.couponError = null;
            API.guest.post('cart/validate_promo', { promocode: code, product_id: this.productId, period: this.selectedPeriod || '' },
                (promo) => {
                    this.couponLoading = false;
                    this.couponApplied = true;
                    this.promoType    = promo.type    || null;
                    this.promoValue   = promo.value   || 0;
                    this.promoPeriods = promo.periods || [];
                },
                (err) => {
                    this.couponLoading = false;
                    this.couponApplied = false;
                    this.couponError = (err && err.message) || 'Invalid promo code.';
                }
            );
        },

        toggleAddon(addonId, pricingType) {
            const key = String(addonId);
            if (!this.addons[key]) {
                let addonPeriod = '';
                if (pricingType === 'recurrent' || this.addonPricingTypes[key] === 'recurrent') {
                    addonPeriod = this.resolveAddonPeriod(key, this.selectedPeriod || '');
                }
                this.addons[key] = { selected: false, period: addonPeriod };
            }
            this.addons[key].selected = !this.addons[key].selected;
        },

        addToCart(period) {
            if (!period) return;
            // The line is already in the cart (e.g. a promo apply failed after a
            // successful add). A second CTA click should continue to checkout
            // rather than add a duplicate line.
            if (this.itemAdded) { window.location.href = '{{ "/order/checkout"|url }}'; return; }
            this.loading = true;
            this.errorMsg = null;
            this.domainInCart = false;

            const data = { id: this.productId, multiple: 1 };
            if (period !== 'once' && period !== 'free') data.period = period;

            // Domain fields (hosting order form) — build nested domain:{} object.
            // JSON transport means PHP won't expand "domain[action]" bracket notation.
            // Search the domain card directly (by stable ID) rather than this.$el
            // to avoid any Alpine scope / $el quirks on nested x-data pages.
            const _domainRoot = document.getElementById('domain-config-card') || this.$el;
            const domainData = {};
            _domainRoot.querySelectorAll('input[name^="domain["], select[name^="domain["]').forEach(el => {
                if (el.type === 'radio' && !el.checked) return;
                const match = el.name.match(/^domain\[([^\]]+)\]$/);
                if (match) domainData[match[1]] = el.value;
            });
            // Also pick up the hidden action input (may be outside the card on some page layouts)
            if (!domainData.action) {
                const actionEl = document.getElementById('domain-action-input');
                if (actionEl) domainData.action = actionEl.value;
            }
            if (Object.keys(domainData).length > 0) data.domain = domainData;

            // Formbuilder fields if present
            const fbSection = this.$refs.formbuilderSection;
            if (fbSection) {
                fbSection.querySelectorAll('input[name], select[name], textarea[name]').forEach(el => {
                    if (el.name === 'form_id' || el.name === 'id') {
                        data[el.name] = el.value;
                    } else if (el.type === 'checkbox') {
                        if (!data[el.name]) data[el.name] = [];
                        if (el.checked) data[el.name].push(el.value);
                    } else if (el.type === 'radio') {
                        if (el.checked) data[el.name] = el.value;
                    } else {
                        data[el.name] = el.value;
                    }
                });
                const required = fbSection.querySelectorAll('[required]');
                for (const el of required) {
                    if (!el.value || !el.value.trim()) {
                        this.loading = false;
                        this.errorMsg = 'Please fill in all required fields.';
                        el.focus();
                        return;
                    }
                }
            }

            // Native server option fields configured under Serviceserver settings.
            // JSON API payloads must use a nested config object; bracket notation is
            // not expanded server-side as it would be in a regular HTML form post.
            const serverConfig = {};

            // The parent order component owns the authoritative selection
            // state. Hidden inputs live inside nested Alpine components and
            // their bound DOM value can still be stale when the CTA is clicked.
            Object.entries(this.srvFieldSelections || {}).forEach(([fieldId, selection]) => {
                const value = String((selection && selection.value) || '').trim();
                if (value) serverConfig[fieldId] = value;
            });

            // Retain a DOM fallback for custom templates that emit native
            // server-option inputs without dispatching selection events.
            const serverOptionInputs = this.$el.querySelectorAll('[data-server-option][name^="config["]');
            for (const el of serverOptionInputs) {
                const match = el.name.match(/^config\[([^\]]+)\]$/);
                if (!match) continue;
                const value = serverConfig[match[1]] || String(el.value || '').trim();
                if (el.dataset.required === 'true' && !value) {
                    this.loading = false;
                    this.errorMsg = `Please select ${String(el.dataset.label || 'a required server option').toLowerCase()}.`;
                    const section = el.closest('.ord-srv-option-card');
                    if (section) {
                        section.classList.add('ord-srv-required-error');
                        section.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        window.setTimeout(() => section.classList.remove('ord-srv-required-error'), 1800);
                    }
                    return;
                }
                if (value) serverConfig[match[1]] = value;
            }
            if (Object.keys(serverConfig).length > 0) {
                // Keep the namespaced payload for custom consumers and mirror
                // each value to FOSSBilling's native top-level cart config.
                data.config = serverConfig;
                Object.entries(serverConfig).forEach(([fieldId, value]) => {
                    data[fieldId] = value;
                });
            }

            // Selected add-ons — recurrent ones always need a valid period
            const addonPayload = {};
            let hasAddons = false;
            let addonPeriodError = false;
            Object.entries(this.addons).forEach(([id, state]) => {
                addonPayload[id] = { selected: state.selected };
                if (state.selected) {
                    if (this.addonPricingTypes[id] === 'recurrent') {
                        let ap = state.period;
                        if (!ap) {
                            const ep = this.addonPrices[id] ? Object.keys(this.addonPrices[id]) : [];
                            ap = (period && ep.includes(period)) ? period : (ep[0] || '');
                        }
                        if (!ap) { addonPeriodError = true; return; }
                        addonPayload[id].period = ap;
                    } else if (state.period) {
                        addonPayload[id].period = state.period;
                    }
                }
                hasAddons = true;
            });
            if (addonPeriodError) {
                this.loading = false;
                this.errorMsg = 'Selected add-on has no valid billing period. Please deselect it or contact support.';
                return;
            }
            if (hasAddons) data.addons = addonPayload;

            const goCheckout = () => { window.location.href = '{{ "/order/checkout"|url }}'; };

            API.guest.post('cart/add_item', data,
                () => {
                    document.dispatchEvent(new CustomEvent('stablepanel:cartUpdated'));
                    // The line is now in the cart; guard against a duplicate add if the
                    // user clicks the CTA again after the promo notification below.
                    this.itemAdded = true;
                    if (this.couponApplied && this.couponCode.trim()) {
                        API.guest.post('cart/apply_promo', { promocode: this.couponCode.trim() },
                            goCheckout,
                            (error) => {
                                // The promo passed pre-validation but was rejected at apply
                                // time (expired, usage limit reached, or no longer valid for
                                // this product). Notify instead of silently dropping the
                                // discount and sending the user to checkout.
                                this.loading = false;
                                const msg = (error && error.message) || 'This promo code could not be applied.';
                                this.couponApplied = false;
                                this.couponDiscount = 0;
                                this.promoType = null;
                                this.promoValue = 0;
                                this.promoPeriods = [];
                                this.couponError = msg;
                                this.errorMsg = 'Added to your cart, but the promo code was not applied: ' + msg + ' You can continue to checkout to proceed without it.';
                            }
                        );
                    } else {
                        goCheckout();
                    }
                },
                (error) => {
                    this.loading = false;
                    const msg = (error && error.message) || 'Failed to add to cart. Please try again.';
                    this.errorMsg = msg;
                    this.domainInCart = /already in the cart/i.test(msg);
                }
            );
        }
    };
}

// Register the shared currency store on alpine:init — the bundle is deferred, so Alpine
// isn't available when this inline script executes. alpine:init fires inside Alpine.start()
// before any x-data component is initialized, so the store is ready for all components.
document.addEventListener('alpine:init', () => {
    if (Alpine.store('fbCurrency')) return;
    Alpine.store('fbCurrency', {
        rate: {{ _op_currency.conversion_rate|default(1) }},
        code: {{ _op_currency.code|default('USD')|json_encode|raw }},
        priceFormat: {{ _op_currency.price_format|default(2)|json_encode|raw }},
        format: {{ (_op_currency.symbol|default(_op_currency.code|default('')) ~ '__PRICE__')|json_encode|raw }},
        formatMoney(rawPrice) {
            const numericPrice = Number(rawPrice);
            if (!Number.isFinite(numericPrice)) return '';
            const p = numericPrice * this.rate;
            const tpl = this.format;
            if (tpl && tpl.includes('__PRICE__')) {
                const fmt = parseInt(this.priceFormat);
                let s;
                const th = (str, sep) => str.replace(/\B(?=(\d{3})+(?!\d))/g, sep);
                if (fmt === 1) { s = p.toFixed(2); }
                else if (fmt === 3) { const pts = p.toFixed(2).split('.'); pts[0] = th(pts[0], '.'); s = pts.join(','); }
                else if (fmt === 4) { s = th(Math.round(p).toString(), ','); }
                else if (fmt === 5) { s = Math.round(p).toString(); }
                else { const pts = p.toFixed(2).split('.'); pts[0] = th(pts[0], ','); s = pts.join('.'); }
                return tpl.replace('__PRICE__', s);
            }
            return new Intl.NumberFormat(undefined, {
                style: 'currency', currency: this.code, currencyDisplay: 'narrowSymbol',
            }).format(p);
        }
    });
});
</script>
{% endif %}
