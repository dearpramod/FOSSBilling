{# ── Payment Options — enabled gateways from System Configuration ──
   Self-contained (sets its own currency) so it can be included from any order
   template. Uses the same filter + ordering as /order/checkout so the methods
   previewed here match exactly what the client is offered at payment. #}
{% set _po_currency = guest.cart_get_currency %}
{% set _po_all = guest.invoice_gateways %}
{% set _po_gateways = [] %}
{% for gtw in _po_all %}
    {% if gtw.code != 'ClientBalance' and _po_currency.code in gtw.accepted_currencies %}
        {% set _po_gateways = _po_gateways|merge([gtw]) %}
    {% endif %}
{% endfor %}
{% set _po_order = ['Khalti', 'Esewa', 'QRPayment', 'BankTransfer'] %}
{% set _po_ordered = [] %}
{% for code in _po_order %}
    {% for gtw in _po_gateways %}
        {% if gtw.code == code or (code == 'Esewa' and 'esewa' in gtw.title|lower) %}
            {% set _po_ordered = _po_ordered|merge([gtw]) %}
        {% endif %}
    {% endfor %}
{% endfor %}
{% for gtw in _po_gateways %}
    {% set _po_found = false %}
    {% for og in _po_ordered %}{% if og.id == gtw.id %}{% set _po_found = true %}{% endif %}{% endfor %}
    {% if not _po_found %}{% set _po_ordered = _po_ordered|merge([gtw]) %}{% endif %}
{% endfor %}

{% if _po_ordered|length > 0 %}
<div class="bg-white rounded-2xl border border-slate-100 shadow-lg p-6 mt-4">
    <div class="flex items-center gap-2 mb-4">
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
        </svg>
        <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Payment Options</h2>
    </div>
    <div class="grid grid-cols-2 gap-2">
        {% for gtw in _po_ordered %}
        <div class="flex items-center gap-2 px-3 py-2.5 rounded-xl border border-slate-100 bg-slate-50">
            {% if gtw.code == 'Khalti' %}
            <svg class="w-4 h-4 text-purple-500 flex-shrink-0" viewBox="0 0 240 240" fill="currentColor"><g transform="translate(0,240) scale(0.1,-0.1)"><path d="M1755 1961 c-27 -11 -298 -105 -601 -210 -304 -104 -567 -197 -585 -206 -99 -50 -133 -130 -88 -205 46 -74 140 -125 324 -173 l90 -24 125 104 c171 143 382 284 486 323 40 15 28 4 -36 -35 -85 -52 -226 -163 -292 -231 -65 -68 -138 -170 -138 -193 0 -9 24 -29 57 -46 168 -88 282 -269 299 -476 5 -51 11 -78 18 -76 26 9 74 90 105 178 18 52 121 335 228 629 208 572 211 586 165 633 -28 28 -96 31 -157 8z"/><path d="M784 841 c-53 -24 -109 -91 -123 -148 -35 -136 73 -273 214 -273 100 0 192 73 215 171 32 134 -75 269 -215 269 -27 0 -68 -9 -91 -19z"/></g></svg>
            {% elseif 'esewa' in gtw.title|lower %}
            <svg class="w-4 h-4 text-green-600 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="21.5" fill="none"/><path fill="none" d="M32.69 27.75a7.91 7.91 0 0 1-5.1 6.12h0a7.94 7.94 0 0 1-10.16-4.74l-1.76-4.84a7.94 7.94 0 0 1 4.74-10.16h0a7.94 7.94 0 0 1 10.16 4.74l.88 2.42l-14.9 5.42M45.5 24h-8"/></svg>
            {% elseif gtw.code == 'QRPayment' or 'qr' in gtw.title|lower %}
            <svg class="w-4 h-4 text-sky-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h7v7H3V3zm11 0h7v7h-7V3zM3 14h7v7H3v-7zm14 3h3m-3 3h3m-6-6h3v3h-3v-3zm3 3h3v3h-3v-3z"/></svg>
            {% elseif gtw.code == 'BankTransfer' or 'bank' in gtw.title|lower %}
            <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M3 10h18"/><path d="M12 3l9 7H3l9-7z"/><path d="M5 10v8"/><path d="M9 10v8"/><path d="M15 10v8"/><path d="M19 10v8"/></svg>
            {% else %}
            <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
            {% endif %}
            <span class="text-xs font-semibold text-slate-700 truncate">{{ gtw.title }}</span>
        </div>
        {% endfor %}
    </div>
    <p class="text-xs text-slate-400 mt-3">Choose your preferred method at checkout.</p>
</div>
{% endif %}
