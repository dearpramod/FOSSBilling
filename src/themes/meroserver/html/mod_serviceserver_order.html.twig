[data-theme="dark"] .ord-os-tab-off:hover { border-color: rgba(255,255,255,.25); color: #f1f5f9; }
.ord-os-tab-on { border-color: var(--color-primary); color: var(--color-primary); background: rgba(var(--color-primary-rgb),.1); }
.ord-os-card { width: 100%; min-height: 4rem; display: flex; align-items: center; gap: .7rem; padding: .65rem .8rem; border-radius: .75rem; border: 1px solid; cursor: pointer; transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease, transform .15s ease; min-width: 0; text-align: left; font: inherit; }
.ord-os-card-off { border-color: rgba(0,0,0,.09); background: transparent; }
.ord-os-card-off:hover { border-color: #cbd5e1; background: #f8fafc; transform: translateY(-1px); }
.ord-os-card:focus-visible { outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb),.12); }
[data-theme="dark"] .ord-os-card-off { border-color: rgba(255,255,255,.08); }
[data-theme="dark"] .ord-os-card-off:hover { border-color: rgba(255,255,255,.18); background: rgba(255,255,255,.04); }
.ord-os-card-on { border-color: var(--color-primary); background: rgba(var(--color-primary-rgb),.035); }
.ord-os-avatar { width: 2rem; height: 2rem; border-radius: .5rem; display: flex; align-items: center; justify-content: center; font-size: .82rem; font-weight: 700; flex-shrink: 0; }
.ord-os-avatar-off { background: rgba(0,0,0,.06); color: #475569; }
.ord-os-avatar-on  { background: rgba(var(--color-primary-rgb),.15); color: var(--color-primary); }
[data-theme="dark"] .ord-os-avatar-off { background: rgba(255,255,255,.08); color: #94a3b8; }
.ord-os-logo {
  width: 2.35rem;
  height: 2.35rem;
  display: grid;
  place-items: center;
  border-radius: .65rem;
  background: #f8fafc;
  color: #64748b;
  border: 1px solid #e2e8f0;
  transition: color .15s ease, background-color .15s ease, border-color .15s ease;
}
.ord-os-logo svg { grid-area: 1 / 1; width: 1.35rem; height: 1.35rem; stroke-width: 1.75; }
.ord-os-card-on .ord-os-logo {
  color: var(--color-primary);
  background: rgba(var(--color-primary-rgb),.07);
  border-color: rgba(var(--color-primary-rgb),.2);
}
.ord-os-price-paid { color: #475569; }
.ord-os-price-included { color: #64748b; }
.ord-os-card-on .ord-os-price-paid,
.ord-os-card-on .ord-os-price-included { color: var(--color-primary); }
[data-theme="dark"] .ord-os-logo {
  background: rgba(255,255,255,.06);
  border-color: rgba(255,255,255,.1);
  color: #94a3b8;
}
[data-theme="dark"] .ord-os-card-on .ord-os-logo {
  color: var(--color-primary);
  background: rgba(var(--color-primary-rgb),.12);
  border-color: rgba(var(--color-primary-rgb),.28);
}
[data-theme="dark"] .ord-os-price-paid,
[data-theme="dark"] .ord-os-price-included { color: #94a3b8; }
[data-theme="dark"] .ord-os-card-on .ord-os-price-paid,
[data-theme="dark"] .ord-os-card-on .ord-os-price-included { color: var(--color-primary); }
.ord-os-more {
  min-height: 2.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .4rem;
  width: 100%;
  margin-top: .75rem;
  border: 1px solid #e2e8f0;
  border-radius: .7rem;
  color: var(--color-primary);
  background: #fff;
  font-size: .75rem;
  font-weight: 700;
  transition: border-color .16s ease, background-color .16s ease, box-shadow .16s ease;
}
.ord-os-more:hover { border-color: rgba(var(--color-primary-rgb),.32); background: rgba(var(--color-primary-rgb),.025); }
.ord-os-more:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb),.12); }
.ord-os-more svg { width: 1rem; height: 1rem; stroke-width: 2; transition: transform .2s ease; }
[data-theme="dark"] .ord-os-more { color: #a5b4fc; background: rgba(255,255,255,.025); border-color: rgba(255,255,255,.1); }
.ord-os-search { border-color: rgba(0,0,0,.12); }
.ord-os-search:focus { border-color: var(--color-primary); }
[data-theme="dark"] .ord-os-search { border-color: rgba(255,255,255,.12); }
</style>
<script>
(function () {
    var revEls = document.querySelectorAll('.reveal-up, .reveal-left, .reveal-right');
    var revObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
            if (e.isIntersecting) { e.target.classList.add('visible'); revObs.unobserve(e.target); }
        });
    }, { threshold: 0.1 });
    revEls.forEach(function(el) { revObs.observe(el); });

    var bars = document.querySelectorAll('.perf-bar');
    if (bars.length) {
        var barObs = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) {
                    var w = e.target.getAttribute('data-width');
                    e.target.style.transition = 'width 1.1s cubic-bezier(0.16,1,0.3,1)';
                    e.target.style.width = w;
                    barObs.unobserve(e.target);
                }
            });
        }, { threshold: 0.3 });
        bars.forEach(function(b) { barObs.observe(b); });
    }

    var uptimeBars = document.querySelectorAll('.uptime-bar');
    if (uptimeBars.length) {
        var uObs = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) {
                    uptimeBars.forEach(function(b) { b.style.opacity = '1'; b.style.transform = 'scaleY(1)'; });
                    uObs.disconnect();
                }
            });
        }, { threshold: 0.2 });
        if (uptimeBars[0]) uObs.observe(uptimeBars[0]);
    }

    function runCounter(el, target, ms) {
        var start = performance.now();
        (function tick(now) {
            var p = Math.min((now - start) / ms, 1);
            var eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.floor(eased * target).toLocaleString();
            if (p < 1) requestAnimationFrame(tick);
            else el.textContent = target.toLocaleString();
        })(start);
    }

    var counters = document.querySelectorAll('.counter');
    if (counters.length) {
        var cObs = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) {
                    runCounter(e.target, parseInt(e.target.dataset.target, 10), 1400);
                    cObs.unobserve(e.target);
                }
            });
        }, { threshold: 0.4 });
        counters.forEach(function(c) { cObs.observe(c); });
    }
}());
</script>

{% endblock %}
