{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{# ── Pre-fetch category data so meta_title can use it (skipped on single-product pages) ── #}
{% set currency = guest.cart_get_currency %}
{% if not request.product %}
{% set all_categories = guest.product_category_get_list({'per_page': 100}) %}
{% set currency_fmt_js = currency.symbol|default(currency.code|default('')) ~ '__PRICE__' %}

{# ── Determine which categories to show (used in both hero and product grid) ── #}
{% set matched = [] %}
{% for cat in all_categories.list %}
    {% if 'server' in cat.title|lower or 'vps' in cat.title|lower or 'dedicated' in cat.title|lower or 'cloud' in cat.title|lower %}
        {% set matched = matched|merge([cat]) %}
    {% endif %}
{% endfor %}
{% set show_categories = matched|length > 0 ? matched : all_categories.list %}
{% set _hero_cat = show_categories|length > 0 ? show_categories|first : null %}

{# ── Parse hero content from category description ── #}
{# Format: > quoted → badge span | # H1 → title | paragraph → p | * item / - item → li #}
{% set _tagline = '' %}
{% set _title = '' %}
{% set _paragraphs = [] %}
{% set _bullets = [] %}
{% if _hero_cat and _hero_cat.description %}
    {% set _lines = _hero_cat.description|split('\n') %}
    {% for _line in _lines %}
        {% set _line = _line|trim %}
        {% if _line starts with '> ' %}
            {% set _tagline = _line[2:]|trim %}
        {% elseif _line starts with '# ' %}
            {% set _title = _line[2:]|trim %}
        {% elseif _line starts with '## ' %}
            {# skip level-2 headings #}
        {% elseif _line starts with '* ' or _line starts with '- ' %}
            {% set _bullets = _bullets|merge([_line[2:]|trim]) %}
        {% elseif _line %}
            {% set _paragraphs = _paragraphs|merge([_line]) %}
        {% endif %}
    {% endfor %}
{% endif %}
{% endif %}

{% block meta_title %}{% if settings.category_title_in_tab|default('1') != '0' and _hero_cat and _hero_cat.title %}{{ _hero_cat.title }}{% else %}Server Plans{% endif %}{% endblock %}
{% block page_header %}Servers{% endblock %}

{% block content %}

{# ── If a specific product is selected, show its order form ── #}
{# product may come from the controller (slug route) or from ?product=ID query param #}
{% if product is not defined and request.product %}
{% set product = guest.product_get({'id': request.product}) %}
{% endif %}
{% if product is defined and product %}
{% set pricing = product.pricing %}
{% set periods = guest.system_periods %}
{% set first_period = '' %}
{% if pricing.type == 'recurrent' %}{% for code, prices in pricing.recurrent %}{% if first_period == '' and prices.enabled %}{% set first_period = code %}{% endif %}{% endfor %}{% endif %}
{# Build base monthly price for savings calculation #}
{% set _base_mo_price = 0 %}
{% if pricing.type == 'recurrent' and pricing.recurrent['1M'] is defined and pricing.recurrent['1M'].enabled %}{% set _base_mo_price = pricing.recurrent['1M'].price %}{% endif %}
{% set _period_months = {'1W': 0.25, '1M': 1, '3M': 3, '6M': 6, '1Y': 12, '2Y': 24, '3Y': 36} %}

<div class="ord-srv-detail">
    <a href="{{ '/order/vps'|url }}" class="ord-srv-back-link inline-flex items-center gap-1.5 text-sm transition-colors mb-4">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Back to Server Plans
    </a>
    <div class="ord-srv-product-head flex items-start gap-3 mb-6">
        <span class="ord-srv-product-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/>
                <path d="M7 7h.01M7 17h.01M11 7h6M11 17h6"/>
            </svg>
        </span>
        <div>
            <div class="flex items-center gap-2.5 flex-wrap">
                <h1 class="text-2xl font-bold text-slate-900 ord-srv-heading">{{ product.title }}</h1>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide"
                      style="background:rgba(var(--color-primary-rgb),0.10);color:var(--color-primary);">
                    {{ pricing.type == 'recurrent' ? 'VPS hosting' : (pricing.type == 'once' ? 'One-time server' : 'Free server') }}
                </span>
            </div>
            <p class="ord-srv-muted text-sm mt-1">Review your plan, choose available server options, and continue securely.</p>
        </div>
    </div>
    <nav class="ord-srv-progress mb-6" aria-label="Order configuration progress">
        <span class="ord-srv-progress-item is-active"><b>1</b><span>Plan & billing</span></span>
        <span class="ord-srv-progress-line" aria-hidden="true"></span>
        <span class="ord-srv-progress-item"><b>2</b><span>Server options</span></span>
        <span class="ord-srv-progress-line" aria-hidden="true"></span>
        <span class="ord-srv-progress-item"><b>3</b><span>Review</span></span>
    </nav>

    {# Optional per-product or shared order form override.
       Filenames are hardcoded — product.type is NOT interpolated to prevent path injection
       if the product row were ever tampered. Check per-product first, then fall back to type. #}
    {% set _tpl_product = 'mod_serviceserver_order_form_' ~ product.id ~ '.html.twig' %}
    {% set _tpl_type    = 'mod_serviceserver_order_form.html.twig' %}
    {% set _resolved_tpl = null %}
    {% if product.type == 'server' %}
        {% if guest.system_template_exists({ 'file': _tpl_product }) %}
            {% set _resolved_tpl = _tpl_product %}
        {% elseif guest.system_template_exists({ 'file': _tpl_type }) %}
            {% set _resolved_tpl = _tpl_type %}
        {% endif %}
    {% endif %}
    {% if _resolved_tpl %}
        {{ include(_resolved_tpl) }}
    {% else %}

    {% include 'partial_order_product_component.html.twig' %}

    {# ══ Two-column Stitch layout ══ #}
    <div x-data="orderProduct({{ product.id }}, '{{ first_period }}')" class="ord-srv-layout">

        {# ═══ LEFT COLUMN ═══ #}
        <div class="ord-srv-main">

            {# ── Compact reference-style plan and billing card ── #}
            {% if pricing.type == 'recurrent' %}
            {% set _period_keys = [] %}
            {% for code, prices in pricing.recurrent %}{% if prices.enabled %}{% set _period_keys = _period_keys|merge([code]) %}{% endif %}{% endfor %}
            <section class="ord-srv-pricing-card bg-white rounded-2xl border border-slate-200/70 p-6" aria-labelledby="server-plan-heading">
                <div class="ord-srv-plan-row">
                    <span class="ord-srv-plan-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 8.5A4.5 4.5 0 019.5 4a4.5 4.5 0 014.24 3H15a4 4 0 010 8H7a4 4 0 01-2-7.46"/><path d="M8 12h8M10 15h4"/></svg>
                    </span>
                    <div>
                        <h2 id="server-plan-heading" class="text-base font-bold ord-srv-heading">Plan & billing</h2>
                        <p class="text-xs ord-srv-muted mt-0.5">{{ product.title }} · Virtual private server</p>
                    </div>
                </div>

                <div class="ord-srv-period-control">
                    <div class="ord-srv-period-field">
                        <label for="server-billing-period" class="block text-sm font-semibold ord-srv-heading mb-2">Billing period</label>
                        <div class="ord-srv-select-wrap">
                            <select id="server-billing-period"
                                    name="billing_period"
                                    x-model="selectedPeriod"
                                    class="ord-srv-period-select">
                                {% for code, prices in pricing.recurrent %}{% if prices.enabled %}
                                <option value="{{ code }}">{{ periods[code] ?? code }}</option>
                                {% endif %}{% endfor %}
                            </select>
                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m7 10 5 5 5-5"/></svg>
                        </div>
                    </div>
                    <div class="ord-srv-period-cost">
                        <span x-show="getPeriodSavingsRaw(selectedPeriod) > 0" x-cloak class="ord-srv-save-pill"
                              x-text="'Save ' + formatMoney(getPeriodSavingsRaw(selectedPeriod))"></span>
                        <div>
                            <strong x-text="formatMoney(getPeriodMonthly(selectedPeriod))"></strong><span>/mo</span>
                        </div>
                        <p x-show="getOriginalTotal(selectedPeriod)" x-cloak>
                            <s x-text="getOriginalTotal(selectedPeriod)"></s>
                        </p>
                    </div>
                </div>
                <p class="ord-srv-renewal-note">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 12a8 8 0 10-2.34 5.66M20 12v-5m0 5h-5"/></svg>
                    Total due today is shown in your summary. You can manage renewal from your dashboard.
                </p>
                <div class="ord-srv-included-note">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m5 12 4 4L19 6"/></svg>
                    Secure provisioning and account management are included with your server.
                </div>
            </section>
            {% elseif pricing.type == 'once' %}
            <div class="ord-srv-section-card flex items-center justify-between">
                <span class="text-sm ord-srv-muted">One-time payment</span>
                <span class="text-2xl font-bold ord-srv-heading">{{ pricing.once.price|money_convert }}</span>
            </div>
            {% elseif pricing.type == 'free' %}
            <div class="ord-srv-section-card flex items-center justify-between">
                <span class="text-sm ord-srv-muted">Free plan</span>
                <span class="text-2xl font-bold text-emerald-500">{{ 0|money_convert }}</span>
            </div>
            {% endif %}

            {# ── Server option pickers — fields configured in admin Settings › Server Options ── #}
            {# NOTE: |json_encode inside x-data="" (HTML attribute) is safe; browser decodes HTML entities before Alpine. #}
            {% set _srv_fields = guest.serviceserver_options_get %}
            {% for field in _srv_fields %}
            {% if field.options is defined and field.options is not empty %}
            {% set is_location_field = 'location' in field.id|lower or 'location' in field.label|lower or 'datacenter' in field.label|lower %}

            {% if field.display is defined and field.display == 'card-grid' %}
            {# ── Card-grid picker: OS / app tiles with category tab filter ── #}
            <section class="ord-srv-section-card-divided ord-srv-option-card">
                <div class="flex items-center gap-3 ord-srv-section-hd">
                    <span class="p-2 ord-srv-icon-wrap rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--color-primary);">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/>
                        </svg>
                    </span>
                    <div class="flex-1">
                        <h4 class="text-sm font-bold ord-srv-heading">{{ field.label }}</h4>
                        {% if field.description is defined and field.description %}
                        <p class="ord-srv-dimmed text-xs mt-0.5">{{ field.description }}</p>
                        {% endif %}
                    </div>
                    {% if not (field.required is defined and field.required) %}
                    <span class="flex-shrink-0 text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-md" style="background:rgba(0,0,0,.05);color:#64748b;">Optional</span>
                    {% endif %}
                </div>
                <div class="p-5"
                     x-data="{
                         search: '',
                         tab: '',
                         selected: null,
                         expanded: false,
                         opts: {{ field.options|json_encode }},
                         tabs() {
                             const seen = new Set(), result = [];
                             this.opts.forEach(o => { const g = o.group || ''; if (!seen.has(g)) { seen.add(g); result.push(g); } });
                             return result;
                         },
                         filtered() {
                             const q = this.search.toLowerCase();
                             return this.opts.filter(o => {
                                 const matchTab = !this.tab || (o.group || '') === this.tab;
                                 const matchSearch = !q || o.label.toLowerCase().includes(q) || (o.meta || '').toLowerCase().includes(q);
                                 return matchTab && matchSearch;
                             });
                         },
                         osKey(label) {
                             const value = String(label || '').toLowerCase();
                             if (value.includes('ubuntu')) return 'ubuntu';
                             if (value.includes('debian')) return 'debian';
                             if (value.includes('alma')) return 'alma';
                             if (value.includes('rocky')) return 'rocky';
                             if (value.includes('centos')) return 'centos';
                             if (value.includes('alpine')) return 'alpine';
                             if (value.includes('arch')) return 'arch';
                             if (value.includes('fedora')) return 'fedora';
                             return 'linux';
                         },
                         select(opt) { this.selected = this.selected && this.selected.value === opt.value ? null : opt; }
                     }"
                     x-init="$watch('selected', v => {
                         document.dispatchEvent(new CustomEvent('srvFieldPriceUpdated', {
                             detail: {
                                 fieldId: '{{ field.id }}',
                                 fieldLabel: '{{ field.label|e('js') }}',
                                 optionValue: v ? v.value : '',
                                 optionLabel: v ? v.label : '',
                                 monthlyPrice: v ? (parseFloat(v.price_monthly) || 0) : 0
                             }
                         }));
                     }); $watch('tab', () => expanded = false)">
                    <div class="relative mb-3">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 ord-srv-dimmed pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                        <input type="text" x-model="search"
                               placeholder="Search {{ field.label|lower }}…"
                               autocomplete="off"
                               class="ord-os-search w-full pl-9 pr-3 py-2 text-sm rounded-xl border bg-transparent outline-none ord-srv-heading">
                    </div>
                    <div class="flex flex-wrap gap-1.5 mb-4">
                        <button type="button" @click="tab = ''"
                                :class="tab === '' ? 'ord-os-tab-on' : 'ord-os-tab-off'"
                                class="ord-os-tab">All</button>
                        <template x-for="t in tabs()" :key="t">
                            <button type="button" @click="tab = t"
                                    :class="tab === t ? 'ord-os-tab-on' : 'ord-os-tab-off'"
                                    class="ord-os-tab" x-text="t"></button>
                        </template>
                    </div>
                    <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                        <template x-for="(opt, optionIndex) in filtered()" :key="opt.value">
                            <button type="button"
                                 x-show="expanded || search || optionIndex < 6"
                                 x-transition:enter="transition ease-out duration-200"
                                 x-transition:enter-start="opacity-0 translate-y-1 scale-[.98]"
                                 x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                                 x-transition:leave="transition ease-in duration-150"
                                 x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                                 x-transition:leave-end="opacity-0 -translate-y-1 scale-[.98]"
                                 @click="select(opt)"
                                 class="ord-os-card"
                                 :class="selected && selected.value === opt.value ? 'ord-os-card-on' : 'ord-os-card-off'">
                                <span class="ord-os-logo flex-shrink-0" :class="'ord-os-logo-' + osKey(opt.label)" aria-hidden="true">
                                    <svg x-show="osKey(opt.label) === 'ubuntu'" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <circle cx="12" cy="12" r="4"/><circle cx="12" cy="3.75" r="1.5" fill="currentColor" stroke="none"/><circle cx="4.85" cy="16.1" r="1.5" fill="currentColor" stroke="none"/><circle cx="19.15" cy="16.1" r="1.5" fill="currentColor" stroke="none"/><path d="M12 7.8V5.5M8.4 14.1l-2 1.15M15.6 14.1l2 1.15"/>
                                    </svg>
                                    <svg x-show="osKey(opt.label) === 'debian'" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <path d="M16.8 7.1c-1.1-2.25-4.7-2.65-7.15-1.25-2.8 1.6-3.5 5.15-1.65 7.55 1.65 2.15 5.25 2.35 7.1.65 1.45-1.3 1.6-3.5.2-4.55-1.15-.9-3.1-.6-3.75.6-.45.85-.05 1.95.75 2.2"/>
                                    </svg>
                                    <svg x-show="!['ubuntu','debian'].includes(osKey(opt.label))" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <path d="M4 6.5h16v11H4z"/><path d="m7.5 10 2 2-2 2M11.5 14h4.5"/>
                                    </svg>
                                </span>
                                <div class="min-w-0 flex-1">
                                    <div class="text-xs font-semibold truncate ord-srv-heading leading-tight" x-text="opt.label"></div>
                                    <div x-show="opt.meta && !(opt.price_monthly > 0)" class="text-[10px] ord-srv-dimmed truncate leading-tight mt-0.5" x-text="opt.meta"></div>
                                    <div class="text-[10px] font-semibold truncate leading-tight mt-0.5"
                                         :class="(opt.price_monthly > 0) ? 'ord-os-price-paid' : 'ord-os-price-included'"
                                         x-text="(opt.price_monthly > 0) ? '+' + $store.fbCurrency.formatMoney(opt.price_monthly) + '/mo' : 'Included'"></div>
                                </div>
                                <svg x-show="selected && selected.value === opt.value" x-cloak
                                     x-transition:enter="transition ease-out duration-150"
                                     x-transition:enter-start="opacity-0 scale-50"
                                     x-transition:enter-end="opacity-100 scale-100"
                                     x-transition:leave="transition ease-in duration-150"
                                     x-transition:leave-start="opacity-100 scale-100"
                                     x-transition:leave-end="opacity-0 scale-50"
                                     class="w-3.5 h-3.5 flex-shrink-0 ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                     style="color:var(--color-primary)">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                                </svg>
                            </button>
                        </template>
                        <div x-show="filtered().length === 0" class="col-span-full py-8 text-center text-sm ord-srv-dimmed">No options found.</div>
                    </div>
                    <button type="button"
                            x-show="!search && filtered().length > 6"
                            @click="expanded = !expanded"
                            class="ord-os-more">
                        <span x-text="expanded ? 'Show fewer options' : `Show all ${filtered().length} options`"></span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" :class="expanded ? 'rotate-180' : ''"><path d="m7 10 5 5 5-5"/></svg>
                    </button>
                    <div x-show="selected" x-cloak
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 -translate-y-1"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         x-transition:leave="transition ease-in duration-150"
                         x-transition:leave-start="opacity-100 translate-y-0"
                         x-transition:leave-end="opacity-0 -translate-y-1"
                         class="mt-3 flex items-center gap-1.5 text-xs font-semibold" style="color:var(--color-primary)">
                        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        <span x-text="selected ? selected.label : ''"></span>
                        <button type="button" @click="selected = null" class="ml-1 ord-srv-dimmed hover:text-red-400 transition-colors" aria-label="Clear selection">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>
                    </div>
                    <input type="hidden" name="config[{{ field.id }}]" :value="selected ? selected.value : ''"
                           data-server-option data-label="{{ field.label|e('html_attr') }}"
                           {% if field.required is defined and field.required %}data-required="true"{% endif %}>
                    {% if field.required is defined and field.required %}
                    <p class="text-xs ord-srv-dimmed mt-2">* Required — please select a {{ field.label|lower }}</p>
                    {% endif %}
                </div>
            </section>

            {% else %}
            {# ── Searchable dropdown picker ── #}
            <section class="ord-srv-section-card-divided ord-srv-option-card"
                     x-data="{
                         open: false,
                         search: '',
                         selected: null,
                         opts: {{ field.options|json_encode }},
                         grouped() {
                             const q = this.search.toLowerCase();
                             const list = q ? this.opts.filter(o => o.label.toLowerCase().includes(q)) : this.opts;
                             const map = {}, order = [];
                             list.forEach(o => { const g = o.group || ''; if (!map[g]) { map[g] = []; order.push(g); } map[g].push(o); });
                             return order.map(g => ({ region: g, options: map[g] }));
                         },
                         select(opt) { this.selected = opt; this.open = false; this.search = ''; }
                     }"
                     x-init="$watch('selected', v => {
                         document.dispatchEvent(new CustomEvent('srvFieldPriceUpdated', {
                             detail: {
                                 fieldId: '{{ field.id }}',
                                 fieldLabel: '{{ field.label|e('js') }}',
                                 optionValue: v ? v.value : '',
                                 optionLabel: v ? v.label : '',
                                 monthlyPrice: v ? (parseFloat(v.price_monthly) || 0) : 0
                             }
                         }));
                     })"
                     @click.outside="open = false"
                     @keydown.escape.window="open = false">

                <div class="flex items-center gap-3 ord-srv-section-hd">
                    <span class="p-2 ord-srv-icon-wrap rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--color-primary);">
                            {% if is_location_field %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21s6-4.35 6-11a6 6 0 10-12 0c0 6.65 6 11 6 11z"/>
                            <circle cx="12" cy="10" r="2" stroke-width="2"/>
                            {% else %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 4a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                            {% endif %}
                        </svg>
                    </span>
                    <div>
                        <h4 class="text-sm font-bold ord-srv-heading">{{ field.label }}</h4>
                        {% if field.description is defined and field.description %}
                        <p class="ord-srv-dimmed text-xs mt-0.5">{{ field.description }}</p>
                        {% endif %}
                    </div>
                </div>

                <div class="p-6">
                    <div>

                        {# Trigger button #}
                        <button type="button"
                                @click="open = !open; if (open) $nextTick(() => $refs.fieldSearch && $refs.fieldSearch.focus())"
                                class="ord-loc-trigger w-full flex items-center gap-3 px-4 py-3.5 rounded-xl border text-left transition-all"
                                :class="open
                                    ? 'border-[color:var(--color-primary)] ring-2 ring-[color:var(--color-primary)]/15'
                                    : 'ord-loc-trigger-idle'">
                            <svg class="w-4 h-4 flex-shrink-0 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                 :style="selected ? 'color:var(--color-primary)' : ''">
                                {% if is_location_field %}
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21s6-4.35 6-11a6 6 0 10-12 0c0 6.65 6 11 6 11z"/>
                                <circle cx="12" cy="10" r="2" stroke-width="2"/>
                                {% else %}
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 4a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                                {% endif %}
                            </svg>
                            <span x-show="!selected" x-transition.opacity.duration.150ms class="flex-1 text-sm ord-srv-dimmed italic">Select {{ field.label|lower }}…</span>
                            <div x-show="selected" x-cloak x-transition.opacity.duration.150ms class="flex-1 flex items-center gap-2 min-w-0">
                                <span class="text-sm font-semibold ord-srv-heading truncate" x-text="selected ? selected.label : ''"></span>
                                <span class="text-[10px] font-semibold flex-shrink-0"
                                      :class="selected && (selected.price_monthly > 0) ? 'text-amber-500' : 'text-emerald-500'"
                                      x-text="selected ? ((selected.price_monthly > 0) ? '+' + $store.fbCurrency.formatMoney(selected.price_monthly) + '/mo' : 'Free') : ''"></span>
                            </div>
                            <svg class="w-4 h-4 ord-srv-dimmed flex-shrink-0 transition-transform duration-200"
                                 :class="open ? 'rotate-180' : ''"
                                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>

                        {# Dropdown panel #}
                        <div x-show="open" x-cloak x-collapse.duration.240ms
                             class="ord-loc-dropdown mt-2 rounded-xl border overflow-hidden">

                            {# Search row #}
                            <div class="flex items-center gap-2.5 px-3.5 py-2.5 border-b ord-loc-search-row">
                                <svg class="w-4 h-4 flex-shrink-0 ord-srv-dimmed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                                </svg>
                                <input x-ref="fieldSearch"
                                       type="text"
                                       x-model="search"
                                       placeholder="Search…"
                                       autocomplete="off"
                                       class="flex-1 bg-transparent outline-none text-sm ord-srv-heading placeholder:text-slate-400">
                            </div>

                            {# Options list — grouped by the `group` field on each option #}
                            <div class="overflow-y-auto" style="max-height: 17rem;">
                                <template x-for="grp in grouped()" :key="grp.region">
                                    <div>
                                        <div x-show="grp.region"
                                             class="px-4 pt-3 pb-1 text-[10px] font-bold uppercase tracking-widest ord-srv-dimmed"
                                             x-text="grp.region"></div>
                                        <template x-for="opt in grp.options" :key="opt.value">
                                            <div @click="select(opt)"
                                                 @keydown.enter.prevent="select(opt)"
                                                 @keydown.space.prevent="select(opt)"
                                                 role="option"
                                                 tabindex="0"
                                                 :aria-selected="selected && selected.value === opt.value"
                                                 class="ord-loc-option flex items-center justify-between px-4 py-2.5 cursor-pointer transition-colors"
                                                 :class="selected && selected.value === opt.value ? 'ord-loc-option-active' : ''">
                                                <span class="text-sm font-medium ord-srv-heading" x-text="opt.label"></span>
                                                <div class="flex items-center gap-1.5 ml-auto flex-shrink-0">
                                                    <span x-show="opt.badge"
                                                          class="text-xs font-semibold ord-loc-badge"
                                                          :class="{
                                                              'ord-badge-best':    opt.badge === 'Best',
                                                              'ord-badge-good':    opt.badge === 'Good',
                                                              'ord-badge-fair':    opt.badge === 'Fair',
                                                              'ord-badge-distant': opt.badge === 'Distant'
                                                          }"
                                                          x-text="opt.badge + (opt.meta ? ' · ' + opt.meta : '')"></span>
                                                    <span class="text-[10px] font-semibold"
                                                          :class="(opt.price_monthly > 0) ? 'text-amber-500' : 'text-emerald-500'"
                                                          x-text="(opt.price_monthly > 0) ? '+' + $store.fbCurrency.formatMoney(opt.price_monthly) + '/mo' : 'Free'"></span>
                                                </div>
                                            </div>
                                        </template>
                                    </div>
                                </template>
                                <div x-show="grouped().length === 0"
                                     class="px-4 py-8 text-center text-sm ord-srv-dimmed">No options found.</div>
                            </div>
                        </div>

                        {# Hidden input — value submitted with cart config as config[field_id] #}
                        <input type="hidden" name="config[{{ field.id }}]" :value="selected ? selected.value : ''"
                               data-server-option data-label="{{ field.label|e('html_attr') }}"
                               {% if field.required is defined and field.required %}data-required="true"{% endif %}>
                        {% if field.required is defined and field.required %}
                        <p class="text-xs ord-srv-dimmed mt-2">* Required — please select a {{ field.label|lower }}</p>
                        {% endif %}
                    </div>
                </div>
            </section>
            {% endif %}

            {% endif %}
            {% endfor %}

            {# ── Custom configuration card (formbuilder) ── #}
            {% if product.form_id is defined and product.form_id and guest.extension_is_on({ 'mod': 'formbuilder' }) %}
            {% set form = guest.formbuilder_get({ 'id': product.form_id }) %}
            <section class="ord-srv-section-card-divided ord-srv-option-card" x-ref="formbuilderSection">
                <div class="flex items-center gap-3 ord-srv-section-hd">
                    <span class="p-2 ord-srv-icon-wrap rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--color-primary);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    </span>
                    <div>
                        <h4 class="text-sm font-bold ord-srv-heading">Configure your server</h4>
                        <p class="ord-srv-dimmed text-xs mt-0.5">Choose the location, operating system, hostname, or other options available for this plan.</p>
                    </div>
                </div>
                <div class="p-6">
                    {{ include('mod_formbuilder_build.html.twig', {hide_form_title: true}, with_context: true, ignore_missing: true) }}
                </div>
            </section>
            {% endif %}

            {# ── Optional add-ons card ── #}
            {% if product.addons is defined and product.addons is not empty %}
            <section class="ord-srv-section-card-divided ord-srv-option-card">
                <div class="flex items-center gap-3 ord-srv-section-hd">
                    <span class="p-2 ord-srv-icon-wrap rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--color-primary);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                    </span>
                    <div>
                        <h4 class="text-sm font-bold ord-srv-heading">Optional add-ons</h4>
                        <p class="ord-srv-dimmed text-xs mt-0.5">Enhance your server with {{ product.addons|length }} available option{{ product.addons|length == 1 ? '' : 's' }}.</p>
                    </div>
                </div>
                <div class="p-4 space-y-2">
                    {% for i, addon in product.addons %}
                    {% set addon_default_period = '' %}
                    {% if addon.pricing.type == 'recurrent' %}{% for acode, aprices in addon.pricing.recurrent %}{% if addon_default_period == '' and aprices.enabled %}{% set addon_default_period = acode %}{% endif %}{% endfor %}{% endif %}
                    <div @click.stop="toggleAddon({{ addon.id }}, '{{ addon.pricing.type | default('once') }}')"
                         class="flex items-center justify-between gap-4 px-4 py-3.5 border rounded-xl cursor-pointer transition-all bg-white"
                         :class="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected
                             ? 'border-[color:var(--color-primary)] ring-1 ring-[color:var(--color-primary)]/20'
                             : 'border-slate-200 hover:border-slate-300'">
                        <div class="flex items-center gap-3 flex-1 min-w-0">
                            {# Large checkbox — matches Stitch w-6 h-6 #}
                            <div class="w-6 h-6 rounded border-2 flex items-center justify-center flex-shrink-0 transition-all"
                                 :class="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'ord-chk-on' : 'ord-chk-off'">
                                <svg x-show="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected" x-cloak
                                     x-transition:enter="transition ease-out duration-150"
                                     x-transition:enter-start="opacity-0 scale-50"
                                     x-transition:enter-end="opacity-100 scale-100"
                                     x-transition:leave="transition ease-in duration-150"
                                     x-transition:leave-start="opacity-100 scale-100"
                                     x-transition:leave-end="opacity-0 scale-50"
                                     class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                            </div>
                            <div class="min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="text-sm font-semibold ord-srv-heading">{{ addon.title }}</span>
                                    {% if i == 0 %}<span class="text-[10px] font-bold px-2 py-0.5 rounded-md uppercase tracking-wider" style="background:rgba(var(--color-primary-rgb),0.12);color:var(--color-primary);">Recommended</span>{% endif %}
                                </div>
                                {% if addon.description %}<p class="text-xs mt-0.5 leading-relaxed ord-srv-dimmed">{{ addon.description|striptags|slice(0,100) }}{{ addon.description|striptags|length > 100 ? '…' : '' }}</p>{% endif %}
                            </div>
                        </div>
                        <div class="text-right flex-shrink-0 font-bold">
                            {% if addon.pricing.type == 'once' %}
                            <span class="text-sm ord-srv-heading">{{ addon.pricing.once.price | money_convert }}</span>
                            {% elseif addon.pricing.type == 'free' %}
                            <span class="text-sm text-emerald-500">Free</span>
                            {% elseif addon.pricing.type == 'recurrent' %}
                            <span class="text-sm ord-srv-heading"
                                  x-text="addonRawPrices['{{ addon.id }}'] && selectedPeriod && addonRawPrices['{{ addon.id }}'][selectedPeriod] !== undefined ? formatMoney(addonRawPrices['{{ addon.id }}'][selectedPeriod]) : (addonRawPrices['{{ addon.id }}'] && addonRawPrices['{{ addon.id }}']['{{ addon_default_period }}'] !== undefined ? formatMoney(addonRawPrices['{{ addon.id }}']['{{ addon_default_period }}']) : '')">{{ addon_default_period ? (addon.pricing.recurrent[addon_default_period].price | money_convert) : '&mdash;' }}</span>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </section>
            {% endif %}

            {# Error message #}
            <div x-show="errorMsg" x-cloak
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 -translate-y-1"
                 x-transition:enter-end="opacity-100 translate-y-0"
                 x-transition:leave="transition ease-in duration-150"
                 x-transition:leave-start="opacity-100 translate-y-0"
                 x-transition:leave-end="opacity-0 -translate-y-1"
                 role="alert" aria-live="polite" class="ord-srv-error-box p-4 rounded-xl border border-red-200 bg-red-50 flex items-start gap-3">
                <svg class="w-4 h-4 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <p class="text-sm text-red-600 ord-srv-error-text" x-text="errorMsg"></p>
            </div>

            {# Mobile CTA #}
            <div class="ord-srv-mobile-cta">
                <button type="button"
                        @click="addToCart({% if pricing.type == 'free' %}'free'{% elseif pricing.type == 'once' %}'once'{% else %}selectedPeriod{% endif %})"
                        :disabled="loading{% if pricing.type == 'recurrent' %} || !selectedPeriod{% endif %}"
                        class="w-full py-4 rounded-xl text-sm font-bold text-white transition-all flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                        style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));box-shadow:0 4px 20px rgba(var(--color-primary-rgb),0.3);">
                    <span x-show="!loading" class="flex items-center gap-2">Continue to Checkout <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></span>
                    <span x-show="loading" class="flex items-center gap-2"><svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>Adding…</span>
                </button>
            </div>
        </div>

        {# ═══ RIGHT COLUMN — sticky order summary ═══ #}
        <aside class="ord-srv-sidebar self-start" aria-label="Order summary">
            <div class="bg-white border border-slate-200 overflow-hidden ord-srv-sidebar-card">

                {# Header row #}
                <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between ord-srv-sidebar-hd">
                    <div>
                        <h2 class="text-base font-bold ord-srv-heading">Order summary</h2>
                        <p class="text-xs ord-srv-dimmed mt-0.5">Review your configuration</p>
                    </div>
                    <span class="ord-summary-currency">{{ currency.code }}</span>
                </div>

                <div class="ord-summary-body p-5">

                    {# Line items #}
                    <div class="ord-summary-lines">
                        <h5 class="font-bold text-slate-900 text-sm ord-srv-heading mb-3">{{ product.title }}</h5>

                        {% if pricing.type == 'recurrent' %}
                        <div x-show="selectedPeriod" class="ord-summary-row">
                            <span class="text-slate-500 ord-srv-muted" x-text="(periodLabels[selectedPeriod] || selectedPeriod) + ' plan'"></span>
                            <span class="font-semibold text-slate-900 ord-srv-heading" x-text="formatMoney(productRawPrices[selectedPeriod] || 0)"></span>
                        </div>
                        <div x-show="!selectedPeriod" class="text-xs text-slate-400 italic">Select a billing period above</div>
                        {% elseif pricing.type == 'once' %}
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-slate-500 ord-srv-muted">One-time</span>
                            <span class="font-semibold text-slate-900 ord-srv-heading">{{ pricing.once.price|money_convert }}</span>
                        </div>
                        {% endif %}

                        {% for addon in product.addons ?? [] %}
                        {% set addon_default_period = '' %}
                        {% if addon.pricing.type == 'recurrent' %}{% for acode, aprices in addon.pricing.recurrent %}{% if addon_default_period == '' and aprices.enabled %}{% set addon_default_period = acode %}{% endif %}{% endfor %}{% endif %}
                        <div x-show="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected" x-cloak
                             x-transition:enter="transition ease-out duration-200"
                             x-transition:enter-start="opacity-0 -translate-y-1"
                             x-transition:enter-end="opacity-100 translate-y-0"
                             x-transition:leave="transition ease-in duration-150"
                             x-transition:leave-start="opacity-100 translate-y-0"
                             x-transition:leave-end="opacity-0 -translate-y-1"
                             class="ord-summary-row">
                            <span class="text-slate-500 ord-srv-muted">{{ addon.title }}</span>
                            {% if addon.pricing.type == 'free' %}
                            <span class="font-semibold text-emerald-500">Free</span>
                            {% elseif addon.pricing.type == 'once' %}
                            <span class="font-semibold text-slate-900 ord-srv-heading">{{ addon.pricing.once.price|money_convert }}</span>
                            {% else %}
                            <span class="font-semibold text-slate-900 ord-srv-heading" x-text="addonRawPrices['{{ addon.id }}'] && selectedPeriod && addonRawPrices['{{ addon.id }}'][selectedPeriod] !== undefined ? formatMoney(addonRawPrices['{{ addon.id }}'][selectedPeriod]) : '—'"></span>
                            {% endif %}
                        </div>
                        {% endfor %}

                        <template x-for="selection in Object.values(srvFieldSelections)" :key="selection.id">
                            <div class="ord-summary-selection">
                                <div class="min-w-0">
                                    <span class="ord-srv-dimmed" x-text="selection.label"></span>
                                    <strong class="ord-srv-heading" x-text="selection.value"></strong>
                                </div>
                                <span x-show="selection.price > 0" class="ord-summary-option-price"
                                      x-text="'+' + formatMoney(selection.price * (periodMonthsMap[selectedPeriod] || 1))"></span>
                                <span x-show="selection.price <= 0" class="ord-summary-included">Included</span>
                            </div>
                        </template>

                        <div x-show="couponDiscount > 0" x-cloak
                             x-transition:enter="transition ease-out duration-200"
                             x-transition:enter-start="opacity-0 -translate-y-1"
                             x-transition:enter-end="opacity-100 translate-y-0"
                             x-transition:leave="transition ease-in duration-150"
                             x-transition:leave-start="opacity-100 translate-y-0"
                             x-transition:leave-end="opacity-0 -translate-y-1"
                             class="flex items-center justify-between text-sm pt-2 border-t border-slate-100">
                            <span class="text-emerald-600">Coupon discount</span>
                            <span class="font-semibold text-emerald-600" x-text="'−' + formatMoney(couponDiscount)"></span>
                        </div>
                    </div>

                    {# Total — Stitch: big 40px font #}
                    <div class="ord-summary-total">
                        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Total Due Today</span>
                        <div class="ord-srv-total leading-none font-black text-slate-900 mt-1 ord-srv-heading"
                             x-text="calcTotal({% if pricing.type == 'once' %}'once'{% elseif pricing.type == 'free' %}'free'{% else %}selectedPeriod || '{{ first_period }}'{% endif %})"></div>
                    </div>

                    {# Coupon — Stitch toggle link pattern #}
                    <div class="space-y-2">
                        {# Toggle link — shown when not yet applied #}
                        <button type="button" x-show="!couponApplied"
                                x-transition:enter="transition ease-out duration-200"
                                x-transition:enter-start="opacity-0"
                                x-transition:enter-end="opacity-100"
                                x-transition:leave="transition ease-in duration-150"
                                x-transition:leave-start="opacity-100"
                                x-transition:leave-end="opacity-0"
                                @click="couponOpen = !couponOpen; couponError = null"
                                class="w-full flex items-center justify-center gap-2 text-sm font-semibold py-2 rounded-lg transition-all hover:bg-slate-50 focus:outline-none"
                                style="color:var(--color-primary);">
                            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                            Have a coupon code?
                            <svg class="w-4 h-4 flex-shrink-0 transition-transform duration-200" :class="couponOpen ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                        </button>
                        {# Collapsible input row #}
                        <div x-show="couponOpen && !couponApplied" x-cloak
                             x-transition:enter="transition ease-out duration-200"
                             x-transition:enter-start="opacity-0 scale-y-95 -translate-y-1"
                             x-transition:enter-end="opacity-100 scale-y-100 translate-y-0"
                             x-transition:leave="transition ease-in duration-150"
                             x-transition:leave-start="opacity-100 scale-y-100 translate-y-0"
                             x-transition:leave-end="opacity-0 scale-y-95 -translate-y-1"
                             class="flex gap-2 origin-top">
                            <div class="relative flex-1 min-w-0">
                                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                                <input type="text" x-model="couponCode"
                                       @keydown.enter.prevent="applyCoupon()"
                                       @input="couponError = null"
                                       placeholder="Promo code"
                                       class="ord-srv-coupon-input w-full pl-9 pr-3 py-2.5 rounded-xl text-sm focus:outline-none focus:ring-2 border transition-all"
                                       style="--tw-ring-color:rgba(var(--color-primary-rgb),0.25);">
                            </div>
                            <button type="button" @click="applyCoupon()"
                                    :disabled="!couponCode.trim() || couponLoading"
                                    class="ord-coupon-apply flex-shrink-0 flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-bold text-white focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed"
                                    style="background:var(--color-primary);">
                                <span x-show="!couponLoading" x-transition.opacity.duration.100ms>Apply</span>
                                <span x-show="couponLoading" x-transition.opacity.duration.100ms class="flex items-center">
                                    <svg class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                                </span>
                            </button>
                        </div>
                        <p x-show="couponError" x-cloak x-text="couponError"
                           x-transition:enter="transition ease-out duration-200"
                           x-transition:enter-start="opacity-0 -translate-y-1"
                           x-transition:enter-end="opacity-100 translate-y-0"
                           x-transition:leave="transition ease-in duration-150"
                           x-transition:leave-start="opacity-100 translate-y-0"
                           x-transition:leave-end="opacity-0 -translate-y-1"
                           class="text-xs text-red-500 text-center"></p>
                        {# Applied badge #}
                        <div x-show="couponApplied" x-cloak
                             x-transition:enter="transition ease-out duration-200"
                             x-transition:enter-start="opacity-0 translate-y-1 scale-[.98]"
                             x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                             x-transition:leave="transition ease-in duration-150"
                             x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                             x-transition:leave-end="opacity-0 -translate-y-1 scale-[.98]"
                             class="flex items-center justify-between rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2">
                            <div class="flex items-center gap-2">
                                <svg class="w-3.5 h-3.5 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                <span class="text-xs font-mono font-bold text-emerald-700 uppercase tracking-wide" x-text="couponCode"></span>
                            </div>
                            <button type="button"
                                    @click="couponApplied = false; couponDiscount = 0; couponCode = ''; couponOpen = false; promoType = null; promoValue = 0; promoPeriods = []; couponError = null;"
                                    class="text-xs text-slate-400 hover:text-red-500 transition-colors font-medium ml-3">Remove</button>
                        </div>
                    </div>

                    {# Continue button — Stitch: scale hover + gradient #}
                    <button type="button"
                            @click="addToCart({% if pricing.type == 'free' %}'free'{% elseif pricing.type == 'once' %}'once'{% else %}selectedPeriod{% endif %})"
                            :disabled="loading{% if pricing.type == 'recurrent' %} || !selectedPeriod{% endif %}"
                            class="ord-srv-submit w-full py-4 rounded-xl text-base font-bold text-white flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                            style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));box-shadow:0 8px 24px rgba(var(--color-primary-rgb),0.3);">
                        <span x-show="!loading" class="flex items-center gap-2">
                            Continue to checkout
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
                        </span>
                        <span x-show="loading" class="flex items-center gap-2">
                            <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                            Adding to cart…
                        </span>
                    </button>

                    {# Guarantee #}
                    <div class="flex items-center justify-center gap-2 pt-1">
                        <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                        <span class="text-xs font-semibold text-emerald-600">30-day money-back guarantee</span>
                    </div>
                </div>

                {# Footer — terms #}
                <div class="px-5 py-3 border-t border-slate-100 ord-srv-sidebar-ft">
                    <p class="text-[10px] text-slate-400 text-center leading-relaxed">
                        By ordering, you agree to our
                        <a href="{{ (settings.link_terms|default('/page/terms-and-conditions'))|url }}" class="ord-srv-terms-link text-slate-500 underline">Terms of Service</a>
                        and Privacy Policy. All taxes are calculated at checkout.
                    </p>
                </div>
            </div>
        </aside>

    </div>
    {% endif %}
</div>

{% else %}


<div class="relative rounded-2xl overflow-hidden mb-10 p-8"
     style="background: linear-gradient(135deg, rgba(var(--color-primary-rgb),0.12) 0%, rgba(var(--color-secondary-rgb),0.08) 100%); border: 1px solid rgba(var(--color-primary-rgb),0.2);">
    <div class="absolute inset-0 pointer-events-none"
         style="background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="relative flex flex-col sm:flex-row items-start sm:items-center justify-between gap-8">
        <div class="flex-1 min-w-0">
            {% if _tagline %}
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold mb-3">
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
                <span>{{ _tagline }}</span>
            </div>
            {% endif %}
            <h1 class="text-2xl font-bold text-white mb-2">{{ _title ?: (_hero_cat ? _hero_cat.title : 'Server Plans') }}</h1>
            {% for _para in _paragraphs %}
            <p class="text-sm text-gray-400 max-w-xl leading-relaxed mb-1">{{ _para }}</p>
            {% endfor %}
        </div>
        {% if _bullets %}
        <div class="flex flex-col gap-2 shrink-0">
            {% for _bullet in _bullets %}
            <div class="flex items-center gap-2 text-sm text-gray-300">
                <svg class="w-4 h-4 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <li class="list-none">{{ _bullet }}</li>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>

{# ===== PRODUCTS ===== #}

<div class="space-y-12">
    {% for category in show_categories %}
        {% set cat_products = category.products|sort((a,b) => a.priority <=> b.priority) %}
        {% if cat_products %}

            {# ── Collect all enabled billing periods across products in this category ── #}
            {% set all_period_order = ['1W', '1M', '3M', '6M', '1Y', '2Y', '3Y'] %}
            {% set period_meta = {
                '1W': {'label': 'Weekly',   'months': 0.25},
                '1M': {'label': 'Monthly',  'months': 1},
                '3M': {'label': '3 Months', 'months': 3},
                '6M': {'label': '6 Months', 'months': 6},
                '1Y': {'label': '1 Year',   'months': 12},
                '2Y': {'label': '2 Years',  'months': 24},
                '3Y': {'label': '3 Years',  'months': 36}
            } %}
            {% set enabled_periods = [] %}
            {% for pk in all_period_order %}
                {% set pk_on = false %}
                {% for p in cat_products %}
                    {% if p.pricing.recurrent[pk] is defined and p.pricing.recurrent[pk].enabled %}
                        {% set pk_on = true %}
                    {% endif %}
                {% endfor %}
                {% if pk_on %}{% set enabled_periods = enabled_periods|merge([pk]) %}{% endif %}
            {% endfor %}

            {# ── Build pricing JSON for Alpine ── #}
            {% set all_pricings = [] %}
            {% for p in cat_products %}{% set all_pricings = all_pricings|merge([p.pricing]) %}{% endfor %}

            <div x-data="{
                    period: '{{ enabled_periods|first|default('1M') }}',
                    allPricings: {{ all_pricings|json_encode }},
                    currencyFormat: {{ currency_fmt_js|json_encode }},
                    currencyRate: {{ currency.conversion_rate|default(1) }},
                    currencyPriceFormat: {{ currency.price_format|default(2)|json_encode }},
                    fmt(price) {
                        const converted = parseFloat(price) * this.currencyRate;
                        let num;
                        switch (parseInt(this.currencyPriceFormat)) {
                            case 2: num = converted.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}); break;
                            case 3: num = converted.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.'); break;
                            case 4: num = Math.round(converted).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ','); break;
                            case 5: num = Math.round(converted).toString(); break;
                            default: num = converted.toFixed(2);
                        }
                        return this.currencyFormat.replace('__PRICE__', num);
                    },
                    fmtNum(price) {
                        const converted = parseFloat(price) * this.currencyRate;
                        switch (parseInt(this.currencyPriceFormat)) {
                            case 2: return converted.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
                            case 3: return converted.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                            case 4: return Math.round(converted).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
                            case 5: return Math.round(converted).toString();
                            default: return converted.toFixed(2);
                        }
                    },
                    getPrice(pricing, key) {
                        if (!pricing) return null;
                        if (pricing.type === 'free') return 0;
                        if (pricing.type === 'once') {
                            const v = pricing.once ? parseFloat(pricing.once.price) : NaN;
                            return isNaN(v) ? null : v;
                        }
                        if (!pricing.recurrent) return null;
                        const p = pricing.recurrent[key];
                        if (!p || !p.enabled) return null;
                        const v = parseFloat(p.price);
                        return isNaN(v) ? null : v;
                    },
                    monthlyEquiv(price, key) {
                        const m = { '1W': 0.25, '1M': 1, '3M': 3, '6M': 6, '1Y': 12, '2Y': 24, '3Y': 36 }[key] || 1;
                        return price / m;
                    },
                    maxSavings(periodKey) {
                        const results = this.allPricings.map(pr => {
                            const mo  = this.getPrice(pr, '1M');
                            const tot = this.getPrice(pr, periodKey);
                            if (mo === null || tot === null || mo <= 0) return null;
                            const pct = Math.round((1 - this.monthlyEquiv(tot, periodKey) / mo) * 100);
                            return pct > 0 ? pct : null;
                        }).filter(v => v !== null);
                        return results.length ? Math.max(...results) : null;
                    }
                }">

                {# ── Billing period switcher ── #}
                {% if enabled_periods|length > 1 %}
                <div class="flex justify-center mb-8">
                    <div class="overflow-x-auto max-w-full pb-1">
                    <div class="inline-flex items-center gap-1 p-1 rounded-full border border-white/10 bg-white/[0.04]">
                        {% for pk in enabled_periods %}
                        {% set pmeta = period_meta[pk] %}
                        <button @click="period='{{ pk }}'"
                                :class="period==='{{ pk }}' ? 'bg-white text-gray-900 shadow' : 'text-gray-400 hover:text-white'"
                                class="relative inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-sm font-medium transition-all whitespace-nowrap">
                            {{ pmeta.label }}
                            {% if pk != '1M' %}
                            <template x-if="maxSavings('{{ pk }}') !== null">
                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold leading-none"
                                      :class="period==='{{ pk }}' ? 'bg-emerald-100 text-emerald-700' : 'bg-emerald-500/20 text-emerald-400'"
                                      x-text="'Save ' + maxSavings('{{ pk }}') + '%'">
                                </span>
                            </template>
                            {% endif %}
                        </button>
                        {% endfor %}
                    </div>
                    </div>
                </div>
                {% endif %}

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-{% if cat_products|length >= 4 %}4{% elseif cat_products|length == 3 %}3{% else %}2{% endif %} gap-5">
                    {% for i, product in cat_products %}
                        {% set pricing_json = product.pricing|json_encode %}

                        {# Parse description features — try HTML delimiters, then newlines, then markdown bullets #}
                        {% set desc_raw = product.description|default('')|replace({'<br>': '|||', '<br/>': '|||', '<br />': '|||', '</p>': '|||', '</li>': '|||'})|striptags|trim %}
                        {% set desc_features = desc_raw|split('|||')|filter(l => l|trim != '') %}
                        {% if desc_features|length <= 1 and product.description %}
                            {% set desc_features = [] %}
                            {% set plain = product.description|striptags|trim %}
                            {% for item in plain|split('\n') %}
                                {% set feat = item|replace({'* ': '', '- ': ''})|trim %}
                                {% if feat %}{% set desc_features = desc_features|merge([feat]) %}{% endif %}
                            {% endfor %}
                        {% endif %}
                        {% if desc_features|length <= 1 %}
                            {% set desc_features = ['Full Root Access', 'NVMe SSD Storage', 'DDoS Protection', '24/7 Support'] %}
                        {% endif %}

                        <div class="relative rounded-2xl border flex flex-col transition-all sm:hover:scale-[1.01]
                              {% if i == 1 %}border-indigo-500/40{% else %}border-white/[0.08] hover:border-indigo-500/25{% endif %}"
                             style="{% if i == 1 %}background: linear-gradient(180deg, rgba(var(--color-primary-rgb),0.08) 0%, rgba(var(--color-primary-rgb),0.03) 100%);{% else %}background: rgba(255,255,255,0.02);{% endif %}"
                             x-data="{ pricing: {{ pricing_json }} }">

                            {% if i == 1 %}
                                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full text-xs font-bold text-white inline-flex items-center gap-1" style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
                                    <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                    Most Popular
                                </div>
                            {% endif %}

                            <div class="p-5 flex-1">
                                <h3 class="text-sm font-bold text-white mb-1">{{ product.title }}</h3>

                                {# Dynamic pricing #}
                                <div class="py-4 border-y border-white/5 my-4">
                                    <template x-if="pricing.type === 'recurrent' || pricing.recurrent">
                                        <div>
                                            <template x-if="getPrice(pricing, period) !== null">
                                                <div>
                                                    <template x-if="period !== '1M' && monthlyEquiv(getPrice(pricing, period), period) && getPrice(pricing, '1M') !== null">
                                                        <div class="flex items-center gap-2 mb-1">
                                                            <span class="text-sm text-gray-500 line-through" x-text="fmt(getPrice(pricing, '1M'))"></span>
                                                            <template x-if="getPrice(pricing, '1M') > 0">
                                                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-bold text-white tracking-wide" style="background: #16a34a;"
                                                                      x-text="Math.round((1 - monthlyEquiv(getPrice(pricing, period), period) / getPrice(pricing, '1M')) * 100) + '% OFF'"></span>
                                                            </template>
                                                        </div>
                                                    </template>
                                                    <div class="flex items-baseline gap-0.5">
                                                        <span class="text-sm font-semibold text-gray-400 leading-none"
                                                              x-text="currencyFormat.split('__PRICE__')[0].trim()"></span>
                                                        <span class="text-3xl font-extrabold text-white tabular-nums leading-none"
                                                              x-text="fmtNum(period === '1M' ? getPrice(pricing, period) : monthlyEquiv(getPrice(pricing, period), period))"></span>
                                                        <span class="text-sm font-semibold text-gray-400 leading-none"
                                                              x-text="currencyFormat.split('__PRICE__')[1].trim()"></span>
                                                        <span class="text-sm text-gray-500 ml-0.5">/mo</span>
                                                    </div>
                                                    <template x-if="period !== '1M' && getPrice(pricing, '1M') !== null">
                                                        <p class="text-xs text-gray-500 mt-1.5 leading-relaxed">
                                                            Billed as <span x-text="fmt(getPrice(pricing, period))"></span>
                                                            / <span x-text="{ '1W': 'week', '3M': '3 mo', '6M': '6 mo', '1Y': 'yr', '2Y': '2 yr', '3Y': '3 yr' }[period] || period"></span>.
                                                        </p>
                                                    </template>
                                                </div>
                                            </template>
                                            <template x-if="getPrice(pricing, period) === null">
                                                <p class="text-sm ord-plan-unavail italic">Not available for this period</p>
                                            </template>
                                        </div>
                                    </template>
                                    {% if product.pricing.type == 'once' %}
                                        <div class="flex items-baseline gap-1">
                                            <span class="text-3xl font-bold text-white" x-text="fmt({{ product.pricing.once.price }})"></span>
                                            <span class="text-sm text-gray-500">once</span>
                                        </div>
                                    {% elseif product.pricing.type == 'free' %}
                                        <div class="flex items-baseline gap-1">
                                            <span class="text-3xl font-bold text-green-400">Free</span>
                                        </div>
                                    {% endif %}
                                </div>

                                {# Feature bullets #}
                                <ul class="space-y-2">
                                    {% for bullet in desc_features|slice(0, 4) %}
                                    <li class="flex items-center gap-2 text-xs ord-plan-feature-text">
                                        <svg class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                        {{ bullet|trim }}
                                    </li>
                                    {% endfor %}
                                </ul>
                            </div>

                            <div class="p-5 pt-0">
                                <template x-if="!(pricing.type === 'recurrent' || pricing.recurrent) || getPrice(pricing, period) !== null">
                                    <a href="{{ ('/order/' ~ product.slug)|url }}"
                                       class="block w-full text-center py-2.5 rounded-xl text-sm font-semibold transition-all
                                              {% if i == 1 %}text-white hover:opacity-90{% else %}bg-white/5 hover:bg-indigo-500/15 text-gray-300 hover:text-white border border-white/10 hover:border-indigo-500/30{% endif %}"
                                       {% if i == 1 %}style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));"{% endif %}>
                                        Deploy Now <svg class="w-3.5 h-3.5 ml-0.5 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
                                    </a>
                                </template>
                                <template x-if="(pricing.type === 'recurrent' || pricing.recurrent) && getPrice(pricing, period) === null">
                                    <span class="block w-full text-center py-2.5 rounded-xl text-sm font-bold bg-white/[0.03] text-gray-600 cursor-not-allowed">Not available</span>
                                </template>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    {% endfor %}

    {% if not show_categories %}
        <div class="text-center py-20 text-gray-600">
            <svg class="w-12 h-12 mx-auto mb-4 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3h14a2 2 0 012 2v4a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2zm0 10h14a2 2 0 012 2v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4a2 2 0 012-2z"/>
            </svg>
            <p class="text-sm">No server plans available yet. Check back soon.</p>
        </div>
    {% endif %}
</div>

{# ====== FEATURE: NVMe PERFORMANCE — text left, visual right ====== #}
<section class="py-24 overflow-hidden border-t border-white/[0.05] mt-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
            <div class="flex-1 reveal-left">
                <p class="text-xs font-semibold text-indigo-400 uppercase tracking-widest mb-3">Performance</p>
                <h2 class="text-3xl sm:text-4xl font-bold text-white mb-5 leading-tight">Blazing-fast NVMe storage</h2>
                <p class="text-gray-400 text-sm leading-relaxed mb-8">
                    Our NVMe SSDs deliver up to 10× faster read/write speeds than traditional SATA drives.
                    Every plan runs on enterprise-grade PCIe NVMe storage — giving your apps the I/O throughput they need to perform at their peak.
                </p>
                <ul class="space-y-3">
                    <li class="flex items-start gap-3">
                        <div class="w-5 h-5 rounded-full bg-indigo-500/15 flex items-center justify-center mt-0.5 flex-shrink-0">
                            <svg class="w-3 h-3 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <span class="text-sm text-gray-300">PCIe 4.0 NVMe — up to 7,000 MB/s sequential read</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <div class="w-5 h-5 rounded-full bg-indigo-500/15 flex items-center justify-center mt-0.5 flex-shrink-0">
                            <svg class="w-3 h-3 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <span class="text-sm text-gray-300">1 Gbps dedicated network uplink per node</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <div class="w-5 h-5 rounded-full bg-indigo-500/15 flex items-center justify-center mt-0.5 flex-shrink-0">
                            <svg class="w-3 h-3 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <span class="text-sm text-gray-300">Latest-gen AMD EPYC / Intel Xeon processors</span>
                    </li>
                </ul>
            </div>

            <div class="flex-1 flex justify-center reveal-right">
                <div class="relative w-full max-w-sm">
                    <div class="absolute inset-0 rounded-3xl blur-3xl opacity-25" style="background: radial-gradient(ellipse, var(--color-primary), transparent 70%);"></div>
                    <div class="relative rounded-2xl border border-white/10 p-6" style="background: linear-gradient(135deg, rgba(var(--color-primary-rgb),0.08) 0%, rgba(var(--color-secondary-rgb),0.05) 100%);">
                        <p class="text-xs text-gray-500 uppercase tracking-wider mb-3 text-center">Sequential Read Speed</p>
                        <div class="flex items-baseline gap-1 justify-center mb-6">
                            <span class="text-5xl font-black text-white counter" data-target="7000">0</span>
                            <span class="text-xl font-bold text-indigo-400">MB/s</span>
                        </div>
                        <div class="space-y-3">
                            <div>
                                <div class="flex justify-between text-xs text-gray-500 mb-1.5"><span>NVMe (Our VPS)</span><span class="text-indigo-300">7,000 MB/s</span></div>
                                <div class="h-2 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.06)"><div class="h-full rounded-full perf-bar" style="background:linear-gradient(90deg,var(--color-primary),var(--color-secondary));width:0" data-width="100%"></div></div>
                            </div>
                            <div>
                                <div class="flex justify-between text-xs text-gray-500 mb-1.5"><span>SATA SSD</span><span>550 MB/s</span></div>
                                <div class="h-2 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.06)"><div class="h-full rounded-full perf-bar" style="background:rgba(255,255,255,0.2);width:0" data-width="8%"></div></div>
                            </div>
                            <div>
