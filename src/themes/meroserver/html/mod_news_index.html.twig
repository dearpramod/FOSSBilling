{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ 'News & Announcements'|trans }}{% endblock %}
{% block page_header %}{% endblock %}

{% block content %}
{% set posts = guest.news_get_list({ "page": request.page|default(1), "per_page": 9 }) %}
{% set currentPage = (request.page|default(1))|number_format(0,'','') %}

<div class="ref-news-page">

    <nav class="ref-news-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ '/dashboard'|url }}">Home</a>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m9 5 7 7-7 7"/></svg>
        <span>News &amp; Announcements</span>
    </nav>

    {# ── Page hero ── #}
    <header class="ref-news-hero text-center relative overflow-hidden">
        <div class="ref-news-hero-copy relative z-10 max-w-2xl mx-auto">
            <span class="ref-news-kicker"><i></i> {{ 'Platform updates'|trans }}</span>
            <h1>{{ 'News & Announcements'|trans }}</h1>
            <p>{{ 'The latest platform updates, security alerts, maintenance notices, and technical releases.'|trans }}</p>
        </div>
        {% if posts.total|default(0) %}
        <div class="ref-news-total">
            <strong>{{ posts.total }}</strong>
            <span>{{ 'published updates'|trans }}</span>
        </div>
        {% endif %}
    </header>

    {% if posts.list|length > 0 %}
    <div class="ref-news-feed space-y-6">

        {# ── Featured post (first item) ── #}
        {% set featured = posts.list[0] %}
        <article class="ref-news-featured bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm">
            <div class="ref-news-featured-art" aria-hidden="true">
                <span>NEWS</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 4h11a2 2 0 012 2v14H5a2 2 0 01-2-2V6a2 2 0 012-2Z"/><path d="M18 8h1a2 2 0 012 2v8a2 2 0 01-2 2h-1M7 8h7M7 12h7M7 16h4"/></svg>
            </div>
            <div class="ref-news-featured-copy p-8">
                <div class="flex items-center justify-between mb-3">
                    <span class="ref-news-label">
                        <span></span>
                        {{ 'Update'|trans }}
                    </span>
                    <span class="text-[11px] font-semibold uppercase tracking-[0.05em] text-slate-400 dark:text-slate-500">{{ featured.updated_at|date('M j, Y') }}</span>
                </div>
                <h2 class="text-2xl leading-8 tracking-[-0.01em] font-semibold text-slate-900 dark:text-white mb-3">
                    <a href="{{ '/news'|url }}/{{ featured.slug }}" class="ref-minimal-link">{{ featured.title }}</a>
                </h2>
                <p class="text-sm leading-5 text-slate-500 dark:text-slate-400">
                    {% if featured.excerpt %}
                        {% set body = featured.excerpt|striptags|replace({'**': '', '__': '', '## ': '', '# ': '', '&nbsp;': ' '})|trim %}
                    {% else %}
                        {% set body = featured.content|striptags|replace({'**': '', '__': '', '## ': '', '# ': '', '&nbsp;': ' '})|trim %}
                    {% endif %}
                    {{ body|slice(0, 280) }}{% if body|length > 280 %}…{% endif %}
                </p>
                <div class="mt-8 flex items-center justify-between">
                    {% if featured.author.name|default(false) %}
                    <span class="text-xs text-slate-400 dark:text-slate-500">{{ featured.author.name }}</span>
                    {% else %}
                    <span></span>
                    {% endif %}
                    <a href="{{ '/news'|url }}/{{ featured.slug }}"
                       class="ref-news-featured-link inline-flex items-center gap-1.5 text-sm font-bold text-[color:var(--color-primary)]">
                        {{ 'Read Full Update'|trans }}
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                </div>
            </div>
        </article>

        {# ── 2-column grid: remaining posts ── #}
        {% if posts.list|length > 1 %}
        <div class="ref-news-grid grid grid-cols-1 md:grid-cols-2 gap-6">
            {% for post in posts.list %}
            {% if loop.index > 1 %}
            <article class="ref-news-card bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 flex flex-col shadow-sm">
                <div class="flex items-center justify-between mb-3">
                    <span class="ref-news-label">
                        <span></span>
                        {{ 'Update'|trans }}
                    </span>
                    <span class="text-[11px] font-semibold uppercase tracking-[0.05em] text-slate-400 dark:text-slate-500">{{ post.updated_at|date('M j, Y') }}</span>
                </div>
                <h3 class="text-[18px] leading-7 tracking-[-0.01em] font-semibold text-slate-900 dark:text-white mb-3">
                    <a href="{{ '/news'|url }}/{{ post.slug }}" class="ref-minimal-link">{{ post.title }}</a>
                </h3>
                <p class="text-sm leading-5 text-slate-500 dark:text-slate-400 flex-1">
                    {% if post.excerpt %}
                        {% set body = post.excerpt|striptags|replace({'**': '', '__': '', '## ': '', '# ': '', '&nbsp;': ' '})|trim %}
                    {% else %}
                        {% set body = post.content|striptags|replace({'**': '', '__': '', '## ': '', '# ': '', '&nbsp;': ' '})|trim %}
                    {% endif %}
                    {{ body|slice(0, 160) }}{% if body|length > 160 %}…{% endif %}
                </p>
                <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 flex justify-between items-center">
                    {% if post.author.name|default(false) %}
                    <span class="text-xs italic text-slate-400 dark:text-slate-500">{{ post.author.name }}</span>
                    {% else %}
                    <span></span>
                    {% endif %}
                    <a href="{{ '/news'|url }}/{{ post.slug }}"
                       class="ref-news-more-link px-4 py-2 rounded-lg text-sm font-medium bg-slate-100 dark:bg-white/[0.05] text-slate-700 dark:text-slate-300 inline-flex items-center gap-1.5">
                        {{ 'Read More'|trans }}
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </article>
            {% endif %}
            {% endfor %}
        </div>
        {% endif %}

        {# ── Pagination ── #}
        {% if posts.pages > 1 %}
        <div class="ref-news-pagination flex items-center justify-center gap-2 mt-12 pb-8">
            {# Prev #}
            {% if currentPage > 1 %}
            <a href="{{ '/news'|url }}?page={{ currentPage - 1 }}"
               aria-label="{{ 'Previous page'|trans }}" class="w-10 h-10 flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-white/[0.05] transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </a>
            {% else %}
            <span class="w-10 h-10 flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 text-slate-300 dark:text-slate-600 cursor-not-allowed">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </span>
            {% endif %}

            {# Page numbers with smart truncation #}
            {% for p in 1..posts.pages %}
                {% set isActive = currentPage == p %}
                {% set nearCurrent = (p >= currentPage - 2 and p <= currentPage + 2) %}
                {% set isEdge = (p == 1 or p == posts.pages) %}
                {% if isEdge or nearCurrent %}
                    {# Ellipsis before current cluster #}
                    {% if not loop.first and p == currentPage - 2 and currentPage - 2 > 2 %}
                    <span class="px-1 text-slate-400 dark:text-slate-500 text-sm">…</span>
                    {% endif %}
                    {# Ellipsis before last page #}
                    {% if not loop.first and not nearCurrent and p == posts.pages and currentPage + 2 < posts.pages - 1 %}
                    <span class="px-1 text-slate-400 dark:text-slate-500 text-sm">…</span>
                    {% endif %}
                    <a href="{{ '/news'|url }}?page={{ p }}"
                       aria-label="{{ 'Page'|trans }} {{ p }}"{% if isActive %} aria-current="page"{% endif %}
                       class="w-10 h-10 flex items-center justify-center rounded-lg text-sm font-medium transition-all {{ isActive ? 'text-white' : 'border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-white/[0.05]' }}"
                       {% if isActive %}style="background: var(--color-primary);"{% endif %}>
                        {{ p }}
                    </a>
                {% endif %}
            {% endfor %}

            {# Next #}
            {% if currentPage < posts.pages %}
            <a href="{{ '/news'|url }}?page={{ currentPage + 1 }}"
               aria-label="{{ 'Next page'|trans }}" class="w-10 h-10 flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-white/[0.05] transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </a>
            {% else %}
            <span class="w-10 h-10 flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 text-slate-300 dark:text-slate-600 cursor-not-allowed">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </span>
            {% endif %}
        </div>
        {% endif %}

    </div>

    {% else %}

    {# ── Empty state ── #}
    <div class="ref-news-empty flex flex-col items-center justify-center py-20 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800">
        <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4 bg-slate-100 dark:bg-white/[0.05]">
            <svg class="w-7 h-7 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                      d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
            </svg>
        </div>
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400">{{ 'No news or announcements'|trans }}</p>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">{{ 'Check back later for updates.'|trans }}</p>
    </div>

    {% endif %}

</div>
{% endblock %}
