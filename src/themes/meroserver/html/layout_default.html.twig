                       class="flex-1 flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-gray-300 border border-white/10 hover:border-indigo-500/40 hover:text-white hover:bg-white/5 transition-all">
                        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
                        Log in
                    </a>
                    <a href="{{ 'signup'|url }}"
                       class="flex-1 flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium btn-primary-gradient">
                        Sign up
                    </a>
                </div>

                {# Guest collapsed: login icon #}
                <div x-show="sidebarCollapsed" class="flex justify-center">
                    <a href="{{ 'login'|url }}" title="Log in"
                       class="w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 border border-white/10 hover:text-white hover:border-indigo-500/40 transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
                    </a>
                </div>

            {% endif %}
        </div>
    </aside>
    {% endif %}

    <!-- Help & Support panel — outside <aside> so position:fixed works (transforms break fixed) -->
    {# Backdrop — starts below header, above content #}
    <div x-show="helpOpen" x-cloak
         x-transition:enter="transition-opacity ease-out duration-200"
         x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
         x-transition:leave="transition-opacity ease-in duration-150"
         x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
         @click="helpOpen = false"
         class="help-panel-backdrop fixed bottom-0 right-0 z-[26] bg-black/20"
         aria-hidden="true">
    </div>

    {# Panel — z-[28] keeps it below header (z-30) so header stays on top #}
    <div x-show="helpOpen" x-cloak
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 -translate-x-full"
         x-transition:enter-end="opacity-100 translate-x-0"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 translate-x-0"
         x-transition:leave-end="opacity-0 -translate-x-full"
         @keydown.escape.window="if (helpOpen) helpOpen = false"
         role="dialog"
         aria-modal="true"
         aria-labelledby="help-panel-title"
         tabindex="-1"
         class="help-panel fixed bottom-0 z-[28] max-w-[90vw] flex flex-col overflow-hidden" id="help-panel">

        {# Header #}
        <div class="help-panel-header flex-shrink-0 px-5 py-4 border-b border-white/[0.07] flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center flex-shrink-0 shadow-lg">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                </div>
                <div>
                    <p id="help-panel-title" class="text-sm font-semibold text-white">Help &amp; Support</p>
                    <p class="text-[11px] text-gray-500">{{ company.name }}</p>
                </div>
            </div>
            <button data-help-close @click="helpOpen = false" class="help-panel-close rounded-lg flex items-center justify-center text-gray-500 hover:text-white hover:bg-white/10 transition-colors" aria-label="Close Help and Support">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        {# Scrollable body #}
        <div class="help-scroll-body flex-1 overflow-y-auto py-4 px-4 space-y-3">

            {# Live Chat CTA — only if URL configured #}
            {% set _chat_url = settings.support_chat_url|default('') %}
            {% if _chat_url %}
            <a href="{{ _chat_url }}" target="_blank" rel="noopener"
               class="flex items-center justify-center gap-2.5 w-full px-4 py-3 rounded-xl text-white text-sm font-semibold transition-all hover:opacity-90 hover:shadow-lg"
               style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 4px 16px rgba(var(--color-primary-rgb),0.25);">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                {{ settings.support_chat_label|default('Start Live Chat') }}
            </a>
            {% endif %}

            {# Customer Services section #}
            <div class="help-panel-card rounded-xl overflow-hidden border border-white/[0.07]">
                <div class="px-4 py-3 border-b border-white/[0.06] flex items-center gap-2">
                    <svg class="w-4 h-4 text-indigo-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <p class="text-xs font-semibold text-gray-300 uppercase tracking-wider">Customer Services</p>
                </div>

                <div class="divide-y divide-white/[0.04]">
                    {# Support Ticket #}
                    {% if settings.support_show_ticket|default('1') != '0' %}
                    {% set _ticket_url = settings.support_ticket_url|default(client ? '/support' : '/support/contact-us') %}
                    <a href="{{ _ticket_url|url }}"
                       class="flex items-center gap-3 px-4 py-3 text-sm text-gray-400 hover:text-white hover:bg-white/[0.04] transition-all">
                        <span class="w-6 h-6 rounded-md bg-violet-500/20 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
                        </span>
                        {{ settings.support_ticket_label|default('Create Support Ticket') }}
                    </a>
                    {% endif %}

                    {# Sales Ticket #}
                    {% if settings.support_show_sales_ticket|default('1') != '0' %}
                    {% set _sales_url = settings.support_sales_ticket_url|default(client ? '/support' : '/support/contact-us') %}
                    <a href="{{ _sales_url|url }}"
                       class="flex items-center gap-3 px-4 py-3 text-sm text-gray-400 hover:text-white hover:bg-white/[0.04] transition-all">
                        <span class="w-6 h-6 rounded-md bg-pink-500/20 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                        </span>
                        {{ settings.support_sales_ticket_label|default('Create Sales Ticket') }}
                    </a>
                    {% endif %}

                    {# View existing tickets (only for logged-in clients) #}
                    {% if client and settings.support_show_view_tickets|default('1') != '0' %}
                    <a href="{{ '/support'|url }}"
                       class="flex items-center gap-3 px-4 py-3 text-sm text-gray-400 hover:text-white hover:bg-white/[0.04] transition-all">
                        <span class="w-6 h-6 rounded-md bg-indigo-500/20 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                        </span>
                        View My Tickets
                    </a>
                    {% endif %}

                    {# WhatsApp #}
                    {% set _support_wa = settings.support_whatsapp|default('') %}
                    {% if _support_wa and settings.support_show_whatsapp|default('1') != '0' %}
                    <a href="https://wa.me/{{ _support_wa|replace({'+': '', ' ': '', '-': ''}) }}" target="_blank" rel="noopener"
                       class="flex items-center gap-3 px-4 py-3 text-sm text-gray-400 hover:text-white hover:bg-white/[0.04] transition-all">
                        <span class="w-6 h-6 rounded-md bg-emerald-500/20 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                        </span>
                        WhatsApp Support
                    </a>
                    {% endif %}

                    {# Phone #}
                    {% set _support_phone = settings.support_phone|default(company.tel|default(''))|default('') %}
                    {% if _support_phone and settings.support_show_phone|default('1') != '0' %}
                    <a href="tel:{{ _support_phone|replace({' ': ''}) }}"
                       class="flex items-center gap-3 px-4 py-3 text-sm text-gray-400 hover:text-white hover:bg-white/[0.04] transition-all">
                        <span class="w-6 h-6 rounded-md bg-sky-500/20 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                        </span>
                        {{ _support_phone }}
                    </a>
                    {% endif %}

                    {# Submit Feedback #}
                    {% if settings.support_show_feedback|default('1') != '0' %}
                    {% set _feedback_url = settings.support_feedback_url|default('/support/contact') %}
                    <a href="{{ _feedback_url|url }}"
                       class="flex items-center gap-3 px-4 py-3 text-sm text-gray-400 hover:text-white hover:bg-white/[0.04] transition-all">
                        <span class="w-6 h-6 rounded-md bg-teal-500/20 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                        </span>
                        {{ settings.support_feedback_label|default('Submit Feedback') }}
                    </a>
                    {% endif %}

                    {# Knowledge Base #}
                    {% if settings.support_show_kb|default('1') != '0' %}
                    {% set _kb_url = settings.support_kb_url|default('/support/kb') %}
                    <a href="{{ _kb_url|url }}"
                       class="flex items-center gap-3 px-4 py-3 text-sm text-gray-400 hover:text-white hover:bg-white/[0.04] transition-all">
                        <span class="w-6 h-6 rounded-md bg-amber-500/20 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                        </span>
                        {{ settings.support_kb_label|default('Knowledge Base') }}
                    </a>
                    {% endif %}

                    {# Getting Started #}
                    {% if settings.support_show_getting_started|default('1') != '0' %}
                    {% set _gs_url = settings.support_getting_started_url|default('/support/kb') %}
                    <a href="{{ _gs_url|url }}"
                       class="flex items-center gap-3 px-4 py-3 text-sm text-gray-400 hover:text-white hover:bg-white/[0.04] transition-all">
                        <span class="w-6 h-6 rounded-md bg-orange-500/20 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        </span>
                        {{ settings.support_getting_started_label|default('Getting Started Guide') }}
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Status footer #}
        <div class="help-panel-footer flex-shrink-0 px-4 py-3 border-t border-white/[0.07]">
            <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <div>
                    <p class="text-xs font-semibold text-emerald-400">All Systems Operational</p>
                    <p class="text-[11px] text-gray-600">{{ company.name }} services running normally</p>
                </div>
            </div>
        </div>
    </div>
    <!-- /Help & Support panel -->

    {% if _show_sidebar %}
    <!-- Desktop sidebar collapse toggle — fixed pill anchored to sidebar right edge middle -->
    <button id="sidebar-toggle"
            x-show="!helpOpen"
            x-transition.opacity.duration.120ms
            @click.stop="sidebarCollapsed = !sidebarCollapsed; helpOpen = false"
            :aria-expanded="(!sidebarCollapsed).toString()"
            aria-controls="sidebar"
            title="Toggle sidebar"
            class="hidden lg:flex fixed top-1/2 -translate-y-1/2 z-[51] w-7 h-7 rounded-full
                   border border-white/15 bg-[#0a0f1e] items-center justify-center
                   text-gray-400 hover:text-white hover:border-indigo-500/60 hover:bg-indigo-500/10
                   shadow-lg transition-all duration-300 ease-in-out">
        <svg x-show="!sidebarCollapsed" x-cloak class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 19l-7-7 7-7M19 19l-7-7 7-7"/>
        </svg>
        <svg x-show="sidebarCollapsed" x-cloak class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 5l7 7-7 7"/>
        </svg>
    </button>
    {% endif %}

    <!-- ========== MAIN AREA ========== -->
    {# `clip` prevents horizontal paint overflow without creating a scroll
       container. Using `hidden` here breaks position:sticky descendants
       inside the independently scrolling #main-content order flow. #}
    <div class="flex-1 flex flex-col min-w-0 overflow-x-clip">

        <!-- Top bar -->
        <header id="global-topbar" class="relative z-30 border-b border-slate-200 dark:border-white/[0.07] bg-white dark:bg-slate-900/80 flex-shrink-0 px-4 sm:px-8 h-16 flex items-center justify-between">
        {{ render_widgets('client.theme.header.start') }}
            {% if isDashboardRoute %}
            <div class="w-full flex items-center justify-between gap-4">
                <div class="flex items-center gap-2">
                    {% if _show_sidebar %}<button @click="sidebarOpen = !sidebarOpen" class="lg:hidden p-2 rounded-lg text-slate-400 hover:text-primary hover:bg-violet-50 transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                    </button>{% endif %}
                </div>
                <div class="flex items-center gap-1 text-slate-500">
                    {# Notification bell #}
                    {% include 'partial_notifications.html.twig' with {
                        _notif_client: client is not null,
                        _notif_news:   _notif_news,
                        _notif_dark:   false
                    } only %}

                    <a id="cart-link-topbar-dashboard" href="{{ '/cart'|url }}" title="Cart"
                       aria-label="Shopping cart"
                       class="relative rounded-lg p-2 transition-colors hover:bg-indigo-50 hover:text-indigo-500">
                        <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                        <span id="cart-badge-topbar-dashboard"
                              class="absolute -top-0.5 -right-0.5 w-[18px] h-[18px] rounded-full text-white text-[9px] font-bold flex items-center justify-center leading-none"
                              style="background: linear-gradient(135deg,var(--color-primary),var(--color-secondary)); display:{{ cartCount > 0 ? 'flex' : 'none' }};">{{ cartCount > 0 ? cartCount : '' }}</span>
                    </a>

                    {% if not client and currencies|length > 1 %}
                    <div class="relative hidden sm:block" x-data="{ open: false }" @click.outside="open=false">
                        <button @click="open=!open" type="button"
                                class="flex items-center gap-1 p-2 rounded-lg text-slate-500 transition-colors hover:bg-indigo-50 hover:text-indigo-500"
                                title="Change currency">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 0c2.5 2.7 3.8 6 3.8 10s-1.3 7.3-3.8 10m0-20C9.5 4.7 8.2 8 8.2 12s1.3 7.3 3.8 10"/></svg>
                            <span class="text-xs font-semibold">{{ currentCurrency.code }}</span>
                            <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                        </button>
                        <div x-show="open"
                             x-transition:enter="transition ease-out duration-200"
                             x-transition:enter-start="opacity-0 translate-y-1"
                             x-transition:enter-end="opacity-100 translate-y-0"
                             x-transition:leave="transition ease-in duration-150"
                             x-transition:leave-start="opacity-100 translate-y-0"
                             x-transition:leave-end="opacity-0 translate-y-1"
                             class="absolute right-0 top-full mt-1.5 w-44 bg-white border border-slate-200 rounded-lg shadow-lg shadow-black/[0.06] py-1.5 z-50">
                            <p class="px-4 pt-1.5 pb-1 text-[10px] font-semibold text-gray-600 uppercase tracking-wider">Currency</p>
                            {% for code, title in currencies %}
                            <button type="button" data-set-currency="{{ code }}"
                                    class="w-full flex items-center gap-2.5 px-4 py-2 text-sm hover:bg-white/[0.04] transition-all {{ currentCurrency.code == code ? 'text-indigo-400' : 'text-gray-400 hover:text-slate-700' }}">
                                <span class="text-xs font-mono font-bold w-8 text-left {{ currentCurrency.code == code ? 'text-indigo-400' : 'text-gray-500' }}">{{ code }}</span>
                                <span class="text-xs truncate">{{ title }}</span>
                                {% if currentCurrency.code == code %}
                                <svg class="w-3 h-3 text-indigo-400 ml-auto flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                {% endif %}
                            </button>
                            {% endfor %}
                        </div>
                    </div>
                    {% else %}
                    <span class="hidden sm:flex items-center gap-1 p-2 rounded-lg text-slate-500" title="Current currency">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 0c2.5 2.7 3.8 6 3.8 10s-1.3 7.3-3.8 10m0-20C9.5 4.7 8.2 8 8.2 12s1.3 7.3 3.8 10"/></svg>
                        <span class="text-xs font-semibold">{{ currentCurrency.code }}</span>
                    </span>
                    {% endif %}
                    {% if _supportpin_on %}
                    <button type="button" @click="$dispatch('supportpin-open')" title="Support PIN"
                            aria-label="Show support PIN"
                            class="rounded-lg p-2 transition-colors hover:bg-indigo-50 hover:text-indigo-500 text-slate-500">
