{# ── Support PIN Modal ── #}
<div x-data="SupportPinModal()"
     @supportpin-open.window="open()"
     x-cloak>
    {# Backdrop — visual only, no click handler #}
    <div x-show="isOpen"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 bg-[#0b1c30]/60 backdrop-blur-sm z-[60]"
         style="pointer-events:none">
    </div>
    {# Dialog wrapper — z-61, handles click-outside-to-close #}
    <div x-show="isOpen"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         @click="close()"
         @keydown.escape.window="close()"
         class="fixed inset-0 flex items-center justify-center p-4"
         style="z-index:61">
        <div class="bg-white dark:bg-slate-800 w-full rounded-xl shadow-2xl overflow-hidden relative border border-slate-200 dark:border-slate-700"
             style="max-width:480px"
             @click.stop>
            {# Close button #}
            <button @click="close()" type="button"
                    class="absolute top-3 right-3 p-2 rounded-full text-slate-400 hover:text-slate-600 hover:bg-slate-100 dark:hover:text-slate-200 dark:hover:bg-slate-700 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>

            <div class="px-8 py-8 pt-10 text-center">
                {# Heading #}
                <h2 class="text-2xl font-semibold text-slate-900 dark:text-slate-100 mb-2">{{ 'Your 6-Digit Support PIN'|trans }}</h2>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-7 leading-relaxed">
                    {{ 'Use this PIN to verify your identity when contacting support for account-level assistance.'|trans }}
                </p>

                {# Loading state #}
                <div x-show="loading" class="py-8 flex items-center justify-center">
                    <svg class="w-8 h-8 text-indigo-400 animate-spin" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                    </svg>
                </div>

                {# PIN digit boxes #}
                <div x-show="!loading" class="mb-6">
                    <div class="bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-lg px-6 py-5 flex items-center justify-center">
                    <div class="flex items-center gap-2 justify-center">
                        {# Digits 1-3 #}
                        <template x-for="(d, i) in digits.slice(0,3)" :key="'a'+i">
                            <div class="w-12 h-16 bg-white dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-lg flex items-center justify-center shadow-sm">
                                <span x-text="revealed ? d : '•'"
                                      class="font-mono text-[28px] font-bold leading-none"
                                      :class="revealed ? 'text-indigo-600 dark:text-white' : 'text-slate-300 dark:text-slate-500'"></span>
                            </div>
                        </template>
                        {# Visual gap #}
                        <div class="w-3"></div>
                        {# Digits 4-6 #}
                        <template x-for="(d, i) in digits.slice(3)" :key="'b'+i">
                            <div class="w-12 h-16 bg-white dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-lg flex items-center justify-center shadow-sm">
                                <span x-text="revealed ? d : '•'"
                                      class="font-mono text-[28px] font-bold leading-none"
                                      :class="revealed ? 'text-indigo-600 dark:text-white' : 'text-slate-300 dark:text-slate-500'"></span>
                            </div>
                        </template>
                    </div>
                    </div>
                    {# Visibility toggle — centred below digit row #}
                    <div class="flex justify-center mt-2">
                    <button @click="revealed = !revealed" type="button"
                            class="flex items-center gap-1 px-3 py-1.5 rounded-full text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/50 transition-colors"
                            :title="revealed ? '{{ 'Hide PIN'|trans }}' : '{{ 'Show PIN'|trans }}'">
                        <svg x-show="!revealed" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                        <svg x-show="revealed" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:none">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
                        </svg>
                        <span x-text="revealed ? '{{ 'Hide PIN'|trans }}' : '{{ 'Show PIN'|trans }}'"></span>
                    </button>
                    </div>
                </div>

                {# Regen success note #}
                <div x-show="regenSuccess"
                     class="flex items-center gap-2 justify-center text-sm text-green-600 mb-4 -mt-2"
                     style="display:none">
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    {{ 'New PIN generated successfully.'|trans }}
                </div>

                {# Inline regenerate confirmation strip #}
                <div x-show="confirmingRegen" style="display:none"
                     class="mb-4 p-4 rounded-lg bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700/50">
                    <p class="text-sm font-medium text-amber-800 dark:text-amber-200 mb-3">
