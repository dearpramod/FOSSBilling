                                class="flex-1 py-2 rounded-lg bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold transition-colors disabled:opacity-50">
                            <span x-text="regenerating ? '{{ 'Generating…'|trans }}' : '{{ 'Yes, replace it'|trans }}'"></span>
                        </button>
                        <button type="button" @click="confirmingRegen = false"
