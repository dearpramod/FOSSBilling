{% set active_locale = guest.system_locale|default('en')|replace({'_': '-'}) %}
{% set normalizedPath = (request_path|default(request.uri|default('/')))|trim('/')|lower %}
{% set isOrderFlowRoute = normalizedPath starts with 'order' and not (normalizedPath starts with 'order/service') %}
<!DOCTYPE html>
<html lang="{{ active_locale }}" class="h-full">
<head>
    <meta charset="utf-8">
    <title>{% block meta_title %}Dashboard{% endblock %} — {{ guest.system_company.name }}</title>
    <meta name="description" content="{% block meta_description %}{% if settings.meta_description|default(false) %}{{ settings.meta_description }}{% else %}{{ guest.system_company.name }} Client Portal{% endif %}{% endblock %}">
    {% if settings.meta_keywords|default(false) %}<meta name="keywords" content="{{ settings.meta_keywords }}">{% endif %}
    {% if settings.meta_robots|default(false) %}<meta name="robots" content="{{ settings.meta_robots }}">{% endif %}
    {% if settings.meta_author|default(false) %}<meta name="author" content="{{ settings.meta_author }}">{% endif %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ CSRFToken }}">
    {% if isOrderFlowRoute %}
    {# Enables the order skeleton only when JavaScript is available. #}
    <script>document.documentElement.classList.add('order-skeleton-enabled');</script>
    {% endif %}
    {# Prevent browser HTTP cache from storing authenticated pages #}
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate, private">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    {# bfcache guard: fires when browser restores page from Back-Forward Cache without a new HTTP request.
       Validates the client session via API and redirects to login if it has been destroyed (e.g. after logout). #}
    <script>
    window.addEventListener('pageshow', (e) => {
        if (!e.persisted) return;
        fetch('/api/client/profile/get', { method: 'GET', credentials: 'same-origin', headers: { Accept: 'application/json' } })
            .then((r) => r.json())
            .then((d) => { if (d && d.error) window.location.replace('/login'); })
            .catch(() => {});
    });
    </script>

    {# ── Theme color custom properties (shared partial: full brand scale) ── #}
    {% include 'partials/theme_colors.html.twig' %}
    <link rel="shortcut icon" href="{{ guest.system_company.favicon_url }}">
    <link rel="canonical" href="{% block canonical_url %}{{ constant('SYSTEM_URL') ~ request_path|trim('/') }}{% endblock %}">
    {% block opengraph %}
    <meta property="og:title" content="{{ (settings.meta_title_prefix|default('') ~ ' ' ~ block('meta_title') ~ ' ' ~ settings.meta_title_suffix|default(''))|trim }}">
    <meta property="og:type" content="website">
    <meta property="og:description" content="{{ block('meta_description') }}">
    <meta property="og:url" content="{{ constant('SYSTEM_URL') ~ request_path|trim('/') }}">
    {% if guest.system_company.logo_url %}<meta property="og:image" content="{{ guest.system_company.logo_url }}">{% endif %}
    {% endblock %}

    {# Fonts: preconnect + non-blocking load #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {# Inter (UI/body) + Inter Tight (headings) + JetBrains Mono (code/logs) — MeroVPS brand fonts #}
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Inter+Tight:wght@600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Inter+Tight:wght@600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" rel="stylesheet">
        <style>[x-cloak],[x-show]{display:block!important}</style>
        <div style="position:fixed;top:0;left:0;right:0;padding:0.75rem 1rem;background:#f59e0b;color:#1c1917;font-size:0.875rem;z-index:9999;text-align:center;">{{ 'JavaScript is required for the full client portal experience. Please enable JavaScript.'|trans }}</div>
    </noscript>
    <!-- Vendor CSS (flag-icons, tom-select) -->
    <link rel="stylesheet" href="{{ 'build/css/vendor.css' | asset_url }}">
    <!-- Theme CSS: Tailwind utilities + theme.css + custom.css (all bundled, minified in production) -->
    <link rel="stylesheet" href="{{ 'build/css/meroserver.css' | asset_url }}">

    <script defer src="{{ 'js/main.js' | public_asset_url }}"></script>
    <script src="{{ 'js/api.js' | public_asset_url }}"></script>
    <!-- Merotheme bundle: Alpine.js + @alpinejs/collapse (defer: Alpine.start() runs after DOM parsed) -->
    <script defer src="{{ 'build/js/meroserver.js' | asset_url }}"></script>

    <!-- Panel utility shims (bb, FBPanel) -->
    <script>
    (function () {
        // Notification container (appended to body on first use)
        function getNotifContainer() {
            var c = document.getElementById('merovps-notif');
            if (!c) {
                c = document.createElement('div');
                c.id = 'merovps-notif';
                c.setAttribute('role', 'status');
                c.setAttribute('aria-live', 'polite');
                c.setAttribute('aria-atomic', 'true');
                // z-index 9999 — always above modals, sidebar toggle, and all overlays
                c.style.cssText = 'position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;display:flex;flex-direction:column;gap:0.625rem;max-width:22rem;pointer-events:none;';
                document.body.appendChild(c);
            }
            return c;
        }

        globalThis.FBPanel = {
            message: function (message, type) {
                var icons = {
                    error:   '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>',
                    success: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>',
                    warning: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>',
                    info:    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>'
                };
                var accent = { error: '#ef4444', success: '#22c55e', warning: '#f59e0b', info: '#6366f1' };
                var color  = accent[type] || accent.info;
                var icon   = icons[type]  || icons.info;
                var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                var rootStyle = getComputedStyle(document.documentElement);
                var primaryColor = rootStyle.getPropertyValue('--color-primary').trim() || '#6366f1';
                var usePrimary = (type === 'info') ? primaryColor : color;
                var bgCard  = isDark ? 'rgba(10,14,26,0.88)' : 'rgba(255,255,255,0.94)';
                var border  = isDark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.06)';
                var txtColor = isDark ? '#f1f5f9' : '#0f172a';
                var el = document.createElement('div');
                el.style.cssText = [
                    'background:' + bgCard,
                    'border:1px solid ' + border,
                    'backdrop-filter:blur(16px) saturate(1.6)',
                    '-webkit-backdrop-filter:blur(16px) saturate(1.6)',
                    'color:' + txtColor,
                    'padding:0.875rem 1rem',
                    'border-radius:0.875rem',
                    'font-size:0.8125rem',
                    'display:flex',
                    'align-items:flex-start',
                    'gap:0.625rem',
                    'box-shadow:0 8px 32px rgba(0,0,0,0.18),0 1.5px 4px rgba(0,0,0,0.08),inset 0 1px 0 rgba(255,255,255,0.12)',
                    'pointer-events:auto',
                    'transform:translateY(12px)',
                    'opacity:0',
                    'transition:transform 240ms cubic-bezier(0.34,1.4,0.64,1),opacity 200ms ease-out',
                    'border-left:3px solid ' + usePrimary
                ].join(';');
                el.innerHTML = '<svg style="width:1rem;height:1rem;flex-shrink:0;color:' + usePrimary + ';margin-top:0.0625rem" fill="none" stroke="currentColor" viewBox="0 0 24 24">' + icon + '</svg>' +
                    '<span style="flex:1;line-height:1.45;font-weight:500">' + message.replace(/</g,'&lt;') + '</span>' +
                    '<button onclick="this.parentElement._removeToast()" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:1.1rem;line-height:1;padding:0;margin-left:0.25rem;flex-shrink:0;pointer-events:auto">&times;</button>';
                el._removeToast = function() {
                    el.style.transform = 'translateY(12px)';
                    el.style.opacity   = '0';
                    setTimeout(function(){ el.remove(); }, 220);
                };
                getNotifContainer().appendChild(el);
                requestAnimationFrame(function(){
                    requestAnimationFrame(function(){
                        el.style.transform = 'translateY(0)';
                        el.style.opacity   = '1';
                    });
                });
                setTimeout(function () { if (el.parentElement) el._removeToast(); }, 7000);
            }
        };

        globalThis.bb = {
            redirect: function (url) { window.location = url; },
            reload: function () { window.location.reload(true); }
        };

        // Extend FOSSBilling with panel notification methods while preserving FOSSBilling.api.*
        globalThis.FOSSBilling = Object.assign(globalThis.FOSSBilling || {}, globalThis.FBPanel);
        // Shorthand alias used throughout templates: API.client.post(...) etc.
        globalThis.API = window.FOSSBilling.api;
        // StablePanel: thin alias used across templates for toast notifications.
        globalThis.StablePanel = { message: function(msg, type) { FOSSBilling.message(msg, type); } };
    })();
    </script>

    {# Prevent layout-shift on reload — runs synchronously before first paint #}
    <script>
    (function(){
        var c = localStorage.getItem('sb_collapsed');
        if (c === '1') document.documentElement.setAttribute('data-sb', 'collapsed');
        var t = localStorage.getItem('merovps_theme') || 'light';
        document.documentElement.setAttribute('data-theme', t);
    })();
    </script>
    <style>
    /* Applied before Alpine boots — prevents flash of wrong sidebar width/position */
    #sidebar { width: 17.25rem; }
    html[data-sb="collapsed"] #sidebar { width: 4rem; }
    #sidebar-toggle { left: calc(17.25rem - 14px); transition: left 300ms ease-in-out; }
    html[data-sb="collapsed"] #sidebar-toggle { left: calc(4rem - 14px); }
    /* Show correct chevron before Alpine boots */
    #sidebar-toggle svg:first-of-type  { display: flex; }
    #sidebar-toggle svg:last-of-type   { display: none; }
    html[data-sb="collapsed"] #sidebar-toggle svg:first-of-type { display: none; }
    html[data-sb="collapsed"] #sidebar-toggle svg:last-of-type  { display: flex; }
    /* Sidebar logo — pre-Alpine FOUC prevention (mirrors x-show logic) */
    .sb-logo-icon { display: none; }
    .sb-logo-full { display: flex; }
    html[data-sb="collapsed"] .sb-logo-icon { display: flex; }
    html[data-sb="collapsed"] .sb-logo-full { display: none; }
    /* Chat icon float animation */
    @keyframes chat-float {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-3px); }
    }
    .chat-icon-animate { animation: chat-float 2.8s ease-in-out infinite; }
    /* Green dot ping ripple */
    @keyframes dot-ping {
        0%        { transform: scale(1);   opacity: 0.9; }
        70%, 100% { transform: scale(2.2); opacity: 0; }
    }
    .dot-ping { animation: dot-ping 2s ease-out infinite; }
    </style>

    {% set _gtm_on = guest.extension_is_on({ "mod": "googletagmanager" }) %}
    {% if _gtm_on %}
    {{ guest.googletagmanager_head_snippet|raw }}
    {% endif %}
    {{ debug_bar_render_head() }}
    {% block head %}{% endblock %}
</head>

{% set orderServicesActive = 'order/domain-registration' in request.uri or 'order/domain-transfer' in request.uri or (request.uri starts with '/order' and 'service' not in request.uri and 'checkout' not in request.uri) %}
{% set isDashboardRoute = normalizedPath == '' or normalizedPath starts with 'dashboard' %}
<body class="bg-[#f8f9ff] text-[#0b1c30] font-sans h-full {{ isOrderFlowRoute ? 'order-flow-page' : '' }} {% block body_class %}{% endblock %}" x-data="{ sidebarOpen: false, sidebarCollapsed: localStorage.getItem('sb_collapsed') === '1', helpOpen: false, orderServicesOpen: {{ orderServicesActive ? 'true' : 'false' }}, darkMode: localStorage.getItem('merovps_theme') === 'dark' }" x-init="document.documentElement.setAttribute('data-theme', darkMode ? 'dark' : 'light'); document.documentElement.setAttribute('data-sb', sidebarCollapsed ? 'collapsed' : 'expanded'); $watch('sidebarCollapsed', function(v){ localStorage.setItem('sb_collapsed', v ? '1' : '0'); document.documentElement.setAttribute('data-sb', v ? 'collapsed' : 'expanded'); }); $watch('darkMode', function(v){ var t = v ? 'dark' : 'light'; localStorage.setItem('merovps_theme', t); document.documentElement.setAttribute('data-theme', t); }); $watch('helpOpen', function(v){ document.documentElement.classList.toggle('help-panel-open', v); if(v){ $nextTick(function(){ var closeButton = document.querySelector('#help-panel [data-help-close]'); if(closeButton) closeButton.focus({preventScroll:true}); }); } else { $nextTick(function(){ if($refs.helpTrigger) $refs.helpTrigger.focus({preventScroll:true}); }); } });">
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-white focus:text-indigo-600 focus:rounded-lg focus:ring-2 focus:ring-indigo-500 focus:shadow-lg">{{ 'Skip to main content'|trans }}</a>
{% if _gtm_on %}
{{ guest.googletagmanager_body_snippet|raw }}
{% endif %}
{{ render_widgets('client.theme.body.start') }}

{% if client and profile is not defined %}
    {% set profile = client.profile_get %}
{% endif %}
{% set _show_sidebar = true %}
{% set company = guest.system_company %}
{% set cart = guest.cart_get %}
{% set cartCount = cart.items is defined ? cart.items|length : 0 %}
{% set currencies = guest.currency_get_pairs %}
{% set currentCurrency = cart.currency %}

{# Auto-sync cart currency to client's billing currency (immutable after registration) #}
{% if client %}
    {% set _clientCurrency = profile.currency|default(null) %}
    {% if _clientCurrency and currentCurrency.code != _clientCurrency %}
        {% set _sync = guest.cart_set_currency({'currency': _clientCurrency}) %}
        {% set currentCurrency = {'code': _clientCurrency} %}
    {% endif %}
{% endif %}

{# ── Notification data (addon — no core PHP changes) ── #}
{% set _partnership_on = guest.extension_is_on({'mod': 'partnership'}) %}
{% set _sidebar_unverified = client and guest.client_is_email_validation_required and not profile.email_approved|default(false) %}
{% set _news_on = guest.extension_is_on({'mod': 'news'}) %}
{% set _supportpin_on = client and guest.extension_is_on({'mod': 'supportpin'}) %}
{% set _notif_news = _news_on ? guest.news_get_list({'per_page': 3}) : {'list': [], 'total': 0} %}
{# Invoice data is fetched async via JS — no server-side query per page load #}

{% if _show_sidebar %}
<!-- Mobile sidebar overlay -->
<div x-show="sidebarOpen" x-cloak
     x-transition:enter="transition-opacity ease-out duration-200"
     x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
     x-transition:leave="transition-opacity ease-in duration-150"
     x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
     class="sidebar-overlay fixed inset-0 z-40 bg-black/60 lg:hidden" @click="sidebarOpen = false">
</div>
{% endif %}

<div class="flex h-screen overflow-hidden">

    <!-- ========== SIDEBAR ========== -->
    {% if _show_sidebar %}
    <aside id="sidebar"
           :class="[
               sidebarOpen ? 'translate-x-0' : '-translate-x-full',
               sidebarCollapsed ? 'lg:w-16' : 'lg:w-[17.25rem]'
           ]"
           class="saas-sidebar fixed inset-y-0 left-0 z-50 lg:z-auto w-[17.25rem] bg-white border-r border-slate-200 flex flex-col transform lg:translate-x-0 lg:relative">

           <!-- Logo -->
           <div class="saas-sidebar-header flex-shrink-0 flex items-center border-b border-slate-200 transition-all duration-300"
               :class="sidebarCollapsed ? 'justify-center px-0 py-3' : 'flex-col justify-center gap-1 px-4 py-3 text-center'">
            <!-- Collapsed: favicon icon -->
            <a x-show="sidebarCollapsed" x-transition.opacity.duration.150ms href="{{ '/'|url }}" class="sb-logo-icon w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 overflow-hidden">
                {% if settings.logo_favicon|default(false) %}
                <img src="{{ settings.logo_favicon }}" alt="{{ company.name }}" class="w-6 h-6 object-contain">
                {% else %}
                <img src="{{ guest.system_company.favicon_url|default('branding/favicon.ico'|public_asset_url) }}" alt="{{ company.name }}" class="w-6 h-6 object-contain">
                {% endif %}
            </a>
            <!-- Expanded: logo or brand text, with dashboard label below -->
            <div x-show="!sidebarCollapsed" x-transition.opacity.duration.150ms class="sb-logo-full flex-col items-center min-w-0 flex-1 overflow-hidden">
                {% if settings.logo_url|default(false) %}
                    <a href="{{ '/'|url }}" class="flex-shrink-0 overflow-hidden">
                        <img src="{{ settings.logo_url }}" alt="{{ company.name }}" class="h-7 w-auto logo-img mx-auto">
                    </a>
                {% else %}
                    <a href="{{ '/'|url }}" class="flex-shrink-0 overflow-hidden">
                        <p class="text-sm font-bold text-slate-900 truncate leading-tight">{{ company.name }}</p>
                    </a>
                {% endif %}
                {% if client %}
                <p class="mt-0.5 text-xs text-slate-500 truncate leading-tight">Client Dashboard</p>
                {% endif %}
            </div>
        </div>

        <!-- Navigation -->
        <nav class="saas-sidebar-nav flex-1 py-4 space-y-1 overflow-y-auto overflow-x-hidden"
             :class="sidebarCollapsed ? 'px-2' : 'px-3'">

            {% if _supportpin_on %}
            <div class="pb-2" x-show="!sidebarCollapsed">
                <button type="button"
                        @click="$dispatch('supportpin-open')"
                        class="flex items-center justify-center gap-2 w-full py-2.5 rounded-lg text-sm font-semibold text-white transition-all hover:opacity-90 shadow-sm shadow-indigo-500/20"
                        style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                    </svg>
                    {{ 'Support PIN'|trans }}
                </button>
            </div>
            {% elseif client %}
            <div class="pb-2" x-show="!sidebarCollapsed">
                <a href="{{ '/order'|url }}"
                   class="flex items-center justify-center gap-2 w-full py-2.5 rounded-lg text-sm font-semibold text-white transition-all hover:opacity-90 shadow-sm shadow-indigo-500/20"
                   style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                    </svg>
                    {{ 'Place New Order'|trans }}
                </a>
            </div>
            {% endif %}

            {% if settings.nav_dashboard|default('1') != '0' %}
            <a href="{{ '/dashboard'|url }}" title="Home"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150
                      {% if request.uri == '/' or request.uri == '/dashboard' %}bg-violet-50 text-primary border-l-[3px] border-l-primary rounded-r-md rounded-tl-none rounded-bl-none{% else %}text-slate-500 hover:bg-violet-50 hover:text-primary{% endif %}"
               :class="sidebarCollapsed ? 'justify-center px-2' : ''">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
                <span :class="sidebarCollapsed ? 'opacity-0 w-0 overflow-hidden' : 'opacity-100'" class="transition-all duration-200 whitespace-nowrap">Home</span>
            </a>
            {% endif %}

            {# ===== My Services (simple link) ===== #}
            {% if settings.nav_services|default('1') != '0' %}
            {% if _sidebar_unverified %}<div class="sb-lock-wrap">{% endif %}
            <a href="{{ '/order/service'|url }}" title="My Services"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150
                      {% if 'order/service' in request.uri %}bg-violet-50 text-primary border-l-[3px] border-l-primary rounded-r-md rounded-tl-none rounded-bl-none{% else %}text-slate-500 hover:bg-violet-50 hover:text-primary{% endif %}
                      {% if _sidebar_unverified %} opacity-40 pointer-events-none{% endif %}"
               :class="sidebarCollapsed ? 'justify-center px-2' : ''"{% if _sidebar_unverified %} aria-disabled="true"{% endif %}>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3h14a2 2 0 012 2v4a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2zm0 10h14a2 2 0 012 2v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4a2 2 0 012-2z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h.01M8 17h.01"/>
                </svg>
                <span :class="sidebarCollapsed ? 'opacity-0 w-0 overflow-hidden' : 'opacity-100'" class="transition-all duration-200 whitespace-nowrap">My Services</span>
            </a>
            {% if _sidebar_unverified %}<div class="sb-lock-tip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>Verify your email</div></div>{% endif %}
            {% endif %}

            {# ===== Order Services (collapsible group) ===== #}
            {% if settings.nav_order|default('1') != '0' %}
            {% if _sidebar_unverified %}<div class="sb-lock-wrap">{% endif %}
            {# Collapsed sidebar: single icon link #}
            <a x-show="sidebarCollapsed"
               x-transition:enter="transition ease-out duration-200"
               x-transition:enter-start="opacity-0 scale-95"
               x-transition:enter-end="opacity-100 scale-100"
               x-transition:leave="transition ease-in duration-150"
               x-transition:leave-start="opacity-100 scale-100"
               x-transition:leave-end="opacity-0 scale-95"
               href="{{ '/order'|url }}" title="Order Services"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150
                      {% if orderServicesActive %}bg-violet-50 text-primary border-l-[3px] border-l-primary rounded-r-md rounded-tl-none rounded-bl-none{% else %}text-slate-500 hover:bg-violet-50 hover:text-primary{% endif %}
                      {% if _sidebar_unverified %} opacity-40 pointer-events-none{% endif %}"
               :class="sidebarCollapsed ? 'justify-center px-2' : ''"{% if _sidebar_unverified %} aria-disabled="true" title="Verify your email to place orders"{% endif %}>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
