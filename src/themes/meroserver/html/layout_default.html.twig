                <button @click="orderServicesOpen = !orderServicesOpen"
                        :aria-expanded="orderServicesOpen.toString()"
                        aria-controls="sidebar-order-services"
                        class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150
                               {% if orderServicesActive %}bg-violet-50 text-primary border-l-[3px] border-l-primary rounded-r-md rounded-tl-none rounded-bl-none{% else %}text-slate-500 hover:bg-violet-50 hover:text-primary{% endif %}">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    <span class="flex-1 text-left whitespace-nowrap">Order Services</span>
                    <svg class="w-3.5 h-3.5 transition-transform duration-200" :class="orderServicesOpen ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
                    </svg>
                </button>

                {# Alpine measures the real submenu height for a reliable reveal. #}
                <div id="sidebar-order-services"
                     x-show="orderServicesOpen"
                     x-collapse.duration.240ms
                     class="sidebar-nav-accordion"
                     :class="{ 'snav-open': orderServicesOpen }"
                     :aria-hidden="(!orderServicesOpen).toString()">
                <div class="sidebar-nav-accordion-inner mt-1 ml-4 pl-3 border-l border-slate-200 space-y-0.5">

                          <a href="{{ '/order'|url }}"
                              class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium transition-all duration-150
                              {% if request.uri == '/order' %}text-primary bg-violet-50{% else %}text-slate-400 hover:text-primary hover:bg-violet-50{% endif %}">
                        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
                        </svg>
                        All Products
                    </a>

                    {%- set sidebarCategories = guest.product_category_get_list({'per_page': 50, 'deep': 0}) -%}
                    {%- set _sb_type_order = {'hosting': 0, 'server': 1, 'custom': 2, 'domain': 3, 'downloadable': 4, 'license': 5, 'membership': 6} -%}
                    {%- set _sb_type_icons = {
                        'hosting':      {'path': 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2', 'active': 'text-indigo-400 bg-indigo-500/10'},
                        'server':       {'path': 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z', 'active': 'text-amber-400 bg-amber-500/10'},
                        'custom':       {'path': 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4', 'active': 'text-purple-400 bg-purple-500/10'},
                        'domain':       {'path': 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9', 'active': 'text-violet-400 bg-violet-500/10'},
                        'downloadable': {'path': 'M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4', 'active': 'text-emerald-400 bg-emerald-500/10'},
                        'license':      {'path': 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', 'active': 'text-blue-400 bg-blue-500/10'},
                        'membership':   {'path': 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z', 'active': 'text-rose-400 bg-rose-500/10'}
                    } -%}
                    {%- set _sb_sorted = sidebarCategories.list|sort((a, b) => (_sb_type_order[a.type]|default(99)) <=> (_sb_type_order[b.type]|default(99))) -%}
                    {% for category in _sb_sorted %}
                    {%- set _ci = _sb_type_icons[category.type]|default({'path': 'M5 12h14M12 5l7 7-7 7', 'active': 'text-indigo-400 bg-indigo-500/10'}) -%}
                    {%- set catSlug = (category.type == 'domain') ? 'domain-registration' : (category.title|lower|replace({' ': '-', '  ': '-', '   ': '-'})|trim('-')) -%}
                    {%- set catHref = ('/order/' ~ catSlug)|url -%}
                    {%- set catActive = (('order/' ~ catSlug) in request.uri) or (category.type == 'domain' and ('order/domain-' in request.uri)) -%}
                          <a href="{{ catHref }}"
                              class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium transition-all duration-150
                              {{ catActive ? _ci.active : 'text-slate-400 hover:text-primary hover:bg-violet-50' }}">
                        {% if category.icon_url %}
                        <img src="{{ category.icon_url }}" alt="" class="w-3.5 h-3.5 flex-shrink-0 object-contain">
                        {% else %}
                        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ _ci.path }}"/>
                        </svg>
                        {% endif %}
                        {{ category.title }}
                    </a>
                    {% endfor %}
                </div>
                </div>{# /sidebar-nav-accordion #}
            </div>

            {% if _sidebar_unverified %}<div class="sb-lock-tip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>Verify your email</div></div>{% endif %}
            {% endif %}{# /nav_order #}

            {% if settings.nav_support|default('1') != '0' %}
            <a href="{{ (client ? '/support' : '/support/contact-us')|url }}" title="Support"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150
                      {% if 'support' in request.uri %}bg-violet-50 text-primary border-l-[3px] border-l-primary rounded-r-md rounded-tl-none rounded-bl-none{% else %}text-slate-500 hover:bg-violet-50 hover:text-primary{% endif %}"
               :class="sidebarCollapsed ? 'justify-center px-2' : ''">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
                <span :class="sidebarCollapsed ? 'opacity-0 w-0 overflow-hidden' : 'opacity-100'" class="transition-all duration-200 whitespace-nowrap">Support</span>
            </a>
            {% endif %}

            <a href="{{ '/support/kb'|url }}" title="Knowledge Base"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150
                      {% if 'support/kb' in request.uri %}bg-violet-50 text-primary border-l-[3px] border-l-primary rounded-r-md rounded-tl-none rounded-bl-none{% else %}text-slate-500 hover:bg-violet-50 hover:text-primary{% endif %}"
               :class="sidebarCollapsed ? 'justify-center px-2' : ''">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
                <span :class="sidebarCollapsed ? 'opacity-0 w-0 overflow-hidden' : 'opacity-100'" class="transition-all duration-200 whitespace-nowrap">Knowledge Base</span>
            </a>

            <a href="{{ '/news'|url }}" title="News"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150
                      {% if 'news' in request.uri %}bg-violet-50 text-primary border-l-[3px] border-l-primary rounded-r-md rounded-tl-none rounded-bl-none{% else %}text-slate-500 hover:bg-violet-50 hover:text-primary{% endif %}"
               :class="sidebarCollapsed ? 'justify-center px-2' : ''">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                </svg>
                <span :class="sidebarCollapsed ? 'opacity-0 w-0 overflow-hidden' : 'opacity-100'" class="transition-all duration-200 whitespace-nowrap">News</span>
            </a>

            {% if client %}
            <div class="pt-4 pb-1" x-show="!sidebarCollapsed">
                <p class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">Account</p>
            </div>
            <div class="pt-4 pb-1" x-show="sidebarCollapsed">
                <div class="border-t border-slate-100"></div>
            </div>

            {% if settings.nav_invoices|default('1') != '0' %}
            <a href="{{ '/invoice'|url }}" title="Invoices"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150
                      {% if 'invoice' in request.uri %}bg-violet-50 text-primary border-l-[3px] border-l-primary rounded-r-md rounded-tl-none rounded-bl-none{% else %}text-slate-500 hover:bg-violet-50 hover:text-primary{% endif %}"
               :class="sidebarCollapsed ? 'justify-center px-2' : ''">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
                <span :class="sidebarCollapsed ? 'opacity-0 w-0 overflow-hidden' : 'opacity-100'" class="transition-all duration-200 whitespace-nowrap">Invoices</span>
            </a>
            {% endif %}

            {% if settings.nav_balance|default('1') != '0' %}
            <a href="{{ '/client/balance'|url }}" title="Credits &amp; Balance"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150
                      {% if 'client/balance' in request.uri %}bg-violet-50 text-primary border-l-[3px] border-l-primary rounded-r-md rounded-tl-none rounded-bl-none{% else %}text-slate-500 hover:bg-violet-50 hover:text-primary{% endif %}"
               :class="sidebarCollapsed ? 'justify-center px-2' : ''">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                </svg>
                <span :class="sidebarCollapsed ? 'opacity-0 w-0 overflow-hidden' : 'opacity-100'" class="transition-all duration-200 whitespace-nowrap">Credits &amp; Balance</span>
            </a>
            {% endif %}

            {% if settings.nav_profile|default('1') != '0' %}
            <a href="{{ '/client/profile'|url }}" title="Profile"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150
                      {% if 'client/profile' in request.uri %}bg-violet-50 text-primary border-l-[3px] border-l-primary rounded-r-md rounded-tl-none rounded-bl-none{% else %}text-slate-500 hover:bg-violet-50 hover:text-primary{% endif %}"
               :class="sidebarCollapsed ? 'justify-center px-2' : ''">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                <span :class="sidebarCollapsed ? 'opacity-0 w-0 overflow-hidden' : 'opacity-100'" class="transition-all duration-200 whitespace-nowrap">Profile</span>
            </a>
            {% if _partnership_on and client %}
            {% if _sidebar_unverified %}<div class="sb-lock-wrap">{% endif %}
            <a href="{{ '/partnership-program'|url }}" title="Partnership Program"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150
                      {% if 'partnership-program' in request.uri %}bg-violet-50 text-primary border-l-[3px] border-l-primary rounded-r-md rounded-tl-none rounded-bl-none{% else %}text-slate-500 hover:bg-violet-50 hover:text-primary{% endif %}
                      {% if _sidebar_unverified %} opacity-40 pointer-events-none{% endif %}"
               :class="sidebarCollapsed ? 'justify-center px-2' : ''"{% if _sidebar_unverified %} aria-disabled="true"{% endif %}>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v8a2 2 0 01-2 2h-2m-5-12V6a2 2 0 00-2-2H7a2 2 0 00-2 2v12a2 2 0 002 2h5a2 2 0 002-2v-2m0-8H9m4 0V7m0 1h4"/>
                </svg>
                <span :class="sidebarCollapsed ? 'opacity-0 w-0 overflow-hidden' : 'opacity-100'" class="transition-all duration-200 whitespace-nowrap">Partnership Program</span>
            </a>
            {% if _sidebar_unverified %}<div class="sb-lock-tip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>Verify your email</div></div>{% endif %}
            {% endif %}
            {% endif %}

            <a href="{{ '/email'|url }}" title="Email History"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150
                      {% if 'email' in request.uri %}bg-violet-50 text-primary border-l-[3px] border-l-primary rounded-r-md rounded-tl-none rounded-bl-none{% else %}text-slate-500 hover:bg-violet-50 hover:text-primary{% endif %}"
               :class="sidebarCollapsed ? 'justify-center px-2' : ''">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <span :class="sidebarCollapsed ? 'opacity-0 w-0 overflow-hidden' : 'opacity-100'" class="transition-all duration-200 whitespace-nowrap">Email History</span>
            </a>
            {% endif %}

        </nav>

        <!-- Help & Support trigger (panel lives outside aside to avoid transform stacking context) -->
        <div class="px-3 py-2">
            <button x-ref="helpTrigger"
                    @click.stop="helpOpen = !helpOpen; sidebarOpen = false"
                    title="Help &amp; Support"
                    aria-controls="help-panel"
                    :aria-expanded="helpOpen.toString()"
                    class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 text-slate-500 hover:bg-violet-50 hover:text-primary"
                    :class="[sidebarCollapsed ? 'justify-center px-2' : '', helpOpen ? 'bg-indigo-500/10 text-indigo-400 help-btn-active' : '']">
                <div class="relative flex-shrink-0">
                    <svg class="w-5 h-5 chat-icon-animate" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                    <span class="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-emerald-400"></span>
                    <span x-show="!helpOpen" class="dot-ping absolute -top-1 -right-1 w-2 h-2 rounded-full bg-emerald-400"></span>
                </div>
                <span :class="sidebarCollapsed ? 'opacity-0 w-0 overflow-hidden' : 'opacity-100'" class="transition-all duration-200 whitespace-nowrap">Help &amp; Support</span>
            </button>
        </div>

        <!-- User info — fixed py-5 height matches right section footer -->
        <div class="saas-sidebar-profile border-t border-slate-100 dark:border-white/[0.06] dark:bg-transparent"
             :class="sidebarCollapsed ? 'px-2 py-4' : 'px-4 py-4'">
            {% if client %}
                {% if profile is not defined %}{% set profile = client.profile_get %}{% endif %}

                {# Expanded: avatar + name/email + sign-out icon in one row #}
                <div x-show="!sidebarCollapsed" class="flex items-center gap-2.5 min-w-0">
                    <div class="flex items-center gap-3 min-w-0 flex-1 overflow-hidden">
                    <div class="relative flex-shrink-0">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-sm font-bold text-white border-2 border-white shadow-sm">
                            {{ profile.first_name|slice(0,1)|upper }}
                        </div>
                        {% if profile.email_approved %}
                        <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full bg-emerald-500 border-2 border-white flex items-center justify-center">
                            <svg class="w-2 h-2 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                        </span>
                        {% endif %}
                    </div>
                    <div class="min-w-0 flex-1 overflow-hidden">
                        <p class="text-sm font-bold text-slate-900 truncate">{{ profile.first_name }} {{ profile.last_name }}</p>
                        <p class="text-xs text-slate-500 truncate">{{ profile.email }}</p>
                    </div>
                    </div>
                    <a href="{{ 'client/logout'|url }}" title="Sign Out"
                       class="ml-auto flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:bg-red-50 hover:text-red-500 transition-all duration-150">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                        </svg>
                    </a>
                </div>

                {# Collapsed: avatar centered #}
                <div x-show="sidebarCollapsed" class="flex justify-center">
                    <a href="{{ 'client/logout'|url }}" title="Sign Out"
                       class="relative w-8 h-8 rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-sm font-bold text-white hover:ring-2 hover:ring-red-400/50 transition-all">
                        {{ profile.first_name|slice(0,1)|upper }}
                        {% if profile.email_approved %}
                        <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full bg-emerald-500 border-2 border-[#030712] flex items-center justify-center">
                            <svg class="w-2 h-2 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                        </span>
                        {% endif %}
                    </a>
                </div>

            {% else %}

