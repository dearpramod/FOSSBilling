<script>
(function () {
    // Rejects external URLs — only allows same-origin or root-relative paths.
    function safeRedirect(url) {
        if (!url) return;
        try {
            var parsed = new URL(url, window.location.origin);
            if (parsed.origin !== window.location.origin) return;
            window.location.href = parsed.href;
        } catch (_) {
            // Relative path (no host) — always safe
            if (url.charAt(0) === '/') window.location.href = url;
        }
    }

    // ── api-link handler ───────────────────────────────────────────────────────
    // Mirrors the bb.apiLink() behaviour from the Huraga theme bundle.
    // Intercepts clicks on <a class="api-link">, calls the API, then:
    //   data-api-jsonp="fnName"  → calls window.fnName(result)  (e.g. cPanel SSO)
    //   data-api-redirect="url" → navigates to url (same-origin or relative only)
    //   data-api-reload (any)   → reloads the page
    //   default                 → shows a success notification
    function initApiLinks() {
        var links = document.getElementsByClassName('api-link');
        for (var i = 0; i < links.length; i++) {
            (function (el) {
                el.addEventListener('click', function (e) {
                    e.preventDefault();
                    var href = el.getAttribute('href');
                    if (!href) return;
                    if (el.dataset.apiConfirm && !window.confirm(el.dataset.apiConfirm)) return;
                    API.makeRequest('GET', href, {}, function (res) {
                        var result   = res && res.result !== undefined ? res.result : res;
                        var jsonpFn  = el.dataset.apiJsonp;
                        var redirect = el.dataset.apiRedirect;
                        if (jsonpFn && typeof window[jsonpFn] === 'function') {
                            window[jsonpFn](result);
                        } else if (redirect) {
                            safeRedirect(redirect);
                        } else if ('apiReload' in el.dataset) {
                            window.location.reload();
                        } else {
                            FBPanel.message('Action completed successfully.', 'success');
                            window.location.reload();
                        }
                    }, function (err) {
                        FBPanel.message(
                            (err && err.message ? err.message : 'An error occurred') +
                            (err && err.code ? ' (' + err.code + ')' : ''),
                            'error'
                        );
                    });
                });
            })(links[i]);
        }
    }

    // ── api-form handler ───────────────────────────────────────────────────────
    // Intercepts <form class="api-form"> submit, serialises inputs and POSTs
    // to the form action, then follows data-api-redirect / data-api-reload.
    function initApiForms() {
        var forms = document.getElementsByClassName('api-form');
        for (var i = 0; i < forms.length; i++) {
            (function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    var method  = (form.getAttribute('method') || 'POST').toUpperCase();
                    var action  = form.getAttribute('action') || '';
                    var buttons = form.querySelectorAll('button:not([type="button"])');
                    var data    = {};
                    var fd = new FormData(form);
                    fd.forEach(function (v, k) { data[k] = v; });
                    if (!data.CSRFToken) data.CSRFToken = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
                    buttons.forEach(function (b) { b.disabled = true; });
                    API.makeRequest(method, action, data, function (res) {
                        buttons.forEach(function (b) { b.disabled = false; });
                        var redirect = form.dataset.apiRedirect;
                        if (redirect) {
                            window.location.href = redirect;
                        } else if ('apiReload' in form.dataset) {
                            window.location.reload();
                        } else {
                            var msg = form.dataset.apiMsg
                                || (res && typeof res.result === 'string' ? res.result : 'Saved successfully.');
                            FBPanel.message(msg, 'success');
                            if (form.dataset.closePanel) {
                                window.dispatchEvent(new CustomEvent('acct-panel-close'));
                            }
                            if (form.dataset.closeModal) {
                                window.dispatchEvent(new CustomEvent('modal-close', { detail: { modal: form.dataset.closeModal } }));
                            }
                        }
                    }, function (err) {
                        buttons.forEach(function (b) { b.disabled = false; });
                        FBPanel.message(
                            (err && err.message ? err.message : 'An error occurred') +
                            (err && err.code ? ' (' + err.code + ')' : ''),
                            'error'
                        );
                    });
                });
            })(forms[i]);
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        initApiLinks();
        initApiForms();
    });
}());
</script>

<script>
(function () {
    var currencyLocked = {{ (client and profile is defined and profile.currency) ? 'true' : 'false' }};
    var currentCurrencyCode = '{{ currentCurrency.code|e('js') }}';
    var currencySwitching = false;

    function switchCurrency(code) {
        if (!code || currencyLocked || currencySwitching) return;
        var next = String(code).toUpperCase();
        if (next === String(currentCurrencyCode).toUpperCase()) return;

        currencySwitching = true;
        API.guest.post('cart/set_currency', { currency: next }, function () {
            window.location.reload();
        }, function () {
            currencySwitching = false;
        }, false);
    }

    function bindCurrencyControls() {
        var buttons = document.querySelectorAll('[data-set-currency]');
        buttons.forEach(function (btn) {
            if (btn.dataset.currencyBound === '1') return;
            btn.dataset.currencyBound = '1';
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                switchCurrency(btn.dataset.setCurrency || '');
            });
        });

        var selects = document.querySelectorAll('select.currency_selector');
        selects.forEach(function (select) {
            if (select.dataset.currencyBound === '1') return;
            select.dataset.currencyBound = '1';
            select.addEventListener('change', function () {
                switchCurrency(select.value || '');
            });
        });
    }

    function syncCartBadge() {
        API.guest.get('cart/get', {}, function (cart) {
            var count = (cart && Array.isArray(cart.items)) ? cart.items.length : 0;
            var el = document.getElementById('cart-badge-topbar');
            if (!el) return;
            if (count > 0) {
                el.textContent = count > 99 ? '99+' : count;
                el.style.display = 'flex';
            } else {
                el.textContent = '';
                el.style.display = 'none';
            }
        }, null, false);
    }
    document.addEventListener('DOMContentLoaded', function () {
        bindCurrencyControls();
        syncCartBadge();
    });
    document.addEventListener('stablepanel:cartUpdated', syncCartBadge);
    window.fbpanel = window.fbpanel || {};
    window.fbpanel.syncCartBadge = syncCartBadge;
    window.fbpanel.switchCurrency = switchCurrency;
}());
</script>

