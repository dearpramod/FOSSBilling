{% extends 'layout_public.html.twig' %}

{# ── Classify the error into a "kind" so the rest of the template can branch cleanly ── #}
{% set msg  = exception.message|default('')|lower %}
{% set code = exception.code|default(0) %}

{% set attempted_url = '' %}
{% if code == 404 %}
    {% set _parts = exception.message|default('')|split(' ') %}
    {% if _parts|length >= 2 and _parts[0] == 'Page' %}
        {% set attempted_url = _parts[1] %}
    {% endif %}
{% endif %}

{% if code == 404 %}
    {% set kind = 'not_found' %}
{% elseif code == 403 %}
    {% set kind = 'forbidden' %}
{% elseif code == 401 %}
    {% set kind = 'unauthorized' %}
{% elseif code == 503 %}
    {% set kind = 'maintenance' %}
{% elseif 'ticket' in msg and ('not found' in msg or 'does not exist' in msg or 'access' in msg) %}
    {% set kind = 'ticket_not_found' %}
{% elseif 'ticket' in msg %}
    {% set kind = 'ticket_error' %}
{% elseif 'news' in msg and ('not found' in msg or 'does not exist' in msg) %}
    {% set kind = 'news_not_found' %}
{% elseif ('invoice' in msg or 'payment' in msg) and ('not found' in msg or 'does not exist' in msg) %}
    {% set kind = 'invoice_not_found' %}
{% elseif ('article' in msg or 'knowledge base' in msg or 'kb' in msg) and ('not found' in msg or 'does not exist' in msg) %}
    {% set kind = 'kb_not_found' %}
{% elseif 'order' in msg and 'not activated' in msg %}
    {% set kind = 'order_not_activated' %}
{% elseif 'not found' in msg or 'does not exist' in msg or 'no record' in msg %}
    {% set kind = 'not_found' %}
{% elseif 'permission' in msg or 'access denied' in msg or 'not allowed' in msg or 'forbidden' in msg %}
    {% set kind = 'forbidden' %}
{% elseif 'login' in msg or 'logged in' in msg or 'authenticated' in msg or 'session' in msg %}
    {% set kind = 'unauthorized' %}
{% elseif 'invalid' in msg or 'required' in msg or 'missing' in msg %}
    {% set kind = 'validation' %}
{% else %}
    {% set kind = 'server_error' %}
{% endif %}

{% block meta_title %}
    {%- if kind == 'not_found' %}Page Not Found
    {%- elseif kind == 'forbidden' %}Access Denied
    {%- elseif kind == 'unauthorized' %}Sign In Required
    {%- elseif kind == 'maintenance' %}Under Maintenance
    {%- elseif kind == 'ticket_not_found' %}Ticket Not Found
    {%- elseif kind == 'ticket_error' %}Ticket Error
    {%- elseif kind == 'news_not_found' %}Article Not Found
    {%- elseif kind == 'invoice_not_found' %}Invoice Not Found
    {%- elseif kind == 'kb_not_found' %}Article Not Found
    {%- elseif kind == 'order_not_activated' %}Order Not Activated
    {%- elseif kind == 'validation' %}Invalid Request
    {%- else %}Something Went Wrong
    {%- endif %}
{% endblock %}

{% block body_class %}error-page{% endblock %}

{% block head %}
<style>
    /* Background dot grid */
    .err-bg-grid {
        position: fixed; inset: 0; z-index: 0; pointer-events: none;
        background-image: radial-gradient(circle, rgba(255,255,255,.045) 1px, transparent 1px);
        background-size: 32px 32px;
    }
    .err-bg-glow {
        position: fixed; inset: 0; z-index: 0; pointer-events: none;
        background:
            radial-gradient(ellipse 60% 50% at 50% 0%,  rgba(var(--color-primary-rgb),.12), transparent),
            radial-gradient(ellipse 40% 40% at 80% 80%, rgba(var(--color-secondary-rgb),.08), transparent);
    }
    /* Icon box float + scan */
    @keyframes errFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
    @keyframes errScan  { 0% { top: 0; } 100% { top: 100%; } }
    .err-icon-wrap  { animation: errFloat 4s ease-in-out infinite; }
    .err-scan-line  {
        position: absolute; left: 0; right: 0; height: 2px; overflow: hidden;
        background: linear-gradient(90deg, transparent, rgba(var(--color-primary-rgb),.5), transparent);
        animation: errScan 2.8s linear infinite;
    }
    /* URL chip */
    .err-url-chip {
        display: inline-flex; align-items: center;
        padding: 1px 8px; border-radius: 6px;
        font-family: ui-monospace, monospace; font-size: .75rem;
        background: rgba(var(--color-primary-rgb),.12);
        border: 1px solid rgba(var(--color-primary-rgb),.22);
        color: rgba(var(--color-primary-rgb),1);
        word-break: break-all;
    }
</style>
{% endblock %}

{% block content %}
<div class="err-bg-grid"></div>
<div class="err-bg-glow"></div>

<section class="relative z-10 min-h-[70vh] flex flex-col items-center justify-center py-20 px-4">
    <div class="w-full max-w-lg mx-auto text-center">

        {# ── Error code / icon box ── #}
        <div class="err-icon-wrap inline-flex mb-10">
            <div class="relative w-36 h-36 rounded-3xl flex flex-col items-center justify-center overflow-hidden select-none"
                 style="
                    background: linear-gradient(135deg, rgba(var(--color-primary-rgb),.08), rgba(var(--color-secondary-rgb),.05));
                    border: 1px solid rgba(var(--color-primary-rgb),.18);
                    box-shadow: 0 0 0 1px rgba(var(--color-primary-rgb),.06), 0 24px 64px rgba(var(--color-primary-rgb),.1);
                 ">
                <div class="err-scan-line"></div>

                {# Corner brackets #}
                {% set bc = 'position:absolute;width:16px;height:16px;border-color:rgba(var(--color-primary-rgb),.4);' %}
                <div style="{{ bc }} top:10px;left:10px;border-left:2px solid;border-top:2px solid;border-radius:4px 0 0 0;"></div>
                <div style="{{ bc }} top:10px;right:10px;border-right:2px solid;border-top:2px solid;border-radius:0 4px 0 0;"></div>
                <div style="{{ bc }} bottom:10px;left:10px;border-left:2px solid;border-bottom:2px solid;border-radius:0 0 0 4px;"></div>
                <div style="{{ bc }} bottom:10px;right:10px;border-right:2px solid;border-bottom:2px solid;border-radius:0 0 4px 0;"></div>

                {# Central content: numeric code or icon #}
                {% if kind in ['not_found','server_error'] %}
                    <span class="text-5xl font-black leading-none tracking-tight"
                          style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
                        {{ code > 0 ? code : '!' }}
                    </span>
                    <span class="mt-2 text-[9px] font-mono uppercase tracking-[.2em] text-white/30">
                        {{ kind == 'not_found' ? 'not_found' : 'error' }}
                    </span>

                {% elseif kind == 'forbidden' %}
                    <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--color-primary);opacity:.9;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                    <span class="mt-2 text-[9px] font-mono uppercase tracking-[.2em] text-white/30">forbidden</span>

                {% elseif kind == 'unauthorized' %}
                    <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--color-primary);opacity:.9;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span class="mt-2 text-[9px] font-mono uppercase tracking-[.2em] text-white/30">auth</span>

                {% elseif kind == 'maintenance' %}
                    <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--color-primary);opacity:.9;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span class="mt-2 text-[9px] font-mono uppercase tracking-[.2em] text-white/30">maintenance</span>

                {% elseif kind in ['ticket_not_found','ticket_error'] %}
                    <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--color-primary);opacity:.9;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                    <span class="mt-2 text-[9px] font-mono uppercase tracking-[.2em] text-white/30">ticket</span>

                {% elseif kind == 'order_not_activated' %}
                    <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--color-primary);opacity:.9;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span class="mt-2 text-[9px] font-mono uppercase tracking-[.2em] text-white/30">pending</span>

                {% elseif kind == 'validation' %}
                    <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--color-primary);opacity:.9;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    <span class="mt-2 text-[9px] font-mono uppercase tracking-[.2em] text-white/30">bad_request</span>

                {% else %}
                    <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--color-primary);opacity:.9;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                    <span class="mt-2 text-[9px] font-mono uppercase tracking-[.2em] text-white/30">resource</span>
                {% endif %}
            </div>
        </div>

        {# ── Heading ── #}
        <h1 class="text-3xl sm:text-4xl font-bold text-white mb-3 leading-tight tracking-tight">
            {%- if kind == 'not_found' -%}Page Not Found
            {%- elseif kind == 'forbidden' -%}Access Denied
            {%- elseif kind == 'unauthorized' -%}Sign In Required
            {%- elseif kind == 'maintenance' -%}Under Maintenance
            {%- elseif kind == 'ticket_not_found' -%}Ticket Not Found
            {%- elseif kind == 'ticket_error' -%}Ticket Error
            {%- elseif kind == 'news_not_found' -%}Article Not Found
            {%- elseif kind == 'invoice_not_found' -%}Invoice Not Found
            {%- elseif kind == 'kb_not_found' -%}Article Not Found
            {%- elseif kind == 'order_not_activated' -%}Order Not Activated
            {%- elseif kind == 'validation' -%}Invalid Request
            {%- else -%}Something Went Wrong
            {%- endif %}
        </h1>

        {# ── Description ── #}
        <p class="text-white/50 text-[0.9375rem] leading-relaxed mb-8 max-w-sm mx-auto">
            {%- if kind == 'not_found' -%}
                The page you're looking for doesn't exist or may have been moved.{% if attempted_url %} <code class="err-url-chip">{{ attempted_url|e }}</code>{% endif %}
            {%- elseif kind == 'forbidden' -%}
                You don't have permission to access this. Please log in with an authorised account or contact support.
            {%- elseif kind == 'unauthorized' -%}
                You need to be signed in to view this page. Please log in to continue.
            {%- elseif kind == 'maintenance' -%}
                The platform is currently undergoing scheduled maintenance. Please check back shortly.
            {%- elseif kind == 'ticket_not_found' -%}
                This support ticket doesn't exist, was deleted, or you don't have access to it.
            {%- elseif kind == 'ticket_error' -%}
                There was a problem loading this ticket. Please go back to your tickets and try again.
            {%- elseif kind == 'news_not_found' -%}
                This article doesn't exist or may have been removed.
            {%- elseif kind == 'invoice_not_found' -%}
                This invoice doesn't exist or the link may have expired.
            {%- elseif kind == 'kb_not_found' -%}
                This knowledge base article doesn't exist or may have been moved.
            {%- elseif kind == 'order_not_activated' -%}
                This order hasn't been activated yet. It may still be pending payment or provisioning.
            {%- elseif kind == 'validation' -%}
                The request contained invalid or missing data. Please review your input and try again.
            {%- else -%}
                An unexpected error occurred. Please try again or contact support if the problem persists.
            {%- endif %}
        </p>

        {# ── Action buttons ── #}
        <div class="flex flex-wrap items-center justify-center gap-2.5 mb-12">

            {# Primary CTA #}
            {% set _primary_href =
                kind == 'unauthorized'        ? '/login'|url :
                kind == 'ticket_not_found'    ? '/support'|url :
                kind == 'ticket_error'        ? '/support'|url :
                kind == 'invoice_not_found'   ? '/invoice'|url :
                kind == 'kb_not_found'        ? '/support/kb'|url :
                kind == 'news_not_found'      ? '/news'|url :
                kind == 'order_not_activated' ? '/order'|url :
                '/'|url
            %}
            {% set _primary_label =
                kind == 'unauthorized'        ? 'Sign In' :
                kind == 'ticket_not_found'    ? 'My Tickets' :
                kind == 'ticket_error'        ? 'My Tickets' :
                kind == 'invoice_not_found'   ? 'My Invoices' :
                kind == 'kb_not_found'        ? 'Knowledge Base' :
                kind == 'news_not_found'      ? 'Browse News' :
                kind == 'order_not_activated' ? 'My Orders' :
                'Go Home'
            %}
            <a href="{{ _primary_href }}"
               class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-white text-sm font-semibold transition-all hover:scale-[1.02] active:scale-[.98]"
               style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));box-shadow:0 4px 20px rgba(var(--color-primary-rgb),.35);">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
                {{ _primary_label }}
            </a>

            {# Go Back #}
            <button onclick="history.back()"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-white/60 text-sm font-medium border border-white/[0.1] bg-white/[0.04] hover:bg-white/[0.08] hover:text-white transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Go Back
            </button>

            {# Contact Support — skip for ticket errors (loop) and maintenance #}
            {% if kind not in ['ticket_not_found','ticket_error','maintenance','invoice_not_found','order_not_activated'] %}
            <a href="{{ (settings.link_support|default('/support/contact'))|url }}"
               class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-white/60 text-sm font-medium border border-white/[0.1] bg-white/[0.04] hover:bg-white/[0.08] hover:text-white transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
                Contact Support
            </a>
            {% endif %}
        </div>

        {# ── Quick-nav tiles (404 and ticket errors only) ── #}
        {% if kind in ['not_found','ticket_not_found','ticket_error'] %}
        <div>
            <p class="text-[10px] font-semibold uppercase tracking-[.18em] text-white/20 mb-4">You might be looking for</p>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">

                {% set _tiles = [
                    { href: '/'|url,           label: 'Home',           svg: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',           tint: '99 102 241' },
                    { href: '/support'|url,    label: 'Support',        svg: 'M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z', tint: '16 185 129' },
                    { href: '/order'|url,      label: 'Order',          svg: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z', tint: '139 92 246' },
                    { href: '/support/kb'|url, label: 'Knowledge Base',  svg: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253', tint: '14 165 233' }
                ] %}

                {% for tile in _tiles %}
                <a href="{{ tile.href }}"
                   class="group flex flex-col items-center gap-2.5 p-4 rounded-2xl border border-white/[0.07] bg-white/[0.03] hover:bg-white/[0.07] hover:border-white/[0.13] hover:-translate-y-0.5 transition-all">
                    <div class="w-9 h-9 rounded-xl flex items-center justify-center transition-colors"
                         style="background:rgba({{ tile.tint }},.12);">
                        <svg class="w-4 h-4 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                             style="color:rgb({{ tile.tint }});">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="{{ tile.svg }}"/>
                        </svg>
                    </div>
                    <span class="text-xs font-medium text-white/40 group-hover:text-white/80 transition-colors">{{ tile.label }}</span>
                </a>
                {% endfor %}

            </div>
        </div>
        {% endif %}

    </div>
</section>
{% endblock %}
