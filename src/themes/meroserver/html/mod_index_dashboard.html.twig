{% extends request.ajax ? "layout_blank.html.twig" : "layout_public.html.twig" %}

{% block meta_title %}Order{% endblock %}
{% block body_class %}public-home-page{% endblock %}

{% block content %}
{% if settings.homepage_mode|default('') == 'store' %}
<script>window.location.replace('{{ '/order'|url }}');</script>
{% elseif settings.homepage_mode|default('') == 'custom' and settings.homepage_custom_url|default('') is not empty %}
<script>window.location.replace('{{ settings.homepage_custom_url|default('')|url }}');</script>
{% endif %}

{% set home_news_enabled = guest.extension_is_on({'mod': 'news'}) %}
{% set home_news = home_news_enabled ? guest.news_get_list({'per_page': 3}) : {'list': []} %}
{% set home_announcements = home_news.list|default([]) %}
{% set home_category_data = guest.product_category_get_list({'per_page': 50}) %}
{% set home_categories = home_category_data.list|default([])|filter(category => category.type != 'domain' and category.products|length > 0)|slice(0, 4) %}

{# ═══════════════════════════════════════════════════════════════════
   HERO — PaaS control plane
   ═══════════════════════════════════════════════════════════════════ #}
<div class="ref-home">
<section class="ref-home-hero">
    <div class="ref-home-hero-inner">
        <div class="ref-home-hero-copy" data-reveal="hero-copy">
            <div class="ref-home-kicker" data-reveal-child
                 x-data="{ active: 0, paused: false }"
                 x-init="setInterval(() => { if (!paused) active = (active + 1) % {{ home_announcements|length > 0 ? home_announcements|length : 1 }} }, 5000)"
                 @mouseenter="paused = true"
                 @mouseleave="paused = false"
                 @focusin="paused = true"
                 @focusout="paused = false">
                <span>Announcement</span>
                <div class="ref-home-announcements" aria-label="Latest announcements">
                    {% for announcement in home_announcements %}
                    <a href="{{ ('/news/' ~ announcement.slug)|url }}"
                       x-show="active === {{ loop.index0 }}"
                       {% if not loop.first %}x-cloak{% endif %}
                       x-transition:enter="ref-announcement-enter"
                       x-transition:enter-start="ref-announcement-enter-start"
                       x-transition:enter-end="ref-announcement-enter-end"
                       x-transition:leave="ref-announcement-leave"
                       x-transition:leave-start="ref-announcement-leave-start"
                       x-transition:leave-end="ref-announcement-leave-end">
                        <strong>{{ announcement.title }}</strong>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6"/>
                        </svg>
                    </a>
                    {% else %}
                    <a href="{{ home_news_enabled ? '/news'|url : '/order'|url }}">
                        <strong>Local infrastructure. Global performance.</strong>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6"/>
                        </svg>
                    </a>
                    {% endfor %}
                </div>
            </div>
            <h1 data-reveal-child>Your cloud platform, built for Nepal</h1>
            <p data-reveal-child>Deploy applications, databases, and managed VPS infrastructure from one control plane—with Git-based delivery, automatic SSL, live observability, and expert support available 24/7.</p>
            <div class="ref-home-hero-actions" data-reveal-child>
                <a href="{{ '/order'|url }}" class="ref-home-primary">
                    Start deploying
                    <span aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M5 12h14M13 6l6 6-6 6"/>
                        </svg>
                    </span>
                </a>
            </div>
            <div class="ref-home-trust" data-reveal-child>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <circle cx="12" cy="12" r="8.5"/>
                    <path d="m8.5 12 2.2 2.2 4.8-5"/>
                </svg>
                <span>Instant setup</span><i>·</i><span>Transparent NPR pricing</span><i>·</i><span>Local support</span>
            </div>
        </div>

        <div class="ref-home-console-stage" data-reveal="console">
            <svg class="ref-home-deploy-map" viewBox="0 0 680 500" fill="none" aria-hidden="true" focusable="false">
                <defs>
                    <linearGradient id="mero-home-deploy-line" x1="34" y1="432" x2="646" y2="62" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#5271ff"/>
                        <stop offset=".55" stop-color="#17a7d4"/>
                        <stop offset="1" stop-color="#20b978"/>
                    </linearGradient>
                </defs>
                <path class="ref-home-deploy-path" pathLength="1" d="M34 432 C124 426 115 318 205 322 S302 393 366 286 492 139 646 62" stroke="url(#mero-home-deploy-line)" stroke-width="2"/>
                <circle class="ref-home-deploy-node" cx="34" cy="432" r="6"/>
                <circle class="ref-home-deploy-node" cx="366" cy="286" r="6"/>
                <circle class="ref-home-deploy-node" cx="646" cy="62" r="6"/>
            </svg>
            <span class="ref-home-float-chip ref-home-float-chip-git" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="6" cy="5" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="19" r="2"/><path d="M6 7v10M8 6h5a5 5 0 0 1 5 5v-3"/></svg>
                Git deployed
            </span>
            <span class="ref-home-float-chip ref-home-float-chip-region" aria-hidden="true">
                <i></i>Kathmandu region
            </span>
            <div class="ref-home-account-console" aria-label="MeroVPS account console preview">
            <div class="ref-home-account-topbar">
                <div>
                    <span class="ref-home-account-mark">M</span>
                    <p><strong>Mero Cloud Platform</strong><small>console.merovps.com</small></p>
                </div>
                <span class="ref-home-account-live"><i></i> All systems operational</span>
            </div>
            <div class="ref-home-account-body">
                <aside aria-hidden="true">
                    <span class="is-active"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="6" rx="1"/><rect x="4" y="14" width="16" height="6" rx="1"/></svg></span>
                    <span><svg viewBox="0 0 24 24"><path d="M4 18h16M7 15V9m5 6V5m5 10v-3"/></svg></span>
                    <span><svg viewBox="0 0 24 24"><path d="M12 3 4 7v5c0 4.8 3.4 8 8 9 4.6-1 8-4.2 8-9V7l-8-4Z"/></svg></span>
                    <span><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3A1.7 1.7 0 0 0 10 3V2.8h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z"/></svg></span>
                </aside>
                <div class="ref-home-account-main">
                    <div class="ref-home-account-heading">
                        <p><small>Production workspace</small><strong>Applications overview</strong></p>
                        <button type="button" aria-label="Deploy a new application">+ Deploy app</button>
                    </div>
                    <div class="ref-home-account-metrics">
                        <div><small>Live services</small><strong>06</strong><span class="is-good">All healthy</span></div>
                        <div><small>Deploy success</small><strong>99.8%</strong><span><i style="width:88%"></i></span></div>
                        <div><small>Requests today</small><strong>84.2K</strong><span><i style="width:62%"></i></span></div>
                    </div>
                    <div class="ref-home-server-card">
                        <div class="ref-home-server-title">
                            <span><i></i><svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="6" rx="1"/><rect x="4" y="14" width="16" height="6" rx="1"/></svg></span>
                            <p><strong>mero-storefront</strong><small>Production · Kathmandu region</small></p>
                            <b>Healthy</b>
                        </div>
                        <div class="ref-home-server-details">
                            <span><small>Runtime</small><strong>Node.js 22</strong></span>
                            <span><small>Last deployment</small><strong>main@8f2a1c · 2m</strong></span>
                            <span><small>Instances</small><strong>3 replicas · Auto</strong></span>
                        </div>
                        <div class="ref-home-server-chart" aria-hidden="true">
                            <svg viewBox="0 0 520 70" preserveAspectRatio="none">
                                <path pathLength="1" d="M0 58 C40 57,48 43,82 46 S130 62,166 44 218 19,250 34 302 61,342 41 390 19,424 33 475 46,520 18"/>
                            </svg>
                        </div>
                    </div>
                    <div class="ref-home-account-foot"><span><i></i> Git connected · SSL active · Autoscaling on</span><b>Live metrics</b></div>
                </div>
            </div>
            </div>
        </div>
    </div>
</section>

<section class="ref-home-products">
    {% for category in home_categories %}
        {% set category_slug = category.title|lower|replace({' ': '-', '/': '-'})|trim('-') %}
        {% set category_href = ('/order/' ~ category_slug)|url %}
        {% set product_starting_prices = category.products
            |map(product => product.price_starting_from|default(0))
            |filter(price => price > 0) %}
        {% set lowest_category_price = product_starting_prices|length > 0 ? min(product_starting_prices) : null %}
        {% for product in category.products %}
            {% set product_starting_price = product.price_starting_from|default(0) %}
            {% if product_starting_price > 0 and (lowest_category_price is null or product_starting_price < lowest_category_price) %}
                {% set lowest_category_price = product_starting_price %}
            {% endif %}
            {% if product.pricing.recurrent is defined %}
                {% for period, price_option in product.pricing.recurrent %}
                    {% if price_option.enabled|default(false) and price_option.price|default(0) > 0 and (lowest_category_price is null or price_option.price < lowest_category_price) %}
                        {% set lowest_category_price = price_option.price %}
                    {% endif %}
                {% endfor %}
            {% endif %}
            {% if product.pricing.once is defined and product.pricing.once.enabled|default(false) and product.pricing.once.price|default(0) > 0 and (lowest_category_price is null or product.pricing.once.price < lowest_category_price) %}
                {% set lowest_category_price = product.pricing.once.price %}
            {% endif %}
        {% endfor %}
        {% if category.type == 'server' %}
            {% set category_badge = 'Cloud compute' %}
        {% elseif category.type == 'hosting' %}
            {% set category_badge = 'Managed hosting' %}
        {% elseif category.type == 'custom' %}
            {% set category_badge = 'Application platform' %}
        {% elseif category.type == 'license' %}
            {% set category_badge = 'Software licensing' %}
        {% elseif category.type == 'downloadable' %}
            {% set category_badge = 'Digital product' %}
        {% else %}
            {% set category_badge = 'Available now' %}
        {% endif %}
        <a href="{{ category_href }}" data-reveal="up" style="--reveal-index: {{ loop.index0 }}">
            <strong>{{ category.title }}</strong><i aria-hidden="true">→</i>
            <span>
                {% if lowest_category_price is not null %}
                    Starts at <b>{{ lowest_category_price|money_convert }}</b>
                {% else %}
                    <b>View pricing</b>
                {% endif %}
            </span>
            <small class="{{ cycle(['is-green', 'is-blue', 'is-cyan', 'is-orange'], loop.index0) }}">{{ category_badge }}</small>
        </a>
    {% else %}
        <a href="{{ '/order'|url }}" data-reveal="up">
            <strong>Explore cloud products</strong><i aria-hidden="true">→</i>
            <span><b>View pricing</b></span>
            <small class="is-blue">Available now</small>
        </a>
    {% endfor %}
</section>

<section class="ref-home-hardware" data-reveal="up">
    <span data-reveal-child>Everything you need to ship and scale</span>
    <div>
        <b data-reveal-child style="--reveal-index: 0"><i>01</i> Deploy from Git</b>
        <b data-reveal-child style="--reveal-index: 1"><i>02</i> Managed runtimes</b>
        <b data-reveal-child style="--reveal-index: 2"><i>03</i> Autoscale services</b>
        <b data-reveal-child style="--reveal-index: 3"><i>04</i> Observe in real time</b>
        <b data-reveal-child style="--reveal-index: 4"><i>05</i> Secure by default</b>
    </div>
</section>

{# ═══════════════════════════════════════════════════════════════════
   WHY CHOOSE US — Glass feature cards
   ═══════════════════════════════════════════════════════════════════ #}
<section class="ref-home-features py-20 border-t border-white/5 relative overflow-hidden">
    {# Subtle ambient glow #}
    <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] rounded-full blur-[160px]" style="background: radial-gradient(ellipse, rgba(var(--color-primary-rgb),0.08) 0%, transparent 70%);"></div>
    </div>

    <div class="ref-home-container relative">
        <div class="text-center mb-12" data-reveal="up">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">
                Speed. <em class="italic">Reliability.</em> Efficiency.
            </h2>
            <p class="text-gray-400 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
                Enterprise-grade infrastructure with blazing-fast NVMe storage, 24/7 support, and seamless migration — all at competitive prices.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {% set cards = [
                {
                    'icon': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>',
                    'color': 'indigo',
                    'title': 'All Products',
                    'desc': 'Web hosting, VPS, and domains — browse everything in one place.',
                    'link': '/order'|url,
                    'link_text': 'Browse Store'
                },
                {
                    'icon': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>',
                    'color': 'violet',
                    'title': 'Domain Names',
                    'desc': 'Register or transfer your perfect domain with instant activation.',
                    'link': '/order/domain-registration'|url,
                    'link_text': 'Search Domains'
                },
                {
                    'icon': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>',
                    'color': 'emerald',
                    'title': 'News & Updates',
                    'desc': 'Stay informed with product releases, maintenance, and company news.',
                    'link': '/news'|url,
                    'link_text': 'Read News'
                },
                {
                    'icon': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>',
                    'color': 'amber',
                    'title': 'Knowledgebase',
                    'desc': 'Step-by-step guides, tutorials, and how-tos to help you get started.',
                    'link': '/support/kb'|url,
                    'link_text': 'Explore KB'
                }
            ] %}

            {% for card in cards %}
            <div class="ref-home-feature-card rounded-2xl bg-white/[0.03] border border-white/[0.07] p-6 flex flex-col transition-all hover:border-{{ card.color }}-500/25 hover:bg-white/[0.05] hover:-translate-y-0.5 group"
                 data-reveal="up" style="--reveal-index: {{ loop.index0 }}">
                <div class="ref-home-feature-icon w-11 h-11 rounded-xl bg-{{ card.color }}-500/10 border border-{{ card.color }}-500/20 flex items-center justify-center mb-5">
                    <svg class="w-5 h-5 text-{{ card.color }}-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">{{ card.icon|raw }}</svg>
                </div>

                <h3 class="text-base font-bold text-white mb-2">{{ card.title }}</h3>
                <p class="text-sm text-gray-500 leading-relaxed flex-1 mb-5">{{ card.desc }}</p>

                <a href="{{ card.link }}" class="inline-flex items-center gap-1.5 text-sm font-semibold text-{{ card.color }}-400 hover:text-{{ card.color }}-300 transition-colors group/link">
                    {{ card.link_text }}
