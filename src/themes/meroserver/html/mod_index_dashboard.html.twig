{# ═══════════════════════════════════════════════════════════════════
   FAQ — Two-column layout
   ═══════════════════════════════════════════════════════════════════ #}
<section class="ref-home-faq py-20 border-t border-white/5" x-data="{ open: null }">
    <div class="ref-home-container">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">
            {# Left column — heading + CTA #}
            <div class="lg:col-span-2" data-reveal="up">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-xs font-medium text-gray-400 mb-6">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    Up To <span class="font-bold text-amber-400">70%</span> Off Managed Cloud Hosting
                </div>

                <h2 class="text-3xl sm:text-4xl font-extrabold text-white leading-tight mb-2">
                    Frequently Ask
                </h2>
                <p class="text-3xl sm:text-4xl font-extrabold italic mb-6" style="color: var(--color-primary);">Questions</p>

                <p class="text-gray-500 text-sm leading-relaxed mb-8 max-w-sm">
                    In today's competitive business, the demand for efficient hosting solutions continues to grow. We've answered the most common questions to help you get started.
                </p>

                <a href="{{ 'login'|url }}"
                   class="inline-flex items-center justify-center px-7 py-3 rounded-xl text-white font-semibold text-sm transition-all"
                   style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 6px 24px rgba(var(--color-primary-rgb),0.3);">
                    Clients Area
                </a>
            </div>

            {# Right column — accordion #}
            <div class="lg:col-span-3" data-reveal="up" style="--reveal-index: 1">
                {% set faqs = [
                    {'q': 'Is MeroVPS a Nepali company?', 'a': 'Yes. MeroVPS is a Nepal-based hosting provider offering local data center proximity, NPR billing, and dedicated support tailored for Nepali businesses and developers.'},
                    {'q': 'What features do I get with web hosting?', 'a': 'All plans include NVMe SSD storage, free SSL certificates, one-click app installer, daily backups, cPanel access, and unlimited bandwidth on select plans.'},
                    {'q': 'How is MeroVPS\'s technical support?', 'a': 'Our support team is available 24/7 via live chat, tickets, and WhatsApp. Average response time is under 5 minutes with expert-level assistance.'},
                    {'q': 'Can I migrate my website to MeroVPS?', 'a': 'Yes. We offer free migration for all plans — our team handles server data, websites, databases, DNS, and application configs with zero downtime.'},
                    {'q': 'Why choose MeroVPS?', 'a': 'Enterprise-grade NVMe infrastructure, 99.9% uptime SLA, instant provisioning under 60 seconds, local support, competitive NPR pricing, and always-on DDoS protection.'},
                    {'q': 'Can I upgrade my web hosting plan later?', 'a': 'Yes. Upgrades are applied instantly from the client portal. You only pay the prorated difference. Downgrades take effect at the next billing cycle.'}
                ] %}

                <div class="divide-y divide-white/[0.06]">
                    {% for i, faq in faqs %}
                    <div class="ref-home-faq-item" :class="{ 'is-open': open === {{ i }} }">
                        <button @click="open = (open === {{ i }}) ? null : {{ i }}"
                                :aria-expanded="open === {{ i }}"
                                aria-controls="home-faq-answer-{{ i }}"
                                class="w-full flex items-center justify-between py-5 text-left group">
                            <span class="text-base font-medium text-white pr-6 group-hover:text-indigo-300 transition-colors">{{ faq.q }}</span>
                            <svg class="w-5 h-5 text-gray-500 flex-shrink-0 transition-transform duration-200"
                                 :class="open === {{ i }} ? 'rotate-180' : ''"
                                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        <div id="home-faq-answer-{{ i }}"
                             x-show="open === {{ i }}"
                             x-collapse.duration.240ms
                             x-cloak
                             class="pb-5">
                            <p class="text-sm text-gray-400 leading-relaxed">{{ faq.a }}</p>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>

</div>
{% endblock %}
