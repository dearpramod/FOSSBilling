{% extends request.ajax ? "layout_blank.html.twig" : "layout_public.html.twig" %}

{% block meta_title %}Cloud hosting & client portal{% endblock %}
{% block body_class %}public-home-page{% endblock %}

{% block content %}
{% if settings.homepage_mode|default('') == 'store' %}
<script>window.location.replace('{{ '/order'|url }}');</script>
{% elseif settings.homepage_mode|default('') == 'custom' and settings.homepage_custom_url|default('') is not empty %}
<script>window.location.replace('{{ settings.homepage_custom_url|default('')|e('js') }}');</script>
{% endif %}

{% set home_news_enabled = guest.extension_is_on({'mod': 'news'}) %}
{% set home_news = home_news_enabled ? guest.news_get_list({'per_page': 3}) : {'list': []} %}
{% set home_announcements = home_news.list|default([]) %}
{% set home_category_data = guest.product_category_get_list({'per_page': 50}) %}
{% set home_categories = home_category_data.list|default([])|filter(category => category.type != 'domain' and category.products|length > 0)|slice(0, 4) %}

{# ═══════════════════════════════════════════════════════════════════
   HERO — PaaS control plane
   ═══════════════════════════════════════════════════════════════════ #}
<div class="ref-home ref-home-saas ref-home-glass">
<section class="ref-home-hero">
    <div class="home-glass-pattern" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="ref-home-hero-inner">
        <div class="ref-home-hero-copy" data-reveal="hero-copy">
            <div class="ref-home-kicker" data-reveal-child
                 x-data="{ active: 0, paused: false }"
                 x-init="setInterval(() => { if (!paused) active = (active + 1) % {{ home_announcements|length > 0 ? home_announcements|length : 1 }} }, 5000)"
                 @mouseenter="paused = true"
                 @mouseleave="paused = false"
                 @focusin="paused = true"
                 @focusout="paused = false">
                <span>Announcement</span>
                <div class="ref-home-announcements" aria-label="Latest announcements">
                    {% for announcement in home_announcements %}
                    <a href="{{ ('/news/' ~ announcement.slug)|url }}"
                       x-show="active === {{ loop.index0 }}"
                       {% if not loop.first %}x-cloak{% endif %}
                       x-transition:enter="ref-announcement-enter"
                       x-transition:enter-start="ref-announcement-enter-start"
                       x-transition:enter-end="ref-announcement-enter-end"
                       x-transition:leave="ref-announcement-leave"
                       x-transition:leave-start="ref-announcement-leave-start"
                       x-transition:leave-end="ref-announcement-leave-end">
                        <strong>{{ announcement.title }}</strong>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6"/>
                        </svg>
                    </a>
                    {% else %}
                    <a href="{{ home_news_enabled ? '/news'|url : '/order'|url }}">
                        <strong>Local infrastructure. Global performance.</strong>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6"/>
                        </svg>
                    </a>
                    {% endfor %}
                </div>
            </div>
            <h1 data-reveal-child>Your cloud.<br><span>Simply managed.</span></h1>
            <p data-reveal-child>Bring your hosting, servers, domains, and billing together. Choose your next service and manage it all from a simple client dashboard, with NPR pricing and local support.</p>
            <div class="ref-home-hero-actions" data-reveal-child>
                <a href="{{ '/order'|url }}" class="ref-home-primary">
                    Explore plans
                    <span aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M5 12h14M13 6l6 6-6 6"/>
                        </svg>
                    </span>
                </a>
                <a href="{{ '/login'|url }}" class="ref-home-secondary">
                    Open dashboard
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </a>
            </div>
            <div class="ref-home-trust" data-reveal-child>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <circle cx="12" cy="12" r="8.5"/>
                    <path d="m8.5 12 2.2 2.2 4.8-5"/>
                </svg>
                <span>Instant setup</span><i>·</i><span>Transparent NPR pricing</span><i>·</i><span>Local support</span>
            </div>
        </div>

        <div class="ref-home-console-stage" data-reveal="console">
            <svg class="home-glass-orbit" viewBox="0 0 640 540" fill="none" aria-hidden="true" focusable="false">
                <ellipse cx="320" cy="270" rx="292" ry="192" transform="rotate(-32 320 270)"/>
                <ellipse cx="320" cy="270" rx="292" ry="192" transform="rotate(32 320 270)"/>
                <circle cx="320" cy="270" r="236"/>
                <circle cx="120" cy="146" r="9" class="home-orbit-dot"/>
                <circle cx="544" cy="346" r="6" class="home-orbit-dot"/>
            </svg>
            <div class="home-glass-caption"><span class="home-glass-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m12 3 9 5-9 5-9-5 9-5ZM3 12l9 5 9-5M3 16l9 5 9-5"/></svg></span><span><small>LESS SWITCHING. MORE DOING.</small><strong>Your entire cloud, connected.</strong></span></div>
            <svg class="ref-home-deploy-map" viewBox="0 0 680 500" fill="none" aria-hidden="true" focusable="false">
                <defs>
                    <linearGradient id="mero-home-deploy-line" x1="34" y1="432" x2="646" y2="62" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#5271ff"/>
                        <stop offset=".55" stop-color="#17a7d4"/>
                        <stop offset="1" stop-color="#20b978"/>
                    </linearGradient>
                </defs>
                <path class="ref-home-deploy-path" pathLength="1" d="M34 432 C124 426 115 318 205 322 S302 393 366 286 492 139 646 62" stroke="url(#mero-home-deploy-line)" stroke-width="2"/>
                <circle class="ref-home-deploy-node" cx="34" cy="432" r="6"/>
                <circle class="ref-home-deploy-node" cx="366" cy="286" r="6"/>
                <circle class="ref-home-deploy-node" cx="646" cy="62" r="6"/>
            </svg>
            <span class="ref-home-float-chip ref-home-float-chip-git" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="6" cy="5" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="19" r="2"/><path d="M6 7v10M8 6h5a5 5 0 0 1 5 5v-3"/></svg>
                Git deployed
            </span>
            <span class="ref-home-float-chip ref-home-float-chip-region" aria-hidden="true">
                <i></i>Kathmandu region
            </span>
            <section class="ref-home-account-console" aria-label="Client dashboard preview with illustrative sample data">
            <div class="ref-home-account-topbar">
                <div>
                    <span class="ref-home-account-mark">M</span>
                    <p><strong>Client dashboard</strong><small>Your services, in one place</small></p>
                </div>
                <span class="ref-home-account-live">Sample workspace</span>
            </div>
            <div class="ref-home-account-body">
                <aside aria-hidden="true">
                    <span class="is-active"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="6" rx="1"/><rect x="4" y="14" width="16" height="6" rx="1"/></svg></span>
                    <span><svg viewBox="0 0 24 24"><path d="M4 18h16M7 15V9m5 6V5m5 10v-3"/></svg></span>
                    <span><svg viewBox="0 0 24 24"><path d="M12 3 4 7v5c0 4.8 3.4 8 8 9 4.6-1 8-4.2 8-9V7l-8-4Z"/></svg></span>
                    <span><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3A1.7 1.7 0 0 0 10 3V2.8h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z"/></svg></span>
                </aside>
                <div class="ref-home-account-main">
                    <div class="ref-home-account-heading">
                        <p><small>Account overview</small><strong>Welcome back</strong></p>
                        <a href="{{ '/order'|url }}" class="ref-home-preview-action">+ New order</a>
                    </div>
                    <div class="ref-home-account-metrics">
                        <div><small>Active services</small><strong>06</strong><span class="is-good">Your infrastructure</span></div>
                        <div><small>Invoices</small><strong>02</strong><span class="is-good">To review</span></div>
                        <div><small>Support tickets</small><strong>01</strong><span class="is-good">Open conversation</span></div>
                    </div>
                    <div class="ref-home-server-card">
                        <div class="ref-home-server-title">
                            <span><i></i><svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="6" rx="1"/><rect x="4" y="14" width="16" height="6" rx="1"/></svg></span>
                            <p><strong>Business cloud server</strong><small>Services / Cloud VPS</small></p>
                            <b>Active</b>
                        </div>
                        <div class="ref-home-server-details">
                            <span><small>Resources</small><strong>2 vCPU · 4 GB RAM</strong></span>
                            <span><small>Billing cycle</small><strong>Monthly</strong></span>
                            <span><small>Management</small><strong>Client portal</strong></span>
                        </div>
                        <div class="ref-home-server-chart" aria-hidden="true">
                            <svg viewBox="0 0 520 70" preserveAspectRatio="none">
                                <path pathLength="1" d="M0 58 C40 57,48 43,82 46 S130 62,166 44 218 19,250 34 302 61,342 41 390 19,424 33 475 46,520 18"/>
                            </svg>
                        </div>
                    </div>
                    <div class="ref-home-account-foot"><span>Services · Billing · Support</span><b>One workspace</b></div>
                </div>
            </div>
            </section>
            <div class="home-glass-workspace-note"><span aria-hidden="true">↗</span><p><strong>Built around your workflow</strong><small>One account for services, invoices, and support.</small></p></div>
        </div>
    </div>
</section>

{# ═══════════════════════════════════════════════════════════════════
   PLATFORM FIT — compact audience strip
   ═══════════════════════════════════════════════════════════════════ #}
<section class="ref-home-trusted" aria-label="Built for growing teams in Nepal">
    <div class="ref-home-container">
        <p class="ref-home-trusted-label">Built for ambitious teams across Nepal</p>
        <div class="ref-home-trusted-strip">
            <span>Startups</span>
            <span>Developers</span>
            <span>Agencies</span>
            <span>Growing businesses</span>
        </div>
    </div>
</section>

<section class="ref-home-products">
    {% for category in home_categories %}
        {% set category_slug = category.title|lower|replace({' ': '-', '/': '-'})|trim('-') %}
        {# Domain categories route to the dedicated wizard, not the title slug (/order/domain-names → 404). #}
        {% set category_href = ((category.type == 'domain') ? '/order/domain-registration' : ('/order/' ~ category_slug))|url %}
        {% set product_starting_prices = category.products
            |map(product => product.price_starting_from|default(0))
            |filter(price => price > 0) %}
        {% set lowest_category_price = product_starting_prices|length > 0 ? min(product_starting_prices) : null %}
        {% for product in category.products %}
            {% set product_starting_price = product.price_starting_from|default(0) %}
            {% if product_starting_price > 0 and (lowest_category_price is null or product_starting_price < lowest_category_price) %}
                {% set lowest_category_price = product_starting_price %}
            {% endif %}
            {% if product.pricing.recurrent is defined %}
                {% for period, price_option in product.pricing.recurrent %}
                    {% if price_option.enabled|default(false) and price_option.price|default(0) > 0 and (lowest_category_price is null or price_option.price < lowest_category_price) %}
                        {% set lowest_category_price = price_option.price %}
                    {% endif %}
                {% endfor %}
            {% endif %}
            {% if product.pricing.once is defined and product.pricing.once.enabled|default(false) and product.pricing.once.price|default(0) > 0 and (lowest_category_price is null or product.pricing.once.price < lowest_category_price) %}
                {% set lowest_category_price = product.pricing.once.price %}
            {% endif %}
        {% endfor %}
        {% if category.type == 'server' %}
            {% set category_badge = 'Cloud compute' %}
        {% elseif category.type == 'hosting' %}
            {% set category_badge = 'Managed hosting' %}
        {% elseif category.type == 'custom' %}
            {% set category_badge = 'Application platform' %}
        {% elseif category.type == 'license' %}
            {% set category_badge = 'Software licensing' %}
        {% elseif category.type == 'downloadable' %}
            {% set category_badge = 'Digital product' %}
        {% else %}
            {% set category_badge = 'Available now' %}
        {% endif %}
        <a href="{{ category_href }}" data-reveal="up" style="--reveal-index: {{ loop.index0 }}">
            <strong>{{ category.title }}</strong><i aria-hidden="true">→</i>
            <span>
                {% if lowest_category_price is not null %}
                    Starts at <b>{{ lowest_category_price|money_convert }}</b>
                {% else %}
                    <b>View pricing</b>
                {% endif %}
            </span>
            <small class="{{ cycle(['is-green', 'is-blue', 'is-cyan', 'is-orange'], loop.index0) }}">{{ category_badge }}</small>
        </a>
    {% else %}
        <a href="{{ '/order'|url }}" data-reveal="up">
            <strong>Explore cloud products</strong><i aria-hidden="true">→</i>
            <span><b>View pricing</b></span>
            <small class="is-blue">Available now</small>
        </a>
    {% endfor %}
</section>

<section class="ref-home-stats" aria-label="Platform reliability at a glance">
    <div class="ref-home-container">
        <div class="ref-home-stats-grid">
            <div data-reveal="up" style="--reveal-index: 0"><strong>99.9%</strong><span>Uptime SLA</span></div>
            <div data-reveal="up" style="--reveal-index: 1"><strong>&lt;60s</strong><span>Average setup</span></div>
            <div data-reveal="up" style="--reveal-index: 2"><strong>24/7</strong><span>Local support</span></div>
            <div data-reveal="up" style="--reveal-index: 3"><strong>500+</strong><span>Customers served</span></div>
        </div>
    </div>
</section>

<section class="ref-home-promise" aria-label="Meroserver platform principles">
    <div class="ref-home-container">
        <div class="ref-home-section-heading" data-reveal="up">
            <span class="ref-home-eyebrow">Why Meroserver?</span>
            <h2>Infrastructure that stays <em>simple</em> as you scale.</h2>
            <p>Built for real applications, real traffic, and teams that would rather ship than manage infrastructure.</p>
        </div>
        <div class="ref-home-promise-grid">
            <article data-reveal="up" style="--reveal-index: 0">
                <span>01</span><h3>Local by design.</h3>
                <p>NPR billing, Nepal-focused infrastructure, and support that understands your context.</p>
            </article>
            <article data-reveal="up" style="--reveal-index: 1">
                <span>02</span><h3>Transparent by default.</h3>
                <p>Clear plans, visible usage, and the controls you need without hidden operational complexity.</p>
            </article>
            <article data-reveal="up" style="--reveal-index: 2">
                <span>03</span><h3>People when it matters.</h3>
                <p>Automation for routine work, backed by experienced humans when you need a hand.</p>
            </article>
        </div>
    </div>
</section>

<section id="mero-how-it-works" class="ref-home-steps">
    <div class="ref-home-container">
        <div class="ref-home-section-heading ref-home-section-heading-light" data-reveal="up">
            <span class="ref-home-eyebrow">Four steps. That’s it.</span>
            <h2>From idea to online in minutes.</h2>
            <p>Choose what you need, configure it your way, and let Meroserver handle the infrastructure underneath.</p>
        </div>
        <ol class="ref-home-steps-grid">
            <li data-reveal="up" style="--reveal-index: 0"><b>01</b><span><strong>Choose a service.</strong><small>Hosting, VPS, domains, or your next application.</small></span></li>
            <li data-reveal="up" style="--reveal-index: 1"><b>02</b><span><strong>Make it yours.</strong><small>Select resources, region, runtime, and billing cycle.</small></span></li>
            <li data-reveal="up" style="--reveal-index: 2"><b>03</b><span><strong>Deploy securely.</strong><small>Launch with SSL, monitoring, and sensible defaults.</small></span></li>
            <li data-reveal="up" style="--reveal-index: 3"><b>04</b><span><strong>Grow without friction.</strong><small>Scale resources whenever your traffic demands it.</small></span></li>
        </ol>
    </div>
</section>

{# ═══════════════════════════════════════════════════════════════════
   FAQ — Two-column layout
   ═══════════════════════════════════════════════════════════════════ #}
<section class="ref-home-faq py-20 border-t border-white/5" x-data="{ open: null }">
    <div class="ref-home-container">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">
            {# Left column — heading + CTA #}
            <div class="lg:col-span-2" data-reveal="up">
                <span class="ref-home-eyebrow">Here to help</span>

                <h2 class="text-3xl sm:text-4xl font-extrabold text-white leading-tight mb-2">
                    A little clarity,
                </h2>
                <p class="text-3xl sm:text-4xl font-extrabold mb-6" style="color: var(--color-primary);">before you begin.</p>

                <p class="text-gray-500 text-sm leading-relaxed mb-8 max-w-sm">
                    Find answers about hosting, billing, and managing your services. Already have an account? Your dashboard brings everything together.
                </p>

                <a href="{{ 'login'|url }}"
                   class="inline-flex items-center justify-center px-7 py-3 rounded-xl text-white font-semibold text-sm transition-all"
                   style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 6px 24px rgba(var(--color-primary-rgb),0.3);">
                    Clients Area
                </a>
            </div>

            {# Right column — accordion #}
            <div class="lg:col-span-3" data-reveal="up" style="--reveal-index: 1">
                {% set faqs = [
                    {'q': 'Is MeroVPS a Nepali company?', 'a': 'Yes. MeroVPS is a Nepal-based hosting provider offering local data center proximity, NPR billing, and dedicated support tailored for Nepali businesses and developers.'},
                    {'q': 'What features do I get with web hosting?', 'a': 'All plans include NVMe SSD storage, free SSL certificates, one-click app installer, daily backups, cPanel access, and unlimited bandwidth on select plans.'},
                    {'q': 'How is MeroVPS\'s technical support?', 'a': 'Our support team is available 24/7 via live chat, tickets, and WhatsApp. Average response time is under 5 minutes with expert-level assistance.'},
                    {'q': 'Can I migrate my website to MeroVPS?', 'a': 'Yes. We offer free migration for all plans — our team handles server data, websites, databases, DNS, and application configs with zero downtime.'},
                    {'q': 'Why choose MeroVPS?', 'a': 'Enterprise-grade NVMe infrastructure, 99.9% uptime SLA, instant provisioning under 60 seconds, local support, competitive NPR pricing, and always-on DDoS protection.'},
                    {'q': 'Can I upgrade my web hosting plan later?', 'a': 'Yes. Upgrades are applied instantly from the client portal. You only pay the prorated difference. Downgrades take effect at the next billing cycle.'}
                ] %}

                <div class="divide-y divide-white/[0.06]">
                    {% for i, faq in faqs %}
                    <div class="ref-home-faq-item" :class="{ 'is-open': open === {{ i }} }">
                        <button type="button"
                                id="home-faq-question-{{ i }}"
                                @click="open = (open === {{ i }}) ? null : {{ i }}"
                                :aria-expanded="open === {{ i }}"
                                aria-controls="home-faq-answer-{{ i }}"
                                class="w-full flex items-center justify-between py-5 text-left group">
                            <span class="text-base font-medium text-white pr-6 group-hover:text-indigo-300 transition-colors">{{ faq.q }}</span>
                            <svg class="w-5 h-5 text-gray-500 flex-shrink-0 transition-transform duration-200"
                                 :class="open === {{ i }} ? 'rotate-180' : ''"
                                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        <div id="home-faq-answer-{{ i }}"
                             role="region"
                             aria-labelledby="home-faq-question-{{ i }}"
                             x-show="open === {{ i }}"
                             x-collapse.duration.240ms
                             x-cloak
                             class="pb-5">
                            <p class="text-sm text-gray-400 leading-relaxed">{{ faq.a }}</p>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>

<section class="home-glass-cta" aria-labelledby="home-workspace-title">
    <div><span class="ref-home-eyebrow">Your next chapter</span><h2 id="home-workspace-title">Make room for<br>your next big idea.</h2><p>Find the right infrastructure. Keep everything in view.</p></div>
    <a href="{{ '/order'|url }}" class="ref-home-primary">Explore the plans <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
</section>

</div>
{% endblock %}
