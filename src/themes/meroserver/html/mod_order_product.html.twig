{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}Order — {{ product.title }}{% endblock %}
{% block page_header %}Order{% endblock %}

{% set periods = guest.system_periods %}
{% set cart = guest.cart_get %}
{% set is_checkout = request.checkout == '1' or request.checkout == 1 %}

{% block content %}

{# ─── Checkout view ──────────────────────────────────────────────────────── #}
{% if is_checkout %}
<div class="max-w-3xl mx-auto">

    {# Back link #}
    <a href="{{ 'order'|url }}/{{ product.id }}" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:opacity-70 transition-colors mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Back to product
    </a>

    <h1 class="text-xl font-bold text-white mb-6">Review &amp; Checkout</h1>

    {% if cart.items %}
    {# Cart Summary #}
    <div class="rounded-2xl border border-white/[0.07] mb-6 overflow-hidden" style="background:rgba(255,255,255,0.02);">
        <div class="px-5 py-4 border-b border-white/5">
            <h2 class="text-sm font-semibold text-white">Order Summary</h2>
        </div>
        <div class="divide-y divide-white/[0.05]">
            {% for item in cart.items %}
            <div class="px-5 py-4 flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-white">{{ item.title }}</p>
                    {% if item.period %}
                        <p class="text-xs text-gray-500 mt-0.5">{{ item.period | period_title }}</p>
                    {% endif %}
                </div>
                <div class="text-right">
                    {% if item.discount_price %}
                        <p class="text-xs text-gray-500 line-through">{{ item.total | money_convert }}</p>
                        <p class="text-sm font-semibold text-green-400">{{ (item.total - item.discount_price) | money_convert }}</p>
                    {% else %}
                        <p class="text-sm font-semibold text-white">{{ item.total | money_convert }}</p>
                    {% endif %}
                    {% if item.setup_price > 0 %}
                        <p class="text-xs text-gray-500">+ {{ item.setup_price | money_convert }} setup</p>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
        {# Totals #}
        <div class="px-5 py-4 border-t border-white/5 space-y-2">
            {% set cart_tax_amount = 0 %}
            {% if cart.discount > 0 %}
            <div class="flex justify-between text-sm">
                <span class="text-gray-400">Subtotal</span>
                <span class="text-white">{{ cart.subtotal | money_convert }}</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-green-400">Discount</span>
                <span class="text-green-400">- {{ cart.discount | money_convert }}</span>
            </div>
            {% endif %}
            {% if client and client.client_is_taxable %}
                {% set cart_tax_rate = client.invoice_get_tax_rate %}
                {% set cart_tax_amount = cart.total * cart_tax_rate / 100 %}
                <div class="flex justify-between text-sm">
                    <span class="text-gray-400">VAT ({{ cart_tax_rate }}%)</span>
                    <span class="text-white">{{ cart_tax_amount | money_convert }}</span>
                </div>
            {% endif %}
            <div class="flex justify-between text-sm font-semibold pt-2 border-t border-white/5">
                <span class="text-white">Total</span>
                <span class="text-base font-bold" style="color:var(--color-secondary);">{{ (cart.total + cart_tax_amount) | money_convert }}</span>
            </div>
        </div>
    </div>

    {# Auth check #}
    {% if not client %}
    <div x-data="checkoutAuth()" class="rounded-2xl border border-amber-500/20 bg-amber-500/5 p-5 mb-6">
        <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
                <p class="text-sm font-semibold text-amber-300">Login required to complete order</p>
                <p class="text-xs text-amber-400/70 mt-1">Please sign in or create an account to proceed with checkout.</p>
            </div>
        </div>
        <div class="flex gap-3 mt-4">
            <button @click="showLogin = true; showSignup = false"
                    class="px-4 py-2 rounded-lg text-sm font-semibold text-white transition-all"
                    style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
                Sign In
            </button>
            <button @click="showSignup = true; showLogin = false"
                    class="px-4 py-2 rounded-lg text-sm font-semibold text-gray-300 hover:text-white border border-white/10 hover:border-white/30 hover:bg-white/5 transition-all">
                Create Account
            </button>
        </div>

        {# ── Login Modal ── #}
        <template x-teleport="body">
            <div x-show="showLogin" x-cloak
                 class="fixed inset-0 z-[9999] flex items-center justify-center p-4"
                 @keydown.escape.window="showLogin = false">
                <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" @click="showLogin = false"></div>
                <div x-show="showLogin" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100 scale-100" x-transition:leave-end="opacity-0 scale-95"
                     class="relative w-full max-w-md rounded-2xl border border-white/[0.08] p-6 shadow-2xl shadow-black/60 backdrop-blur-xl"
                     style="background:rgba(15,15,25,0.95);" @click.stop>

                    {# Close button #}
                    <button @click="showLogin = false" class="absolute top-4 right-4 text-gray-500 hover:text-white transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>

                    <h2 class="text-lg font-bold text-white mb-1">Sign In</h2>
                    <p class="text-xs text-gray-500 mb-5">Sign in to continue with your order</p>

                    <form @submit.prevent="login()">
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-300 mb-1.5">Email address</label>
                                <input type="email" x-model="email" required autofocus
                                       placeholder="you@example.com"
                                       class="w-full px-4 py-3 rounded-xl text-white text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white/20 focus:ring-offset-0 transition-all"
                                       style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);">
                            </div>
                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <label class="block text-sm font-medium text-gray-300">Password</label>
                                    <a href="{{ 'password-reset'|url }}" target="_blank" class="text-xs transition-colors hover:opacity-80" style="color:var(--color-secondary);">Forgot?</a>
                                </div>
                                <input type="password" x-model="password" required
                                       placeholder="••••••••"
                                       class="w-full px-4 py-3 rounded-xl text-white text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white/20 focus:ring-offset-0 transition-all"
                                       style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);">
                            </div>
                            <div x-show="authError" x-cloak class="p-3 rounded-xl border border-red-500/20 bg-red-500/5">
                                <p class="text-sm text-red-400" x-text="authError"></p>
                            </div>
                            <button type="submit" :disabled="authLoading"
                                    class="w-full py-3 rounded-xl text-sm font-semibold text-white transition-all disabled:opacity-50"
                                    style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 4px 16px rgba(var(--color-primary-rgb),0.3);">
                                <span x-show="!authLoading">Sign In & Continue</span>
                                <span x-show="authLoading" class="flex items-center justify-center gap-2">
                                    <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                    Signing in...
                                </span>
                            </button>
                        </div>
                    </form>

                    <p class="text-xs text-gray-500 text-center mt-4">
                        Don't have an account?
                        <button @click="showLogin = false; showSignup = true" class="font-medium transition-colors hover:opacity-80" style="color:var(--color-secondary);">Create one</button>
                    </p>
                </div>
            </div>
        </template>

        {# ── Signup Modal ── #}
        <template x-teleport="body">
            <div x-show="showSignup" x-cloak
                 class="fixed inset-0 z-[9999] flex items-center justify-center p-4"
                 @keydown.escape.window="showSignup = false">
                <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" @click="showSignup = false"></div>
                <div x-show="showSignup" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100 scale-100" x-transition:leave-end="opacity-0 scale-95"
                     class="relative w-full max-w-md rounded-2xl border border-white/[0.08] p-6 shadow-2xl shadow-black/60 backdrop-blur-xl max-h-[90vh] overflow-y-auto"
                     style="background:rgba(15,15,25,0.95);" @click.stop>

                    <button @click="showSignup = false" class="absolute top-4 right-4 text-gray-500 hover:text-white transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>

                    <h2 class="text-lg font-bold text-white mb-1">Create Account</h2>
                    <p class="text-xs text-gray-500 mb-5">Sign up to complete your order</p>

                    <form @submit.prevent="signup()">
                        <div class="space-y-4">
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-medium text-gray-300 mb-1.5">First Name</label>
                                    <input type="text" x-model="regFirstName" required
                                           class="w-full px-3.5 py-2.5 rounded-xl text-white text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white/20 focus:ring-offset-0 transition-all"
                                           style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-300 mb-1.5">Last Name</label>
                                    <input type="text" x-model="regLastName" required
                                           class="w-full px-3.5 py-2.5 rounded-xl text-white text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white/20 focus:ring-offset-0 transition-all"
                                           style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);">
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-300 mb-1.5">Email address</label>
                                <input type="email" x-model="regEmail" required
                                       placeholder="you@example.com"
                                       class="w-full px-3.5 py-2.5 rounded-xl text-white text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white/20 focus:ring-offset-0 transition-all"
                                       style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-300 mb-1.5">Password</label>
                                <input type="password" x-model="regPassword" required minlength="8"
                                       placeholder="Minimum 8 characters"
                                       class="w-full px-3.5 py-2.5 rounded-xl text-white text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white/20 focus:ring-offset-0 transition-all"
                                       style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-300 mb-1.5">Confirm Password</label>
                                <input type="password" x-model="regPasswordConfirm" required minlength="8"
                                       class="w-full px-3.5 py-2.5 rounded-xl text-white text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white/20 focus:ring-offset-0 transition-all"
                                       style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);">
                            </div>
                            <div x-show="authError" x-cloak class="p-3 rounded-xl border border-red-500/20 bg-red-500/5">
                                <p class="text-sm text-red-400" x-text="authError"></p>
                            </div>
                            <button type="submit" :disabled="authLoading"
                                    class="w-full py-3 rounded-xl text-sm font-semibold text-white transition-all disabled:opacity-50"
                                    style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 4px 16px rgba(var(--color-primary-rgb),0.3);">
                                <span x-show="!authLoading">Create Account & Continue</span>
                                <span x-show="authLoading" class="flex items-center justify-center gap-2">
                                    <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                    Creating account...
                                </span>
                            </button>
                        </div>
                    </form>

                    <p class="text-xs text-gray-500 text-center mt-4">
                        Already have an account?
                        <button @click="showSignup = false; showLogin = true" class="font-medium transition-colors hover:opacity-80" style="color:var(--color-secondary);">Sign in</button>
                    </p>
                </div>
            </div>
        </template>
    </div>
    {% else %}

    {# Payment gateway selection #}
    {% set gateways = guest.invoice_gateways %}
    {% set _prd_balance = client.client_balance_get_total %}
    {% set _prd_tax_amount = client.client_is_taxable ? (cart.total * client.invoice_get_tax_rate / 100) : 0 %}
    {% set _prd_client_currency = client.profile_get.currency %}
    {% set enough_balance = _prd_balance >= (cart.total + _prd_tax_amount) and _prd_client_currency == cart.currency.code %}

    <div class="rounded-2xl border border-white/[0.07] mb-6 overflow-hidden" style="background:rgba(255,255,255,0.02);"
         x-data="orderCheckout()" x-init="init()">
        <div class="px-5 py-4 border-b border-white/5">
            <h2 class="text-sm font-semibold text-white">Payment Method</h2>
        </div>
        <div class="p-5">

            {% if enough_balance %}
            <div class="flex items-center gap-3 p-3 rounded-xl bg-green-500/5 border border-green-500/20 mb-4">
                <svg class="w-5 h-5 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <p class="text-sm text-green-300">Sufficient balance — amount will be deducted from your account balance.</p>
            </div>
            {% else %}
            <div class="space-y-2 mb-5">
                {% for gtw in gateways %}
                    {% if cart.currency.code in gtw.accepted_currencies %}
                    <label class="flex items-center gap-3 p-3.5 rounded-xl border cursor-pointer transition-all"
                           :class="selectedGateway == '{{ gtw.id }}' ? '' : 'border-white/[0.07] hover:border-white/20'"
                           :style="selectedGateway == '{{ gtw.id }}' ? 'background:rgba(var(--color-primary-rgb),0.08); border-color:var(--color-primary);' : 'background:rgba(255,255,255,0.015);'">
                        <input type="radio" name="gateway_id" value="{{ gtw.id }}" x-model="selectedGateway" class="hidden">
                        <div class="w-4 h-4 rounded-full border-2 flex items-center justify-center flex-shrink-0 transition-all"
                             :class="selectedGateway == '{{ gtw.id }}' ? '' : 'border-white/30'"
                             :style="selectedGateway == '{{ gtw.id }}' ? 'border-color:var(--color-secondary);' : ''">
                            <div class="w-2 h-2 rounded-full transition-all" :class="selectedGateway == '{{ gtw.id }}' ? 'opacity-100' : 'opacity-0'"
                                 style="background:var(--color-secondary);"></div>
                        </div>
                        <span class="text-sm text-white">{{ gtw.title }}</span>
                    </label>
                    {% endif %}
                {% endfor %}
                {% if gateways|length == 0 %}
                    <p class="text-sm text-gray-500 py-2">No payment gateways are configured yet. Please contact support.</p>
                {% endif %}
            </div>
            {% endif %}



            {# Checkout button #}
            <button @click="checkout()"
                    :disabled="loading || (!enough_balance && !selectedGateway)"
                    class="w-full py-3 rounded-xl text-sm font-semibold text-white transition-all disabled:opacity-40 disabled:cursor-not-allowed"
                    style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 4px 16px rgba(var(--color-primary-rgb),0.3);">
                <span x-show="!loading">Complete Order →</span>
                <span x-show="loading" class="flex items-center justify-center gap-2">
                    <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                    Processing...
                </span>
            </button>

            <p class="text-xs text-gray-600 text-center mt-3">
                By completing your order, you agree to our
                <a href="{{ settings.link_terms|default('/page/terms-and-conditions') }}" target="_blank" class="text-gray-500 hover:opacity-70">Terms of Service</a>
                and <a href="{{ settings.link_privacy|default('/page/privacy-policy') }}" target="_blank" class="text-gray-500 hover:opacity-70">Privacy Policy</a>.
            </p>
        </div>
    </div>

    {% endif %} {# end client check #}

    {% else %}
    {# Empty cart #}
    <div class="rounded-2xl border border-white/[0.07] py-20 text-center" style="background:rgba(255,255,255,0.02);">
        <p class="text-sm text-gray-500 mb-4">Your cart is empty.</p>
        <a href="{{ 'order'|url }}/{{ product.id }}" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-white text-sm font-semibold transition-all" style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
            Configure Product
        </a>
    </div>
    {% endif %}

</div>

{# ─── Product config view ────────────────────────────────────────────────── #}
{% else %}
{% if product.pricing.type == 'recurrent' and product.pricing.recurrent['1M'] is defined and product.pricing.recurrent['1M'].enabled %}
    {% set first_period = '1M' %}
{% elseif product.pricing.type == 'recurrent' and product.pricing.recurrent['3M'] is defined and product.pricing.recurrent['3M'].enabled %}
    {% set first_period = '3M' %}
{% elseif product.pricing.type == 'recurrent' and product.pricing.recurrent['6M'] is defined and product.pricing.recurrent['6M'].enabled %}
    {% set first_period = '6M' %}
{% elseif product.pricing.type == 'recurrent' and product.pricing.recurrent['1Y'] is defined and product.pricing.recurrent['1Y'].enabled %}
    {% set first_period = '1Y' %}
{% elseif product.pricing.type == 'recurrent' and product.pricing.recurrent['2Y'] is defined and product.pricing.recurrent['2Y'].enabled %}
    {% set first_period = '2Y' %}
{% else %}
    {% set first_period = '' %}
{% endif %}
{% include 'partial_order_product_component.html.twig' %}
<div x-data="orderProduct({{ product.id }}, '{{ first_period }}')" class="max-w-4xl mx-auto">

    {% if product.type == 'hosting' %}

    {# ── Hosting: screenshot-style sidebar layout ── #}
    <a href="{{ 'order'|url }}" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:opacity-70 transition-colors mb-4">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Back to Plans
    </a>
    <div class="mb-6">
        <span class="inline-flex items-center rounded-full border border-white/[0.10] bg-white/[0.04] px-3 py-1 text-xs font-semibold text-gray-300 mb-3">{{ product.pricing.type == 'recurrent' ? 'Subscription' : (product.pricing.type == 'once' ? 'One-time' : 'Free') }}</span>
        <h1 class="text-3xl font-bold text-white">{{ product.title }}</h1>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {# ── Main content: period + domain config ── #}
        <div class="lg:col-span-2 space-y-5">
            {# Compute enabled periods so the hosting form's period card renders #}
            {%- set _opf_enabled = [] -%}
            {%- set _opf_pk_labels = {} -%}
            {%- if product.pricing.type == 'recurrent' -%}
                {%- for _pk, _pp in product.pricing.recurrent -%}
                    {%- if _pp.enabled -%}
                        {%- set _opf_enabled = _opf_enabled|merge([_pk]) -%}
                        {%- set _opf_pk_labels = _opf_pk_labels|merge({(_pk): (periods[_pk] ?? _pk)}) -%}
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}
            {{ include('mod_servicehosting_order_form.html.twig') }}
        </div>
        {# ── Order Summary Sidebar (Stitch-style white card) ── #}
        <div class="lg:col-span-1 self-start">
            {% set currency = guest.cart_get_currency %}
            <div class="bg-white rounded-2xl border border-slate-100 shadow-lg p-6 sticky top-6 space-y-5">
                <div class="flex items-center justify-between">
                    <h2 class="text-lg font-bold text-slate-900">Order summary</h2>
                    <span class="inline-flex items-center rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 text-xs font-bold text-slate-500">{{ currency.code }}</span>
                </div>

                {# Line items #}
                <div class="space-y-3">
                    <div>
                        <p class="font-semibold text-slate-900 text-sm mb-2">{{ product.title }}</p>
                        {% if product.pricing.type == 'recurrent' %}
                        {% for code, prices in product.pricing.recurrent %}{% if prices.enabled %}
                        <div x-show="selectedPeriod === '{{ code }}'" class="flex items-start justify-between gap-2">
                            <span class="text-sm text-slate-500">{{ periods[code] ?? code }}</span>
                            <div class="text-right">
                                {% if prices.setup > 0 %}<p class="text-xs text-slate-400 line-through">{{ (prices.price + prices.setup) | money_convert }}</p>{% endif %}
                                <span class="text-sm font-semibold text-slate-900">{{ prices.price | money_convert }}</span>
                            </div>
                        </div>
                        {% endif %}{% endfor %}
                        <div x-show="!selectedPeriod" class="text-xs text-slate-400 italic">Select a billing period</div>
                        {% elseif product.pricing.type == 'once' %}
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-sm text-slate-500">One-time</span>
                            <span class="text-sm font-semibold text-slate-900">{{ product.pricing.once.price | money_convert }}</span>
                        </div>
                        {% endif %}
                    </div>

                    <div class="flex items-center justify-between gap-2">
                        <span class="text-sm text-slate-500">Domain name</span>
                        <span class="text-sm font-mono" :class="domainName ? 'text-slate-700' : 'text-slate-400'" x-text="domainName || '—'"></span>
                    </div>
                </div>

                <hr class="border-slate-100">

                {# Taxes row — VAT is added on /order/checkout, not here #}
                {% if client and client.client_is_taxable %}
                {% set tax_rate = client.invoice_get_tax_rate %}
                <div class="flex items-center justify-between gap-2">
                    <span class="text-sm text-slate-500 flex items-center gap-1">
                        Taxes ({{ tax_rate }}%)
                        <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </span>
                    <span class="text-sm font-semibold text-slate-500">Added at checkout</span>
                </div>
                <hr class="border-slate-100">
                {% endif %}

                {# Total #}
                <div class="flex items-end justify-between">
                    <span class="text-base font-bold text-slate-900">Total</span>
                    <div class="text-right">
                        {% if product.pricing.type == 'recurrent' %}
                        <p class="text-2xl font-bold text-slate-900" x-show="selectedPeriod" x-text="calcTotal(selectedPeriod)"></p>
                        <p class="text-sm italic text-slate-400" x-show="!selectedPeriod">—</p>
                        {% elseif product.pricing.type == 'once' %}
                        <p class="text-2xl font-bold text-slate-900" x-text="calcTotal('once')">{{ product.pricing.once.price | money_convert }}</p>
                        {% else %}
                        <p class="text-2xl font-bold text-emerald-600">Free</p>
                        {% endif %}
                        <div x-show="couponDiscount > 0" x-cloak class="flex items-center justify-end gap-1 mt-1">
                            <svg class="w-3 h-3 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                            <span class="text-xs text-emerald-600 font-medium" x-text="'−' + formatMoney(couponDiscount)"></span>
                        </div>
                    </div>
                </div>

                {# Coupon code — always-visible input + Apply button #}
                {% if product.pricing.type != 'free' %}
                <div class="space-y-2">
                    {# Input row: hidden once applied #}
                    <div x-show="!couponApplied" class="flex gap-2">
                        <div class="relative flex-1 min-w-0">
                            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                            <input type="text" x-model="couponCode"
                                   @keydown.enter.prevent="applyCoupon()"
                                   @input="couponError = null"
                                   placeholder="Promo code"
                                   class="w-full pl-9 pr-3 py-2.5 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-white/20 border border-slate-200 bg-slate-50 transition-all">
                        </div>
                        <button type="button" @click="applyCoupon()"
                                :disabled="!couponCode.trim() || couponLoading"
                                class="flex-shrink-0 flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-bold text-white transition-all focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed"
                                style="background:var(--color-primary);">
                            <span x-show="!couponLoading">Apply</span>
                            <span x-show="couponLoading" class="flex items-center">
                                <svg class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                            </span>
                        </button>
                    </div>
                    {# Error message #}
                    <p x-show="couponError" x-cloak x-text="couponError" class="text-xs text-red-500 flex items-center gap-1">
                    </p>
                    {# Applied state: pill badge + Remove link #}
                    <div x-show="couponApplied" x-cloak class="flex items-center justify-between rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2">
                        <div class="flex items-center gap-2">
                            <svg class="w-3.5 h-3.5 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                            <span class="text-xs font-mono font-bold text-emerald-700 uppercase tracking-wide" x-text="couponCode"></span>
                        </div>
                        <button type="button"
                                @click="couponApplied = false; couponDiscount = 0; couponCode = ''; promoType = null; promoValue = 0; promoPeriods = []; couponError = null;"
                                class="text-xs text-slate-400 hover:text-red-500 transition-colors font-medium ml-3">
                            Remove
                        </button>
                    </div>
                </div>
                {% endif %}

                {# Continue / Add to cart button #}
                <button type="button"
                        @click="addToCart({% if product.pricing.type == 'free' %}'free'{% elseif product.pricing.type == 'once' %}'once'{% else %}selectedPeriod{% endif %})"
                        :disabled="loading{% if product.pricing.type == 'recurrent' %} || !selectedPeriod{% endif %}"
                        class="flex w-full items-center justify-center gap-2 rounded-xl px-5 py-4 text-sm font-bold text-white transition-all disabled:cursor-not-allowed disabled:opacity-60"
                        style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary)); box-shadow:0 8px 24px rgba(var(--color-primary-rgb),0.25);">
                    <span x-show="!loading">Continue</span>
                    <span x-show="loading" class="flex items-center gap-2">
                        <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                        Processing...
                    </span>
                </button>
                <div x-show="errorMsg" x-cloak class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600" x-text="errorMsg"></div>
                <a x-show="domainInCart" x-cloak href="{{ '/order/checkout'|url }}"
                   class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-90"
                   style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));">
                    View Cart →
                </a>

                {# Trust signals #}
                <div class="border-t border-slate-100 pt-4 space-y-3">
                    <div class="flex items-center gap-2 text-xs text-slate-500">
                        <svg class="w-3.5 h-3.5 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                        <span>30-day money-back guarantee</span>
                    </div>
                    {# Trustpilot-style star rating #}
                    <div class="flex flex-col items-center gap-1 py-1">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold text-slate-700">Excellent</span>
                            <div class="flex gap-0.5">
                                <span class="w-4 h-4 bg-[#00b67a] flex items-center justify-center text-white" style="font-size:10px;clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)">★</span>
                                <span class="w-4 h-4 bg-[#00b67a] flex items-center justify-center text-white" style="font-size:10px;clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)">★</span>
                                <span class="w-4 h-4 bg-[#00b67a] flex items-center justify-center text-white" style="font-size:10px;clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)">★</span>
                                <span class="w-4 h-4 bg-[#00b67a] flex items-center justify-center text-white" style="font-size:10px;clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)">★</span>
                                <span class="w-4 h-4 bg-[#dcdce6] flex items-center justify-center text-slate-400" style="font-size:10px;clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)">★</span>
                            </div>
                        </div>
                        <p class="text-[10px] text-slate-400">Trusted by thousands of customers worldwide</p>
                    </div>
                    <p class="text-xs text-slate-400 text-center">
                        By ordering, you agree to our <a href="{{ settings.link_terms|default('/page/terms-and-conditions') }}" class="text-slate-500 underline hover:text-indigo-600">Terms of Service</a>
                    </p>
                </div>
            </div>

            {% include 'partial_payment_options.html.twig' %}
        </div>
    </div>

    {% else %}

    {# ── Non-hosting products ── #}
    {%- set _is_formbuilder = (product.form_id is defined and product.form_id and guest.extension_is_on({ 'mod': 'formbuilder' })) -%}

    <a href="{{ 'order'|url }}" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:opacity-70 transition-colors mb-4">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        All Plans
    </a>

    {% if _is_formbuilder %}
    <div class="mb-6">
        <span class="inline-flex items-center rounded-full border border-white/[0.10] bg-white/[0.04] px-3 py-1 text-xs font-semibold text-gray-300 mb-3">{{ product.pricing.type == 'recurrent' ? 'Subscription' : (product.pricing.type == 'once' ? 'One-time' : 'Free') }}</span>
        <h1 class="text-3xl font-bold text-white">{{ product.title }}</h1>
    </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        {# ── Left: Product info (hidden for formbuilder — form takes full 2/3 + sidebar 1/3) ── #}
        {% if not _is_formbuilder %}
        <div class="lg:col-span-1">
            <div class="rounded-2xl border border-white/[0.07] p-6 sticky top-6" style="background:rgba(255,255,255,0.02);">
                <div class="w-12 h-12 rounded-xl border flex items-center justify-center mb-4" style="background:rgba(var(--color-primary-rgb),0.10); border-color:rgba(var(--color-primary-rgb),0.20);">
                    <svg class="w-6 h-6" style="color:var(--color-secondary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </div>
                <h1 class="text-lg font-bold text-white mb-5">{{ product.title }}</h1>

                {# Parse description into feature bullets.
                   Supports HTML (<br>, <li>, <p>), newline-separated, or "- / *" markdown lists.
                   Falls back to type-appropriate defaults if description is empty. #}
                {% set _desc_raw = product.description|default('')|replace({'<br>': '|||', '<br/>': '|||', '<br />': '|||', '</p>': '|||', '</li>': '|||', 'check\\_circle': '', 'check_circle': ''})|striptags|trim %}
                {% set _bullets = _desc_raw|split('|||')|filter(l => l|trim != '') %}
                {% if _bullets|length <= 1 and product.description %}
                    {% set _bullets = [] %}
                    {% for _line in product.description|striptags|trim|split('\n') %}
                        {% set _feat = _line|replace({'* ': '', '- ': ''})|trim %}
                        {% if _feat %}{% set _bullets = _bullets|merge([_feat]) %}{% endif %}
                    {% endfor %}
                {% endif %}
                {% if _bullets|length == 0 %}
                    {% if product.type == 'domain' %}
                        {% set _bullets = ['Instant Domain Activation', 'Free DNS Management', 'WHOIS Privacy Available', 'Easy Transfer In/Out', 'Auto-Renewal Support', '24/7 Support'] %}
                    {% else %}
                        {% set _bullets = ['NVMe SSD Storage', 'DDoS Protection Included', 'Full Root SSH Access', '24/7 Technical Support', '99.9% Uptime SLA', 'Instant Provisioning'] %}
                    {% endif %}
                {% endif %}

                <ul class="space-y-2.5">
                    {% for bullet in _bullets|slice(0, 6) %}
                    <li class="flex items-center gap-2.5 text-sm text-gray-400">
                        <svg class="w-4 h-4 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        {{ bullet }}
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        {% endif %}

        {# ── Right: Configure & Order ── #}
        <div class="{{ _is_formbuilder ? 'lg:col-span-3' : 'lg:col-span-2' }} space-y-5">

            {# Pricing type display #}
            {% if product.type == 'domain' %}
                {# ── Domain product: 3-step wizard ── #}
                {% set reg_tlds = guest.serviceDomain_tlds({'allow_register': 1}) %}
                {% set xfr_tlds = guest.serviceDomain_tlds({'allow_transfer': 1}) %}

                <div x-data="domainOrder({{ product.id }})"
                     x-init="
                        regTld = '{{ (request.register_tld is defined and request.register_tld) ? request.register_tld|escape('js') : (reg_tlds is not empty ? reg_tlds[0].tld : '') }}';
                        xfrTld = '{{ xfr_tlds is not empty ? xfr_tlds[0].tld : '' }}';
                        {% if request.action is defined and request.action == 'transfer' %}mode = 'transfer';{% endif %}
                        {% if request.register_sld is defined and request.register_sld %}
                        regSld = '{{ request.register_sld|escape('js') }}';
                        domainPreview = regSld + regTld;
                        $nextTick(() => checkAvailability());
                        {% endif %}
                     "
                     x-cloak class="space-y-5">

                    {# ── Step indicator ── #}
                    <div class="flex items-center justify-between px-1">
                        <template x-for="(label, idx) in ['Domain Search', 'Nameservers', 'Contact Info']" :key="idx">
                            <div class="flex items-center" :class="idx < 2 ? 'flex-1' : ''">
                                <div class="flex flex-col items-center gap-1">
                                    <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold transition-all"
                                         :class="step === idx+1 ? 'text-white shadow-lg' : (step > idx+1 ? 'bg-green-500/20 text-green-400 border border-green-500/30' : 'bg-white/5 text-gray-500 border border-white/10')"
                                         :style="step === idx+1 ? 'background:var(--color-primary);' : ''">
                                        <template x-if="step > idx+1">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                        </template>
                                        <template x-if="step <= idx+1">
                                            <span x-text="idx+1"></span>
                                        </template>
                                    </div>
                                    <span class="text-[10px] font-medium whitespace-nowrap"
                                          :class="step === idx+1 ? '' : (step > idx+1 ? 'text-green-400' : 'text-gray-600')"
                                          :style="step === idx+1 ? 'color:var(--color-secondary);' : ''"
                                          x-text="label"></span>
                                </div>
                                <div x-show="idx < 2" class="flex-1 h-px mx-2 mb-4 transition-all"
                                     :class="step > idx+1 ? 'bg-green-500/30' : 'bg-white/8'"></div>
                            </div>
                        </template>
                    </div>

                    {# ══════════════════════════════════
                       STEP 1 — Domain Search
                    ══════════════════════════════════ #}
                    <div x-show="step === 1" x-transition.opacity.duration.200ms class="space-y-4">

                        {# ── Action selection cards ── #}
                        <div class="grid grid-cols-3 gap-3">

                            {# Register card #}
                            {% if reg_tlds %}
                            <button type="button" @click="mode='register'; available=null; errorMsg=null"
                                    class="relative text-left rounded-2xl border p-4 transition-all focus:outline-none"
                                    :class="mode==='register' ? 'shadow-lg' : 'border-white/[0.07] hover:border-white/20'"
                                    :style="mode==='register' ? 'background:rgba(var(--color-primary-rgb),0.10); border-color:var(--color-secondary);' : 'background:rgba(255,255,255,0.02);'">
                                {# checkmark badge #}
                                <span x-show="mode==='register'"
                                      class="absolute top-0 right-0 w-6 h-6 flex items-center justify-center rounded-bl-xl rounded-tr-2xl"
                                      style="background:var(--color-primary);">
                                    <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                                </span>
                                <div class="w-9 h-9 rounded-xl flex items-center justify-center mb-3"
                                     :class="mode==='register' ? '' : ''"
                                     :style="mode==='register' ? 'background:rgba(var(--color-primary-rgb),0.20);' : 'background:rgba(255,255,255,0.05);'">
                                    <svg class="w-5 h-5" :style="mode==='register' ? 'color:var(--color-secondary);' : 'color:rgb(107,114,128);'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                                    </svg>
                                </div>
                                <p class="text-sm font-semibold mb-0.5" :class="mode==='register' ? 'text-white' : 'text-gray-300'">Register New</p>
                                <p class="text-xs leading-relaxed" :style="mode==='register' ? 'color:rgba(var(--color-secondary-rgb),0.70);' : 'color:rgb(75,85,99);'">Find & register a new domain name</p>
                            </button>
                            {% endif %}

                            {# Transfer card #}
                            {% if xfr_tlds %}
                            <button type="button" @click="mode='transfer'; available=null; errorMsg=null"
                                    class="relative text-left rounded-2xl border p-4 transition-all focus:outline-none"
                                    :class="mode==='transfer' ? 'shadow-lg' : 'border-white/[0.07] hover:border-white/20'"
                                    :style="mode==='transfer' ? 'background:rgba(var(--color-primary-rgb),0.10); border-color:var(--color-secondary);' : 'background:rgba(255,255,255,0.02);'">
                                <span x-show="mode==='transfer'"
                                      class="absolute top-0 right-0 w-6 h-6 flex items-center justify-center rounded-bl-xl rounded-tr-2xl"
                                      style="background:var(--color-primary);">
                                    <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                                </span>
                                <div class="w-9 h-9 rounded-xl flex items-center justify-center mb-3"
                                     :style="mode==='transfer' ? 'background:rgba(var(--color-primary-rgb),0.20);' : 'background:rgba(255,255,255,0.05);'">
                                    <svg class="w-5 h-5" :style="mode==='transfer' ? 'color:var(--color-secondary);' : 'color:rgb(107,114,128);'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                                    </svg>
                                </div>
                                <p class="text-sm font-semibold mb-0.5" :class="mode==='transfer' ? 'text-white' : 'text-gray-300'">Transfer Domain</p>
                                <p class="text-xs leading-relaxed" :style="mode==='transfer' ? 'color:rgba(var(--color-secondary-rgb),0.70);' : 'color:rgb(75,85,99);'">Move your domain to us</p>
                            </button>
                            {% endif %}

                            {# Use Own Domain card #}
                            <button type="button" @click="mode='owndomain'; available=null; errorMsg=null"
                                    class="relative text-left rounded-2xl border p-4 transition-all focus:outline-none"
                                    :class="mode==='owndomain' ? 'shadow-lg' : 'border-white/[0.07] hover:border-white/20'"
                                    :style="mode==='owndomain' ? 'background:rgba(var(--color-primary-rgb),0.10); border-color:var(--color-secondary);' : 'background:rgba(255,255,255,0.02);'">
                                <span x-show="mode==='owndomain'"
                                      class="absolute top-0 right-0 w-6 h-6 flex items-center justify-center rounded-bl-xl rounded-tr-2xl"
                                      style="background:var(--color-primary);">
                                    <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                                </span>
                                <div class="w-9 h-9 rounded-xl flex items-center justify-center mb-3"
                                     :style="mode==='owndomain' ? 'background:rgba(var(--color-primary-rgb),0.20);' : 'background:rgba(255,255,255,0.05);'">
                                    <svg class="w-5 h-5" :style="mode==='owndomain' ? 'color:var(--color-secondary);' : 'color:rgb(107,114,128);'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                                    </svg>
                                </div>
                                <p class="text-sm font-semibold mb-0.5" :class="mode==='owndomain' ? 'text-white' : 'text-gray-300'">Use Own Domain</p>
                                <p class="text-xs leading-relaxed" :style="mode==='owndomain' ? 'color:rgba(var(--color-secondary-rgb),0.70);' : 'color:rgb(75,85,99);'">Already own a domain? Use it here</p>
                            </button>

                        </div>

                        {# ── Register fields ── #}
                        {% if reg_tlds %}
                        <div x-show="mode==='register'" x-transition.opacity.duration.200ms class="space-y-4">
                            <div class="rounded-2xl border border-white/[0.07] overflow-hidden" style="background:rgba(255,255,255,0.02);">
                                <div class="px-5 py-4 border-b border-white/5">
                                    <h3 class="text-sm font-semibold text-white">Search Your Domain</h3>
                                    <p class="text-xs text-gray-500 mt-0.5">Enter a name and check if it's available</p>
                                </div>
                                <div class="p-5 space-y-4">
                                    <div>
                                        <label class="block text-xs text-gray-400 font-medium mb-2">Domain Name</label>
                                        <div class="flex rounded-xl overflow-hidden border border-white/15 focus-within:border-white/40 transition-colors" style="background:#1a1a2e;">
                                            <input type="text" x-model="regSld" placeholder="yourdomain"
                                                   @input="domainPreview = regSld.trim() ? regSld.trim() + regTld : ''; available = null"
                                                   @keydown.enter="checkAvailability()"
                                                   class="flex-1 bg-transparent px-4 py-3.5 text-white text-sm placeholder-gray-600 focus:outline-none min-w-0">
                                            <div class="flex items-center px-1 py-1" style="background:rgba(255,255,255,0.03);">
                                                <div class="w-px h-6 bg-white/10 mr-1"></div>
                                                <select x-model="regTld"
                                                        @change="domainPreview = regSld.trim() ? regSld.trim() + regTld : ''; available = null"
                                                        class="bg-transparent text-sm font-medium focus:outline-none cursor-pointer pr-2 pl-2"
                                                        style="color:var(--color-secondary); appearance:none; -webkit-appearance:none;">
                                                    {% for t in reg_tlds %}
                                                    <option value="{{ t.tld }}" style="background:#1e1e3a; color:#e2e8f0;">{{ t.tld }}</option>
                                                    {% endfor %}
                                                </select>
                                                <svg class="w-3.5 h-3.5 text-gray-500 pointer-events-none -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                            </div>
                                        </div>
                                        <div x-show="domainPreview" class="mt-2 flex items-center gap-2">
                                            <span class="text-xs text-gray-500">Preview:</span>
                                            <span class="text-xs font-mono font-semibold" style="color:var(--color-secondary);" x-text="domainPreview"></span>
                                        </div>
                                    </div>

                                    {# Registration period #}
                                    <div>
                                        <label class="block text-xs text-gray-400 font-medium mb-2">Registration Period</label>
                                        <div class="flex gap-2 flex-wrap">
                                            {% for y in 1..5 %}
                                            <button type="button" @click="regYears={{ y }}"
                                                    :class="regYears==={{ y }} ? '' : 'border-white/10 text-gray-400 hover:border-white/20 hover:text-gray-200'"
                                                    :style="regYears==={{ y }} ? 'border-color:var(--color-secondary); background:rgba(var(--color-secondary-rgb),0.12); color:var(--color-secondary);' : 'background:rgba(255,255,255,0.03);'"
                                                    class="px-4 py-2 rounded-xl border text-sm font-medium transition-all">
                                                {{ y }}{{ y == 1 ? ' yr' : ' yrs' }}
                                            </button>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {# TLD pricing table #}
                            <div class="rounded-2xl border border-white/[0.07] overflow-hidden" style="background:rgba(255,255,255,0.02);">
                                <div class="px-5 py-3.5 border-b border-white/5 flex items-center justify-between">
                                    <p class="text-xs text-gray-400 uppercase tracking-wide font-medium">TLD Pricing</p>
                                    <p class="text-xs text-gray-600">per year</p>
                                </div>
                                <div class="divide-y divide-white/[0.04]">
                                    {% for t in reg_tlds %}
                                    <button type="button" @click="regTld='{{ t.tld }}'; domainPreview = regSld.trim() ? regSld.trim() + '{{ t.tld }}' : ''; available = null"
                                            class="w-full flex items-center justify-between px-5 py-3.5 transition-colors text-left"
                                            :class="regTld === '{{ t.tld }}' ? '' : 'hover:bg-white/[0.02]'"
                                            :style="regTld === '{{ t.tld }}' ? 'background:rgba(var(--color-secondary-rgb),0.06);' : ''">
                                        <div class="flex items-center gap-3">
                                            <div class="w-2 h-2 rounded-full flex-shrink-0 transition-all"
                                                 :class="regTld === '{{ t.tld }}' ? '' : 'bg-white/15'"
                                                 :style="regTld === '{{ t.tld }}' ? 'background:var(--color-secondary); box-shadow:0 0 0 2px rgba(var(--color-secondary-rgb),0.30);' : ''"></div>
                                            <span class="text-sm font-mono font-medium"
                                                  :style="regTld === '{{ t.tld }}' ? 'color:var(--color-secondary);' : 'color:rgb(209,213,219);'">{{ t.tld }}</span>
                                        </div>
                                        <div class="text-right">
                                            <span class="text-sm font-semibold"
                                                  :class="regTld === '{{ t.tld }}' ? 'text-white' : 'text-gray-300'">{{ t.price_registration | money_convert }}</span>
                                            {% if t.price_renew != t.price_registration %}
                                            <p class="text-xs text-gray-600 mt-0.5">Renew {{ t.price_renew | money_convert }}/yr</p>
                                            {% endif %}
                                        </div>
                                    </button>
                                    {% endfor %}
                                </div>
                            </div>

                            {# Availability result badge #}
                            <div x-show="available === true" x-transition.opacity.duration.200ms class="flex items-center gap-2.5 p-3 rounded-xl bg-green-500/8 border border-green-500/20">
                                <svg class="w-4 h-4 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                <p class="text-sm text-green-300"><span class="font-mono font-semibold" x-text="domainPreview"></span> is available!</p>
                            </div>
                            <div x-show="available === false" x-transition.opacity.duration.200ms class="flex items-center gap-2.5 p-3 rounded-xl bg-red-500/8 border border-red-500/20">
                                <svg class="w-4 h-4 text-red-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                <p class="text-sm text-red-300"><span class="font-mono font-semibold" x-text="domainPreview"></span> is not available.</p>
                            </div>

                            {# Check / Continue button #}
                            <div class="flex gap-3">
                                <button type="button" @click="checkAvailability()"
                                        :disabled="checking || !regSld.trim()"
                                        class="flex-1 py-3.5 rounded-xl text-sm font-semibold transition-all disabled:opacity-50 disabled:cursor-not-allowed border"
                                        style="background:rgba(var(--color-secondary-rgb),0.08); border-color:rgba(var(--color-secondary-rgb),0.40); color:var(--color-secondary);">
                                    <span x-show="!checking">Check Availability</span>
                                    <span x-show="checking" class="flex items-center justify-center gap-2">
                                        <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                        Checking...
                                    </span>
                                </button>
                                <button type="button" @click="step = 2"
                                        x-show="available === true"
                                        x-transition.opacity.duration.200ms
                                        class="flex-1 py-3.5 rounded-xl text-sm font-semibold text-white transition-all"
                                        style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 4px 16px rgba(var(--color-primary-rgb),0.3);">
                                    Continue →
                                </button>
                            </div>
                        </div>
                        {% endif %}

                        {# ── Transfer fields ── #}
                        {% if xfr_tlds %}
                        <div x-show="mode==='transfer'" x-transition.opacity.duration.200ms class="space-y-4">
                            <div class="rounded-2xl border border-white/[0.07] overflow-hidden" style="background:rgba(255,255,255,0.02);">
                                <div class="px-5 py-4 border-b border-white/5">
                                    <h3 class="text-sm font-semibold text-white">Transfer Your Domain</h3>
                                    <p class="text-xs text-gray-500 mt-0.5">Enter the domain and EPP code from your current registrar</p>
                                </div>
                                <div class="p-5 space-y-4">
                                    <div>
                                        <label class="block text-xs text-gray-400 font-medium mb-2">Domain Name</label>
                                        <div class="flex rounded-xl overflow-hidden border border-white/15 focus-within:border-white/40 transition-colors" style="background:#1a1a2e;">
                                            <input type="text" x-model="xfrSld" placeholder="yourdomain"
                                                   @input="available = null"
                                                   class="flex-1 bg-transparent px-4 py-3.5 text-white text-sm placeholder-gray-600 focus:outline-none min-w-0">
                                            <div class="flex items-center px-1 py-1" style="background:rgba(255,255,255,0.03);">
                                                <div class="w-px h-6 bg-white/10 mr-1"></div>
                                                <select x-model="xfrTld"
                                                        class="bg-transparent text-sm font-medium focus:outline-none cursor-pointer pr-2 pl-2"
                                                        style="color:var(--color-secondary); appearance:none; -webkit-appearance:none;">
                                                    {% for t in xfr_tlds %}
                                                    <option value="{{ t.tld }}" style="background:#1e1e3a; color:#e2e8f0;">{{ t.tld }}</option>
                                                    {% endfor %}
                                                </select>
                                                <svg class="w-3.5 h-3.5 text-gray-500 pointer-events-none -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block text-xs text-gray-400 font-medium mb-2">EPP / Authorization Code</label>
                                        <input type="text" x-model="authCode" placeholder="e.g. Ab3#Xy9!kL2..."
                                               class="w-full rounded-xl px-4 py-3.5 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                               style="background:#1a1a2e;">
                                        <p class="text-xs text-gray-600 mt-1.5">Obtain this code from your current registrar's control panel</p>
                                    </div>
                                    <div class="flex items-start gap-2.5 p-3 rounded-xl bg-blue-500/5 border border-blue-500/15">
                                        <svg class="w-4 h-4 text-blue-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        <p class="text-xs text-blue-300/80">Transfers typically complete within 5–7 days. Your domain must be unlocked and older than 60 days.</p>
                                    </div>
                                </div>
                            </div>

                            {# Transfer eligibility result #}
                            <div x-show="available === true" x-transition.opacity.duration.200ms class="flex items-center gap-2.5 p-3 rounded-xl bg-green-500/8 border border-green-500/20">
                                <svg class="w-4 h-4 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                <p class="text-sm text-green-300">Domain is eligible for transfer.</p>
                            </div>
                            <div x-show="available === false" x-transition.opacity.duration.200ms class="flex items-center gap-2.5 p-3 rounded-xl bg-red-500/8 border border-red-500/20">
                                <svg class="w-4 h-4 text-red-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                <p class="text-sm text-red-300" x-text="availMsg || 'This domain cannot be transferred.'"></p>
                            </div>

                            <div class="flex gap-3">
                                <button type="button" @click="checkTransfer()"
                                        :disabled="checking || !xfrSld.trim()"
                                        class="flex-1 py-3.5 rounded-xl text-sm font-semibold transition-all disabled:opacity-50 disabled:cursor-not-allowed border"
                                        style="background:rgba(var(--color-secondary-rgb),0.08); border-color:rgba(var(--color-secondary-rgb),0.40); color:var(--color-secondary);">
                                    <span x-show="!checking">Check Transfer</span>
                                    <span x-show="checking" class="flex items-center justify-center gap-2">
                                        <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                        Checking...
                                    </span>
                                </button>
                                <button type="button" @click="step = 2"
                                        x-show="available === true"
                                        x-transition.opacity.duration.200ms
                                        class="flex-1 py-3.5 rounded-xl text-sm font-semibold text-white transition-all"
                                        style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 4px 16px rgba(var(--color-primary-rgb),0.3);">
                                    Continue →
                                </button>
                            </div>
                        </div>
                        {% endif %}

                        {# ── Use Own Domain fields ── #}
                        <div x-show="mode==='owndomain'" x-transition.opacity.duration.200ms class="space-y-4">
                            <div class="rounded-2xl border border-white/[0.07] overflow-hidden" style="background:rgba(255,255,255,0.02);">
                                <div class="px-5 py-4 border-b border-white/5">
                                    <h3 class="text-sm font-semibold text-white">Enter Your Domain</h3>
                                    <p class="text-xs text-gray-500 mt-0.5">Provide your existing domain name to use with this service</p>
                                </div>
                                <div class="p-5 space-y-3">
                                    <div>
                                        <label class="block text-xs text-gray-400 font-medium mb-2">Domain Name</label>
                                        <div class="flex rounded-xl overflow-hidden border border-white/15 focus-within:border-white/40 transition-colors" style="background:#1a1a2e;">
                                            <input type="text" x-model="ownSld" placeholder="yourdomain"
                                                   @keydown.enter.prevent=""
                                                   class="flex-1 bg-transparent px-4 py-3.5 text-white text-sm placeholder-gray-600 focus:outline-none min-w-0">
                                            <div class="flex items-center px-1 py-1" style="background:rgba(255,255,255,0.03);">
                                                <div class="w-px h-6 bg-white/10 mr-1"></div>
                                                <input type="text" x-model="ownTld" placeholder=".com"
                                                       class="bg-transparent text-sm font-medium focus:outline-none w-20 px-2" style="color:var(--color-secondary);"
                                                       style="appearance:none; -webkit-appearance:none;">
                                            </div>
                                        </div>
                                        <p class="text-xs text-gray-600 mt-1.5">Enter TLD with leading dot, e.g. <span class="text-gray-500 font-mono">.com</span></p>
                                    </div>
                                    <div class="flex items-start gap-2.5 p-3 rounded-xl bg-amber-500/5 border border-amber-500/15">
                                        <svg class="w-4 h-4 text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        <p class="text-xs text-amber-300/80">Your domain registration will not be managed by us. You keep full control at your current registrar.</p>
                                    </div>
                                </div>
                            </div>

                            <button type="button" @click="goToStep3()"
                                    :disabled="!ownSld.trim() || !ownTld.trim()"
                                    class="w-full py-3.5 rounded-xl text-sm font-semibold text-white transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                                    style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 4px 16px rgba(var(--color-primary-rgb),0.3);">
                                Continue →
                            </button>
                        </div>

                    </div>{# /step 1 #}

                    {# ══════════════════════════════════
                       STEP 2 — Nameservers
                    ══════════════════════════════════ #}
                    <div x-show="step === 2" x-transition.opacity.duration.200ms class="space-y-4">

                        <div class="rounded-2xl border border-white/[0.07] overflow-hidden" style="background:rgba(255,255,255,0.02);">
                            <div class="px-5 py-4 border-b border-white/5">
                                <h3 class="text-sm font-semibold text-white">Nameserver Configuration</h3>
                                <p class="text-xs text-gray-500 mt-0.5">Choose default nameservers or enter your own</p>
                            </div>
                            <div class="p-5 space-y-4">

                                {# Toggle #}
                                <div class="flex gap-1 p-1 rounded-xl border border-white/10" style="background:rgba(255,255,255,0.04);">
                                    <button type="button" @click="useDefaultNs = true"
                                            :class="useDefaultNs ? 'text-white shadow-lg' : 'text-gray-400 hover:text-white'"
                                            :style="useDefaultNs ? 'background:var(--color-primary);' : ''"
                                            class="flex-1 py-2.5 rounded-lg text-sm font-medium transition-all">
                                        Use Default Nameservers
                                    </button>
                                    <button type="button" @click="useDefaultNs = false"
                                            :class="!useDefaultNs ? 'text-white shadow-lg' : 'text-gray-400 hover:text-white'"
                                            :style="!useDefaultNs ? 'background:var(--color-primary);' : ''"
                                            class="flex-1 py-2.5 rounded-lg text-sm font-medium transition-all">
                                        Custom Nameservers
                                    </button>
                                </div>

                                {# Default NS notice #}
                                <div x-show="useDefaultNs" x-transition.opacity.duration.200ms
                                     class="flex items-start gap-2.5 p-3.5 rounded-xl border"
                                     style="background:rgba(var(--color-secondary-rgb),0.06); border-color:rgba(var(--color-secondary-rgb),0.20);">
                                    <svg class="w-4 h-4 flex-shrink-0 mt-0.5" style="color:var(--color-secondary);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                    <div>
                                        <p class="text-sm font-medium" style="color:var(--color-secondary);">Default nameservers will be used</p>
                                        <p class="text-xs mt-0.5 text-gray-500">Our default nameservers will be automatically configured for your domain.</p>
                                    </div>
                                </div>

                                {# Custom NS fields #}
                                <div x-show="!useDefaultNs" x-transition.opacity.duration.200ms class="space-y-3">
                                    <div class="grid grid-cols-1 gap-3">
                                        <div>
                                            <label class="block text-xs text-gray-400 font-medium mb-1.5">Nameserver 1 <span class="text-red-400">*</span></label>
                                            <input type="text" x-model="ns1" placeholder="ns1.example.com"
                                                   class="w-full rounded-xl px-4 py-3 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                                   style="background:#1a1a2e;">
                                        </div>
                                        <div>
                                            <label class="block text-xs text-gray-400 font-medium mb-1.5">Nameserver 2 <span class="text-red-400">*</span></label>
                                            <input type="text" x-model="ns2" placeholder="ns2.example.com"
                                                   class="w-full rounded-xl px-4 py-3 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                                   style="background:#1a1a2e;">
                                        </div>
                                        <div>
                                            <label class="block text-xs text-gray-400 font-medium mb-1.5">Nameserver 3 <span class="text-gray-600">(optional)</span></label>
                                            <input type="text" x-model="ns3" placeholder="ns3.example.com"
                                                   class="w-full rounded-xl px-4 py-3 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                                   style="background:#1a1a2e;">
                                        </div>
                                        <div>
                                            <label class="block text-xs text-gray-400 font-medium mb-1.5">Nameserver 4 <span class="text-gray-600">(optional)</span></label>
                                            <input type="text" x-model="ns4" placeholder="ns4.example.com"
                                                   class="w-full rounded-xl px-4 py-3 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                                   style="background:#1a1a2e;">
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div class="flex gap-3">
                            <button type="button" @click="step = 1"
                                    class="px-5 py-3.5 rounded-xl text-sm font-semibold text-gray-400 hover:text-white border border-white/10 hover:border-white/20 transition-all"
                                    style="background:rgba(255,255,255,0.03);">
                                ← Back
                            </button>
                            <button type="button" @click="goToStep3()"
                                    :disabled="!useDefaultNs && (!ns1.trim() || !ns2.trim())"
                                    class="flex-1 py-3.5 rounded-xl text-sm font-semibold text-white transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                                    style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 4px 16px rgba(var(--color-primary-rgb),0.3);">
                                Continue →
                            </button>
                        </div>

                    </div>{# /step 2 #}

                    {# ══════════════════════════════════
                       STEP 3 — Contact Information
                    ══════════════════════════════════ #}
                    <div x-show="step === 3" x-transition.opacity.duration.200ms class="space-y-4">

                        <div class="rounded-2xl border border-white/[0.07] overflow-hidden" style="background:rgba(255,255,255,0.02);">
                            <div class="px-5 py-4 border-b border-white/5">
                                <h3 class="text-sm font-semibold text-white">Contact Information</h3>
                                <p class="text-xs text-gray-500 mt-0.5">Required for domain registration WHOIS records</p>
                            </div>
                            <div class="p-5 space-y-4">

                                {# Source toggle #}
                                <div class="flex gap-1 p-1 rounded-xl border border-white/10" style="background:rgba(255,255,255,0.04);">
                                    <button type="button" @click="useAccountContact = true; loadContactFromAccount()"
                                            :class="useAccountContact ? 'text-white shadow-lg' : 'text-gray-400 hover:text-white'"
                                            :style="useAccountContact ? 'background:var(--color-primary);' : ''"
                                            class="flex-1 py-2.5 rounded-lg text-sm font-medium transition-all">
                                        Use Account Contact
                                    </button>
                                    <button type="button" @click="useAccountContact = false; contact = {first_name:'',last_name:'',email:'',company:'',address_1:'',city:'',state:'',country:'',postcode:'',phone_cc:'',phone:''}"
                                            :class="!useAccountContact ? 'text-white shadow-lg' : 'text-gray-400 hover:text-white'"
                                            :style="!useAccountContact ? 'background:var(--color-primary);' : ''"
                                            class="flex-1 py-2.5 rounded-lg text-sm font-medium transition-all">
                                        Custom Contact
                                    </button>
                                </div>

                                {# Loading indicator for profile fetch #}
                                <div x-show="contactLoading" class="flex items-center justify-center py-6 gap-2 text-gray-500 text-sm">
                                    <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                    Loading account details...
                                </div>

                                {# Contact form fields #}
                                <div x-show="!contactLoading" class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="block text-xs text-gray-400 font-medium mb-1.5">First Name <span class="text-red-400">*</span></label>
                                        <input type="text" x-model="contact.first_name" placeholder="John"
                                               :readonly="useAccountContact"
                                               :class="useAccountContact ? 'opacity-70 cursor-not-allowed' : ''"
                                               class="w-full rounded-xl px-4 py-3 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                               style="background:#1a1a2e;">
                                    </div>
                                    <div>
                                        <label class="block text-xs text-gray-400 font-medium mb-1.5">Last Name <span class="text-red-400">*</span></label>
                                        <input type="text" x-model="contact.last_name" placeholder="Doe"
                                               :readonly="useAccountContact"
                                               :class="useAccountContact ? 'opacity-70 cursor-not-allowed' : ''"
                                               class="w-full rounded-xl px-4 py-3 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                               style="background:#1a1a2e;">
                                    </div>
                                    <div class="col-span-2">
                                        <label class="block text-xs text-gray-400 font-medium mb-1.5">Email Address <span class="text-red-400">*</span></label>
                                        <input type="email" x-model="contact.email" placeholder="john@example.com"
                                               :readonly="useAccountContact"
                                               :class="useAccountContact ? 'opacity-70 cursor-not-allowed' : ''"
                                               class="w-full rounded-xl px-4 py-3 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                               style="background:#1a1a2e;">
                                    </div>
                                    <div class="col-span-2">
                                        <label class="block text-xs text-gray-400 font-medium mb-1.5">Company <span class="text-gray-600">(optional)</span></label>
                                        <input type="text" x-model="contact.company" placeholder="Acme Corp"
                                               :readonly="useAccountContact"
                                               :class="useAccountContact ? 'opacity-70 cursor-not-allowed' : ''"
                                               class="w-full rounded-xl px-4 py-3 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                               style="background:#1a1a2e;">
                                    </div>
                                    <div class="col-span-2">
                                        <label class="block text-xs text-gray-400 font-medium mb-1.5">Address <span class="text-red-400">*</span></label>
                                        <input type="text" x-model="contact.address_1" placeholder="123 Main Street"
                                               :readonly="useAccountContact"
                                               :class="useAccountContact ? 'opacity-70 cursor-not-allowed' : ''"
                                               class="w-full rounded-xl px-4 py-3 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                               style="background:#1a1a2e;">
                                    </div>
                                    <div>
                                        <label class="block text-xs text-gray-400 font-medium mb-1.5">City <span class="text-red-400">*</span></label>
                                        <input type="text" x-model="contact.city" placeholder="New York"
                                               :readonly="useAccountContact"
                                               :class="useAccountContact ? 'opacity-70 cursor-not-allowed' : ''"
                                               class="w-full rounded-xl px-4 py-3 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                               style="background:#1a1a2e;">
                                    </div>
                                    <div>
                                        <label class="block text-xs text-gray-400 font-medium mb-1.5">State / Region</label>
                                        <input type="text" x-model="contact.state" placeholder="NY"
                                               :readonly="useAccountContact"
                                               :class="useAccountContact ? 'opacity-70 cursor-not-allowed' : ''"
                                               class="w-full rounded-xl px-4 py-3 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                               style="background:#1a1a2e;">
                                    </div>
                                    <div>
                                        <label class="block text-xs text-gray-400 font-medium mb-1.5">Country <span class="text-red-400">*</span></label>
                                        <input type="text" x-model="contact.country" placeholder="US"
                                               :readonly="useAccountContact"
                                               :class="useAccountContact ? 'opacity-70 cursor-not-allowed' : ''"
                                               class="w-full rounded-xl px-4 py-3 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                               style="background:#1a1a2e;">
                                    </div>
                                    <div>
                                        <label class="block text-xs text-gray-400 font-medium mb-1.5">Postcode <span class="text-red-400">*</span></label>
                                        <input type="text" x-model="contact.postcode" placeholder="10001"
                                               :readonly="useAccountContact"
                                               :class="useAccountContact ? 'opacity-70 cursor-not-allowed' : ''"
                                               class="w-full rounded-xl px-4 py-3 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                               style="background:#1a1a2e;">
                                    </div>
                                    <div>
                                        <label class="block text-xs text-gray-400 font-medium mb-1.5">Phone Code</label>
                                        <input type="text" x-model="contact.phone_cc" placeholder="+1"
                                               :readonly="useAccountContact"
                                               :class="useAccountContact ? 'opacity-70 cursor-not-allowed' : ''"
                                               class="w-full rounded-xl px-4 py-3 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                               style="background:#1a1a2e;">
                                    </div>
                                    <div>
                                        <label class="block text-xs text-gray-400 font-medium mb-1.5">Phone Number</label>
                                        <input type="text" x-model="contact.phone" placeholder="5551234567"
                                               :readonly="useAccountContact"
                                               :class="useAccountContact ? 'opacity-70 cursor-not-allowed' : ''"
                                               class="w-full rounded-xl px-4 py-3 text-white text-sm placeholder-gray-600 border border-white/15 focus:outline-none focus:border-white/40 transition-colors"
                                               style="background:#1a1a2e;">
                                    </div>
                                </div>

                            </div>
                        </div>

                        {# Error message #}
                        <div x-show="errorMsg" x-cloak class="p-3.5 rounded-xl border border-red-500/20 bg-red-500/5 flex items-start gap-2.5">
                            <svg class="w-4 h-4 text-red-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <p class="text-sm text-red-400" x-text="errorMsg"></p>
                        </div>
                        <a x-show="domainInCart" x-cloak href="{{ '/order/checkout'|url }}"
                           class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-90"
                           style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));">
                            View Cart →
                        </a>

                        {# ── Coupon code ── #}
                        <div>
                            <button type="button" @click="couponOpen = !couponOpen; couponError = null"
                                    class="flex items-center gap-1.5 text-sm font-semibold focus:outline-none transition-colors w-full"
                                    :class="couponApplied ? 'text-emerald-400' : 'text-gray-400 hover:opacity-70'">
                                <template x-if="couponApplied">
                                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                </template>
                                <template x-if="!couponApplied">
                                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                                </template>
                                <span x-text="couponApplied ? 'Code saved!' : 'Have a coupon code?'"></span>
                                <svg class="w-3.5 h-3.5 transition-transform duration-200 ml-auto flex-shrink-0"
                                     :class="couponOpen ? 'rotate-180' : ''"
                                     fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                            </button>
                            <div x-show="couponOpen" x-transition:enter="transition ease-out duration-150"
                                 x-transition:enter-start="opacity-0 -translate-y-1" x-transition:enter-end="opacity-100 translate-y-0"
                                 class="mt-2.5">
                                <div class="flex gap-2">
                                    <input type="text" x-model="couponCode"
                                           @keydown.enter.prevent="applyCoupon()"
                                           placeholder="Enter coupon code"
                                           class="flex-1 min-w-0 rounded-xl px-3 py-2.5 text-sm text-white placeholder-gray-600 focus:outline-none transition-all"
                                           style="border: 1.5px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.05);"
                                           @focus="$el.style.borderColor='var(--color-primary)'; $el.style.background='rgba(255,255,255,0.08)'"
                                           @blur="$el.style.borderColor='rgba(255,255,255,0.1)'; $el.style.background='rgba(255,255,255,0.05)'"
                                           :disabled="couponApplied">
                                    <button type="button" @click="applyCoupon()"
                                            :disabled="!couponCode.trim() || couponLoading || couponApplied"
                                            class="flex-shrink-0 px-4 py-2.5 rounded-xl text-sm font-bold transition-all focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed"
                                            style="background: var(--color-primary); color:#fff;">
                                        <span x-show="!couponLoading && !couponApplied">Apply</span>
                                        <span x-show="couponLoading" class="flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5 animate-spin" aria-hidden="true" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                                        </span>
                                        <span x-show="couponApplied">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                        </span>
                                    </button>
                                </div>
                                <p x-show="couponError" x-cloak x-text="couponError" class="mt-1.5 text-xs text-red-400"></p>
                                <p x-show="couponApplied" x-cloak class="mt-1.5 text-xs text-emerald-400 font-medium flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                    Code saved — discount applied at checkout.
                                </p>
                            </div>
                        </div>

                        <div class="flex gap-3">
                            <button type="button" @click="mode === 'owndomain' ? step = 1 : step = 2"
                                    class="px-5 py-3.5 rounded-xl text-sm font-semibold text-gray-400 hover:text-white border border-white/10 hover:border-white/20 transition-all"
                                    style="background:rgba(255,255,255,0.03);">
                                ← Back
                            </button>
                            <button type="button" @click="addToCart()"
                                    :disabled="loading || !contact.first_name.trim() || !contact.last_name.trim() || !contact.email.trim() || !contact.address_1.trim() || !contact.city.trim() || !contact.country.trim() || !contact.postcode.trim()"
                                    class="flex-1 py-3.5 rounded-xl text-sm font-semibold text-white transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                                    style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 4px 16px rgba(var(--color-primary-rgb),0.3);">
                                <span x-show="!loading">Add to Cart & Continue →</span>
                                <span x-show="loading" class="flex items-center justify-center gap-2">
                                    <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                    Adding to cart...
                                </span>
                            </button>
                        </div>

                        <p class="text-xs text-gray-600 text-center">
                            By ordering, you agree to our <a href="{{ settings.link_terms|default('/page/terms-and-conditions') }}" class="text-gray-500 hover:opacity-70">Terms of Service</a>
                        </p>

                    </div>{# /step 3 #}

                </div>{# /x-data domainOrder #}

            {% else %}
                {# ── All other product types (server, custom, downloadable, etc.) ── #}
                {% set service_order_tpl = 'mod_service' ~ product.type ~ '_order_form.html.twig' %}
                {% if guest.system_template_exists({ 'file': service_order_tpl }) %}
                    {{ include(service_order_tpl) }}

                {% elseif product.form_id is defined and product.form_id and guest.extension_is_on({ 'mod': 'formbuilder' }) %}
                    {# ── Custom form product with pricing + addons ── #}
                    {% set form = guest.formbuilder_get({ 'id': product.form_id }) %}
                    {% set pricing = product.pricing %}
                    {% set periods = guest.system_periods %}

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
                    <div class="lg:col-span-2 space-y-5" x-ref="formbuilderSection">

                        {# ── 1. Billing cycle (recurrent only) — shown FIRST ── #}
                        {% if pricing.type == 'recurrent' %}
                        {%- set _base_price = (pricing.recurrent['1M'] is defined and pricing.recurrent['1M'].enabled) ? pricing.recurrent['1M'].price : 0 -%}
                        <div class="rounded-2xl border border-white/[0.07] overflow-hidden" style="background:rgba(255,255,255,0.02);">
                            <div class="px-5 py-3.5 border-b border-white/[0.05] flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                    <p class="text-sm font-semibold text-gray-200">Select billing cycle</p>
                                </div>
                                {% if _base_price > 0 %}<span class="text-xs font-medium" style="color:rgba(52,211,153,0.8);">Longer plans save more</span>{% endif %}
                            </div>
                            <div class="p-4 space-y-2.5">
                                {% for code, prices in pricing.recurrent %}
                                {% if prices.enabled %}
                                {%- set _months_map = {'1W': 0.25, '1M': 1, '3M': 3, '6M': 6, '1Y': 12, '2Y': 24, '3Y': 36} -%}
                                {%- set _months = _months_map[code] ?? 1 -%}
                                {%- set _ppm = (_months > 0) ? (prices.price / _months) : prices.price -%}
                                {%- set _savings_pct = (_base_price > 0 and _months > 1 and _ppm < _base_price) ? ((1 - (_ppm / _base_price)) * 100)|round : 0 -%}
                                <div @click="selectedPeriod = '{{ code }}'"
                                     :class="selectedPeriod === '{{ code }}' ? '' : 'border-white/[0.07] hover:border-white/15'"
                                     class="flex items-center justify-between p-4 rounded-xl border cursor-pointer transition-all"
                                     :style="selectedPeriod === '{{ code }}' ? 'background:rgba(var(--color-primary-rgb),0.07); border-color:var(--color-secondary);' : 'background:rgba(255,255,255,0.015);'">
                                    <div class="flex items-center gap-3">
                                        <div class="w-4 h-4 rounded-full border-2 flex items-center justify-center transition-all flex-shrink-0"
                                             :class="selectedPeriod === '{{ code }}' ? '' : 'border-white/30'"
                                             :style="selectedPeriod === '{{ code }}' ? 'border-color:var(--color-secondary);' : ''">
                                            <div class="w-1.5 h-1.5 rounded-full transition-transform" style="background:var(--color-secondary);"
                                                 :class="selectedPeriod === '{{ code }}' ? 'scale-100' : 'scale-0'"></div>
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <span class="text-sm font-medium text-white">{{ periods[code] ?? code }}</span>
                                                {% if _savings_pct >= 5 %}
                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded-md text-[10px] font-bold"
                                                      style="background:rgba(16,185,129,0.12);color:#34d399;border:1px solid rgba(52,211,153,0.2);">SAVE {{ _savings_pct }}%</span>
                                                {% endif %}
                                            </div>
                                            {% if prices.setup is defined and prices.setup > 0 %}
                                            <p class="text-xs text-gray-500 mt-0.5">+ {{ prices.setup|money_convert }} setup fee</p>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <div>
                                            <span class="text-base font-bold text-white">{{ prices.price|money_convert }}</span>
                                            {%- if code == '1W' -%}<span class="text-xs text-gray-500">/wk</span>
                                            {%- elseif code == '1M' -%}<span class="text-xs text-gray-500">/mo</span>
                                            {%- elseif code == '3M' -%}<span class="text-xs text-gray-500">/qtr</span>
                                            {%- elseif code == '6M' -%}<span class="text-xs text-gray-500">/6mo</span>
                                            {%- elseif code == '1Y' -%}<span class="text-xs text-gray-500">/yr</span>
                                            {%- elseif code == '2Y' -%}<span class="text-xs text-gray-500">/2yr</span>
                                            {%- else -%}<span class="text-xs text-gray-500">/{{ code }}</span>{%- endif -%}
                                        </div>
                                        {% if _months > 1 and _base_price > 0 %}
                                        <p class="text-xs text-gray-600 mt-0.5">{{ _ppm|money_convert }}/mo equiv.</p>
                                        {% endif %}
                                    </div>
                                </div>
                                {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}

                        {# ── 2. Configuration form — shown SECOND ── #}
                        <div class="fb-config-card rounded-2xl border border-white/[0.07] overflow-hidden" style="background:rgba(255,255,255,0.02);">
                            <div class="px-5 py-3.5 border-b border-white/[0.05] flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl flex-shrink-0 flex items-center justify-center" style="background:rgba(var(--color-primary-rgb),0.10);border:1px solid rgba(var(--color-primary-rgb),0.18);">
                                    <svg class="w-4 h-4" style="color:var(--color-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-semibold text-white">{{ (form is defined and form.name is defined) ? form.name : product.title }}</p>
                                    <p class="text-xs text-gray-500 mt-0.5">Fill in the details below to configure your order</p>
                                </div>
                            </div>
                            <div class="p-5">
                                {% include 'mod_formbuilder_build.html.twig' ignore missing with {'hide_form_title': true} %}
                            </div>
                        </div>

                        {# ── Add-ons ── #}
                        {% if product.addons is defined and product.addons is not empty %}
                        {# ... addon cards ... #}
                        <div>
                            <div class="flex items-center gap-2 mb-3">
                                <p class="text-xs text-gray-500 uppercase tracking-wide font-medium">Optional Add-ons</p>
                                <span class="text-xs text-gray-600 ml-auto">{{ product.addons|length }} available</span>
                            </div>
                            <div class="space-y-2.5">
                                {% for addon in product.addons %}
                                {% set addon_default_period = '' %}
                                {% if addon.pricing.type == 'recurrent' %}{% for code, prices in addon.pricing.recurrent %}{% if addon_default_period == '' and prices.enabled %}{% set addon_default_period = code %}{% endif %}{% endfor %}{% endif %}
                                <div class="rounded-2xl border transition-all duration-200"
                                     :class="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? '' : 'border-white/[0.08] hover:border-white/[0.12]'"
                                     :style="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'background:rgba(var(--color-primary-rgb),0.06); border-color:var(--color-secondary);' : 'background:rgba(255,255,255,0.02);'">
                                    <div class="p-4">
                                        <div class="flex items-start gap-3">
                                            <div class="w-9 h-9 rounded-xl flex-shrink-0 mt-0.5 flex items-center justify-center transition-all"
                                                 :style="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'background:rgba(var(--color-primary-rgb),0.2);border:1px solid rgba(var(--color-primary-rgb),0.35);' : 'background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);'">
                                                <svg class="w-4 h-4 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                                     :style="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'color:var(--color-secondary);' : 'color:rgb(107,114,128);'">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                                                </svg>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div class="flex items-start justify-between gap-3">
                                                    <div class="flex-1 min-w-0">
                                                        <p class="text-sm font-semibold text-white leading-tight">{{ addon.title }}</p>
                                                        {% if addon.description %}<div class="text-xs text-gray-400 mt-1 leading-relaxed [&_ul]:list-disc [&_ul]:pl-4 [&_ol]:list-decimal [&_ol]:pl-4 [&_li]:mt-0.5 [&_strong]:text-gray-300">{{ addon.description|markdown }}</div>{% endif %}
                                                    </div>
                                                    <div class="text-right flex-shrink-0">
                                {% if addon.pricing.type == 'once' %}
                                <span class="text-base font-bold text-white">{{ addon.pricing.once.price | money_convert }}</span>
                                <span class="text-xs text-gray-500 block">one-time</span>
                                {% elseif addon.pricing.type == 'free' %}
                                <span class="text-base font-bold text-emerald-400">Free</span>
                                {% elseif addon.pricing.type == 'recurrent' %}
                                <span class="text-base font-bold text-white"
                                      x-text="addonRawPrices['{{ addon.id }}'] && selectedPeriod && addonRawPrices['{{ addon.id }}'][selectedPeriod] !== undefined ? formatMoney(addonRawPrices['{{ addon.id }}'][selectedPeriod]) : (addonRawPrices['{{ addon.id }}'] && addonRawPrices['{{ addon.id }}']['{{ addon_default_period }}'] !== undefined ? formatMoney(addonRawPrices['{{ addon.id }}']['{{ addon_default_period }}']) : '')">{{ addon_default_period ? (addon.pricing.recurrent[addon_default_period].price | money_convert) : '&mdash;' }}</span>
                                <span class="text-xs text-gray-500 block"
                                      x-text="'/' + (addonPeriodLabels[selectedPeriod] || selectedPeriod || '{{ addon_default_period }}')">{{ addon_default_period ? ('/' ~ addon_default_period) : '' }}</span>
                                {% endif %}
                                                    </div>
                                                </div>
                                                <div class="flex items-center justify-between mt-3 gap-2">
                                {% if addon.pricing.type == 'recurrent' %}
                                <p class="text-xs flex items-center gap-1"
                                   :style="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'color:rgba(var(--color-secondary-rgb),0.60);' : 'color:rgb(75,85,99);'">
                                    <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                    Billed <span class="ml-0.5" x-text="selectedPeriod ? (addonPeriodLabels[selectedPeriod] || selectedPeriod) : '{{ addon_default_period }}'"></span>&nbsp;with your plan
                                </p>
                                {% elseif addon.pricing.type == 'once' %}
                                <p class="text-xs text-gray-600">
                                    {% if addon.pricing.once.setup is defined and addon.pricing.once.setup > 0 %}
                                    + {{ addon.pricing.once.setup | money_convert }} setup fee
                                    {% else %}One-time charge{% endif %}
                                </p>
                                {% else %}
                                <p class="text-xs text-emerald-500/70">No extra cost</p>
                                {% endif %}
                                                    <button @click.stop="toggleAddon({{ addon.id }}, '{{ addon.pricing.type | default('once') }}')"
                                                            class="px-4 py-2 rounded-xl text-xs font-semibold transition-all border whitespace-nowrap flex items-center gap-1.5"
                                                            :class="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'hover:opacity-80' : 'border-transparent text-white hover:opacity-90'"
                                                            :style="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'background:rgba(var(--color-secondary-rgb),0.10); border-color:rgba(var(--color-secondary-rgb),0.30); color:var(--color-secondary);' : 'background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));'">
                                                        <svg class="w-3 h-3" x-show="!(addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected)" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                                                        <svg class="w-3 h-3" x-show="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                                        <span x-text="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'Added' : 'Add'">Add</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}
                    </div>{# /formbuilderSection #}

                    {# ── Order Summary Sidebar ── #}
                    <div class="sticky top-6">
                        <div class="rounded-2xl border border-white/[0.07] overflow-hidden" style="background:rgba(255,255,255,0.02);">
                            <div class="px-5 py-4 border-b border-white/[0.05] flex items-center justify-between">
                                <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Order Summary</p>
                                {% set _fb_currency = guest.cart_get_currency %}
                                <span class="inline-flex items-center rounded-lg border border-white/[0.08] bg-white/[0.03] px-2 py-1 text-xs font-bold text-gray-300">{{ _fb_currency.code }}</span>
                            </div>
                            <div class="p-5 space-y-4">
                                <p class="text-sm font-bold text-white">{{ product.title }}</p>

                                {# Per-period or one-time price row #}
                                {% if pricing.type == 'recurrent' %}
                                <div>
                                    {% for code, prices in pricing.recurrent %}{% if prices.enabled %}
                                    <div x-show="selectedPeriod === '{{ code }}'" class="flex items-start justify-between gap-2">
                                        <p class="text-sm text-gray-400">{{ periods[code] ?? code }} plan</p>
                                        <div class="text-right">
                                            {% if prices.setup > 0 %}<p class="text-xs text-gray-600 line-through">{{ (prices.price + prices.setup) | money_convert }}</p>{% endif %}
                                            <p class="text-sm font-semibold text-white">{{ prices.price | money_convert }}</p>
                                        </div>
                                    </div>
                                    {% endif %}{% endfor %}
                                    <div x-show="!selectedPeriod" class="text-sm text-gray-600 italic">Select a billing period</div>
                                </div>
                                {% elseif pricing.type == 'once' %}
                                <div class="flex items-center justify-between gap-2">
                                    <p class="text-sm text-gray-400">One-time payment</p>
                                    <p class="text-sm font-semibold text-white">{{ pricing.once.price | money_convert }}</p>
                                </div>
                                {% endif %}

                                <div class="border-t border-white/[0.06] pt-4 space-y-1">
                                    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Total due today</p>
                                    {% if pricing.type == 'recurrent' %}
                                    <p class="text-2xl font-bold text-white" x-show="selectedPeriod" x-text="calcTotal(selectedPeriod)"></p>
                                    {% elseif pricing.type == 'once' %}
                                    <p class="text-2xl font-bold text-white" x-text="calcTotal('once')">{{ pricing.once.price | money_convert }}</p>
                                    {% else %}
                                    <p class="text-2xl font-bold text-emerald-400">Free</p>
                                    {% endif %}
                                    <div x-show="couponDiscount > 0" x-cloak class="flex items-center gap-1.5 mt-1">
                                        <svg class="w-3 h-3 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                        <span class="text-xs text-emerald-400" x-text="'Coupon: −' + formatMoney(couponDiscount)"></span>
                                    </div>
                                </div>

                                {% if pricing.type != 'free' %}
                                {# ── Coupon code ── #}
                                <div>
                                    <button type="button" @click="couponOpen = !couponOpen; couponError = null"
                                            class="flex items-center gap-1.5 text-sm font-semibold focus:outline-none transition-colors w-full"
                                            :class="couponApplied ? 'text-emerald-400' : 'text-gray-400 hover:opacity-70'">
                                        <template x-if="couponApplied">
                                            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        </template>
                                        <template x-if="!couponApplied">
                                            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                                        </template>
                                        <span x-text="couponApplied ? 'Code saved!' : 'Have a coupon code?'"></span>
                                        <svg class="w-3.5 h-3.5 transition-transform duration-200 ml-auto flex-shrink-0" :class="couponOpen ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                                    </button>
                                    <div x-show="couponOpen" x-transition:enter="transition ease-out duration-150" x-transition:enter-start="opacity-0 -translate-y-1" x-transition:enter-end="opacity-100 translate-y-0" class="mt-2.5">
                                        <div class="flex gap-2">
                                            <input type="text" x-model="couponCode" @keydown.enter.prevent="applyCoupon()" placeholder="Enter coupon code"
                                                   class="flex-1 min-w-0 rounded-xl px-3 py-2.5 text-sm text-white placeholder-gray-600 focus:outline-none transition-all"
                                                   style="border: 1.5px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.05);"
                                                   @focus="$el.style.borderColor='var(--color-primary)'; $el.style.background='rgba(255,255,255,0.08)'"
                                                   @blur="$el.style.borderColor='rgba(255,255,255,0.1)'; $el.style.background='rgba(255,255,255,0.05)'"
                                                   :disabled="couponApplied">
                                            <button type="button" @click="applyCoupon()" :disabled="!couponCode.trim() || couponLoading || couponApplied"
                                                    class="flex-shrink-0 px-4 py-2.5 rounded-xl text-sm font-bold transition-all focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed"
                                                    style="background: var(--color-primary); color:#fff;">
                                                <span x-show="!couponLoading && !couponApplied">Apply</span>
                                                <span x-show="couponLoading" class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg></span>
                                                <span x-show="couponApplied"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg></span>
                                            </button>
                                        </div>
                                        <p x-show="couponError" x-cloak x-text="couponError" class="mt-1.5 text-xs text-red-400"></p>
                                        <p x-show="couponApplied" x-cloak class="mt-1.5 text-xs text-emerald-400 font-medium flex items-center gap-1">
                                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                            Code saved — discount applied at checkout.
                                        </p>
                                    </div>
                                </div>
                                {% endif %}

                                {# ── Continue button ── #}
                                <button type="button"
                                        @click="addToCart({% if pricing.type == 'free' %}'free'{% elseif pricing.type == 'once' %}'once'{% else %}selectedPeriod{% endif %})"
                                        :disabled="loading{% if pricing.type == 'recurrent' %} || !selectedPeriod{% endif %}"
                                        class="flex w-full items-center justify-center gap-2 rounded-xl px-5 py-3.5 text-sm font-bold text-white transition-all disabled:cursor-not-allowed disabled:opacity-60"
                                        style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary)); box-shadow:0 8px 24px rgba(var(--color-primary-rgb),0.22);">
                                    <span x-show="!loading">→ Continue</span>
                                    <span x-show="loading" class="flex items-center gap-2">
                                        <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                        Processing...
                                    </span>
                                </button>
                                <div x-show="errorMsg" x-cloak class="rounded-xl border border-red-500/25 bg-red-500/5 px-4 py-3 text-sm text-red-400" x-text="errorMsg"></div>
                                <a x-show="domainInCart" x-cloak href="{{ '/order/checkout'|url }}"
                                   class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-90"
                                   style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));">
                                    View Cart →
                                </a>

                                <div class="border-t border-white/[0.06] pt-4 space-y-2.5">
                                    <p class="flex items-center gap-2 text-xs text-gray-500">
                                        <svg class="w-3.5 h-3.5 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                        30-day money-back guarantee
                                    </p>
                                    <p class="text-xs text-gray-600 text-center">
                                        By ordering, you agree to our <a href="{{ settings.link_terms|default('/page/terms-and-conditions') }}" class="text-gray-500 hover:opacity-70">Terms of Service</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>{# /sidebar #}
                    </div>{# /inner grid #}

                {% elseif product.pricing.type == 'free' %}
                {# Free product #}
                <div class="rounded-2xl border border-green-500/20 bg-green-500/5 p-6">
                    <p class="text-2xl font-bold text-green-400">Free</p>
                    <p class="text-sm text-green-300/70 mt-1">No payment required</p>
                </div>

                <button @click="addToCart('free')"
                        :disabled="loading"
                        class="w-full py-3.5 rounded-xl text-sm font-semibold text-white transition-all disabled:opacity-50"
                        style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 4px 16px rgba(var(--color-primary-rgb),0.3);">
                    <span x-show="!loading">Get for Free →</span>
                    <span x-show="loading" class="flex items-center justify-center gap-2">
                        <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                        Please wait...
                    </span>
                </button>

            {% elseif product.pricing.type == 'once' %}
                {# One-time payment #}
                <div class="rounded-2xl border border-white/[0.07] p-6" style="background:rgba(255,255,255,0.02);">
                    <p class="text-xs text-gray-500 mb-2 uppercase tracking-wide font-medium">One-time Payment</p>
                    <div class="flex items-baseline gap-2">
                        <span class="text-4xl font-bold text-white">{{ product.pricing.once.price | money_convert }}</span>
                    </div>
                    {% if product.pricing.once.setup > 0 %}
                        <p class="text-sm text-gray-500 mt-1">+ {{ product.pricing.once.setup | money_convert }} setup fee</p>
                    {% endif %}
                </div>

                <div x-show="couponDiscount > 0" x-cloak class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 px-4 py-3 flex items-center justify-between gap-4">
                    <span class="text-sm text-emerald-400">After coupon</span>
                    <span class="text-xl font-bold text-emerald-400" x-text="calcTotal('once')"></span>
                </div>

                {% if product.addons|length > 0 %}
                {# ── Optional Add-ons ── #}
                <div>
                    <div class="flex items-center gap-2 mb-3">
                        <p class="text-xs text-gray-500 uppercase tracking-wide font-medium">Optional Add-ons</p>
                        <span class="text-xs text-gray-600 ml-auto">{{ product.addons|length }} available</span>
                    </div>
                    <div class="space-y-2.5">
                        {% for addon in product.addons %}
                        {% set addon_default_period = '' %}
                        {% if addon.pricing.type == 'recurrent' %}{% for code, prices in addon.pricing.recurrent %}{% if addon_default_period == '' and prices.enabled %}{% set addon_default_period = code %}{% endif %}{% endfor %}{% endif %}
                        <div class="rounded-2xl border transition-all duration-200"
                             x-init="if (!addons['{{ addon.id }}']) addons['{{ addon.id }}'] = { selected: false, period: '{{ addon_default_period }}' }"
                             :class="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? '' : 'border-white/[0.08] hover:border-white/[0.12]'"
                             :style="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'background:rgba(var(--color-primary-rgb),0.06); border-color:var(--color-secondary);' : 'background:rgba(255,255,255,0.02);'">
                            <div class="p-4">
                                <div class="flex items-start gap-3">
                                    <div class="w-9 h-9 rounded-xl flex-shrink-0 mt-0.5 flex items-center justify-center transition-all"
                                         :style="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'background:rgba(var(--color-primary-rgb),0.2);border:1px solid rgba(var(--color-primary-rgb),0.35);' : 'background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);'">
                                        <svg class="w-4 h-4 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                             :style="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'color:var(--color-secondary);' : 'color:rgb(107,114,128);'">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                                        </svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-start justify-between gap-3">
                                            <div class="flex-1 min-w-0">
                                                <p class="text-sm font-semibold text-white leading-tight">{{ addon.title }}</p>
                                                {% if addon.description %}<div class="text-xs text-gray-400 mt-1 leading-relaxed [&_ul]:list-disc [&_ul]:pl-4 [&_ol]:list-decimal [&_ol]:pl-4 [&_li]:mt-0.5 [&_strong]:text-gray-300">{{ addon.description|markdown }}</div>{% endif %}
                                            </div>
                                            <div class="text-right flex-shrink-0">
                        {% if addon.pricing.type == 'once' %}
                        <span class="text-base font-bold text-white">{{ addon.pricing.once.price | money_convert }}</span>
                        <span class="text-xs text-gray-500 block">one-time</span>
                        {% elseif addon.pricing.type == 'free' %}
                        <span class="text-base font-bold text-emerald-400">Free</span>
                        {% elseif addon.pricing.type == 'recurrent' %}
                        <span class="text-base font-bold text-white">{{ addon.pricing.recurrent[addon_default_period].price | money_convert }}</span>
                        <span class="text-xs text-gray-500 block">/{{ addon_default_period }}</span>
                        {% endif %}
                                            </div>
                                        </div>
                                        <div class="flex items-center justify-between mt-3 gap-2">
                    {% if addon.pricing.type == 'recurrent' %}
                    <p class="text-xs text-gray-600">Add-on charge</p>
                    {% elseif addon.pricing.type == 'once' %}
                    <p class="text-xs text-gray-600">
                        {% if addon.pricing.once.setup is defined and addon.pricing.once.setup > 0 %}
                        + {{ addon.pricing.once.setup | money_convert }} setup fee
                        {% else %}One-time charge{% endif %}
                    </p>
                    {% else %}
                    <p class="text-xs text-emerald-500/70">No extra cost</p>
                    {% endif %}
                                            <button @click.stop="toggleAddon({{ addon.id }}, '{{ addon.pricing.type | default('once') }}')"
                                                    class="px-4 py-2 rounded-xl text-xs font-semibold transition-all border whitespace-nowrap flex items-center gap-1.5"
                                                    :class="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'hover:opacity-80' : 'border-transparent text-white hover:opacity-90'"
                                                    :style="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'background:rgba(var(--color-secondary-rgb),0.10); border-color:rgba(var(--color-secondary-rgb),0.30); color:var(--color-secondary);' : 'background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));'">
                                                <svg class="w-3 h-3" x-show="!(addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected)" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                                                <svg class="w-3 h-3" x-show="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                                <span x-text="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'Added' : 'Add'">Add</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                {% if product.addons|length > 0 %}
                {# Reactive total — only shown if addons are available #}
                <div class="rounded-2xl border border-white/[0.07] p-5" style="background:rgba(255,255,255,0.02);">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide font-medium">You pay today</p>
                            <p class="text-xs text-gray-600 mt-0.5">One-time charge</p>
                        </div>
                        <div class="text-right">
                            <div class="text-2xl font-bold text-white" x-text="calcTotal('once')"></div>
                        </div>
                    </div>
                </div>
                {% endif %}
                {# ── Coupon code ── #}
                <div>
                    <button type="button" @click="couponOpen = !couponOpen; couponError = null"
                            class="flex items-center gap-1.5 text-sm font-semibold focus:outline-none transition-colors w-full"
                            :class="couponApplied ? 'text-emerald-400' : 'text-gray-400 hover:opacity-70'">
                        <template x-if="couponApplied">
                            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </template>
                        <template x-if="!couponApplied">
                            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                        </template>
                        <span x-text="couponApplied ? 'Code saved!' : 'Have a coupon code?'"></span>
                        <svg class="w-3.5 h-3.5 transition-transform duration-200 ml-auto flex-shrink-0"
                             :class="couponOpen ? 'rotate-180' : ''"
                             fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                    </button>
                    <div x-show="couponOpen" x-transition:enter="transition ease-out duration-150"
                         x-transition:enter-start="opacity-0 -translate-y-1" x-transition:enter-end="opacity-100 translate-y-0"
                         class="mt-2.5">
                        <div class="flex gap-2">
                            <input type="text" x-model="couponCode"
                                   @keydown.enter.prevent="applyCoupon()"
                                   placeholder="Enter coupon code"
                                   class="flex-1 min-w-0 rounded-xl px-3 py-2.5 text-sm text-white placeholder-gray-600 focus:outline-none transition-all"
                                   style="border: 1.5px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.05);"
                                   @focus="$el.style.borderColor='var(--color-primary)'; $el.style.background='rgba(255,255,255,0.08)'"
                                   @blur="$el.style.borderColor='rgba(255,255,255,0.1)'; $el.style.background='rgba(255,255,255,0.05)'"
                                   :disabled="couponApplied">
                            <button type="button" @click="applyCoupon()"
                                    :disabled="!couponCode.trim() || couponLoading || couponApplied"
                                    class="flex-shrink-0 px-4 py-2.5 rounded-xl text-sm font-bold transition-all focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed"
                                    style="background: var(--color-primary); color:#fff;">
                                <span x-show="!couponLoading && !couponApplied">Apply</span>
                                <span x-show="couponLoading" class="flex items-center gap-1.5">
                                    <svg class="w-3.5 h-3.5 animate-spin" aria-hidden="true" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                                </span>
                                <span x-show="couponApplied">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                </span>
                            </button>
                        </div>
                        <p x-show="couponError" x-cloak x-text="couponError" class="mt-1.5 text-xs text-red-400"></p>
                        <p x-show="couponApplied" x-cloak class="mt-1.5 text-xs text-emerald-400 font-medium flex items-center gap-1">
                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                            Code saved — discount applied at checkout.
                        </p>
                    </div>
                </div>

                <button @click="addToCart('once')"
                        :disabled="loading"
                        class="w-full py-3.5 rounded-xl text-sm font-semibold text-white transition-all disabled:opacity-50"
                        style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 4px 16px rgba(var(--color-primary-rgb),0.3);">
                    <span x-show="!loading">Add to Cart →</span>
                    <span x-show="loading" class="flex items-center justify-center gap-2">
                        <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                        Adding to cart...
                    </span>
                </button>

            {% elseif product.pricing.type == 'recurrent' %}
                {# Billing period selection #}
                <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wide font-medium mb-3">Select Billing Cycle</p>
                    <div class="space-y-2.5">
                        {% for code, prices in product.pricing.recurrent %}
                            {% if prices.enabled %}
                            <label class="flex items-center justify-between p-4 rounded-xl border cursor-pointer transition-all"
                                   :class="selectedPeriod === '{{ code }}' ? '' : 'border-white/[0.07] hover:border-white/15'"
                                   :style="selectedPeriod === '{{ code }}' ? 'background:rgba(var(--color-primary-rgb),0.05); border-color:var(--color-secondary);' : 'background:rgba(255,255,255,0.015);'">
                                <div class="flex items-center gap-3">
                                    <input type="radio" name="period" value="{{ code }}" x-model="selectedPeriod" class="hidden">
                                    <div class="w-4 h-4 rounded-full border-2 flex items-center justify-center transition-all"
                                         :class="selectedPeriod === '{{ code }}' ? '' : 'border-white/30'"
                                         :style="selectedPeriod === '{{ code }}' ? 'border-color:var(--color-secondary);' : ''">
                                        <div class="w-1.5 h-1.5 rounded-full transition-transform" style="background:var(--color-secondary);"
                                             :class="selectedPeriod === '{{ code }}' ? 'scale-100' : 'scale-0'"></div>
                                    </div>
                                    <div>
                                        <span class="text-sm font-medium text-white">{{ periods[code] ?? code }}</span>
                                        {% if prices.setup is defined and prices.setup > 0 %}
                                            <p class="text-xs text-gray-500">+ {{ prices.setup | money_convert }} setup</p>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="text-right">
                                    <span class="text-base font-bold text-white">{{ prices.price | money_convert }}</span>
                                    {%- if code == '1M' -%}<span class="text-xs text-gray-500">/mo</span>
                                    {%- elseif code == '3M' -%}<span class="text-xs text-gray-500">/qtr</span>
                                    {%- elseif code == '6M' -%}<span class="text-xs text-gray-500">/6mo</span>
                                    {%- elseif code == '1Y' -%}<span class="text-xs text-gray-500">/yr</span>
                                    {%- elseif code == '2Y' -%}<span class="text-xs text-gray-500">/2yr</span>
                                    {%- else -%}<span class="text-xs text-gray-500">/{{ code }}</span>{%- endif -%}
                                </div>
                            </label>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

                {% if product.addons|length > 0 %}
                {# ── Optional Add-ons ── #}
                <div x-show="selectedPeriod" x-transition.opacity.duration.200ms>
                    <div class="flex items-center gap-2 mb-3">
                        <p class="text-xs text-gray-500 uppercase tracking-wide font-medium">Optional Add-ons</p>
                        <span class="text-xs text-gray-600 ml-auto">{{ product.addons|length }} available</span>
                    </div>
                    <div class="space-y-2.5">
                        {% for addon in product.addons %}
                        <div class="rounded-2xl border transition-all duration-200"
                             x-init="(() => { const id = '{{ addon.id }}'; const ep = addonPrices[id] ? Object.keys(addonPrices[id]) : []; const resolvePeriod = (p) => (ep.length === 0 || ep.includes(p)) ? p : (ep[0] || p); if (!addons[id]) addons[id] = { selected: false, period: resolvePeriod(selectedPeriod || '') }; $watch('selectedPeriod', v => { if (addons[id]) addons[id].period = resolvePeriod(v || ''); }); })()"
                             :class="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? '' : 'border-white/[0.08] hover:border-white/[0.12]'"
                             :style="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'background:rgba(var(--color-primary-rgb),0.06); border-color:var(--color-secondary);' : 'background:rgba(255,255,255,0.02);'">
                            <div class="p-4">
                                <div class="flex items-start gap-3">
                                    <div class="w-9 h-9 rounded-xl flex-shrink-0 mt-0.5 flex items-center justify-center transition-all"
                                         :style="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'background:rgba(var(--color-primary-rgb),0.2);border:1px solid rgba(var(--color-primary-rgb),0.35);' : 'background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);'">
                                        <svg class="w-4 h-4 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                             :style="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'color:var(--color-secondary);' : 'color:rgb(107,114,128);'">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                                        </svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-start justify-between gap-3">
                                            <div class="flex-1 min-w-0">
                                                <p class="text-sm font-semibold text-white leading-tight">{{ addon.title }}</p>
                                                {% if addon.description %}<div class="text-xs text-gray-400 mt-1 leading-relaxed [&_ul]:list-disc [&_ul]:pl-4 [&_ol]:list-decimal [&_ol]:pl-4 [&_li]:mt-0.5 [&_strong]:text-gray-300">{{ addon.description|markdown }}</div>{% endif %}
                                            </div>
                                            <div class="text-right flex-shrink-0">
                        {% if addon.pricing.type == 'once' %}
                        <span class="text-base font-bold text-white">{{ addon.pricing.once.price | money_convert }}</span>
                        <span class="text-xs text-gray-500 block">one-time</span>
                        {% elseif addon.pricing.type == 'free' %}
                        <span class="text-base font-bold text-emerald-400">Free</span>
                        {% elseif addon.pricing.type == 'recurrent' %}
                        <span class="text-base font-bold text-white"
                              x-text="addonPrices['{{ addon.id }}'] && selectedPeriod && addonPrices['{{ addon.id }}'][selectedPeriod] ? addonPrices['{{ addon.id }}'][selectedPeriod] : '&#8212;'">&#8212;</span>
                        <span class="text-xs text-gray-500 block"
                              x-text="selectedPeriod ? '/' + (addonPeriodLabels[selectedPeriod] || selectedPeriod) : ''"></span>
                        {% endif %}
                                            </div>
                                        </div>
                                        <div class="flex items-center justify-between mt-3 gap-2">
                    {% if addon.pricing.type == 'recurrent' %}
                    <p class="text-xs flex items-center gap-1"
                       :style="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'color:rgba(var(--color-secondary-rgb),0.60);' : 'color:rgb(75,85,99);'">
                        <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                        Billed <span class="ml-0.5" x-text="addonPeriodLabels[selectedPeriod] || selectedPeriod"></span>&nbsp;with your plan
                    </p>
                    {% elseif addon.pricing.type == 'once' %}
                    <p class="text-xs text-gray-600">
                        {% if addon.pricing.once.setup is defined and addon.pricing.once.setup > 0 %}
                        + {{ addon.pricing.once.setup | money_convert }} setup fee
                        {% else %}One-time charge{% endif %}
                    </p>
                    {% else %}
                    <p class="text-xs text-emerald-500/70">No extra cost</p>
                    {% endif %}
                                            <button @click.stop="toggleAddon({{ addon.id }}, '{{ addon.pricing.type | default('once') }}')"
                                                    class="px-4 py-2 rounded-xl text-xs font-semibold transition-all border whitespace-nowrap flex items-center gap-1.5"
                                                    :class="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'hover:opacity-80' : 'border-transparent text-white hover:opacity-90'"
                                                    :style="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'background:rgba(var(--color-secondary-rgb),0.10); border-color:rgba(var(--color-secondary-rgb),0.30); color:var(--color-secondary);' : 'background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));'">
                                                <svg class="w-3 h-3" x-show="!(addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected)" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                                                <svg class="w-3 h-3" x-show="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                                <span x-text="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'Added' : 'Add'">Add</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                {# Order summary preview #}
                <div class="rounded-2xl border border-white/[0.07] p-5" style="background:rgba(255,255,255,0.02);">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide font-medium">You pay today</p>
                            <p class="text-xs text-gray-600 mt-0.5">Renews on the same schedule</p>
                            <div x-show="couponDiscount > 0" x-cloak class="mt-2 flex items-center gap-1.5">
                                <svg class="w-3 h-3 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                <span class="text-xs text-emerald-400" x-text="'Coupon: −' + formatMoney(couponDiscount)"></span>
                            </div>
                        </div>
                        <div class="text-right flex-shrink-0">
                            <div class="text-2xl font-bold text-white" x-text="calcTotal(selectedPeriod)"></div>
                        </div>
                    </div>
                </div>

                {# Add to cart button #}
                <div>
                    {# ── Coupon code ── #}
                    <div>
                        <button type="button" @click="couponOpen = !couponOpen; couponError = null"
                                class="flex items-center gap-1.5 text-sm font-semibold focus:outline-none transition-colors w-full"
                                :class="couponApplied ? 'text-emerald-400' : 'text-gray-400 hover:opacity-70'">
                            <template x-if="couponApplied">
                                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </template>
                            <template x-if="!couponApplied">
                                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                            </template>
                            <span x-text="couponApplied ? 'Code saved!' : 'Have a coupon code?'"></span>
                            <svg class="w-3.5 h-3.5 transition-transform duration-200 ml-auto flex-shrink-0"
                                 :class="couponOpen ? 'rotate-180' : ''"
                                 fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                        </button>
                        <div x-show="couponOpen" x-transition:enter="transition ease-out duration-150"
                             x-transition:enter-start="opacity-0 -translate-y-1" x-transition:enter-end="opacity-100 translate-y-0"
                             class="mt-2.5">
                            <div class="flex gap-2">
                                <input type="text" x-model="couponCode"
                                       @keydown.enter.prevent="applyCoupon()"
                                       placeholder="Enter coupon code"
                                       class="flex-1 min-w-0 rounded-xl px-3 py-2.5 text-sm text-white placeholder-gray-600 focus:outline-none transition-all"
                                       style="border: 1.5px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.05);"
                                       @focus="$el.style.borderColor='var(--color-primary)'; $el.style.background='rgba(255,255,255,0.08)'"
                                       @blur="$el.style.borderColor='rgba(255,255,255,0.1)'; $el.style.background='rgba(255,255,255,0.05)'"
                                       :disabled="couponApplied">
                                <button type="button" @click="applyCoupon()"
                                        :disabled="!couponCode.trim() || couponLoading || couponApplied"
                                        class="flex-shrink-0 px-4 py-2.5 rounded-xl text-sm font-bold transition-all focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed"
                                        style="background: var(--color-primary); color:#fff;">
                                    <span x-show="!couponLoading && !couponApplied">Apply</span>
                                    <span x-show="couponLoading" class="flex items-center gap-1.5">
                                        <svg class="w-3.5 h-3.5 animate-spin" aria-hidden="true" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                                    </span>
                                    <span x-show="couponApplied">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                    </span>
                                </button>
                            </div>
                            <p x-show="couponError" x-cloak x-text="couponError" class="mt-1.5 text-xs text-red-400"></p>
                            <p x-show="couponApplied" x-cloak class="mt-1.5 text-xs text-emerald-400 font-medium flex items-center gap-1">
                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                Code saved — discount applied at checkout.
                            </p>
                        </div>
                    </div>

                    <button @click="addToCart(selectedPeriod)"
                            :disabled="loading || !selectedPeriod"
                            class="w-full py-3.5 rounded-xl text-sm font-semibold text-white transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                            style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 4px 16px rgba(var(--color-primary-rgb),0.3);">
                        <span x-show="!loading">Continue to Checkout →</span>
                        <span x-show="loading" class="flex items-center justify-center gap-2">
                            <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                            Adding to cart...
                        </span>
                    </button>

                    {# Error message #}
                    <div x-show="errorMsg" x-cloak class="mt-3 p-3 rounded-xl border border-red-500/20 bg-red-500/5">
                        <p class="text-sm text-red-400" x-text="errorMsg"></p>
                    </div>
                    <a x-show="domainInCart" x-cloak href="{{ '/order/checkout'|url }}"
                       class="flex items-center justify-center gap-2 mt-2 w-full py-2.5 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-90"
                       style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));">
                        View Cart →
                    </a>

                    <p class="text-xs text-gray-600 text-center mt-3">
                        By ordering, you agree to our <a href="{{ settings.link_terms|default('/page/terms-and-conditions') }}" class="text-gray-500 hover:opacity-70">Terms of Service</a>
                    </p>
                </div>

                {% else %}
                    {# ── Unknown pricing type fallback ── #}
                    <div class="rounded-2xl border border-white/[0.07] p-5 text-center" style="background:rgba(255,255,255,0.02);">
                        <p class="text-sm text-gray-400">Please contact us to order this product.</p>
                    </div>
                {% endif %}

            {% endif %}

        </div>
    </div>
    {% endif %}{# end hosting/non-hosting layout #}
</div>
{% endif %}

{% endblock %}

{% block js %}
{% autoescape false %}
<script>
function domainOrder(productId) {
    return {
        productId: productId,
        step: 1,
        mode: 'register',

        // Step 1 — domain search
        regSld: '',
        regTld: '',
        regYears: 1,
        xfrSld: '',
        xfrTld: '',
        authCode: '',
        ownSld: '',
        ownTld: '.com',
        domainPreview: '',
        checking: false,
        available: null,
        availMsg: '',

        // Step 2 — nameservers
        useDefaultNs: true,
        ns1: '',
        ns2: '',
        ns3: '',
        ns4: '',

        // Step 3 — contact info
        useAccountContact: true,
        contactLoading: false,
        contact: {
            first_name: '', last_name: '', email: '', company: '',
            address_1: '', city: '', state: '', country: '', postcode: '',
            phone_cc: '', phone: ''
        },

        loading: false,
        errorMsg: null,
        domainInCart: false,

        // Coupon state
        couponDiscount: 0,
        couponOpen: false,
        couponCode: '',
        couponLoading: false,
        couponError: null,
        couponApplied: false,
        promoType: null,
        promoValue: 0,
        promoPeriods: [],

        checkAvailability() {
            if (!this.regSld.trim()) return;
            this.checking = true;
            this.available = null;
            this.availMsg = '';
            this.errorMsg = null;
            const sld = this.regSld.trim();
            const tld = this.regTld;
            API.guest.post('servicedomain/check',
                { sld: sld, tld: tld },
                () => { this.checking = false; this.available = true; },
                (err) => { this.checking = false; this.available = false; this.availMsg = err.message || 'Domain is not available.'; }
            );
        },

        checkTransfer() {
            if (!this.xfrSld.trim()) return;
            this.checking = true;
            this.available = null;
            this.availMsg = '';
            this.errorMsg = null;
            const sld = this.xfrSld.trim();
            const tld = this.xfrTld;
            API.guest.post('servicedomain/can_be_transferred',
                { sld: sld, tld: tld },
                () => { this.checking = false; this.available = true; },
                (err) => { this.checking = false; this.available = false; this.availMsg = err.message || 'Domain cannot be transferred.'; }
            );
        },

        loadContactFromAccount() {
            this.contactLoading = true;
            API.client.post('profile/get', {},
                (profile) => {
                    this.contactLoading = false;
                    this.contact.first_name = profile.first_name || '';
                    this.contact.last_name  = profile.last_name  || '';
                    this.contact.email      = profile.email      || '';
                    this.contact.company    = profile.company    || '';
                    this.contact.address_1  = profile.address_1  || '';
                    this.contact.city       = profile.city       || '';
                    this.contact.state      = profile.state      || '';
                    this.contact.country    = profile.country    || '';
                    this.contact.postcode   = profile.postcode   || '';
                    this.contact.phone_cc   = profile.phone_cc   || '';
                    this.contact.phone      = profile.phone      || '';
                },
                () => { this.contactLoading = false; }
            );
        },

        goToStep3() {
            this.step = 3;
            if (this.useAccountContact) {
                this.loadContactFromAccount();
            }
        },

        addToCart() {
            this.loading = true;
            this.errorMsg = null;
            this.domainInCart = false;

            const params = {
                id: this.productId,
                multiple: 1,
            };

            if (this.mode === 'register') {
                params.action = 'register';
                params.register_sld = this.regSld.trim();
                params.register_tld = this.regTld;
                params.register_years = this.regYears;
                if (!this.useDefaultNs && this.ns1.trim() && this.ns2.trim()) {
                    params.ns1 = this.ns1.trim();
                    params.ns2 = this.ns2.trim();
                    if (this.ns3.trim()) params.ns3 = this.ns3.trim();
                    if (this.ns4.trim()) params.ns4 = this.ns4.trim();
                }
            } else if (this.mode === 'transfer') {
                params.action = 'transfer';
                params.transfer_sld = this.xfrSld.trim();
                params.transfer_tld = this.xfrTld;
                params.auth_code = this.authCode.trim();
            } else {
                params.action = 'owndomain';
                params.owndomain_sld = this.ownSld.trim();
                params.owndomain_tld = this.ownTld.trim().startsWith('.') ? this.ownTld.trim() : '.' + this.ownTld.trim();
            }

            API.guest.post('cart/add_item', params,
                () => {
                    document.dispatchEvent(new CustomEvent('stablepanel:cartUpdated'));
                    const redirect = () => { window.location.href = '{{ "/order/checkout"|url }}'; };
                    if (this.couponApplied && this.couponCode.trim()) {
                        // Only apply a promo that was pre-validated; failure is non-blocking
                        API.guest.post('cart/apply_promo', { promocode: this.couponCode.trim() },
                            redirect,
                            redirect
                        );
                    } else {
                        redirect();
                    }
                },
                (err) => {
                    this.loading = false;
                    const msg = (err && err.message) || 'Failed to add to cart.';
                    this.errorMsg = msg;
                    this.domainInCart = /already in the cart/i.test(msg);
                }
            );
        },

        applyCoupon() {
            const code = this.couponCode.trim();
            if (!code || this.couponLoading || this.couponApplied) return;
            this.couponLoading = true;
            this.couponError   = null;
            API.guest.post('cart/validate_promo', { promocode: code, product_id: this.productId, period: '' },
                (promo) => {
                    this.couponLoading = false;
                    this.couponApplied = true;
                    this.promoType     = promo.type    || null;
                    this.promoValue    = promo.value   || 0;
                    this.promoPeriods  = promo.periods || [];
                },
                (err) => {
                    this.couponLoading = false;
                    this.couponApplied = false;
                    this.couponError   = err.message || 'Invalid promo code.';
                }
            );
        }
    }
}


function checkoutAuth() {
    return {
        showLogin: false,
        showSignup: false,
        email: '',
        password: '',
        regFirstName: '',
        regLastName: '',
        regEmail: '',
        regPassword: '',
        regPasswordConfirm: '',
        authLoading: false,
        authError: null,

        login() {
            if (!this.email || !this.password) return;
            this.authLoading = true;
            this.authError = null;
            API.guest.post('client/login',
                { email: this.email, password: this.password },
                () => { window.location.reload(); },
                (err) => {
                    this.authLoading = false;
                    this.authError = err.message || 'Invalid email or password.';
                }
            );
        },

        signup() {
            if (this.regPassword !== this.regPasswordConfirm) {
                this.authError = 'Passwords do not match.';
                return;
            }
            if (this.regPassword.length < 8) {
                this.authError = 'Password must be at least 8 characters.';
                return;
            }
            this.authLoading = true;
            this.authError = null;
            API.guest.post('client/create', {
                first_name: this.regFirstName,
                last_name: this.regLastName,
                email: this.regEmail,
                password: this.regPassword,
                password_confirm: this.regPasswordConfirm
            },
                () => {
                    // Auto-login after signup
                    API.guest.post('client/login',
                        { email: this.regEmail, password: this.regPassword },
                        () => { window.location.reload(); },
                        () => { window.location.reload(); }
                    );
                },
                (err) => {
                    this.authLoading = false;
                    this.authError = err.message || 'Failed to create account. Please try again.';
                }
            );
        }
    }
}

function orderCheckout() {
    return {
        selectedGateway: null,
        loading: false,
        enough_balance: {{ enough_balance|default(false) ? 'true' : 'false' }},

        init() {
            // Select first gateway by default
            const firstGateway = document.querySelector('input[name="gateway_id"]');
            if (firstGateway) {
                this.selectedGateway = firstGateway.value;
            }
        },

        checkout() {
            if (this.loading) return;
            if (!this.enough_balance && !this.selectedGateway) {
                alert('Please select a payment method.');
                return;
            }
            this.loading = true;

            const data = {};
            if (!this.enough_balance && this.selectedGateway) {
                data.gateway_id = this.selectedGateway;
            }

            API.client.post('cart/checkout', data,
                (result) => {
                    if (result.invoice_hash) {
                        window.location.href = '{{ "invoice"|url }}/' + result.invoice_hash;
                    } else {
                        // Order placed (free / paid from balance)
                        window.location.href = '{{ "/order/service"|url }}';
                    }
                },
                (error) => {
                    this.loading = false;
                    alert(error.message || 'Checkout failed. Please try again.');
                }
            );
        }
    }
}
</script>
