{% extends "layout_public.html.twig" %}

{% block meta_title %}Email Confirmation{% endblock %}

{% block content %}
<div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md text-center">

        {% if expired|default(false) %}

            {# ── Invalid / expired link ── #}
            <div class="w-16 h-16 rounded-2xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 flex items-center justify-center mx-auto mb-6">
                <svg class="w-8 h-8 text-red-500 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
                </svg>
            </div>

            <h1 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Link expired or invalid</h1>
            <p class="text-slate-500 dark:text-slate-400 text-sm mb-8 max-w-sm mx-auto">
                This email confirmation link has expired or has already been used.
                Confirmation links are valid for 48 hours. Please log in and request a new one from your profile.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                <a href="{{ 'login'|url }}"
                   class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl text-white text-sm font-semibold transition-all"
                   style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 8px 20px rgba(var(--color-primary-rgb), 0.25);">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                    </svg>
                    Sign in to request a new link
                </a>
                {% if guest.extension_is_on({'mod': 'support'}) %}
                <a href="{{ 'support/contact'|url }}"
                   class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-600 dark:text-slate-300 text-sm font-medium hover:bg-slate-200 dark:hover:bg-white/10 transition-all">
                    Contact support
                </a>
                {% endif %}
            </div>

        {% else %}

            {# ── Success ── #}
            <div class="w-16 h-16 rounded-2xl bg-emerald-50 dark:bg-green-500/10 border border-emerald-200 dark:border-green-500/20 flex items-center justify-center mx-auto mb-6">
                <svg class="w-8 h-8 text-emerald-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Email confirmed!</h1>
            <p class="text-slate-500 dark:text-slate-400 text-sm mb-8">Your email address has been successfully verified. You can now access all features.</p>
            <a href="{{ 'dashboard'|url }}"
               class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl text-white text-sm font-semibold transition-all"
               style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); box-shadow: 0 8px 20px rgba(var(--color-primary-rgb), 0.25);">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
                Go to dashboard
            </a>

        {% endif %}

    </div>
</div>
{% endblock %}
