{# ═══════════════════════════════════════════════════════════════════════════
   Shared "Order summary" card — Stitch-style white sticky card matching the
   hosting/server order forms. Used by every non-hosting, non-domain product
   type (plain custom products with no form, and formbuilder-attached custom
   products) so there is exactly one implementation of this card, not one
   per product-configuration path.

   Context expected from the including template (all already in scope via
   Twig's default include-shares-context behavior — nothing needs to be
   passed explicitly):
     - product        the current product array
     - periods        guest.system_periods
     - settings       theme settings (for the terms link)
     - _is_formbuilder whether the calling branch already renders its own
                       period-picker / add-ons picker elsewhere on the page
                       (the formbuilder branch's left column does). When
                       true, this card shows a reactive PRICE RECAP only for
                       periods/add-ons, not another picker — avoiding two
                       different pickers for the same choice on one page.

   .order-professional scopes the shared dark-mode counter-rules in
   theme.css (§DARK-EXT, "Stitch-style, light-native Tailwind" pages) that
   remap bg-white/text-slate-900/headings/borders for a light card on this
   otherwise-dark theme — without it, dark mode remaps h2/p.text-slate-900
   to white with no matching background remap, making the text invisible
   against the still-white card (see git history for the discovery).
═══════════════════════════════════════════════════════════════════════════ #}
{% set _oc_currency = guest.cart_get_currency %}
<div class="order-professional">
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sticky top-6">
    {# Header — exact hierarchy/casing match to the hosting order form's sidebar:
       a small uppercase eyebrow label, THEN the actual product title, bigger and bold. #}
    <div class="flex justify-between items-center mb-2">
        <h3 class="text-xs font-bold text-slate-500 uppercase tracking-widest">Order Summary</h3>
        <span class="text-[10px] bg-slate-100 px-2 py-0.5 rounded text-slate-500 font-bold">{{ _oc_currency.code }}</span>
    </div>
    <h4 class="text-xl font-bold text-slate-900 mb-6">{{ product.title }}</h4>

    <div class="space-y-5">
    <div>
        {% if product.pricing.type == 'recurrent' %}
            {% if _is_formbuilder %}
            {# Companion mode: the billing-cycle card above already picks the period —
               this is a reactive recap of whichever one is currently selected. #}
            <div>
                {% for code, prices in product.pricing.recurrent %}{% if prices.enabled %}
                <div x-show="selectedPeriod === '{{ code }}'" class="flex items-start justify-between gap-2">
                    <span class="text-sm text-slate-500">{{ periods[code] ?? code }} plan</span>
                    <div class="text-right">
                        {% if prices.setup > 0 %}<p class="text-xs text-slate-400 line-through">{{ (prices.price + prices.setup) | money_convert }}</p>{% endif %}
                        <span class="text-sm font-semibold text-slate-900">{{ prices.price | money_convert }}</span>
                    </div>
                </div>
                {% endif %}{% endfor %}
                <div x-show="!selectedPeriod" class="text-xs text-slate-400 italic">Select a billing period</div>
            </div>
            {% else %}
            {# Standalone mode: this card is the only place to pick a period. #}
            <div class="space-y-2">
                {% for code, prices in product.pricing.recurrent %}
                    {% if prices.enabled %}
                    <label class="flex items-center justify-between gap-3 p-3 rounded-xl border cursor-pointer transition-all"
                           :class="selectedPeriod === '{{ code }}' ? 'border-indigo-400 bg-indigo-50/70' : 'border-slate-200 hover:border-slate-300'">
                        <span class="flex items-center gap-2.5">
                            <input type="radio" name="period" value="{{ code }}" x-model="selectedPeriod" class="hidden">
                            <span class="w-4 h-4 rounded-full border-2 flex items-center justify-center flex-shrink-0"
                                  :class="selectedPeriod === '{{ code }}' ? 'border-indigo-500' : 'border-slate-300'">
                                <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 transition-transform" :class="selectedPeriod === '{{ code }}' ? 'scale-100' : 'scale-0'"></span>
                            </span>
                            <span>
                                <span class="text-sm text-slate-700">{{ periods[code] ?? code }}</span>
                                {% if prices.setup is defined and prices.setup > 0 %}
                                <span class="block text-xs text-slate-400">+{{ prices.setup | money_convert }} setup</span>
                                {% endif %}
                            </span>
                        </span>
                        <span class="text-sm font-semibold text-slate-900">{{ prices.price | money_convert }}</span>
                    </label>
                    {% endif %}
                {% endfor %}
            </div>
            {% endif %}
        {% elseif product.pricing.type == 'once' %}
        <div class="flex items-center justify-between gap-2">
            <span class="text-sm text-slate-500">One-time</span>
            <div class="text-right">
                <span class="text-sm font-semibold text-slate-900">{{ product.pricing.once.price | money_convert }}</span>
                {% if product.pricing.once.setup > 0 %}
                <p class="text-xs text-slate-400">+{{ product.pricing.once.setup | money_convert }} setup</p>
                {% endif %}
            </div>
        </div>
        {% else %}
        <div class="flex items-center justify-between gap-2">
            <span class="text-sm text-slate-500">This product</span>
            <span class="text-sm font-semibold text-emerald-600">Free</span>
        </div>
        {% endif %}
    </div>

    {% if product.addons is defined and product.addons is not empty and product.pricing.type != 'free' %}
        {% if _is_formbuilder %}
        {# Companion mode: the add-ons picker lives in the config column above —
           this is a reactive recap of whichever ones are currently selected. #}
        <div class="space-y-1.5">
            {% for addon in product.addons %}
            <div class="flex items-center justify-between gap-2 text-sm" x-show="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected">
                <span class="text-slate-500">{{ addon.title }}</span>
                <span class="font-semibold text-slate-900">
                    {% if addon.pricing.type == 'free' %}Free
                    {% elseif addon.pricing.type == 'once' %}{{ addon.pricing.once.price | money_convert }}
                    {% elseif addon.pricing.type == 'recurrent' %}<span x-text="getAddonDisplayPrice('{{ addon.id }}')"></span>
                    {% endif %}
                </span>
            </div>
            {% endfor %}
        </div>
        {% else %}
        {# Standalone mode: this card is the only place to pick add-ons. #}
        <div class="space-y-2 pt-1">
            <p class="text-xs font-semibold text-slate-500">Add-ons</p>
            {% for addon in product.addons %}
            {% set addon_default_period = '' %}
            {% if addon.pricing.type == 'recurrent' %}{% for code, prices in addon.pricing.recurrent %}{% if addon_default_period == '' and prices.enabled %}{% set addon_default_period = code %}{% endif %}{% endfor %}{% endif %}
            <div class="rounded-xl border p-3 transition-all"
                 x-init="if (!addons['{{ addon.id }}']) addons['{{ addon.id }}'] = { selected: false, period: '{{ addon_default_period }}' }"
                 :class="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'border-indigo-400 bg-indigo-50/70' : 'border-slate-200'">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <p class="text-sm font-medium text-slate-800 leading-tight">{{ addon.title }}</p>
                        {% if addon.pricing.type == 'once' %}
                        <p class="text-xs text-slate-400 mt-0.5">{{ addon.pricing.once.price | money_convert }} one-time</p>
                        {% elseif addon.pricing.type == 'free' %}
                        <p class="text-xs text-emerald-600 mt-0.5">No extra cost</p>
                        {% elseif addon.pricing.type == 'recurrent' %}
                        <p class="text-xs text-slate-400 mt-0.5">
                            <span x-text="addonRawPrices['{{ addon.id }}'] && selectedPeriod && addonRawPrices['{{ addon.id }}'][selectedPeriod] !== undefined ? formatMoney(addonRawPrices['{{ addon.id }}'][selectedPeriod]) : (addonRawPrices['{{ addon.id }}'] && addonRawPrices['{{ addon.id }}']['{{ addon_default_period }}'] !== undefined ? formatMoney(addonRawPrices['{{ addon.id }}']['{{ addon_default_period }}']) : '')">{{ addon_default_period ? (addon.pricing.recurrent[addon_default_period].price | money_convert) : '' }}</span>
                            <span x-text="selectedPeriod ? '/' + (addonPeriodLabels[selectedPeriod] || selectedPeriod) : (addon_default_period ? '/{{ addon_default_period }}' : '')">{{ addon_default_period ? ('/' ~ addon_default_period) : '' }}</span>
                        </p>
                        {% endif %}
                    </div>
                    <button type="button" @click.stop="toggleAddon({{ addon.id }}, '{{ addon.pricing.type | default('once') }}')"
                            class="flex-shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all"
                            :class="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'bg-indigo-100 text-indigo-700' : 'text-white'"
                            :style="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? '' : 'background:var(--color-primary);'">
                        <span x-text="addons['{{ addon.id }}'] && addons['{{ addon.id }}'].selected ? 'Added' : 'Add'">Add</span>
                    </button>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    {% endif %}

    <hr class="border-slate-100">

    <div class="flex items-end justify-between">
        <div>
            <p class="text-xs font-bold text-slate-500 uppercase">Total Due Today</p>
        </div>
        <div class="text-right">
            {% if product.pricing.type == 'recurrent' %}
            <p class="text-2xl font-bold text-slate-900" x-show="selectedPeriod" x-text="calcTotal(selectedPeriod)"></p>
            <p class="text-sm italic text-slate-400" x-show="!selectedPeriod">Select a plan</p>
            {% elseif product.pricing.type == 'once' %}
            <p class="text-2xl font-bold text-slate-900" x-text="calcTotal('once')">{{ product.pricing.once.price | money_convert }}</p>
            {% else %}
            <p class="text-2xl font-bold text-emerald-600">Free</p>
            {% endif %}
            <div x-show="couponDiscount > 0" x-cloak class="flex items-center justify-end gap-1 mt-1">
                <svg class="w-3 h-3 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span class="text-xs text-emerald-600 font-medium" x-text="'−' + formatMoney(couponDiscount)"></span>
            </div>
        </div>
    </div>

    {% if product.pricing.type != 'free' %}
    <div class="space-y-2">
        <div x-show="!couponApplied" class="flex gap-2">
            <div class="relative flex-1 min-w-0">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                <input type="text" x-model="couponCode"
                       @keydown.enter.prevent="applyCoupon()"
                       @input="couponError = null"
                       placeholder="Promo code"
                       class="w-full pl-9 pr-3 py-2.5 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-white/20 border border-slate-200 bg-slate-50 transition-all">
            </div>
            <button type="button" @click="applyCoupon()"
                    :disabled="!couponCode.trim() || couponLoading"
                    class="flex-shrink-0 flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-bold text-white transition-all focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed"
                    style="background:var(--color-primary);">
                <span x-show="!couponLoading">Apply</span>
                <span x-show="couponLoading" class="flex items-center">
                    <svg class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                </span>
            </button>
        </div>
        <p x-show="couponError" x-cloak x-text="couponError" class="text-xs text-red-500"></p>
        <div x-show="couponApplied" x-cloak class="flex items-center justify-between rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2">
            <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span class="text-xs font-mono font-bold text-emerald-700 uppercase tracking-wide" x-text="couponCode"></span>
            </div>
            <button type="button"
                    @click="couponApplied = false; couponDiscount = 0; couponCode = ''; promoType = null; promoValue = 0; promoPeriods = []; couponError = null;"
                    class="text-xs text-slate-400 hover:text-red-500 transition-colors font-medium ml-3">
                Remove
            </button>
        </div>
    </div>
    {% endif %}

    <button type="button"
            @click="addToCart({% if product.pricing.type == 'free' %}'free'{% elseif product.pricing.type == 'once' %}'once'{% else %}selectedPeriod{% endif %})"
            :disabled="loading{% if product.pricing.type == 'recurrent' %} || !selectedPeriod{% endif %}"
            class="ord-cta-primary w-full py-4 rounded-lg text-white font-black flex items-center justify-center gap-2 transition-all hover:opacity-90 active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed shadow-lg"
            style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary)); box-shadow:0 4px 16px rgba(var(--color-primary-rgb),0.25);">
        <span x-show="!loading" class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            {% if product.pricing.type == 'free' %}Get for Free{% elseif product.pricing.type == 'once' %}Add to Cart{% else %}Continue{% endif %}
        </span>
        <span x-show="loading" class="flex items-center gap-2">
            <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
            {% if product.pricing.type == 'free' %}Please wait…{% else %}Processing…{% endif %}
        </span>
    </button>
    <div x-show="errorMsg" x-cloak class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600" x-text="errorMsg"></div>
    <a x-show="domainInCart" x-cloak href="{{ '/order/checkout'|url }}"
       class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-90"
       style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));">
        View Cart →
    </a>

    <div class="border-t border-slate-100 pt-4">
        <div class="flex items-center justify-center gap-1.5 text-xs font-semibold text-emerald-600 mb-2">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-7a2 2 0 00-2-2h-1V7a5 5 0 00-10 0v3H6a2 2 0 00-2 2v7a2 2 0 002 2zm3-11V7a3 3 0 016 0v3H9z"/></svg>
            Secure checkout · Instant setup
        </div>
        <p class="text-[10px] text-center text-slate-400">
            By ordering, you agree to our <a href="{{ settings.link_terms|default('/page/terms-and-conditions') }}" class="hover:underline" style="color:var(--color-primary);">Terms of Service</a>
        </p>
    </div>
    </div>
</div>
</div>
