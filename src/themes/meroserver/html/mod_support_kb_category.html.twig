{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ category.title }} — Knowledge Base{% endblock %}
{% block page_header %}{% endblock %}
{% block breadcrumb %}{% endblock %}

{% block content %}
{% set all_categories = guest.support_kb_category_get_list({ 'per_page': 20 }) %}

{% block js %}
<style>
/* Override global h3 color rule (specificity 0,1,2) — match it so last-declared wins */
html body .kb-cat-article-title { color: var(--color-primary) !important; }
</style>
{% endblock %}

<div class="ref-kbc-page space-y-6">

    {# ── Breadcrumbs ── #}
    <nav class="ref-kbc-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ '/dashboard'|url }}">Home</a>
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="{{ 'support/kb'|url }}">Knowledge Base</a>
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span>{{ category.title }}</span>
    </nav>

    <header class="ref-kbc-hero">
        <div class="ref-kbc-hero-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M12 6.25v13m0-13C10.8 5.45 9.25 5 7.5 5S4.2 5.45 3 6.25v13C4.2 18.45 5.75 18 7.5 18s3.3.45 4.5 1.25m0-13C13.2 5.45 14.75 5 16.5 5s3.3.45 4.5 1.25v13C19.8 18.45 18.25 18 16.5 18s-3.3.45-4.5 1.25"/></svg>
        </div>
        <div class="ref-kbc-hero-copy">
            <span>Knowledge-base category</span>
            <h1>{{ category.title }}</h1>
            {% if category.description %}
            <p>{{ category.description }}</p>
            {% else %}
            <p>Browse practical guides, configuration steps, and troubleshooting resources in this topic.</p>
            {% endif %}
        </div>
        <div class="ref-kbc-count">
            <strong>{{ category.articles|default([])|length }}</strong>
            <span>article{{ category.articles|default([])|length != 1 ? 's' : '' }}</span>
        </div>
    </header>

    {# ── Two-column layout ── #}
    <div class="ref-kbc-layout flex flex-col md:flex-row gap-6 items-start">

        {# ── Left: Category + Articles ── #}
        <div class="flex-1 min-w-0">

            {# ── Article list ── #}
            {% if category.articles|default([])|length > 0 %}
            <div class="ref-kbc-articles space-y-3">
                {% for article in category.articles %}
                <a href="{{ ('support/kb')|url }}/{{ article.category.slug }}/{{ article.slug }}"
                   class="ref-kbc-article flex items-start justify-between gap-4 p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm hover:shadow-md hover:border-[color:var(--color-primary)]/30 dark:hover:border-[color:var(--color-primary)]/30 transition-all group">
                    <span class="ref-kbc-article-number">{{ "%02d"|format(loop.index) }}</span>
                    <div class="flex-1 min-w-0">
                        <h3 class="kb-cat-article-title text-base font-semibold group-hover:underline mb-2 leading-snug">{{ article.title }}</h3>
                        {% set excerpt = article.content|default('')|striptags|trim %}
                        {% if excerpt %}
                        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed line-clamp-2 mb-4">{{ excerpt|slice(0, 180) }}{% if excerpt|length > 180 %}…{% endif %}</p>
                        {% endif %}
                        <div class="flex flex-wrap items-center gap-4 text-xs text-slate-400 dark:text-slate-500">
                            <span class="flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                                {{ article.views }} view{{ article.views != 1 ? 's' : '' }}
                            </span>
                            {% if article.updated_at %}
                            <span class="flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                Updated {{ article.updated_at|date('M j, Y') }}
                            </span>
                            {% endif %}
                        </div>
                    </div>
                    <svg class="w-4 h-4 text-slate-300 dark:text-slate-600 group-hover:text-[color:var(--color-primary)] transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
                {% endfor %}
            </div>
            {% else %}
            <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 py-16 text-center">
                <div class="w-12 h-12 rounded-2xl bg-slate-100 dark:bg-white/[0.05] border border-slate-200 dark:border-white/[0.07] flex items-center justify-center mx-auto mb-4">
                    <svg class="w-6 h-6 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <p class="text-sm text-slate-500 dark:text-slate-400">No articles in this category yet.</p>
            </div>
            {% endif %}

            {# ── Back nav ── #}
            <div class="ref-kbc-back mt-5">
                <a href="{{ 'support/kb'|url }}"
                   class="inline-flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 hover:text-[color:var(--color-primary)] dark:hover:text-[color:var(--color-primary)] transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Back to Knowledge Base
                </a>
            </div>

        </div>

        {# ── Right sidebar ── #}
        <aside class="ref-kbc-sidebar w-full md:w-72 lg:w-80 shrink-0 space-y-5">

            {# Other categories #}
            {% if all_categories.list|length > 1 %}
            <div class="ref-kbc-related bg-white dark:bg-white/[0.04] rounded-2xl border border-slate-200 dark:border-white/[0.07] shadow-sm overflow-hidden">
                <div class="px-5 py-4 border-b border-slate-100 dark:border-white/[0.06] bg-slate-50/50 dark:bg-white/[0.02]">
                    <h4 class="text-[10px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500">Related Categories</h4>
                </div>
                <div class="p-2">
                    {% for cat in all_categories.list %}
                    {% if cat.id != category.id %}
                    <a href="{{ ('support/kb')|url }}/{{ cat.slug }}"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-slate-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-500/10 hover:text-[color:var(--color-primary)] transition-all group">
                        <div class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-white/[0.05] border border-slate-200 dark:border-white/[0.07] flex items-center justify-center flex-shrink-0 group-hover:border-[color:var(--color-primary)]/30 group-hover:bg-indigo-50 dark:group-hover:bg-indigo-500/10 transition-all">
                            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[color:var(--color-primary)] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                            </svg>
                        </div>
                        <span class="font-medium leading-snug">{{ cat.title }}</span>
                    </a>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# Contact Support CTA #}
            <div class="ref-kbc-support rounded-2xl p-6 relative overflow-hidden" style="background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary, var(--color-primary)) 100%);">
                <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(circle at top right, rgba(255,255,255,0.12) 0%, transparent 60%);"></div>
                <div class="absolute -bottom-5 -right-5 opacity-[0.07] pointer-events-none">
                    <svg class="w-28 h-28 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/>
                    </svg>
                </div>
                <div class="relative">
                    <div class="w-9 h-9 rounded-xl bg-white/20 flex items-center justify-center mb-4">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                    </div>
                    <h4 class="text-sm font-bold text-white mb-1" style="text-shadow: 0 1px 6px rgba(0,0,0,0.2);">Still need help?</h4>
                    <p class="text-xs text-white/80 mb-4 leading-relaxed">Our support engineers are ready to assist 24/7.</p>
                    <a href="{{ 'support'|url }}"
                       class="inline-flex items-center gap-2 w-full justify-center px-4 py-2.5 bg-white/15 hover:bg-white/25 border border-white/40 rounded-xl text-white text-sm font-semibold transition-all">
                        Open a Support Ticket
                    </a>
                </div>
            </div>

        </aside>
    </div>
</div>
{% endblock %}
