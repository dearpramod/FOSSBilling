{% block js %}
<style>
/* ── Server product detail layout ── */
.ord-srv-detail { max-width: 1100px; margin: 0 auto; }
.ord-srv-layout { display: grid; grid-template-columns: 1fr; gap: 1.5rem; align-items: start; }
.ord-srv-main { display: flex; flex-direction: column; gap: 1.25rem; }
/* Sidebar column: self-start so sticky on inner card works */
.ord-srv-sidebar { align-self: start; }
/* Base card — white bg + subtle border in light; near-transparent in dark */
.ord-srv-card { border-radius: 1rem; border: 1px solid rgba(0,0,0,0.09); background: #fff; padding: 1.5rem; }
[data-theme="dark"] .ord-srv-card { border-color: rgba(255,255,255,0.08); background: rgba(255,255,255,0.025); }

/* ── Semantic color tokens ── */
.ord-srv-heading { color: #0f172a; }
.ord-srv-muted   { color: #64748b; }
.ord-srv-dimmed  { color: #94a3b8; }
[data-theme="dark"] .ord-srv-heading { color: #f1f5f9; }
[data-theme="dark"] .ord-srv-muted   { color: #94a3b8; }
[data-theme="dark"] .ord-srv-dimmed  { color: #64748b; }

/* ── Section cards — Stitch white cards ── */
.ord-srv-section-card { background: #fff; border: 1px solid rgba(0,0,0,0.09); border-radius: 1rem; padding: 1.5rem; }
[data-theme="dark"] .ord-srv-section-card { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.08); }

/* Divided section card (slate-50 header bar + content body) */
.ord-srv-section-card-divided { background: #fff; border: 1px solid rgba(0,0,0,0.09); border-radius: 1rem; overflow: hidden; }
[data-theme="dark"] .ord-srv-section-card-divided { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.08); }
.ord-srv-section-hd { background: #f8fafc; border-bottom: 1px solid rgba(0,0,0,0.07); padding: 1rem 1.25rem; }
[data-theme="dark"] .ord-srv-section-hd { background: rgba(255,255,255,0.04); border-bottom-color: rgba(255,255,255,0.06); }

/* ── Billing period tile cards ── */
.ord-period-tile-on  { border-color: var(--color-primary) !important; background: rgba(var(--color-primary-rgb),0.06) !important; }
.ord-period-tile-off { border-color: rgba(0,0,0,0.12); background: #fff; }
.ord-period-tile-off:hover { border-color: rgba(0,0,0,0.25); background: #f8fafc; }
[data-theme="dark"] .ord-period-tile-off { border-color: rgba(255,255,255,0.1); background: rgba(255,255,255,0.03); }
[data-theme="dark"] .ord-period-tile-off:hover { border-color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.06); }

/* Radio dot states on period tiles */
.ord-radio-tile-on  { border-color: var(--color-primary); }
.ord-radio-tile-off { border-color: rgba(0,0,0,0.25); }
[data-theme="dark"] .ord-radio-tile-off { border-color: rgba(255,255,255,0.3); }

/* ── Sidebar white card (Stitch-style) + dark mode overrides ── */
.ord-srv-sidebar-card { background: #fff; }
[data-theme="dark"] .ord-srv-sidebar-card { background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.1); }
[data-theme="dark"] .ord-srv-sidebar-hd { background: rgba(255,255,255,0.04); border-bottom-color: rgba(255,255,255,0.06); }
[data-theme="dark"] .ord-srv-sidebar-ft { background: rgba(255,255,255,0.03); border-top-color: rgba(255,255,255,0.06); }

/* Add-on cards */
.ord-addon-card { border: 1.5px solid rgba(0,0,0,0.1); border-radius: 0.75rem; cursor: pointer; transition: border-color 0.2s, background 0.2s; background: transparent; }
.ord-addon-card:hover { border-color: rgba(0,0,0,0.22); }
[data-theme="dark"] .ord-addon-card { border-color: rgba(255,255,255,0.09); }
[data-theme="dark"] .ord-addon-card:hover { border-color: rgba(255,255,255,0.2); }
.ord-addon-active { border-color: var(--color-primary) !important; background: rgba(var(--color-primary-rgb),0.07) !important; }
/* Checkbox inside addon */
.ord-chk-on { border-color: var(--color-primary); background: var(--color-primary); }
.ord-chk-off { border-color: rgba(0,0,0,0.25); background: transparent; }
[data-theme="dark"] .ord-chk-off { border-color: rgba(255,255,255,0.3); }
/* Mobile CTA */
.ord-srv-mobile-cta { display: block; }
@media (min-width: 1024px) {
  .ord-srv-layout { grid-template-columns: 1fr 380px; gap: 2rem; }
  .ord-srv-mobile-cta { display: none; }
}
/* ── Formbuilder field styles (order form) ── */
.fb-section-card { border-radius: 1rem; overflow: hidden; border: 1px solid rgba(0,0,0,0.08); background: rgba(0,0,0,0.02); }
[data-theme="dark"] .fb-section-card { border-color: rgba(255,255,255,0.08); background: rgba(255,255,255,0.025); }
.fb-section-header { border-bottom: 1px solid rgba(0,0,0,0.07); }
[data-theme="dark"] .fb-section-header { border-bottom-color: rgba(255,255,255,0.06); }
.fb-label { display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.5rem; color: inherit; }
.fb-input, .fb-select, .fb-textarea { width: 100%; font-size: 0.875rem; outline: none; border: 1.5px solid rgba(0,0,0,0.12); border-radius: 0.75rem; background: rgba(255,255,255,0.8); color: inherit; transition: border-color 0.15s, background 0.15s; }
[data-theme="dark"] .fb-input,[data-theme="dark"] .fb-select,[data-theme="dark"] .fb-textarea { border-color: rgba(255,255,255,0.12); background: rgba(255,255,255,0.04); }
.fb-input { padding: 0.625rem 0.875rem; }
.fb-input::placeholder, .fb-textarea::placeholder { color: rgba(0,0,0,0.3); }
[data-theme="dark"] .fb-input::placeholder,[data-theme="dark"] .fb-textarea::placeholder { color: rgba(255,255,255,0.25); }
.fb-select { padding: 0.625rem 2.5rem 0.625rem 0.875rem; appearance: none; cursor: pointer; }
.fb-textarea { padding: 0.75rem 0.875rem; resize: vertical; }
.fb-input:focus, .fb-select:focus, .fb-textarea:focus { border-color: var(--color-primary); }
.fb-radio-opt { display: flex; align-items: center; gap: 0.625rem; padding: 0.75rem; border: 1.5px solid rgba(0,0,0,0.1); border-radius: 0.75rem; cursor: pointer; transition: border-color 0.2s, background 0.2s; background: transparent; }
.fb-radio-opt:hover { border-color: rgba(0,0,0,0.22); }
[data-theme="dark"] .fb-radio-opt { border-color: rgba(255,255,255,0.1); }
[data-theme="dark"] .fb-radio-opt:hover { border-color: rgba(255,255,255,0.2); }
.fb-radio-checked { border-color: var(--color-primary) !important; background: rgba(var(--color-primary-rgb),0.08) !important; }
.fb-chk-opt { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem; border: 1.5px solid rgba(0,0,0,0.08); border-radius: 0.75rem; cursor: pointer; transition: border-color 0.2s; }
[data-theme="dark"] .fb-chk-opt { border-color: rgba(255,255,255,0.08); }

/* ── Server option field cards ── */
.ord-opt-card {
    padding: 0.65rem 0.75rem; border-radius: 0.75rem; border: 2px solid;
    transition: border-color 0.15s, background 0.15s; cursor: pointer; width: 100%;
}
.ord-opt-card-on  { border-color: var(--color-primary); background: rgba(var(--color-primary-rgb),0.07); }
.ord-opt-card-off { border-color: rgba(0,0,0,0.1); background: transparent; }
.ord-opt-card-off:hover { border-color: rgba(0,0,0,0.22); background: rgba(0,0,0,0.02); }
[data-theme="dark"] .ord-opt-card-off { border-color: rgba(255,255,255,0.1); }
[data-theme="dark"] .ord-opt-card-off:hover { border-color: rgba(255,255,255,0.22); background: rgba(255,255,255,0.03); }
/* Group tabs */
.ord-opt-tab { padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; border: 1px solid; transition: all 0.15s; }
.ord-opt-tab-on  { background: var(--color-primary); color: #fff; border-color: var(--color-primary); }
.ord-opt-tab-off { background: transparent; color: inherit; border-color: rgba(0,0,0,0.12); }
.ord-opt-tab-off:hover { border-color: rgba(0,0,0,0.3); }
[data-theme="dark"] .ord-opt-tab-off { border-color: rgba(255,255,255,0.15); }
[data-theme="dark"] .ord-opt-tab-off:hover { border-color: rgba(255,255,255,0.3); }
/* Required error flash */
.ord-srv-required-error { border-color: #ef4444 !important; background: rgba(239,68,68,0.06) !important; }
/* Dropdown select */
.ord-srv-select {
    appearance: none; padding: 0.65rem 2.5rem 0.65rem 0.875rem;
    border-radius: 0.75rem; border: 1.5px solid rgba(0,0,0,0.14);
    background: #fff; color: inherit; font-size: 0.875rem;
    transition: border-color 0.15s; cursor: pointer; outline: none;
}
.ord-srv-select:focus { border-color: var(--color-primary); }
[data-theme="dark"] .ord-srv-select { border-color: rgba(255,255,255,0.14); background: rgba(255,255,255,0.04); }
[data-theme="dark"] .ord-srv-select:focus { border-color: var(--color-primary); }
.reveal-up, .reveal-left, .reveal-right {
    opacity: 0;
    transition: opacity 0.65s ease, transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
}
.reveal-up    { transform: translateY(30px); }
.reveal-left  { transform: translateX(-30px); }
.reveal-right { transform: translateX(30px); }
.reveal-up.visible, .reveal-left.visible, .reveal-right.visible {
    opacity: 1;
    transform: translate(0, 0);
}
.shield-pulse {
    animation: shieldPulse 2.5s ease-in-out infinite;
}
@keyframes shieldPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(var(--color-secondary-rgb),0.4); }
    50%       { box-shadow: 0 0 0 14px rgba(var(--color-secondary-rgb),0); }
}
</style>
<script>
(function () {
    var revEls = document.querySelectorAll('.reveal-up, .reveal-left, .reveal-right');
    var revObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
            if (e.isIntersecting) { e.target.classList.add('visible'); revObs.unobserve(e.target); }
        });
    }, { threshold: 0.1 });
    revEls.forEach(function(el) { revObs.observe(el); });

    var bars = document.querySelectorAll('.perf-bar');
    if (bars.length) {
        var barObs = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) {
                    var w = e.target.getAttribute('data-width');
                    e.target.style.transition = 'width 1.1s cubic-bezier(0.16,1,0.3,1)';
                    e.target.style.width = w;
                    barObs.unobserve(e.target);
                }
            });
        }, { threshold: 0.3 });
        bars.forEach(function(b) { barObs.observe(b); });
    }

    var uptimeBars = document.querySelectorAll('.uptime-bar');
    if (uptimeBars.length) {
        var uObs = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) {
                    uptimeBars.forEach(function(b) { b.style.opacity = '1'; b.style.transform = 'scaleY(1)'; });
                    uObs.disconnect();
                }
            });
        }, { threshold: 0.2 });
        if (uptimeBars[0]) uObs.observe(uptimeBars[0]);
    }

    function runCounter(el, target, ms) {
        var start = performance.now();
        (function tick(now) {
            var p = Math.min((now - start) / ms, 1);
            var eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.floor(eased * target).toLocaleString();
            if (p < 1) requestAnimationFrame(tick);
            else el.textContent = target.toLocaleString();
        })(start);
    }

    var counters = document.querySelectorAll('.counter');
    if (counters.length) {
        var cObs = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) {
                    runCounter(e.target, parseInt(e.target.dataset.target, 10), 1400);
                    cObs.unobserve(e.target);
                }
            });
        }, { threshold: 0.4 });
        counters.forEach(function(c) { cObs.observe(c); });
    }
}());
</script>

{% endblock %}
