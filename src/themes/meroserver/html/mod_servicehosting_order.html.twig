{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ product.title }} — Order{% endblock %}
{% block page_header %}Web Hosting{% endblock %}

{% block content %}

{# ── Compute first enabled billing period ── #}
{% if product.pricing.type == 'recurrent' and product.pricing.recurrent['1M'] is defined and product.pricing.recurrent['1M'].enabled %}
    {% set first_period = '1M' %}
{% elseif product.pricing.type == 'recurrent' and product.pricing.recurrent['3M'] is defined and product.pricing.recurrent['3M'].enabled %}
    {% set first_period = '3M' %}
{% elseif product.pricing.type == 'recurrent' and product.pricing.recurrent['6M'] is defined and product.pricing.recurrent['6M'].enabled %}
    {% set first_period = '6M' %}
{% elseif product.pricing.type == 'recurrent' and product.pricing.recurrent['1Y'] is defined and product.pricing.recurrent['1Y'].enabled %}
    {% set first_period = '1Y' %}
{% elseif product.pricing.type == 'recurrent' and product.pricing.recurrent['2Y'] is defined and product.pricing.recurrent['2Y'].enabled %}
    {% set first_period = '2Y' %}
{% else %}
    {% set first_period = '' %}
{% endif %}

{# ── Period metadata ── #}
{% set _opf_all_pk = ['1W', '1M', '3M', '6M', '1Y', '2Y', '3Y'] %}
{% set _opf_pk_labels = {'1W': 'Every week', '1M': 'Monthly', '3M': 'Quarterly', '6M': 'Every 6 months', '1Y': 'Every year', '2Y': 'Every 2 years', '3Y': 'Every 3 years'} %}
{% set _opf_enabled = [] %}
{% for pk in _opf_all_pk %}
    {% if product.pricing.type == 'recurrent' and product.pricing.recurrent[pk] is defined and product.pricing.recurrent[pk].enabled %}
        {% set _opf_enabled = _opf_enabled|merge([pk]) %}
    {% endif %}
{% endfor %}

{# ── Shared Alpine component — must be included BEFORE the x-data element ── #}
{% include 'partial_order_product_component.html.twig' %}

{# ── Back-link from product category ── #}
{% set _back_url = '/order'|url %}
{% set _back_label = 'Plans' %}
{% for cat in guest.product_category_get_list({'per_page': 100, 'deep': 0}).list %}
    {% if cat.id == product.product_category_id %}
        {% set _cat_slug = cat.title|lower|replace({' ': '-', '/': '-'})|trim('-') %}
        {% set _back_url = ('/order/' ~ _cat_slug)|url %}
        {% set _back_label = cat.title %}
    {% endif %}
{% endfor %}

{# ══════════════════════════════════════════════════════════════
   Two-column layout — matches Stitch grid grid-cols-12 gap-8
══════════════════════════════════════════════════════════════ #}
<div x-data="orderProduct({{ product.id }}, '{{ first_period }}')"
     class="order-professional grid grid-cols-12 gap-6 xl:gap-8 items-start pb-24 lg:pb-0">

    {# ══ LEFT: Configuration (col-span-8) ══ #}
    <div class="col-span-12 lg:col-span-8 space-y-6">

        {# Back link + title #}
        <div>
            <a href="{{ _back_url }}"
               class="text-sm text-slate-500 flex items-center gap-2 hover:text-primary transition-colors mb-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                Back to {{ _back_label }}
            </a>
            <h2 class="text-3xl font-bold text-slate-900">{{ product.title }}</h2>
        </div>

        {# ── Domain configuration form (period selector is now inside the card header) ── #}
        {% set _form_tpl = 'mod_service' ~ product.type ~ '_order_form.html.twig' %}
        {% if guest.system_template_exists({ 'file': _form_tpl }) %}
            {% include _form_tpl %}
        {% endif %}

        {# ── Add-ons — carousel with prev/next matching Stitch ── #}
        {% if product.addons|length > 0 %}
        <section>
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold text-slate-900">
                    Optional add-ons
                    <span class="text-sm font-normal text-slate-500 ml-1">{{ product.addons|length }} available</span>
                </h3>
                <div class="flex gap-2">
                    <button type="button" @click="prevAddon()"
                            :disabled="addonIndex === 0"
                            class="p-1 border border-slate-200 rounded text-slate-400 hover:text-slate-600 disabled:opacity-30 disabled:cursor-not-allowed">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                        </svg>
                    </button>
                    <button type="button" @click="nextAddon()"
                            :disabled="addonIndex >= {{ product.addons|length - 1 }}"
                            class="p-1 border border-slate-200 rounded text-slate-400 hover:text-slate-600 disabled:opacity-30 disabled:cursor-not-allowed">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </button>
                </div>
            </div>

            {% for addon in product.addons %}
            <div x-show="addonIndex === {{ loop.index0 }}" x-cloak
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 translate-x-2"
                 x-transition:enter-end="opacity-100 translate-x-0"
                 class="hosting-addon-card rounded-2xl p-6 border"
                 style="background:rgba(var(--color-primary-rgb),0.03); border-color:rgba(var(--color-primary-rgb),0.12);">

                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-lg flex items-center justify-center text-white flex-shrink-0"
                         style="background:var(--color-primary);">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
                        </svg>
                    </div>
                    <h4 class="font-bold text-slate-900 text-lg">{{ addon.title }}</h4>
                </div>

                <p class="font-bold mb-6
                    {% if addon.pricing.type == 'free' %}text-green-600
                    {% else %}{% endif %}">
                    {% if addon.pricing.type == 'free' %}
                        Free
                    {% elseif addon.pricing.type == 'once' %}
                        <span style="color:var(--color-primary);">{{ addon.pricing.once.price|money_convert }}</span>
                    {% elseif addon.pricing.type == 'recurrent' %}
                        <span style="color:var(--color-primary);"
                              x-text="getAddonDisplayPrice('{{ addon.id }}')"></span>
                    {% endif %}
                </p>

                <button type="button"
                        @click="toggleAddon('{{ addon.id }}')"
                        class="w-full py-3 rounded-lg font-bold flex items-center justify-center gap-2 transition-all border"
                        :class="addons['{{ addon.id }}']?.selected
                            ? 'bg-primary text-white border-transparent'
                            : 'hover:bg-primary hover:text-white hover:border-transparent'"
                        :style="addons['{{ addon.id }}']?.selected
                            ? 'background:var(--color-primary);border-color:transparent;'
                            : 'color:var(--color-primary);border-color:rgba(var(--color-primary-rgb),0.5);'">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              :d="addons['{{ addon.id }}']?.selected
                                  ? 'M6 18L18 6M6 6l12 12'
                                  : 'M12 6v6m0 0v6m0-6h6m-6 0H6'"/>
                    </svg>
                    <span x-text="addons['{{ addon.id }}']?.selected ? 'Remove {{ addon.title }}' : 'Add {{ addon.title }}'">
                        Add {{ addon.title }}
                    </span>
                </button>
            </div>
            {% endfor %}
        </section>
        {% endif %}

    </div>
    {# ══ END LEFT ══ #}

    {# ══ RIGHT: Sticky order summary (col-span-4) — Stitch-exact ══ #}
    <aside class="hosting-summary-column col-span-12 lg:col-span-4 space-y-6" aria-label="Order summary">
        <div class="hosting-order-summary bg-white rounded-2xl border border-slate-200 overflow-hidden">
            <div class="p-6">

                {# Header #}
                <div class="flex justify-between items-center mb-2">
                    <h3 class="text-xs font-bold text-slate-500 uppercase tracking-widest">Order Summary</h3>
                    <span class="text-[10px] bg-slate-100 px-2 py-0.5 rounded text-slate-500 font-bold"
                          x-text="$store.fbCurrency.code"></span>
                </div>
                <h4 class="text-xl font-bold text-slate-900 mb-6">{{ product.title }}</h4>

                {# Line items #}
                <div class="space-y-4 mb-8">

                    {# Recurrent plan line #}
                    <div class="flex justify-between text-sm" x-show="selectedPeriod">
                        <span class="text-slate-500" x-text="getPeriodLabel(selectedPeriod) + ' plan'"></span>
                        <div class="text-right">
                            <template x-if="getPeriodSavingsRaw(selectedPeriod) > 0 && productRawPrices['1M']">
                                <span class="text-xs text-slate-400 line-through mr-1"
                                      x-text="formatMoney((productRawPrices['1M'] || 0) * (periodMonthsMap[selectedPeriod] || 1))"></span>
                            </template>
                            <span class="font-bold text-slate-900"
                                  x-text="formatMoney(productRawPrices[selectedPeriod] || 0)"></span>
                        </div>
                    </div>

                    {# One-time plan line #}
                    {% if product.pricing.type == 'once' %}
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500">{{ product.title }}</span>
                        <span class="font-bold text-slate-900">{{ product.pricing.once.price|money_convert }}</span>
                    </div>
                    {% endif %}

                    {# Domain name line — shows the selected domain and its price once chosen #}
                    <div class="flex justify-between items-baseline gap-2 text-sm">
                        <span class="text-slate-500 flex-shrink-0">Domain name</span>
                        <span class="text-right min-w-0">
                            <span x-show="domainName" class="block font-semibold text-slate-900 truncate" x-text="domainName"></span>
                            <span class="font-bold text-slate-900"
                                  x-text="domainRawPrice > 0 ? formatMoney(domainRawPrice) : (domainName ? 'Free' : '—')"></span>
                        </span>
                    </div>

                    {# Selected add-ons #}
                    {% for addon in product.addons %}
                    <div class="flex justify-between text-sm" x-show="addons['{{ addon.id }}']?.selected">
                        <span class="text-slate-500">{{ addon.title }}</span>
                        <span class="font-bold text-slate-900">
                            {% if addon.pricing.type == 'free' %}Free
                            {% elseif addon.pricing.type == 'once' %}{{ addon.pricing.once.price|money_convert }}
                            {% elseif addon.pricing.type == 'recurrent' %}
                            <span x-text="getAddonDisplayPrice('{{ addon.id }}')"></span>
                            {% endif %}
                        </span>
                    </div>
                    {% endfor %}
                </div>

                <hr class="border-slate-100 mb-6"/>

                {# Total — Stitch-exact: strikethrough original total on left, new total on right #}
                <div class="hosting-summary-total flex justify-between items-end mb-6">
                    <div>
                        <p class="text-[10px] font-bold text-slate-500 uppercase">Total Due Today</p>
                        <template x-if="getPeriodSavingsRaw(selectedPeriod) > 0 && getOriginalTotal(selectedPeriod)">
                            <p class="text-xs text-slate-400 line-through"
                               x-text="getOriginalTotal(selectedPeriod)"></p>
                        </template>
                    </div>
                    <p class="text-3xl font-black" style="color:var(--color-primary);"
                       {% if product.pricing.type == 'recurrent' %}x-text="calcTotal(selectedPeriod)"
                       {% elseif product.pricing.type == 'once' %}x-text="calcTotal('once')"
                       {% else %}x-text="calcTotal('free')"{% endif %}></p>
                </div>

                {# Coupon — always-visible input + Apply button #}
                <div class="space-y-2 mb-4">
                    <div x-show="!couponApplied" class="flex gap-2">
                        <div class="relative flex-1 min-w-0">
                            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                            <input type="text" x-model="couponCode"
                                   @keydown.enter.prevent="applyCoupon()"
                                   @input="couponError = null"
                                   placeholder="Promo code"
                                   class="w-full pl-9 pr-3 py-2.5 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 border border-slate-200 bg-slate-50 transition-all">
                        </div>
                        <button type="button" @click="applyCoupon()"
                                :disabled="!couponCode.trim() || couponLoading"
                                class="flex-shrink-0 flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-bold text-white transition-all focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed"
                                style="background:var(--color-primary);">
                            <span x-show="!couponLoading">Apply</span>
                            <span x-show="couponLoading" class="flex items-center">
                                <svg class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                            </span>
                        </button>
                    </div>
                    <p x-show="couponError" x-cloak x-text="couponError" class="text-xs text-red-500"></p>
                    <div x-show="couponApplied" x-cloak class="flex items-center justify-between rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2">
                        <div class="flex items-center gap-2">
                            <svg class="w-3.5 h-3.5 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                            <span class="text-xs font-mono font-bold text-emerald-700 uppercase tracking-wide" x-text="couponCode"></span>
                        </div>
                        <button type="button"
                                @click="couponApplied = false; couponDiscount = 0; couponCode = ''; promoType = null; promoValue = 0; promoPeriods = []; couponError = null;"
                                class="text-xs text-slate-400 hover:text-red-500 transition-colors font-medium ml-3">
                            Remove
                        </button>
                    </div>
                </div>

                {# Error message #}
                <div x-show="errorMsg"
                     class="mb-3 px-3 py-2.5 rounded-lg bg-red-50 border border-red-200 text-xs text-red-600 font-medium"
                     x-text="errorMsg"></div>

                {# Continue button — Stitch brand-300 (lighter shade of primary) #}
                {% if product.pricing.type == 'recurrent' %}
                <button type="button" @click="addToCart(selectedPeriod)"
                        :disabled="loading || !selectedPeriod || !domainName"
                        :aria-disabled="(loading || !selectedPeriod || !domainName).toString()"
                        :class="!loading && selectedPeriod && domainName ? 'is-ready' : 'is-disabled'"
                {% elseif product.pricing.type == 'once' %}
                <button type="button" @click="addToCart('once')"
                        :disabled="loading || !domainName"
                        :aria-disabled="(loading || !domainName).toString()"
                        :class="!loading && domainName ? 'is-ready' : 'is-disabled'"
                {% else %}
                <button type="button" @click="addToCart('free')"
                        :disabled="loading || !domainName"
                        :aria-disabled="(loading || !domainName).toString()"
                        :class="!loading && domainName ? 'is-ready' : 'is-disabled'"
                {% endif %}
                        class="ord-cta-primary w-full py-4 rounded-lg text-white font-black flex items-center justify-center gap-2 transition-all hover:opacity-90 active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed shadow-lg"
                        style="box-shadow:0 4px 16px rgba(var(--color-primary-rgb),0.25);">
                    <span x-show="!loading" class="flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                        Continue
                    </span>
                    <span x-show="loading" class="flex items-center gap-2">
                        <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
                        </svg>
                        Processing…
                    </span>
                </button>

                {# Explain why the CTA is disabled — a domain must be chosen first #}
                <p x-show="!domainName && !loading" x-cloak
                   class="mt-2 text-center text-xs text-slate-500">
                    Choose or enter a domain above to continue.
                </p>
            </div>

            {# Secure checkout footer #}
            <div class="hosting-summary-footer p-4 border-t border-slate-100">
                <div class="flex items-center justify-center gap-1.5 text-xs font-semibold text-emerald-600 mb-2">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-7a2 2 0 00-2-2h-1V7a5 5 0 00-10 0v3H6a2 2 0 00-2 2v7a2 2 0 002 2zm3-11V7a3 3 0 016 0v3H9z"/></svg>
                    Secure checkout · Instant setup
                </div>
                <p class="text-[10px] text-center text-slate-400 mt-1">
                    By ordering, you agree to our
                    <a href="{{ '/tos'|url }}" class="hover:underline" style="color:var(--color-primary);">Terms of Service</a>
                </p>
            </div>

        </div>
    </aside>
    {# ══ END RIGHT ══ #}

<style>
.order-professional {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    font-family: var(--font-brand-sans, "Inter", ui-sans-serif, system-ui, sans-serif);
}

.order-professional > div:first-child > div:first-child {
    padding: 1.1rem 1.25rem;
    border: 1px solid rgba(var(--color-primary-rgb), .13);
    border-radius: 1rem;
    background:
        radial-gradient(circle at 92% 10%, rgba(var(--color-secondary-rgb), .10), transparent 34%),
        linear-gradient(135deg, rgba(var(--color-primary-rgb), .07), rgba(255, 255, 255, .82) 62%);
}

.order-professional > div:first-child > div:first-child h2 {
    font-family: var(--font-brand-display, "Inter Tight", "Inter", sans-serif);
    letter-spacing: -.035em;
}

#period-card,
#domain-config-card {
    border-color: #dfe7f1;
    box-shadow: 0 8px 26px rgba(15, 23, 42, .045);
}

#period-card {
    position: relative;
    overflow: hidden;
}

#period-card::before,
.hosting-order-summary::before {
    content: "";
    position: absolute;
    z-index: 2;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
}

#domain-config-card > div:first-child {
    background: linear-gradient(90deg, rgba(var(--color-primary-rgb), .035), #fff 34%);
}

.domain-search-group {
    min-height: 3.25rem;
    border-color: #d9e2ec !important;
    border-radius: .85rem !important;
    background: #fff;
    box-shadow: 0 1px 2px rgba(15, 23, 42, .025), inset 0 0 0 1px rgba(255,255,255,.7);
    transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease;
}

.domain-search-group:focus-within {
    border-color: var(--color-primary) !important;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(var(--color-primary-rgb), .10), 0 4px 14px rgba(15,23,42,.045);
}

.domain-search-group input {
    min-height: 3.25rem;
    font-size: .9375rem;
    font-weight: 520;
}

.domain-search-group input::placeholder {
    color: #94a3b8;
    font-weight: 450;
}

.domain-tld-select,
.domain-search-group .domain-tld-input {
    align-self: stretch;
    margin: .35rem;
    min-width: 6.25rem;
    min-height: 0 !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: .6rem;
    background: #f1f5f9 !important;
    box-shadow: inset 0 1px 1px rgba(15,23,42,.025);
}

.domain-tld-select {
    margin-left: 0;
}

.domain-tld-select select {
    min-width: 6.25rem !important;
    color: #334155;
    text-align: center;
}

.domain-search-group .domain-tld-input {
    flex: 0 0 6.5rem !important;
    width: 6.5rem !important;
    max-width: 6.5rem;
    height: auto !important;
    margin-left: 0;
    color: var(--color-primary) !important;
    text-align: center;
    letter-spacing: .01em;
    caret-color: var(--color-primary);
}

.domain-tld-select:focus-within {
    border-color: rgba(var(--color-primary-rgb),.55) !important;
    background: rgba(var(--color-primary-rgb),.055) !important;
    box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb),.09);
}

.domain-search-group .domain-tld-input:focus {
    border-color: #cbd5e1 !important;
    background: #f8fafc !important;
    box-shadow: none;
}

.own-domain-input-group:focus-within .domain-tld-input {
    border-color: rgba(var(--color-primary-rgb), .25) !important;
    background: rgba(var(--color-primary-rgb), .045) !important;
}

.domain-search-group > span {
    border-color: #e2e8f0 !important;
    background: #f8fafc !important;
}

@media (max-width: 639px) {
    .own-domain-entry {
        flex-direction: column;
    }

    .own-domain-entry .domain-action-btn {
        width: 100%;
    }

    .domain-search-group .domain-tld-input {
        flex-basis: 5.5rem !important;
        width: 5.5rem !important;
        max-width: 5.5rem;
    }
}

.domain-action-btn {
    min-height: 3.25rem;
    min-width: 7.25rem;
    justify-content: center;
    border-radius: .85rem !important;
    color: #fff !important;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    box-shadow: 0 6px 16px rgba(var(--color-primary-rgb), .20);
}

.domain-action-btn:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 9px 20px rgba(var(--color-primary-rgb), .25);
}

.domain-action-btn.is-success {
    color: #fff !important;
    background: linear-gradient(135deg, #059669, #10b981) !important;
    box-shadow: 0 7px 18px rgba(5,150,105,.2);
}

.ord-cta-primary {
    min-height: 3.65rem;
    border: 1px solid transparent;
    color: #fff !important;
    transition: transform .2s ease, box-shadow .2s ease, filter .2s ease, opacity .2s ease, background .2s ease;
}

.ord-cta-primary.is-ready {
    opacity: 1 !important;
    cursor: pointer;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)) !important;
    box-shadow: 0 10px 24px rgba(var(--color-primary-rgb),.28) !important;
}

.ord-cta-primary.is-ready:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    box-shadow: 0 14px 30px rgba(var(--color-primary-rgb),.34) !important;
}

.ord-cta-primary.is-ready:active {
    transform: translateY(0) scale(.99);
}

.ord-cta-primary.is-disabled {
    opacity: .48;
    cursor: not-allowed;
    color: rgba(255,255,255,.92) !important;
    background: color-mix(in srgb, var(--color-primary) 55%, white) !important;
    box-shadow: none !important;
}

html body .order-professional .domain-action-btn {
    color: #fff !important;
}

.hosting-addon-card {
    box-shadow: 0 8px 26px rgba(15, 23, 42, .04);
}

.hosting-order-summary {
    position: relative;
    box-shadow: 0 18px 46px rgba(15, 23, 42, .10), 0 3px 10px rgba(15, 23, 42, .04);
}

.hosting-summary-total {
    padding: 1rem;
    border: 1px solid #edf2f7;
    border-radius: .85rem;
    background: #f8fafc;
}

.hosting-summary-footer {
    background: #f8fafc;
}

@media (min-width: 1024px) {
    .hosting-summary-column {
        position: relative;
        align-self: stretch;
        min-width: 0;
    }

    .hosting-order-summary {
        position: -webkit-sticky;
        position: sticky;
        top: 1rem;
        z-index: 10;
        max-height: none;
        overflow: visible;
    }
}

@media (max-width: 639px) {
    .order-professional > div:first-child > div:first-child {
        padding: 1rem;
    }

    #period-card,
    #domain-config-card {
        border-radius: .9rem;
    }

    #domain-config-card .flex.items-stretch.gap-3 {
        flex-direction: column;
    }

    #domain-config-card .domain-action-btn {
        width: 100%;
        justify-content: center;
    }

    #domain-config-card .domain-tab {
        min-width: 8.5rem;
    }

    #domain-config-card .domain-tab + .domain-tab {
        margin-left: .2rem;
    }

    #domain-config-card .flex.gap-1.p-1 {
        overflow-x: auto;
        justify-content: flex-start;
        scrollbar-width: none;
    }

    #domain-config-card .flex.gap-1.p-1::-webkit-scrollbar {
        display: none;
    }
}

[data-theme="dark"] .order-professional > div:first-child > div:first-child {
    border-color: rgba(255, 255, 255, .08);
    background:
        radial-gradient(circle at 92% 10%, rgba(var(--color-secondary-rgb), .12), transparent 34%),
        linear-gradient(135deg, rgba(var(--color-primary-rgb), .10), rgba(255, 255, 255, .025) 62%);
}

[data-theme="dark"] #period-card,
[data-theme="dark"] #domain-config-card,
[data-theme="dark"] .hosting-order-summary {
    color: #e2e8f0;
    background: rgba(255, 255, 255, .035);
    border-color: rgba(255, 255, 255, .09);
    box-shadow: none;
}

[data-theme="dark"] .order-professional .text-slate-900 { color: #f1f5f9 !important; }
[data-theme="dark"] .order-professional .text-slate-700 { color: #cbd5e1 !important; }
[data-theme="dark"] .order-professional .text-slate-500 { color: #94a3b8 !important; }
[data-theme="dark"] .order-professional .bg-white { background-color: rgba(255, 255, 255, .035); }
[data-theme="dark"] .order-professional .bg-slate-50 { background-color: rgba(255, 255, 255, .04); }
[data-theme="dark"] .order-professional .bg-slate-100 { background-color: rgba(255, 255, 255, .065); }
[data-theme="dark"] .order-professional .border-slate-100,
[data-theme="dark"] .order-professional .border-slate-200,
[data-theme="dark"] .order-professional .border-slate-300 { border-color: rgba(255, 255, 255, .09) !important; }

[data-theme="dark"] #domain-config-card > div:first-child {
    background: linear-gradient(90deg, rgba(var(--color-primary-rgb), .08), rgba(255, 255, 255, .025) 34%);
    border-color: rgba(255, 255, 255, .07);
}

[data-theme="dark"] .domain-search-group,
[data-theme="dark"] .domain-search-group input,
[data-theme="dark"] .domain-search-group select {
    color: #e2e8f0;
    background-color: rgba(255, 255, 255, .035);
    border-color: rgba(255, 255, 255, .11) !important;
}

[data-theme="dark"] .domain-tld-select,
[data-theme="dark"] .domain-search-group .domain-tld-input,
[data-theme="dark"] .domain-search-group > span {
    background: rgba(255,255,255,.045) !important;
    border-color: rgba(255,255,255,.1) !important;
}

[data-theme="dark"] .hosting-summary-total,
[data-theme="dark"] .hosting-summary-footer {
    background: rgba(255, 255, 255, .035);
    border-color: rgba(255, 255, 255, .07);
}
</style>

{# ── Mobile sticky checkout bar — visible below lg breakpoint only ── #}
<div class="lg:hidden fixed bottom-0 left-0 right-0 z-40 border-t px-4 py-3 flex items-center justify-between gap-4 mobile-checkout-bar"
     style="background:rgba(255,255,255,0.97);border-top-color:rgba(0,0,0,0.08);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);">
    <div class="min-w-0">
        <p class="text-[11px] font-semibold text-slate-500 truncate">{{ product.title }}</p>
        <p class="text-xl font-black text-slate-900 leading-tight"
           {% if product.pricing.type == 'recurrent' %}x-text="calcTotal(selectedPeriod)"
           {% elseif product.pricing.type == 'once' %}x-text="calcTotal('once')"
           {% else %}x-text="calcTotal('free')"{% endif %}></p>
    </div>
    {% if product.pricing.type == 'recurrent' %}
    <button type="button" @click="addToCart(selectedPeriod)" :disabled="loading || !selectedPeriod || !domainName"
    {% elseif product.pricing.type == 'once' %}
    <button type="button" @click="addToCart('once')" :disabled="loading || !domainName"
    {% else %}
    <button type="button" @click="addToCart('free')" :disabled="loading || !domainName"
    {% endif %}
            class="flex-shrink-0 flex items-center gap-2 px-5 py-2.5 rounded-xl text-white font-bold text-sm transition-all hover:opacity-90 active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed shadow-md"
            style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
        <span x-show="!loading">Continue
            <svg class="w-4 h-4 inline-block ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
        </span>
        <span x-show="loading" class="flex items-center gap-1.5">
            <svg class="w-4 h-4 animate-spin" aria-hidden="true" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
            </svg>
        </span>
    </button>
</div>
</div>
{% endblock %}
