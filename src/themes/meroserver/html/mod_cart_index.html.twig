{% extends "layout_public.html.twig" %}

{% block meta_title %}Your Cart{% endblock %}

{% set cart = guest.cart_get %}
{% set currencies = guest.currency_get_pairs %}
{% set currentCurrency = guest.cart_get_currency %}

{% block content %}
<script>
function cartPage() {
    return {
        showLogin: false,
        loginEmail: '',
        loginPassword: '',
        loginLoading: false,
        loginError: '',
        init() {},
        submitLogin() {
            const self = this;
            self.loginLoading = true;
            self.loginError = '';
            API.guest.post(
                'client/login',
                { email: self.loginEmail, password: self.loginPassword },
                function () { location.reload(); },
                function (err) {
                    self.loginLoading = false;
                    self.loginError = err.message || 'Invalid email or password.';
                }
            );
        }
    };
}
</script>
<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12" x-data="cartPage()" x-init="init()">

    {# ── Page header ── #}
    <div class="flex items-center gap-4 mb-8">
        <a href="{{ '/order'|url }}"
           class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-indigo-400 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Back to Plans
        </a>
    </div>

    <div class="mb-8">
        <h1 class="text-2xl font-bold text-white">
            Your Cart
            {% set cart_main_count = 0 %}{% for _ci in cart.items %}{% if not (_ci.parent_id|default(false)) %}{% set cart_main_count = cart_main_count + 1 %}{% endif %}{% endfor %}
            {% if cart.items %}
                <span class="ml-2 text-base font-normal text-gray-500">({{ cart_main_count }} item{{ cart_main_count != 1 ? 's' : '' }})</span>
            {% endif %}
        </h1>
    </div>

    {% if cart.items %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        {# ── Left column: items ── #}
        <div class="lg:col-span-2 space-y-3">

            {# Cart items – add-ons shown as sub-rows beneath their parent product #}
            {% for item in cart.items %}{% if not (item.parent_id|default(false)) %}
            <div class="rounded-2xl border border-white/[0.07] overflow-hidden"
                 style="background:rgba(255,255,255,0.02);"
                 id="cart-item-{{ item.id }}">
                <div class="p-5 flex items-start gap-4">

                    {# Product icon #}
                    <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"
                                  d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/>
                        </svg>
                    </div>

                    {# Details #}
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold text-white mb-1 truncate">{{ item.title }}</p>
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                            {% if item.period|default(false) %}
                                <span class="inline-flex items-center gap-1 text-xs text-gray-500">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    {{ item.period | period_title }}
                                </span>
                            {% endif %}
                            {% if item.quantity > 1 %}
                                <span class="text-xs text-gray-500">× {{ item.quantity }}</span>
                            {% endif %}
                            {% if item.type %}
                                <span class="px-1.5 py-0.5 rounded-md text-xs font-medium bg-white/[0.04] text-gray-500 border border-white/[0.06]">{{ item.type }}</span>
                            {% endif %}
                        </div>
                        {% if item.setup_price > 0 %}
                            <p class="text-xs text-gray-600 mt-1">+ {{ item.setup_price | money_convert }} one-time setup</p>
                        {% endif %}
                    </div>

                    {# Price + remove #}
                    <div class="flex flex-col items-end gap-2 flex-shrink-0">
                        <div class="text-right">
                            {% if item.discount > 0 %}
                                <p class="text-xs text-gray-500 line-through">{{ item.total | money_convert }}</p>
                                <p class="text-sm font-bold text-green-400">{{ (item.total - item.discount) | money_convert }}</p>
                            {% else %}
                                <p class="text-sm font-bold text-white">{{ item.total | money_convert }}</p>
                            {% endif %}
                        </div>
                        <button onclick="cartPage_removeItem({{ item.id }})"
                                class="text-xs text-gray-600 hover:text-red-400 transition-colors flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                            Remove
                        </button>
                    </div>

                </div>

                {# Add-on sub-items grouped under this product #}
                {% for sub in cart.items %}{% if sub.parent_id is defined and sub.parent_id == item.product_id %}
                <div class="flex items-center gap-3 px-5 py-3 border-t border-white/[0.04]"
                     id="cart-item-{{ sub.id }}"
                     style="background:rgba(255,255,255,0.008);">
                    <div class="w-10 flex-shrink-0 flex justify-end">
                        <span class="inline-flex items-center justify-center w-5 h-5 rounded-md bg-indigo-500/10 border border-indigo-500/15">
                            <svg class="w-2.5 h-2.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                            </svg>
                        </span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                            <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wide bg-indigo-500/10 text-indigo-400 border border-indigo-500/15">add-on</span>
                            <p class="text-xs font-medium text-gray-300 truncate">{{ sub.title }}</p>
                        </div>
                        {% if sub.period|default(false) %}
                        <p class="text-xs text-gray-600 mt-0.5">{{ sub.period | period_title }}</p>
                        {% endif %}
                    </div>
                    <div class="flex items-center gap-3 flex-shrink-0">
                        {% if sub.discount > 0 %}
                            <span class="text-xs font-semibold text-green-400">{{ (sub.total - sub.discount) | money_convert }}</span>
                        {% else %}
                            <span class="text-xs font-semibold text-gray-400">+ {{ sub.total | money_convert }}</span>
                        {% endif %}
                        <button onclick="cartPage_removeItem({{ sub.id }})"
                                class="text-gray-600 hover:text-red-400 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                        </button>
                    </div>
                </div>
                {% endif %}{% endfor %}

            </div>
            {% endif %}{% endfor %}

            {# Promo code #}
            <div class="rounded-2xl border border-white/[0.07] p-5 mt-4" style="background:rgba(255,255,255,0.02);">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Promo Code</p>
                {% if cart.promocode %}
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="w-7 h-7 rounded-lg {{ cart.promo_discount > 0 ? 'bg-green-500/10' : 'bg-amber-500/10' }} flex items-center justify-center">
                                {% if cart.promo_discount > 0 %}
                                <svg class="w-3.5 h-3.5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                {% else %}
                                <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                {% endif %}
                            </div>
                            <span class="text-sm font-mono font-semibold {{ cart.promo_discount > 0 ? 'text-green-500' : 'text-amber-600' }}">{{ cart.promocode }}</span>
                        </div>
                        <button onclick="API.guest.post('cart/remove_promo',{},function(){location.reload();})"
                                class="text-xs text-gray-600 hover:text-red-400 transition-colors">
                            Remove
                        </button>
                    </div>
                    {% if cart.promo_discount == 0 %}
                    <div class="mt-2.5 flex items-start gap-2 p-2.5 rounded-lg border border-amber-500/30 bg-amber-500/10">
                        <svg class="w-3.5 h-3.5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <p class="text-xs text-amber-700 leading-relaxed">This code doesn't apply to the products in your cart and won't provide a discount.</p>
                    </div>
                    {% endif %}
                {% else %}
                    <div class="flex gap-2">
                        <input type="text" id="promo-input" placeholder="Enter code"
                               class="flex-1 bg-white/[0.04] border border-white/[0.08] rounded-xl px-3 py-2 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/20 transition-all">
                        <button onclick="applyPromo()"
                                class="px-4 py-2 rounded-xl text-xs font-semibold text-indigo-300 bg-indigo-500/10 border border-indigo-500/20 hover:bg-indigo-500/20 transition-all whitespace-nowrap">
                            Apply
                        </button>
                    </div>
                    <p id="promo-error" class="text-xs text-red-600 mt-2 hidden flex items-center gap-1">
                        <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <span id="promo-error-text"></span>
                    </p>
                {% endif %}
            </div>

        </div>

        {# ── Right column: order summary ── #}
        <div class="lg:col-span-1">
            <div class="rounded-2xl border border-white/[0.07] overflow-hidden sticky top-20" style="background:rgba(255,255,255,0.02);">

                <div class="px-5 py-4 border-b border-white/[0.05]">
                    <h2 class="text-sm font-semibold text-white">Order Summary</h2>
                </div>

                <div class="p-5 space-y-3">

                    {# Subtotal #}
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-400">Subtotal</span>
                        <span class="text-white font-medium">{{ cart.subtotal | money_convert }}</span>
                    </div>

                    {# Discount #}
                    {% if cart.discount > 0 %}
                    <div class="flex justify-between text-sm">
                        <span class="text-green-400">Discount</span>
                        <span class="text-green-400 font-medium">− {{ cart.discount | money_convert }}</span>
                    </div>
                    {% endif %}

                    {# Tax (only for logged-in taxable clients) #}
                    {% set cart_tax = 0 %}
                    {% if client and client.client_is_taxable %}
                        {% set tax_rate = client.invoice_get_tax_rate %}
                        {% if tax_rate > 0 %}
                        {% set cart_tax = cart.total * tax_rate / 100 %}
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-400">VAT ({{ tax_rate }}%)</span>
                            <span class="text-white">{{ cart_tax | money_convert }}</span>
                        </div>
                        {% endif %}
                    {% endif %}

                    <div class="pt-3 border-t border-white/[0.05]">
                        <div class="flex justify-between items-center">
                            <span class="text-sm font-semibold text-white">Total</span>
                            <span class="text-xl font-bold text-indigo-400">{{ (cart.total + cart_tax) | money_convert }}</span>
                        </div>
                        <p class="text-xs text-gray-600 mt-1">Billed in {{ currentCurrency.name }}</p>
                    </div>

                    {# Currency selector — guest only #}
                    {% if not client and currencies|length > 1 %}
                    <div class="pt-2">
                        <p class="text-xs text-gray-600 mb-1.5 uppercase tracking-wide font-semibold">Currency</p>
                        <div class="flex flex-wrap gap-1.5">
                            {% for code, title in currencies %}
                                <button type="button" data-set-currency="{{ code }}"
                                    class="px-2.5 py-1 rounded-lg text-xs font-mono font-semibold transition-all
                                           {{ currentCurrency.code == code
                                              ? 'bg-indigo-500/20 text-indigo-300 border border-indigo-500/40'
                                              : 'bg-white/[0.03] text-gray-500 border border-white/[0.07] hover:text-white hover:border-white/20' }}">
                                {{ code }}
                            </button>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                </div>

                <div class="px-5 pb-5 space-y-3">

                    {% if client %}
                        {# Logged-in: go straight to checkout #}
                        <a href="{{ '/order/checkout'|url }}"
                           class="w-full flex items-center justify-center gap-2 py-3 rounded-xl text-white text-sm font-semibold transition-all hover:opacity-90"
                           style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary)); box-shadow:0 4px 16px rgba(var(--color-primary-rgb),.25);">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                            Proceed to Checkout
                        </a>
                    {% else %}
                        {# Guest: prompt sign in or create account #}
                        <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-3 mb-1">
                            <p class="text-xs text-amber-300 font-medium">Sign in to complete your order</p>
                        </div>
                        <button @click="showLogin = true"
                           class="w-full flex items-center justify-center gap-2 py-3 rounded-xl text-white text-sm font-semibold transition-all hover:opacity-90"
                           style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary)); box-shadow:0 4px 16px rgba(var(--color-primary-rgb),.25);">
                            Sign In &amp; Checkout
                        </button>
                        <a href="{{ '/signup'|url }}"
                           class="w-full flex items-center justify-center gap-2 py-2.5 rounded-xl text-gray-300 text-sm font-medium border border-white/[0.1] bg-white/[0.03] hover:bg-white/[0.07] hover:text-white transition-all">
                            Create an Account
                        </a>
                    {% endif %}

                    <button onclick="API.guest.post('cart/reset',{},function(){location.reload();})"
                            class="w-full py-2 rounded-xl text-xs text-gray-600 hover:text-red-400 hover:bg-red-500/5 border border-transparent hover:border-red-500/10 transition-all">
                        Clear Cart
                    </button>
                </div>

            </div>
        </div>

    </div>

    {% else %}

    {# ── Empty cart ── #}
    <div class="flex flex-col items-center justify-center py-24 text-center">
        <div class="w-20 h-20 rounded-2xl bg-white/[0.03] border border-white/[0.07] flex items-center justify-center mb-6">
            <svg class="w-10 h-10 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                      d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
        </div>
        <h2 class="text-xl font-bold text-white mb-2">Your cart is empty</h2>
        <p class="text-gray-500 text-sm mb-8 max-w-xs">Browse our plans and add something to get started.</p>
        <a href="{{ '/order'|url }}"
           class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl text-white text-sm font-semibold hover:opacity-90 transition-all"
           style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary)); box-shadow:0 4px 16px rgba(var(--color-primary-rgb),.25);">
            Browse Plans
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
        </a>
    </div>

    {% endif %}

    {# ── Login Modal ── #}
    <div x-show="showLogin"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 z-50 flex items-center justify-center p-4"
         style="display:none;"
         @keydown.escape.window="showLogin = false">

        {# Backdrop #}
        <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" @click="showLogin = false"></div>

        {# Modal card #}
        <div class="login-modal relative w-full max-w-sm rounded-2xl border border-white/[0.08] shadow-2xl shadow-black/60 p-8"
             style="background:#0d1424;"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 scale-95"
             x-transition:enter-end="opacity-100 scale-100"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100 scale-100"
             x-transition:leave-end="opacity-0 scale-95">

            {# Close #}
            <button @click="showLogin = false"
                    class="absolute top-4 right-4 w-7 h-7 flex items-center justify-center rounded-lg text-gray-500 hover:text-white hover:bg-white/[0.06] transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>

            {# Header #}
            <div class="mb-6">
                <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center mb-4">
                    <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </div>
                <h2 class="login-modal-title text-lg font-bold text-white">Sign in to continue</h2>
                <p class="text-sm text-gray-500 mt-1">You'll return to your cart after signing in.</p>
            </div>

            {# Error message #}
            <div x-show="loginError" x-cloak
                 class="mb-4 rounded-xl border border-red-500/20 bg-red-500/5 px-3 py-2.5">
                <p class="text-xs text-red-400" x-text="loginError"></p>
            </div>

            {# Form #}
            <form @submit.prevent="submitLogin()" class="space-y-4">
                <div>
                    <label class="login-modal-label block text-xs font-medium text-gray-400 mb-1.5">Email address</label>
                    <input type="email" x-model="loginEmail" required autocomplete="email"
                           placeholder="you@example.com"
                           class="login-modal-input w-full bg-white/[0.04] border border-white/[0.08] rounded-xl px-3 py-2.5 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/20 transition-all">
                </div>
                <div>
                    <label class="login-modal-label block text-xs font-medium text-gray-400 mb-1.5">Password</label>
                    <input type="password" x-model="loginPassword" required autocomplete="current-password"
                           placeholder="••••••••"
                           class="login-modal-input w-full bg-white/[0.04] border border-white/[0.08] rounded-xl px-3 py-2.5 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/20 transition-all">
                </div>
                <button type="submit"
                        :disabled="loginLoading"
                        class="w-full flex items-center justify-center gap-2 py-3 rounded-xl text-white text-sm font-semibold transition-all hover:opacity-90 disabled:opacity-60"
                        style="background:linear-gradient(135deg,var(--color-primary),var(--color-secondary)); box-shadow:0 4px 16px rgba(var(--color-primary-rgb),.25);">
                    <svg x-show="loginLoading" class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                    <span x-text="loginLoading ? 'Signing in…' : 'Sign In & Checkout'"></span>
                </button>
            </form>

            {# Footer #}
            <p class="mt-5 text-center text-xs text-gray-600">
                No account?
                <a href="{{ '/signup'|url }}" class="text-indigo-400 hover:text-indigo-300 transition-colors">Create one free</a>
                &nbsp;·&nbsp;
                <a href="{{ '/reset-password'|url }}" class="text-indigo-400 hover:text-indigo-300 transition-colors">Forgot password?</a>
            </p>

        </div>
    </div>

</div>
{% endblock %}

{% block js %}
<script>
// Exposed globally so inline onclick handlers can reach it
function cartPage_removeItem(itemId) {
    API.guest.post('cart/remove_item', { id: itemId }, function () {
        var el = document.getElementById('cart-item-' + itemId);
        if (el) {
            el.style.transition = 'opacity .2s, transform .2s';
            el.style.opacity = '0';
            el.style.transform = 'translateX(8px)';
            setTimeout(function () { location.reload(); }, 220);
        } else {
            location.reload();
        }
    });
}

function applyPromo() {
    var code = document.getElementById('promo-input').value.trim();
    var errEl = document.getElementById('promo-error');
    var errText = document.getElementById('promo-error-text');
    if (!code) return;
    errEl.classList.add('hidden');
    API.guest.post('cart/apply_promo', { promocode: code },
        function () { location.reload(); },
        function (err) {
            errText.textContent = err.message || 'Invalid promo code.';
            errEl.classList.remove('hidden');
        }
    );
}

// Sync the global navbar badge after any reload triggered from this page
