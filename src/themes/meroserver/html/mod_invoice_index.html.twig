{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}Invoices{% endblock %}
{% block page_header %}{% endblock %}

{% block content %}
{% if request.status %}
    {% set invoices = client.invoice_get_list({'per_page': 10, 'page': request.page|default(1), 'status': request.status}) %}
{% else %}
    {% set invoices = client.invoice_get_list({'per_page': 10, 'page': request.page|default(1)}) %}
{% endif %}
{% set currentPage = request.page|default(1)|number_format(0,'','') %}

{# Stats — 2 SQL queries; replaces 3 × invoice_get_list + Twig sum loops #}
{% set invoice_stats = client.invoice_get_stats %}

{# Pagination display range #}
{% set rangeStart = (currentPage - 1) * 10 + 1 %}
{% set rangeEnd = currentPage * 10 %}
{% if rangeEnd > invoices.total %}{% set rangeEnd = invoices.total %}{% endif %}

<div class="ref-invoice-page space-y-8">

    {# ── Page header + filter tabs ── #}
    <header class="ref-invoice-hero flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <span class="ref-invoice-eyebrow">Billing center</span>
            <h1 class="text-[30px] leading-[38px] tracking-[-0.02em] font-bold text-slate-900 dark:text-white mb-1">Invoices</h1>
            <p class="text-sm text-slate-500 dark:text-slate-400">
                Manage your billing and view payment history.
                {% if invoice_stats.total > 0 %}
                <span class="font-semibold" style="color: var(--color-primary);">{{ invoice_stats.total }} invoice{{ invoice_stats.total != 1 ? 's' : '' }} total</span>
                {% endif %}
            </p>
        </div>
        <div class="ref-invoice-tabs flex bg-white dark:bg-white/[0.04] p-1 rounded-xl shadow-sm border border-slate-200 dark:border-white/[0.08] self-start md:self-auto">
            <a href="{{ '/invoice'|url }}"
               class="px-5 py-2 rounded-lg text-xs font-semibold transition-all {{ not request.status ? 'text-white' : 'text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-white/[0.04]' }}"
               {% if not request.status %}style="background: var(--color-primary);"{% endif %}>All</a>
            <a href="?status=paid"
               class="px-5 py-2 rounded-lg text-xs font-semibold transition-all {{ request.status == 'paid' ? 'text-white' : 'text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-white/[0.04]' }}"
               {% if request.status == 'paid' %}style="background: var(--color-primary);"{% endif %}>Paid</a>
            <a href="?status=unpaid"
               class="px-5 py-2 rounded-lg text-xs font-semibold transition-all {{ request.status == 'unpaid' ? 'text-white' : 'text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-white/[0.04]' }}"
               {% if request.status == 'unpaid' %}style="background: var(--color-primary);"{% endif %}>Unpaid</a>
        </div>
    </header>

    {# ── Stats row ── #}
    <div class="ref-invoice-stats grid grid-cols-1 md:grid-cols-3 gap-6">

        {# Total Outstanding #}
        <div class="ref-invoice-stat bg-white dark:bg-white/[0.03] p-6 rounded-xl border shadow-sm
            {{ invoice_stats.unpaid_count > 0 ? 'border-red-200 dark:border-red-500/25 bg-red-50/20 dark:bg-red-500/[0.04]' : 'border-slate-200 dark:border-white/[0.06]' }}">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0
                    {{ invoice_stats.unpaid_count > 0 ? 'bg-red-100 dark:bg-red-500/15 text-red-500' : 'bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' }}">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <span class="text-sm font-semibold text-slate-600 dark:text-slate-300">Total Outstanding</span>
            </div>
            {% if invoice_stats.unpaid_count > 0 %}
            <div class="text-2xl font-bold text-slate-900 dark:text-white">{{ invoice_stats.outstanding_total|money(invoice_stats.currency) }}</div>
            <div class="mt-2 flex items-center gap-1.5 text-xs font-medium text-red-500">
                <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                {{ invoice_stats.unpaid_count }} invoice{{ invoice_stats.unpaid_count != 1 ? 's' : '' }} unpaid
            </div>
            {% else %}
            <div class="text-2xl font-bold text-slate-900 dark:text-white">—</div>
            <div class="mt-2 flex items-center gap-1.5 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                All payments up to date
            </div>
            {% endif %}
        </div>

        {# Last Payment #}
        <div class="ref-invoice-stat bg-white dark:bg-white/[0.03] p-6 rounded-xl border border-slate-200 dark:border-white/[0.06] shadow-sm">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center flex-shrink-0 text-indigo-600 dark:text-indigo-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <span class="text-sm font-semibold text-slate-600 dark:text-slate-300">Last Payment</span>
            </div>
            {% if invoice_stats.last_paid is not null %}
            <div class="text-2xl font-bold text-slate-900 dark:text-white">{{ invoice_stats.last_paid.total|money(invoice_stats.last_paid.currency) }}</div>
            <div class="mt-2 text-xs text-slate-500 dark:text-slate-400">Processed on {{ invoice_stats.last_paid.updated_at|date('M j, Y') }}</div>
            {% else %}
            <div class="text-2xl font-bold text-slate-900 dark:text-white">—</div>
            <div class="mt-2 text-xs text-slate-500 dark:text-slate-400">No payments yet</div>
            {% endif %}
        </div>

        {# Invoice summary #}
        <div class="ref-invoice-stat bg-white dark:bg-white/[0.03] p-6 rounded-xl border border-slate-200 dark:border-white/[0.06] shadow-sm">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-white/[0.06] flex items-center justify-center flex-shrink-0 text-slate-600 dark:text-slate-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                </div>
                <span class="text-sm font-semibold text-slate-600 dark:text-slate-300">All Invoices</span>
            </div>
            <div class="text-2xl font-bold text-slate-900 dark:text-white">{{ invoice_stats.total }}</div>
            <div class="mt-2 text-xs text-slate-500 dark:text-slate-400">
                {{ invoice_stats.unpaid_count }} unpaid · {{ invoice_stats.paid_count }} paid
            </div>
        </div>

    </div>

    {# ── Invoice table ── #}
    <div class="ref-invoice-table bg-white dark:bg-white/[0.03] rounded-xl border border-slate-200 dark:border-white/[0.06] shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 dark:border-white/[0.06] flex items-center justify-between">
            <h3 class="text-[18px] leading-7 tracking-[-0.01em] font-semibold text-slate-900 dark:text-white">
                {% if request.status == 'unpaid' %}Unpaid Invoices
                {% elseif request.status == 'paid' %}Paid Invoices
                {% else %}Recent Invoices{% endif %}
            </h3>
        </div>

        {% if invoices.list %}
        <div class="ref-invoice-table-scroll overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-slate-50 dark:bg-white/[0.02] border-b border-slate-100 dark:border-white/[0.05]">
                        <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Invoice ID</th>
                        <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 hidden sm:table-cell">Date</th>
                        <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 hidden md:table-cell">Due Date</th>
                        <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Amount</th>
                        <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Status</th>
                        <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-white/[0.04]">
                    {% for invoice in invoices.list %}
                    <tr class="ref-invoice-row hover:bg-slate-50/50 dark:hover:bg-white/[0.02] transition-colors">
                        <td class="px-6 py-4" data-label="Invoice">
                            <a href="{{ 'invoice'|url }}/{{ invoice.hash }}"
                               class="text-sm font-semibold text-slate-900 dark:text-white hover:underline">
                                #{{ invoice.serie }}{{ invoice.nr }}
                            </a>
                        </td>
                        <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-400 hidden sm:table-cell" data-label="Created">
                            {{ invoice.created_at|date("M j, Y") }}
                        </td>
                        <td class="px-6 py-4 hidden md:table-cell" data-label="Due">
                            {% if invoice.due_at %}
                                <span class="text-sm {{ invoice.status == 'unpaid' and invoice.due_at|date('U') < 'now'|date('U') ? 'text-red-500 font-medium' : 'text-slate-600 dark:text-slate-400' }}">
                                    {{ invoice.due_at|date("M j, Y") }}
                                </span>
                            {% else %}
                                <span class="text-sm text-slate-400 dark:text-slate-600">—</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-sm font-bold text-slate-900 dark:text-white" data-label="Amount">
                            {{ invoice.total|money(invoice.currency) }}
                        </td>
                        <td class="px-6 py-4" data-label="Status">
                            {% if invoice.status == 'paid' %}
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-green-100 dark:bg-green-500/10 text-green-700 dark:text-green-400 text-xs font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                Paid
                            </span>
                            {% elseif invoice.status == 'unpaid' %}
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-red-100 dark:bg-red-500/10 text-red-700 dark:text-red-400 text-xs font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                                Unpaid
                            </span>
                            {% else %}
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 dark:bg-white/[0.06] text-slate-600 dark:text-slate-400 text-xs font-medium">
                                {{ invoice.status|capitalize }}
                            </span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-right" data-label="Action">
                            {% if invoice.status == 'unpaid' %}
                            <a href="{{ 'invoice'|url }}/{{ invoice.hash }}"
                               class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-xs font-semibold text-white shadow-sm hover:opacity-90 transition-all active:scale-95"
                               style="background: var(--color-primary);">
                                Pay Now
                            </a>
                            {% else %}
                            <a href="{{ 'invoice'|url }}/{{ invoice.hash }}"
                               class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                                View
                            </a>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Table footer: result count + pagination #}
        <div class="px-6 py-4 bg-slate-50 dark:bg-white/[0.02] border-t border-slate-100 dark:border-white/[0.05] flex items-center justify-between gap-4 flex-wrap">
            <p class="text-xs text-slate-500 dark:text-slate-400">
                {% if invoices.total > 0 %}
                Showing {{ rangeStart }}–{{ rangeEnd }} of {{ invoices.total }} result{{ invoices.total != 1 ? 's' : '' }}
                {% endif %}
            </p>
            {% if invoices.pages > 1 %}
            <div class="flex items-center gap-1.5">
                {# Prev #}
                {% if currentPage > 1 %}
                <a href="?{% if request.status %}status={{ request.status }}&{% endif %}page={{ currentPage - 1 }}"
                   class="p-1.5 rounded-lg border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.03] text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                </a>
                {% else %}
                <span class="p-1.5 rounded-lg border border-slate-100 dark:border-white/[0.04] text-slate-300 dark:text-slate-700 cursor-not-allowed">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                </span>
                {% endif %}

                {# Page numbers with smart truncation #}
                {% for p in 1..invoices.pages %}
                    {% set isActive = currentPage == p %}
                    {% set nearCurrent = (p >= currentPage - 2 and p <= currentPage + 2) %}
                    {% set isEdge = (p == 1 or p == invoices.pages) %}
                    {% if isEdge or nearCurrent %}
                        {% if not loop.first and p == currentPage - 2 and currentPage - 2 > 2 %}
                        <span class="px-1 text-slate-400 dark:text-slate-500 text-xs">…</span>
                        {% endif %}
                        {% if not loop.first and not nearCurrent and p == invoices.pages and currentPage + 2 < invoices.pages - 1 %}
                        <span class="px-1 text-slate-400 dark:text-slate-500 text-xs">…</span>
                        {% endif %}
                        <a href="?{% if request.status %}status={{ request.status }}&{% endif %}page={{ p }}"
                           class="w-8 h-8 flex items-center justify-center rounded-lg text-xs font-medium transition-all {{ isActive ? 'text-white' : 'border border-slate-200 dark:border-white/[0.08] text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-white/[0.04]' }}"
                           {% if isActive %}style="background: var(--color-primary);"{% endif %}>
                            {{ p }}
                        </a>
                    {% endif %}
                {% endfor %}

                {# Next #}
                {% if currentPage < invoices.pages %}
                <a href="?{% if request.status %}status={{ request.status }}&{% endif %}page={{ currentPage + 1 }}"
                   class="p-1.5 rounded-lg border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.03] text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
                {% else %}
                <span class="p-1.5 rounded-lg border border-slate-100 dark:border-white/[0.04] text-slate-300 dark:text-slate-700 cursor-not-allowed">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </span>
                {% endif %}
            </div>
            {% endif %}
        </div>

        {% else %}
        {# Empty state #}
        <div class="py-16 text-center">
            <div class="w-12 h-12 rounded-xl bg-slate-50 dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.08] flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
            </div>
            <p class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">No invoices found</p>
            <p class="text-xs text-slate-400 dark:text-slate-500">
                {% if request.status %}No {{ request.status }} invoices on your account.{% else %}You have no invoices yet.{% endif %}
            </p>
        </div>
        {% endif %}

    </div>

    {# ── Info section ── #}
    <div class="ref-invoice-info grid grid-cols-1 md:grid-cols-2 gap-6">

        {# Payment methods card #}
        <div class="rounded-xl p-6 border flex gap-4"
             style="background: rgba(var(--color-primary-rgb, 99,102,241), 0.05); border-color: rgba(var(--color-primary-rgb, 99,102,241), 0.12);">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0"
                 style="background: rgba(var(--color-primary-rgb, 99,102,241), 0.10);">
                <svg class="w-5 h-5" style="color: var(--color-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                </svg>
            </div>
            <div>
                <h4 class="font-bold text-slate-900 dark:text-white mb-1">Payment Methods</h4>
                <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                    Manage your payment methods and billing preferences in your
                    <a href="{{ '/client/profile'|url }}" class="font-medium hover:underline" style="color: var(--color-primary);">Billing Profile</a>.
                </p>
            </div>
        </div>

        {# Support card #}
        <div class="rounded-xl p-6 border border-slate-200 dark:border-white/[0.06] bg-white dark:bg-white/[0.03] shadow-sm">
            <h4 class="font-bold text-slate-900 dark:text-white mb-1">Questions about your invoice?</h4>
            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
                Our support team can help with billing disputes, payment issues, or account queries.
            </p>
            <a href="{{ 'support'|url }}"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-semibold text-white shadow-sm hover:opacity-90 transition-all"
               style="background: var(--color-primary);">
                Contact Support
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </a>
        </div>

    </div>

</div>
{% endblock %}
