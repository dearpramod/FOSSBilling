{% extends "layout_public.html.twig" %}

{% set company = guest.system_company %}
{% set _rc = {} %}
{% if guest.extension_is_on({'mod': 'antispam'}) %}
    {% set _rc = guest.antispam_recaptcha %}
{% endif %}

{% block meta_title %}Reset Password{% endblock %}
{% block body_class %}public-state-page public-password-page{% endblock %}

{% block content %}
<script>
function pwdReset() {
    {% if _rc.enabled and _rc.captcha_provider|default('recaptcha_v2') == 'recaptcha_v3' and _rc.publickey %}
    const _rcKey = '{{ _rc.publickey|e('js') }}';
    {% else %}
    const _rcKey = null;
    {% endif %}

    return {
        email: '{{ request.email|default('')|e('js') }}',
        loading: false,
        sent: false,
        submittedEmail: '',

        async submit() {
            if (!this.email || this.loading) return;
            this.loading = true;
            this.submittedEmail = this.email;

            var data = { email: this.email };

            // reCAPTCHA v3 — execute invisibly and inject token
            if (_rcKey && typeof grecaptcha !== 'undefined') {
                try {
                    var token = await new Promise(function(resolve, reject) {
                        grecaptcha.ready(function() {
                            grecaptcha.execute(_rcKey, { action: 'PASSWORD_RESET' }).then(resolve).catch(reject);
                        });
                    });
                    if (token) data['g-recaptcha-response'] = token;
                } catch (e) { /* proceed without token */ }
            }

            // reCAPTCHA v2 widget
            if (!data['g-recaptcha-response'] && typeof grecaptcha !== 'undefined' && typeof grecaptcha.getResponse === 'function') {
                var v2Token = grecaptcha.getResponse();
                if (v2Token) data['g-recaptcha-response'] = v2Token;
            }

            // Cloudflare Turnstile
            var _tsEl = document.querySelector('#pwd-reset-captcha [name="cf-turnstile-response"]');
            if (_tsEl && _tsEl.value) data['cf-turnstile-response'] = _tsEl.value;

            // hCaptcha
            if (typeof hcaptcha !== 'undefined' && typeof hcaptcha.getResponse === 'function') {
                var hToken = hcaptcha.getResponse();
                if (hToken) data['h-captcha-response'] = hToken;
            }

            API.guest.post(
                'client/reset_password',
                data,
                () => {
                    this.loading = false;
                    this.sent = true;
                },
                (res) => {
                    this.loading = false;
                    // Reset captcha widget on failure so user can retry
                    if (typeof grecaptcha !== 'undefined' && typeof grecaptcha.reset === 'function') grecaptcha.reset();
                    if (typeof hcaptcha !== 'undefined' && typeof hcaptcha.reset === 'function') hcaptcha.reset();
                    StablePanel.message(res.message || 'Something went wrong. Please try again.', 'error');
                },
                false
            );
        }
    };
}
</script>
<div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

        {# Logo / brand #}
        <div class="text-center mb-8">
            {% if settings.login_logo_url|default(false) %}
                <img src="{{ settings.login_logo_url }}" alt="{{ company.name }}" class="h-12 mx-auto mb-4 object-contain">
            {% else %}
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center mx-auto mb-4 shadow-lg shadow-indigo-500/30">
                <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                </svg>
            </div>
            {% endif %}
            <h1 class="text-2xl font-bold text-white">Reset your password</h1>
            <p class="text-sm text-gray-500 mt-1">We'll send a recovery link to your email</p>
        </div>

        {# Card #}
        <div class="rounded-2xl bg-white/[0.04] border border-white/[0.08] p-8 shadow-2xl shadow-black/50 backdrop-blur-sm"
             x-data="pwdReset()" x-cloak>

            {# Success state #}
            <div x-show="sent" x-transition.opacity.duration.200ms class="text-center py-4">
                <div class="w-14 h-14 rounded-full bg-green-500/10 border border-green-500/20 flex items-center justify-center mx-auto mb-4">
                    <svg class="w-7 h-7 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                </div>
                <h2 class="text-lg font-semibold text-white mb-2">Check your inbox</h2>
                <p class="text-sm text-gray-400 leading-relaxed">
                    If an account exists for <strong x-text="submittedEmail" class="text-gray-300"></strong>,
                    a password reset link has been sent. The link expires in 15 minutes.
                </p>
                <p class="text-xs text-gray-600 mt-3">Didn't receive it? Check your spam folder.</p>
            </div>

            {# Form state #}
            <form x-show="!sent" @submit.prevent="submit" novalidate>
                <div class="space-y-5">
                    <div class="space-y-1.5">
                        <label for="reset-email" class="block text-sm font-medium text-gray-300">Email address</label>
                        <input id="reset-email" type="email" name="email"
                               x-model="email"
                               :disabled="loading"
                               required autofocus
                               autocomplete="email"
                               value="{{ request.email }}"
                               placeholder="you@example.com"
                               class="w-full px-4 py-3 rounded-xl bg-white/[0.05] border border-white/[0.10] text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all disabled:opacity-50">
                    </div>

                    {# Captcha widget (v2 / Turnstile / hCaptcha — v3 is invisible) #}
                    {% if _rc.enabled %}
                    {% set _lp = _rc.captcha_provider|default('recaptcha_v2') %}
                    <div id="pwd-reset-captcha">
                    {% if _lp == 'turnstile' and _rc.turnstile_site_key %}
                        <div class="cf-turnstile" data-sitekey="{{ _rc.turnstile_site_key }}" data-theme="dark"></div>
                    {% elseif _lp == 'hcaptcha' and _rc.hcaptcha_site_key %}
                        <div class="h-captcha" data-sitekey="{{ _rc.hcaptcha_site_key }}" data-theme="dark"></div>
                    {% elseif _lp == 'recaptcha_v3' and _rc.publickey %}
                        {# v3 is invisible — token injected by submit() #}
                    {% elseif _rc.publickey %}
                        <div class="g-recaptcha" data-sitekey="{{ _rc.publickey }}" data-theme="dark"
                             style="transform-origin:top left;"></div>
                    {% endif %}
                    </div>
                    {% endif %}

                    <button type="submit"
                            :disabled="loading || !email"
                            class="w-full py-3 px-4 rounded-xl bg-indigo-500 hover:bg-indigo-600 text-white text-sm font-semibold transition-all shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/50 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2">
                        <svg x-show="loading" class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                        </svg>
                        <span x-text="loading ? 'Sending…' : 'Send Reset Link'"></span>
                    </button>
                </div>
            </form>

            {# Back to login #}
            <div class="mt-6 text-center" x-show="!sent">
                <p class="text-sm text-gray-500">
                    Remembered it?
                    <a href="{{ 'login'|url }}" class="text-indigo-400 hover:text-indigo-300 font-medium transition-colors">Back to Sign In</a>
                </p>
            </div>
            <div class="mt-6 text-center" x-show="sent" x-transition.opacity.duration.200ms>
                <a href="{{ 'login'|url }}" class="text-sm text-indigo-400 hover:text-indigo-300 font-medium transition-colors">← Back to Sign In</a>
            </div>

        </div>

        {# Back to home #}
        <div class="text-center mt-6">
            <a href="{{ '/'|url }}" class="text-xs text-gray-600 hover:text-gray-400 transition-colors">← Back to {{ company.name }}</a>
        </div>

    </div>
</div>
{% endblock %}

{% block js %}
{% if _rc.enabled %}
{% set _lp = _rc.captcha_provider|default('recaptcha_v2') %}
{% if _lp == 'turnstile' and _rc.turnstile_site_key %}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{% elseif _lp == 'hcaptcha' and _rc.hcaptcha_site_key %}
<script src="https://js.hcaptcha.com/1/api.js" async defer></script>
{% elseif _lp == 'recaptcha_v3' and _rc.publickey %}
<script src="https://www.google.com/recaptcha/api.js?render={{ _rc.publickey|e('html_attr') }}" async defer></script>
{% elseif _rc.publickey %}
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
{% endif %}
{% endif %}
{% endblock %}
