{% extends request.ajax ? "layout_blank.html.twig" : "layout_public.html.twig" %}
{% set _rc_c = guest.extension_is_on({'mod': 'antispam'}) ? guest.antispam_recaptcha : {} %}

{% block meta_title %}Contact Us{% endblock %}
{% block meta_description %}Get in touch with our team. We're here to help 24/7.{% endblock %}
{% block body_class %}public-contact-page{% endblock %}

{% block content %}
{% set company = guest.system_company %}

<!-- ===== HERO ===== -->
<section class="relative pt-14 pb-9 sm:pt-16 sm:pb-11">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-medium mb-5">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
            Support available 24/7
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-3">
            We're here to help
        </h1>
        <p class="text-base sm:text-lg text-gray-400 max-w-xl mx-auto">
            Send us a message and our team will get back to you within 24 hours.
        </p>
    </div>
</section>

<!-- ===== CONTACT GRID ===== -->
<section class="max-w-6xl mx-auto px-4 sm:px-6 pb-16 sm:pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 lg:gap-8 items-start">

        <!-- LEFT: Contact form -->
        <div class="lg:col-span-3">
            <div class="rounded-2xl bg-white/[0.03] border border-white/[0.08] overflow-hidden">
                <div class="px-6 py-5 border-b border-white/[0.06]">
                    <h2 class="text-base font-semibold text-white">Send a message</h2>
                    <p class="text-xs text-gray-500 mt-0.5">Fill in the form and we'll reply to your email.</p>
                </div>

                <form id="public-ticket-create"
                      class="p-6 space-y-5">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>

                    <!-- Name + Email row -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label class="block text-xs font-medium text-gray-400" for="name">Full name</label>
                            <input type="text"
                                   id="name"
                                   name="name"
                                   value="{{ request.name }}"
                                   required
                                   placeholder="John Doe"
                                   class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
                        </div>
                        <div class="space-y-1.5">
                            <label class="block text-xs font-medium text-gray-400" for="email">Email address</label>
                            <input type="email"
                                   id="email"
                                   name="email"
                                   value="{{ request.email }}"
                                   required
                                   placeholder="john@example.com"
                                   class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
                        </div>
                    </div>

                    <!-- Subject -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-medium text-gray-400" for="subject">Subject</label>
                        <input type="text"
                               id="subject"
                               name="subject"
                               value="{{ request.subject }}"
                               required
                               placeholder="How can we help?"
                               class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
                    </div>

                    <!-- Message -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-medium text-gray-400" for="message">Message</label>
                        <textarea id="message"
                                  name="message"
                                  rows="6"
                                  required
                                  placeholder="Describe your issue or question in detail…"
                                  class="w-full px-3.5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent resize-none transition-all">{{ request.message }}</textarea>
                    </div>

                    <!-- Anti-spam hidden field (removed via JS) -->
                    <input type="hidden" name="anti-spam" value="1" id="anti-spam" required/>

                    {% if _rc_c.enabled %}
                    {% set _cp = _rc_c.captcha_provider|default('recaptcha_v2') %}
                    {% if _cp == 'turnstile' and _rc_c.turnstile_site_key %}
                    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
                    <div class="cf-turnstile mb-2" data-sitekey="{{ _rc_c.turnstile_site_key }}"></div>
                    {% elseif _cp == 'hcaptcha' and _rc_c.hcaptcha_site_key %}
                    <script src="https://js.hcaptcha.com/1/api.js" async defer></script>
                    <div class="h-captcha mb-2" data-sitekey="{{ _rc_c.hcaptcha_site_key }}"></div>
                    {% elseif _cp == 'recaptcha_v3' and _rc_c.publickey %}
                    <script src="https://www.google.com/recaptcha/api.js?render={{ _rc_c.publickey }}" async defer></script>
                    {% elseif _rc_c.publickey %}
                    <div class="mb-2">
                        <script src="https://www.google.com/recaptcha/api.js" async defer></script>
                        <div class="g-recaptcha" data-sitekey="{{ _rc_c.publickey }}" style="transform-origin:top left;"></div>
                    </div>
                    {% endif %}
                    {% endif %}

                    <!-- Submit -->
                    <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3 pt-1">
                        <p class="text-xs text-gray-600">We typically reply within 24 hours.</p>
                        <button type="submit"
                                class="public-contact-submit inline-flex items-center justify-center gap-2 w-full sm:w-auto px-6 py-2.5 rounded-lg text-white text-sm font-semibold whitespace-nowrap transition-all shadow-lg shadow-indigo-500/25"
                                style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
                            Send Message
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/>
                            </svg>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIGHT: Contact info + feature cards -->
        <div class="lg:col-span-2 space-y-5 lg:sticky lg:top-24 self-start">

            <!-- Company info card -->
            <div class="rounded-2xl bg-white/[0.03] border border-white/[0.08] p-6 space-y-4">
                <h3 class="text-sm font-semibold text-white">{{ company.name }}</h3>

                {% if company.address_1|default(false) %}
                <div class="flex items-start gap-3">
                    <div class="mt-0.5 flex-shrink-0 w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center">
                        <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                    </div>
                    <div class="text-sm text-gray-400 leading-relaxed">
                        {{ company.address_1|default('') }}{% if company.address_2|default(false) %}<br>{{ company.address_2 }}{% endif %}{% if company.address_3|default(false) %}<br>{{ company.address_3 }}{% endif %}
                    </div>
                </div>
                {% endif %}

                {% if company.tel|default(false) %}
                <div class="flex items-center gap-3">
                    <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center">
                        <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                    </div>
                    <a href="tel:{{ company.tel }}" class="text-sm text-gray-400 hover:text-white transition-colors">{{ company.tel }}</a>
                </div>
                {% endif %}

                {% if company.email|default(false) %}
                <div class="flex items-center gap-3">
                    <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center">
                        <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <a href="mailto:{{ company.email }}" class="text-sm text-gray-400 hover:text-white transition-colors">{{ company.email }}</a>
                </div>
                {% endif %}

                {% if company.www|default(false) %}
                <div class="flex items-center gap-3">
                    <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center">
                        <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                        </svg>
                    </div>
                    <a href="{{ company.www }}" target="_blank" rel="noopener" class="text-sm text-gray-400 hover:text-white transition-colors">{{ company.www }}</a>
                </div>
                {% endif %}
            </div>

            <!-- Feature cards -->
            <div class="rounded-2xl bg-white/[0.03] border border-white/[0.08] p-5 flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center">
                    <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div>
                    <h4 class="text-sm font-semibold text-white">24/7 Support</h4>
                    <p class="text-xs text-gray-500 mt-0.5 leading-relaxed">Our team is available around the clock to assist you with any issues.</p>
                </div>
            </div>

            <div class="rounded-2xl bg-white/[0.03] border border-white/[0.08] p-5 flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center">
                    <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
                <div>
                    <h4 class="text-sm font-semibold text-white">99.9% Uptime</h4>
                    <p class="text-xs text-gray-500 mt-0.5 leading-relaxed">We guarantee reliable infrastructure with zero data loss.</p>
                </div>
            </div>

            <div class="rounded-2xl bg-white/[0.03] border border-white/[0.08] p-5 flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center">
                    <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                </div>
                <div>
                    <h4 class="text-sm font-semibold text-white">Fast Response</h4>
                    <p class="text-xs text-gray-500 mt-0.5 leading-relaxed">Most tickets are answered within a few hours, not days.</p>
                </div>
            </div>

        </div>
    </div>
</section>

{% endblock %}

{% block js %}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var antiSpam = document.getElementById('anti-spam');
        if (antiSpam) antiSpam.remove();

        var form = document.getElementById('public-ticket-create');
        if (!form) return;

        form.addEventListener('submit', function (e) {
            e.preventDefault();

            var btn = form.querySelector('button[type="submit"]');
            var btnOriginal = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> Sending…';
            }

            var data = {
                name: form.querySelector('[name="name"]').value,
                email: form.querySelector('[name="email"]').value,
                subject: form.querySelector('[name="subject"]').value,
                message: form.querySelector('[name="message"]').value
            };

            function doPost() {
                API.guest.post('support/ticket_create', data, function (hash) {
                    window.location = "{{ 'support/contact/conversation'|url }}" + '/' + hash;
                }, function (err) {
                    FOSSBilling.message(err || 'An error occurred. Please try again.', 'error');
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = btnOriginal;
                    }
                });
            }

            {% if _rc_c.enabled and _rc_c.captcha_provider|default('recaptcha_v2') == 'recaptcha_v3' and _rc_c.publickey %}
            grecaptcha.ready(function () {
                grecaptcha.execute('{{ _rc_c.publickey }}', { action: 'SUBMIT_TICKET' }).then(function (token) {
                    data['g-recaptcha-response'] = token;
                    doPost();
                });
            });
            {% else %}
            var rcResp = (typeof grecaptcha !== 'undefined' && grecaptcha.getResponse) ? grecaptcha.getResponse() : '';
            if (rcResp) data['g-recaptcha-response'] = rcResp;
            doPost();
            {% endif %}
        });
    });
</script>
{% endblock %}
