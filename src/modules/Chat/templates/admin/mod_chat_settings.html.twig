{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ 'Chat Widget Settings'|trans }}{% endblock %}

{% set active_menu = 'extensions' %}

{% block content %}
{% set p = admin.extension_config_get({"ext":"mod_chat"}) %}
<form method="post" action="{{ 'extension/config_save'|api_url }}" {{ fb_api_form({message: 'Chat widget settings updated'|trans}) }}>
    <input type="hidden" name="ext" value="mod_chat"/>

    <div class="card">
        <div class="card-header"><h3 class="card-title">{{ 'Live Chat (Tawk.to)'|trans }}</h3></div>
        <div class="card-body">
            <p class="text-muted">{{ 'Find these in your Tawk.to dashboard under Administration → Chat Widget. The embed URL looks like https://embed.tawk.to/PROPERTY_ID/WIDGET_ID.'|trans }}</p>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">{{ 'WhatsApp number'|trans }}</label>
                    <input type="tel" class="form-control" name="whatsapp_number" maxlength="24" autocomplete="off" value="{{ p.whatsapp_number ?? '' }}" placeholder="+9779800000000"/>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">{{ 'Phone number'|trans }}</label>
                    <input type="tel" class="form-control" name="phone_number" maxlength="32" autocomplete="off" value="{{ p.phone_number ?? '' }}" placeholder="+977-1-4000000"/>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">{{ 'Tawk.to property ID'|trans }}</label>
                    <input type="text" class="form-control" name="tawk_property_id" maxlength="128" autocomplete="off" pattern="[A-Za-z0-9_-]+" value="{{ p.tawk_property_id ?? '' }}" placeholder="5xxxxxxxxxxxxxxxxxxxxxxx"/>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">{{ 'Tawk.to widget ID'|trans }}</label>
                    <input type="text" class="form-control" name="tawk_widget_id" maxlength="128" autocomplete="off" pattern="[A-Za-z0-9_-]+" value="{{ p.tawk_widget_id ?? '' }}" placeholder="default"/>
                </div>
            </div>
            <div class="alert alert-info mb-0" role="note">
                {{ 'The guest API returns only the two public Tawk identifiers, sanitized phone number, and validated WhatsApp link. It does not expose FOSSBilling sessions or customer identity.'|trans }}
            </div>
            {# Clear legacy Secure Mode secrets when these settings are next saved. #}
            <input type="hidden" name="tawk_api_key" value=""/>
        </div>
    </div>

    <div class="mt-3 text-end">
        <button type="submit" class="btn btn-primary">{{ 'Save settings'|trans }}</button>
    </div>
</form>
{% endblock %}
