{#
  MeroPanel Chat widget — rendered via the theme widget slot (client.theme.body.end).
  render_widgets() renders this with an EMPTY context and `guest` is not a Twig global
  in the client environment, so the config is fetched from the module's own guest
  endpoint (/api/guest/chat/config) and the widget builds itself client-side. This keeps
  the module fully self-contained: no theme edits, no core edits, works on every page.
#}
{% verbatim %}
<style>
/* ---- MeroPanel Chat widget (self-contained, theme-independent) ---- */
#mchat-root{--mchat-primary:var(--color-primary,#5271ff);--mchat-secondary:var(--color-secondary,#224dda);--mchat-primary-rgb:var(--color-primary-rgb,82,113,255);--mchat-radius:var(--radius-xl,20px);position:fixed;right:24px;bottom:24px;z-index:99998;font-family:var(--font-brand-sans,"Inter"),ui-sans-serif,system-ui,-apple-system,sans-serif;}
#mchat-panel{position:absolute;right:0;bottom:76px;width:360px;height:520px;max-width:calc(100vw - 32px);max-height:calc(100vh - 120px);display:flex;flex-direction:column;
  background:#ffffff;border:1px solid rgba(var(--mchat-primary-rgb),.1);border-radius:var(--mchat-radius);overflow:hidden;
  box-shadow:0 20px 48px rgba(15,23,42,.24),0 4px 12px rgba(15,23,42,.10);
  opacity:0;transform:translateY(12px) scale(.98);pointer-events:none;
  transition:opacity .18s ease,transform .18s ease;transform-origin:bottom right;}
#mchat-root.mchat-open #mchat-panel{opacity:1;transform:translateY(0) scale(1);pointer-events:auto;}
.mchat-head{position:relative;flex:0 0 auto;padding:22px 20px 20px;color:#fff;overflow:hidden;
  background:linear-gradient(135deg,var(--mchat-primary),var(--mchat-secondary));}
/* Keep white header copy accessible when an administrator selects a very
   bright brand color, while retaining the configured hue. */
@supports (color:color-mix(in srgb,#000,#fff)){
  .mchat-head{background:linear-gradient(135deg,color-mix(in srgb,var(--mchat-primary) 80%,#07111f),color-mix(in srgb,var(--mchat-secondary) 86%,#07111f));}
}
.mchat-head-orb{position:absolute;top:-30px;right:-20px;width:96px;height:96px;border-radius:50%;
  background:rgba(255,255,255,.14);}
.mchat-head h4{margin:0;font-size:15px;font-weight:700;line-height:1.2;}
.mchat-head .mchat-sub{margin:2px 0 0;font-size:12px;opacity:.8;}
.mchat-head .mchat-greet{margin:16px 0 0;font-size:17px;font-weight:700;position:relative;}
.mchat-online{display:inline-flex;align-items:center;gap:6px;margin-top:10px;font-size:12px;font-weight:500;position:relative;}
.mchat-online i{width:8px;height:8px;border-radius:50%;background:#34d399;box-shadow:0 0 0 3px rgba(52,211,153,.25);}
.mchat-online.mchat-away i{background:#f59e0b;box-shadow:0 0 0 3px rgba(245,158,11,.25);}
.mchat-online.mchat-offline i{background:#94a3b8;box-shadow:0 0 0 3px rgba(148,163,184,.25);}
.mchat-badge{position:absolute;top:-2px;right:-2px;min-width:20px;height:20px;padding:0 5px;border-radius:10px;background:#ef4444;color:#fff;font-size:11px;font-weight:700;line-height:1;display:none;align-items:center;justify-content:center;box-shadow:0 0 0 2px #fff;}
.mchat-badge.mchat-show{display:flex;}
html[data-theme="dark"] .mchat-badge{box-shadow:0 0 0 2px #0b1120;}
.mchat-body{min-height:0;padding:12px;display:flex;flex:1 1 auto;flex-direction:column;gap:8px;overflow-y:auto;background:#f4f6fb;scrollbar-width:thin;scrollbar-color:rgba(var(--mchat-primary-rgb),.24) transparent;}
.mchat-row{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:14px;
  background:#fff;border:1px solid #eef1f6;text-decoration:none;transition:background .15s,box-shadow .15s,transform .05s;cursor:pointer;}
.mchat-row:hover{background:#f9fafc;box-shadow:0 4px 14px rgba(15,23,42,.06);}
.mchat-row:active{transform:scale(.99);}
.mchat-row:focus-visible{outline:3px solid rgba(var(--mchat-primary-rgb),.2);outline-offset:2px;}
.mchat-row.mchat-loading{opacity:.72;pointer-events:none;}
.mchat-row.mchat-loading .mchat-ico svg{animation:mchat-pulse .9s ease-in-out infinite alternate;}
.mchat-ico{width:42px;height:42px;border-radius:12px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;color:#fff;}
.mchat-ico svg{width:22px;height:22px;}
.mchat-ico.wa{background:#25d366;} .mchat-ico.call{background:var(--mchat-secondary);} .mchat-ico.live{background:var(--mchat-primary);} .mchat-ico.ticket{background:linear-gradient(135deg,var(--mchat-primary),var(--mchat-secondary));}
.mchat-txt{flex:1 1 auto;min-width:0;}
.mchat-txt b{display:block;font-size:14px;font-weight:600;color:#0f172a;line-height:1.2;}
.mchat-txt span{display:block;font-size:12px;color:#64748b;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.mchat-live-availability{display:flex!important;align-items:center;gap:6px;}
.mchat-availability-dot{width:7px;height:7px;flex:0 0 auto;border-radius:50%;background:#22c55e;box-shadow:0 0 0 0 rgba(34,197,94,.42);animation:mchat-available-pulse 1.8s ease-out infinite;}
.mchat-live-availability.is-away .mchat-availability-dot{background:#f59e0b;animation:none;box-shadow:none;}
.mchat-live-availability.is-offline .mchat-availability-dot{background:#94a3b8;animation:none;box-shadow:none;}
.mchat-chev{color:#cbd5e1;flex:0 0 auto;}
#mchat-launcher{position:relative;width:60px;height:60px;border:0;border-radius:50%;cursor:pointer;margin-left:auto;
  display:flex;align-items:center;justify-content:center;color:#fff;
  background:linear-gradient(135deg,var(--mchat-primary),var(--mchat-secondary));
  box-shadow:0 10px 26px rgba(var(--mchat-primary-rgb),.36);transition:transform .15s ease,box-shadow .15s ease,filter .15s ease;}
#mchat-launcher:hover{transform:translateY(-2px);filter:saturate(1.08) brightness(1.03);box-shadow:0 14px 30px rgba(var(--mchat-primary-rgb),.46);}
#mchat-launcher:focus-visible{outline:3px solid rgba(var(--mchat-primary-rgb),.3);outline-offset:4px;}
#mchat-launcher svg{width:26px;height:26px;transition:transform .2s ease;}
#mchat-launcher .mchat-ic-close{display:none;}
#mchat-root.mchat-open #mchat-launcher .mchat-ic-open{display:none;}
#mchat-root.mchat-open #mchat-launcher .mchat-ic-close{display:block;}
#mchat-root.mchat-tawk-open{pointer-events:none;}
#mchat-root.mchat-tawk-open #mchat-launcher{opacity:0;transform:translateY(8px) scale(.9);pointer-events:none;}
html[data-theme="dark"] #mchat-panel{background:#0f172a;border-color:rgba(var(--mchat-primary-rgb),.18);box-shadow:0 20px 48px rgba(0,0,0,.5);}
html[data-theme="dark"] .mchat-body{background:color-mix(in srgb,#0b1120 94%,var(--mchat-primary));}
html[data-theme="dark"] .mchat-row{background:color-mix(in srgb,#111c33 95%,var(--mchat-primary));border-color:rgba(var(--mchat-primary-rgb),.13);}
html[data-theme="dark"] .mchat-row:hover{background:color-mix(in srgb,#16233f 90%,var(--mchat-primary));border-color:rgba(var(--mchat-primary-rgb),.25);}
html[data-theme="dark"] .mchat-txt b{color:#f1f5f9;}
html[data-theme="dark"] .mchat-txt span{color:#94a3b8;}
html[data-theme="dark"] .mchat-chev{color:#475569;}
@keyframes mchat-pulse{to{opacity:.45;transform:scale(.88);}}
@keyframes mchat-available-pulse{0%{box-shadow:0 0 0 0 rgba(34,197,94,.42)}70%,100%{box-shadow:0 0 0 7px rgba(34,197,94,0)}}
@media (max-width:480px){#mchat-root{right:max(16px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));}#mchat-panel{width:min(360px,calc(100vw - 32px));height:min(520px,calc(100vh - 120px));}}
@media (prefers-reduced-motion:reduce){#mchat-panel,#mchat-launcher,#mchat-launcher svg,.mchat-row{transition-duration:.01ms!important;transform:none!important;}.mchat-availability-dot{animation:none!important;}}
</style>

<script>
(function(){
    if (window.__mchatInit) { return; }
    window.__mchatInit = true;

    var CHEV = '<svg class="mchat-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>';
    var IC = {
        wa: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.86 9.86 0 0 0 4.76 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.8c2.16 0 4.19.84 5.72 2.37a8.06 8.06 0 0 1 2.37 5.73c0 4.46-3.63 8.09-8.1 8.09a8.1 8.1 0 0 1-4.12-1.13l-.3-.18-3.13.82.83-3.05-.19-.31a8.03 8.03 0 0 1-1.24-4.31c0-4.46 3.63-8.1 8.1-8.1Zm-2.6 4.03c-.13 0-.35.05-.53.25-.18.2-.7.68-.7 1.66 0 .98.72 1.93.82 2.06.1.13 1.4 2.24 3.46 3.05 1.72.68 2.07.54 2.44.5.37-.03 1.2-.49 1.36-.96.17-.47.17-.87.12-.96-.05-.08-.18-.13-.38-.23-.2-.1-1.2-.59-1.38-.66-.18-.07-.32-.1-.46.1-.13.2-.53.66-.65.8-.12.13-.24.15-.44.05-.2-.1-.85-.31-1.62-1-.6-.53-1-1.19-1.12-1.39-.12-.2-.01-.31.09-.41.09-.09.2-.24.3-.36.1-.12.13-.2.2-.34.06-.13.03-.25-.02-.35-.05-.1-.44-1.1-.62-1.5-.16-.4-.32-.34-.44-.34l-.38-.01Z"/></svg>',
        call: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>',
        live: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
        ticket: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v12H7l-3 3V4Z"/><path d="M8 8h8M8 12h5"/></svg>'
    };
    function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(m){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]; }); }

    function build(c){
        if (!c || (!(c.tawk_property_id && c.tawk_widget_id) && !c.phone_number && !c.whatsapp_url)) { return; }

        var rows = '';
        if (c.whatsapp_url){
            rows += '<a class="mchat-row" href="' + esc(c.whatsapp_url) + '" target="_blank" rel="noopener noreferrer">'
                 + '<span class="mchat-ico wa">' + IC.wa + '</span><div class="mchat-txt"><b>WhatsApp</b><span>Send us a message</span></div>' + CHEV + '</a>';
        }
        if (c.phone_number){
            rows += '<a class="mchat-row" href="tel:' + esc(c.phone_number) + '">'
                 + '<span class="mchat-ico call">' + IC.call + '</span><div class="mchat-txt"><b>Call our agent</b><span>' + esc(c.phone_number) + '</span></div>' + CHEV + '</a>';
        }
        if (c.tawk_property_id && c.tawk_widget_id){ rows += '<a class="mchat-row" id="mchat-live" href="#" role="button"'
             + ' data-tawk-property="' + esc(c.tawk_property_id) + '" data-tawk-widget="' + esc(c.tawk_widget_id) + '">'
             + '<span class="mchat-ico live">' + IC.live + '</span>'
             + '<div class="mchat-txt"><b>Live Chat</b><span id="mchat-live-status" class="mchat-live-availability"><i class="mchat-availability-dot" aria-hidden="true"></i><span id="mchat-live-status-text">Agents Available</span></span></div>' + CHEV + '</a>'; }
        rows += '<a class="mchat-row" href="/support">'
             + '<span class="mchat-ico ticket">' + IC.ticket + '</span>'
             + '<div class="mchat-txt"><b>Support Ticket</b><span>Send a request and track replies</span></div>' + CHEV + '</a>';

        var online = '<span class="mchat-online" id="mchat-status"><i></i> <span class="mchat-status-txt">We\'re online</span></span>';

        var root = document.createElement('div');
        root.id = 'mchat-root';
        root.innerHTML =
            '<div id="mchat-panel" role="dialog" aria-modal="false" aria-labelledby="mchat-title">'
          +   '<div class="mchat-head"><div class="mchat-head-orb"></div>'
          +     '<h4 id="mchat-title">Support Team</h4><p class="mchat-sub">Typically replies in minutes</p><p class="mchat-greet">Hi! How can we help? 👋</p>' + online
          +   '</div>'
          +   '<div class="mchat-body">' + rows + '</div>'
          + '</div>'
          + '<button id="mchat-launcher" type="button" aria-label="Open support chat" aria-expanded="false">'
          +   '<svg class="mchat-ic-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>'
          +   '<svg class="mchat-ic-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>'
          +   '<span class="mchat-badge" id="mchat-badge"></span>'
          + '</button>';
        document.body.appendChild(root);

        var launcher = root.querySelector('#mchat-launcher');
        function setOpen(open){
            root.classList.toggle('mchat-open', open);
            launcher.setAttribute('aria-expanded', open ? 'true' : 'false');
            launcher.setAttribute('aria-label', open ? 'Close support menu' : 'Open support menu');
            if (open){ var firstAction = root.querySelector('.mchat-row'); if (firstAction){ window.setTimeout(function(){ firstAction.focus(); }, 190); } }
        }
        launcher.addEventListener('click', function(){
            var willOpen = !root.classList.contains('mchat-open');
            if (willOpen && window.Tawk_API){
                try {
                    if (typeof window.Tawk_API.isChatMaximized === 'function' && window.Tawk_API.isChatMaximized() && typeof window.Tawk_API.minimize === 'function'){
                        window.Tawk_API.minimize();
                    }
                    if (typeof window.Tawk_API.hideWidget === 'function'){ window.Tawk_API.hideWidget(); }
                } catch(err){}
                root.classList.remove('mchat-tawk-open');
            }
            setOpen(willOpen);
        });
        document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && root.classList.contains('mchat-open')){ setOpen(false); launcher.focus(); } });
        document.addEventListener('click', function(e){ if (!root.contains(e.target)){ setOpen(false); } });

        var live = root.querySelector('#mchat-live');
        if (live){
            var statusEl = root.querySelector('#mchat-status');
            var badgeEl = root.querySelector('#mchat-badge');
            var liveStatusEl = root.querySelector('#mchat-live-status');
            var liveStatusText = root.querySelector('#mchat-live-status-text');
            var tawkLoaded = false;
            var pendingMaximize = false;
            var loadTimer = null;

            // Reflect Tawk's real online/away/offline status onto our header dot.
            function applyStatus(status){
                if (statusEl){
                    statusEl.classList.remove('mchat-away', 'mchat-offline');
                    var txt = statusEl.querySelector('.mchat-status-txt');
                    if (status === 'away'){ statusEl.classList.add('mchat-away'); if (txt){ txt.textContent = "We're away"; } }
                    else if (status === 'offline'){ statusEl.classList.add('mchat-offline'); if (txt){ txt.textContent = "We're offline"; } }
                    else if (txt){ txt.textContent = "We're online"; }
                }
                if (liveStatusEl){ liveStatusEl.classList.toggle('is-away', status === 'away'); liveStatusEl.classList.toggle('is-offline', status === 'offline'); }
                if (liveStatusText){ liveStatusText.textContent = status === 'offline' ? 'Offline — leave us a message' : (status === 'away' ? 'Agents are away' : 'Agents Available'); }
            }
            // Unread agent messages -> badge on our launcher (while Tawk is minimized/hidden).
            function applyUnread(count){
                if (!badgeEl) { return; }
                var n = parseInt(count, 10) || 0;
                badgeEl.textContent = n > 9 ? '9+' : String(n);
                badgeEl.classList.toggle('mchat-show', n > 0);
            }

            function loadTawk(){
                if (tawkLoaded){ return; }
                tawkLoaded = true;
                var api = window.Tawk_API = window.Tawk_API || {};
                window.Tawk_LoadStart = new Date();

                // Tawk customStyle officially supports zIndex only and must be set
                // before the embed downloads. Keep it directly below our launcher;
                // the launcher is hidden while the Tawk conversation is maximized.
                api.customStyle = { zIndex: '99997 !important' };

                api.onLoad = function(){
                    try {
                        if (loadTimer){ window.clearTimeout(loadTimer); loadTimer = null; }
                        live.classList.remove('mchat-loading');
                        api.hideWidget(); // keep OUR launcher as the only launcher
                        if (typeof api.getStatus === 'function'){ applyStatus(api.getStatus()); }
                        if (pendingMaximize){ api.maximize(); }
                    } catch(err){}
                };
                api.onStatusChange = function(status){ applyStatus(status); };
                function restoreModuleLauncher(){
                    // hideWidget() fires during initial setup immediately before a
                    // requested maximize. Do not expose our launcher in that gap.
                    if (pendingMaximize){ return; }
                    try {
                        if (typeof api.isChatMaximized === 'function' && api.isChatMaximized()){
                            root.classList.add('mchat-tawk-open');
                            return;
                        }
                    } catch(err){}
                    root.classList.remove('mchat-tawk-open');
                    live.classList.remove('mchat-loading');
                    try { api.hideWidget(); } catch(err){}
                }
                api.onChatMinimized = restoreModuleLauncher;
                api.onChatHidden = restoreModuleLauncher;
                api.onChatMaximized = function(){ pendingMaximize = false; setOpen(false); live.classList.remove('mchat-loading'); root.classList.add('mchat-tawk-open'); applyUnread(0); };
                api.onUnreadCountChanged = function(count){ applyUnread(count); };

                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://embed.tawk.to/' + live.getAttribute('data-tawk-property') + '/' + live.getAttribute('data-tawk-widget');
                s.charset = 'UTF-8';
                s.crossOrigin = 'anonymous';
                // Do not disclose the client's full account/order URL to Tawk.
                s.referrerPolicy = 'origin';
                s.onerror = function(){
                    if (loadTimer){ window.clearTimeout(loadTimer); loadTimer = null; }
                    tawkLoaded = false;
                    pendingMaximize = false;
                    root.classList.remove('mchat-tawk-open');
                    live.classList.remove('mchat-loading');
                    if (liveStatusText){ liveStatusText.textContent = 'Chat unavailable — use a ticket'; }
                };
                document.head.appendChild(s);
                loadTimer = window.setTimeout(function(){
                    if (!pendingMaximize){ return; }
                    pendingMaximize = false;
                    root.classList.remove('mchat-tawk-open');
                    live.classList.remove('mchat-loading');
                    if (liveStatusText){ liveStatusText.textContent = 'Still connecting — try again'; }
                }, 12000);
            }

            live.addEventListener('click', function(e){
                e.preventDefault();
                setOpen(false);
                root.classList.add('mchat-tawk-open');
                live.classList.add('mchat-loading');
                if (liveStatusText){ liveStatusText.textContent = 'Agents Available'; }
                if (tawkLoaded && window.Tawk_API && typeof window.Tawk_API.maximize === 'function'){
                    window.Tawk_API.maximize();
                } else {
                    pendingMaximize = true;
                    loadTawk();
                }
            });
        }
    }

    function init(){
        fetch('/api/guest/chat/config', { headers: { 'Accept': 'application/json' }, credentials: 'omit', cache: 'no-store' })
            .then(function(r){ if (!r.ok){ throw new Error('Chat configuration unavailable'); } return r.json(); })
            .then(function(d){ build(d && d.result ? d.result : null); })
            .catch(function(){ /* silently skip if unreachable */ });
    }
    if (document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', init); } else { init(); }
})();
</script>
{% endverbatim %}
