{% block subject %}[{{ guest.system_company.name }}] Payment Received for Invoice {{ invoice.serie_nr|default(invoice.id|default('')) }}{% endblock %}
{% block content %}
<!doctype html>
<html lang="en" data-fb-email-shell="modern">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="x-apple-disable-message-reformatting">
    <title>Payment received by {{ guest.system_company.name }}</title>
</head>
<body style="margin:0;padding:0;background-color:#edf3f8;color:#172033;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;-webkit-text-size-adjust:100%;">
    <div itemscope itemtype="http://schema.org/Invoice" style="display:none!important;max-height:0;overflow:hidden;mso-hide:all;">
        <meta itemprop="accountId" content="{{ c.id|default(c.email|default('')) }}">
        <meta itemprop="confirmationNumber" content="{{ invoice.serie_nr|default(invoice.id|default('')) }}">
        <meta itemprop="paymentStatus" content="PaymentComplete">
        <div itemprop="provider" itemscope itemtype="http://schema.org/Organization"><meta itemprop="name" content="{{ guest.system_company.name }}"></div>
        <div itemprop="customer" itemscope itemtype="http://schema.org/Person">
            <meta itemprop="name" content="{{ c.first_name|default('') }} {{ c.last_name|default('') }}">
            <meta itemprop="email" content="{{ c.email|default('') }}">
        </div>
        <div itemprop="totalPaymentDue" itemscope itemtype="http://schema.org/PriceSpecification">
            <meta itemprop="price" content="{{ invoice.total|default(0) }}">
            <meta itemprop="priceCurrency" content="{{ invoice.currency|default(default_currency) }}">
        </div>
    </div>
    <div style="display:none!important;max-height:0;max-width:0;overflow:hidden;opacity:0;color:transparent;mso-hide:all;">Payment received for invoice {{ invoice.serie_nr|default(invoice.id|default('')) }}. Thank you.</div>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background-color:#edf3f8;">
        <tr><td align="center" style="padding:36px 16px;">
            <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;">
                <tr><td align="center" style="padding:4px 24px 28px;">
                    <!--FB_EMAIL_LOGO-->
                </td></tr>

                <tr><td style="border-top:4px solid #16a36a;border-radius:16px 16px 0 0;background-color:#fff;padding:38px 40px 22px;">
                    <div style="margin-bottom:12px;color:#128158;font-size:12px;font-weight:700;line-height:18px;letter-spacing:1.2px;text-transform:uppercase;">Payment confirmed</div>
                    <h1 style="margin:0;color:#111827;font-size:28px;font-weight:750;line-height:36px;letter-spacing:-.7px;">Thank you — payment received</h1>
                    <p style="margin:16px 0 0;color:#56637a;font-size:16px;line-height:25px;">Hi {{ c.first_name|default('there') }}, your payment has been successfully applied to the invoice below.</p>
                </td></tr>

                <tr><td style="background-color:#fff;padding:0 40px 28px;">
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border:1px solid #cfeade;border-radius:12px;background-color:#f2fbf7;">
                        <tr>
                            <td style="padding:22px 24px;">
                                <div style="color:#568070;font-size:11px;font-weight:700;line-height:16px;letter-spacing:1px;text-transform:uppercase;">Total paid</div>
                                <div style="margin-top:5px;color:#10251e;font-size:28px;font-weight:800;line-height:36px;letter-spacing:-.7px;">{{ invoice.total|default(0)|format_currency(invoice.currency|default(default_currency)) }}</div>
                            </td>
                            <td align="right" style="padding:22px 24px;border-left:1px solid #cfeade;">
                                <div style="color:#568070;font-size:11px;font-weight:700;line-height:16px;letter-spacing:1px;text-transform:uppercase;">Status</div>
                                <div style="margin-top:7px;color:#128158;font-size:16px;font-weight:750;line-height:24px;">Paid</div>
                            </td>
                        </tr>
                    </table>
                </td></tr>

                <tr><td style="background-color:#fff;padding:0 40px 30px;">
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;">
                        <tr>
                            <td style="padding:11px 0;border-bottom:1px solid #edf0f5;color:#7a879a;font-size:14px;">Invoice number</td>
                            <td align="right" style="padding:11px 0;border-bottom:1px solid #edf0f5;color:#172033;font-size:14px;font-weight:700;">{{ invoice.serie_nr|default(invoice.id|default('')) }}</td>
                        </tr>
                        <tr>
                            <td style="padding:11px 0;border-bottom:1px solid #edf0f5;color:#7a879a;font-size:14px;">Paid on</td>
                            <td align="right" style="padding:11px 0;border-bottom:1px solid #edf0f5;color:#172033;font-size:14px;font-weight:650;">{{ invoice.paid_at|default('')|format_date }}</td>
                        </tr>
                        {% if invoice.orders|default([])|length > 0 %}
                            {% for order in invoice.orders|default([]) %}
                            <tr>
                                <td style="padding:11px 0;border-bottom:1px solid #edf0f5;color:#7a879a;font-size:14px;">{{ order.product_name|default('Order') }}</td>
                                <td align="right" style="padding:11px 0;border-bottom:1px solid #edf0f5;color:#172033;font-size:14px;font-weight:650;">#{{ order.id }}</td>
                            </tr>
                            {% endfor %}
                        {% endif %}
                    </table>
                </td></tr>

                <tr><td align="center" style="background-color:#fff;padding:0 40px 36px;">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0"><tr><td align="center" style="border-radius:10px;background-color:#3158e8;">
                        <a href="{{ "invoice/#{invoice.hash|default('')}"|url(area: 'client') }}" target="_blank" style="display:inline-block;min-width:180px;padding:14px 22px;color:#fff;font-size:15px;font-weight:700;line-height:20px;text-align:center;text-decoration:none;border-radius:10px;">View payment receipt</a>
                    </td></tr></table>
                    <p style="margin:18px 0 0;color:#7a879a;font-size:13px;line-height:20px;"><a href="{{ "invoice/pdf/#{invoice.hash|default('')}"|url(area: 'client') }}" target="_blank" style="color:#3158e8;font-weight:650;text-decoration:none;">Download PDF receipt</a></p>
                </td></tr>

                <tr><td style="border-top:1px solid #e8ecf3;border-radius:0 0 16px 16px;background-color:#f9fafc;padding:24px 40px;color:#6d788c;font-size:13px;line-height:20px;">
                    <div style="color:#253047;font-weight:700;">Payment successfully processed</div>
                    <div style="margin-top:5px;">No further action is required. Keep this email for your records.</div>
                    <div style="margin-top:16px;color:#8a95a7;">{{ guest.system_email.signature }}</div>
                </td></tr>
                <tr><td align="center" style="padding:24px 24px 0;color:#7d899b;font-size:12px;line-height:18px;">This is a transactional payment receipt from {{ guest.system_company.name }}.</td></tr>
            </table>
        </td></tr>
    </table>
</body>
</html>
{% endblock %}
