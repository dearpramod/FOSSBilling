{% block subject %}[{{ guest.system_company.name }}] Password Changed{% endblock %}
{% block content %}
{% set _co = guest.system_company %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body style="margin:0;padding:0;background-color:#f1f5f9;font-family:Arial,Helvetica,sans-serif">

<table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;background-color:#f1f5f9">
    <tr>
        <td align="center" style="padding:30px 16px">

            <!-- ===== HEADER ===== -->
            <table width="600" cellspacing="0" cellpadding="0" align="center" style="border-collapse:collapse;background-color:#ffffff;border-bottom:2px solid #e2e8f0;border-radius:12px 12px 0 0;overflow:hidden">
                <tr>
                    <td style="padding:20px 28px">
                        <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse">
                            <tr>
                                <td align="left" valign="middle">
                                    {% if _co.logo_url|default %}
                                    <a href="{{ _co.www }}" target="_blank"><img src="{{ _co.logo_url }}" alt="{{ _co.name }}" style="max-height:48px;max-width:180px;border:0;display:inline-block;vertical-align:middle;"></a>
                                    {% else %}
                                    <span style="font-size:20px;font-weight:bold;color:#0f172a;letter-spacing:-0.3px">{{ _co.name }}</span>
                                    {% endif %}
                                </td>
                                <td align="right" valign="middle">
                                    <a href="{{ 'admin'|alink }}" style="background-color:#0f172a;color:#ffffff;text-decoration:none;font-size:13px;font-weight:bold;padding:10px 18px;border-radius:6px;display:inline-block">Admin Panel</a>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- ===== BODY CARD ===== -->
            <table width="600" cellspacing="0" cellpadding="0" align="center" style="border-collapse:collapse;background-color:#ffffff">
                <tr>
                    <td style="padding:32px 28px;color:#1e293b;font-size:15px;line-height:1.6">
<h1>Password reset</h1>
    <p>Hello {{ staff.name }},</p>
    <p>Your password has been changed.</p>
    
    <p><a href="{{'admin/staff/login'|link({'email' : c.email }) }}" target="_blank">Click here to login.</a>

                    </td>
                </tr>
            </table>

            <!-- ===== FOOTER ===== -->
            <table width="600" cellspacing="0" cellpadding="0" align="center" style="border-collapse:collapse;background-color:#0f172a;border-radius:0 0 12px 12px;overflow:hidden">
                <tr>
                    <td style="padding:28px;text-align:center">
                        {% if _co.logo_url|default %}
                        <p style="margin:0 0 12px;"><a href="{{ _co.www }}" target="_blank"><img src="{{ _co.logo_url }}" alt="{{ _co.name }}" style="max-height:40px;max-width:160px;border:0;display:inline-block;filter:brightness(0) invert(1);opacity:0.9;"></a></p>
                        {% else %}
                        <p style="margin:0 0 12px;font-size:16px;font-weight:bold;color:#f8fafc">{{ _co.name }}</p>
                        {% endif %}
                        {% if _co.tel or _co.email %}
                        <p style="margin:0 0 5px;font-size:12px;color:#94a3b8">{% if _co.tel %}{{ _co.tel }}{% endif %}{% if _co.tel and _co.email %} &bull; {% endif %}{% if _co.email %}<a href="mailto:{{ _co.email }}" style="color:#94a3b8;text-decoration:none;">{{ _co.email }}</a>{% endif %}</p>
                        {% endif %}
                        {% if _co.address_1 %}<p style="margin:0 0 12px;font-size:12px;color:#94a3b8">{{ _co.address_1 }}{% if _co.city %}, {{ _co.city }}{% endif %}{% if _co.state %}, {{ _co.state }}{% endif %}{% if _co.country %}, {{ _co.country }}{% endif %}</p>{% endif %}
                        <p style="margin:0;font-size:11px;color:#475569">&copy; {{ "now"|date("Y") }} {{ _co.name }}. All rights reserved.</p>
                    </td>
                </tr>
            </table>

        </td>
    </tr>
</table>

</body>
</html>
{% endblock %}
