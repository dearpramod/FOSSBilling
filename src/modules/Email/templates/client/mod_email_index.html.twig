{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}Email History{% endblock %}

{% set currentPage = request.page|default(1) %}
{% set emails = client.email_get_list({"per_page": 20, "page": currentPage}) %}

{% block content %}

{# Page header #}
<div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Email History</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Review all transactional communications sent to your account.</p>
    </div>
</div>

{# Email list card #}
<div class="bg-white dark:bg-white/[0.03] rounded-xl border border-slate-200 dark:border-white/[0.08] shadow-sm overflow-hidden">

    {% if emails.list is empty %}
        <div class="px-6 py-20 text-center">
            <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4 bg-amber-50 dark:bg-amber-400/10 border border-amber-200 dark:border-amber-400/20">
                <svg class="w-7 h-7 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
            </div>
            <p class="text-slate-600 dark:text-slate-400 font-medium">No emails yet</p>
            <p class="text-slate-400 dark:text-slate-500 text-sm mt-1">Emails sent to your account will appear here.</p>
        </div>

    {% else %}

        {# Table header #}
        <div class="hidden md:grid grid-cols-12 gap-4 px-6 py-3 border-b border-slate-100 dark:border-white/[0.06] bg-slate-50 dark:bg-white/[0.02]">
            <div class="col-span-6 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Subject</div>
            <div class="col-span-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Sender</div>
            <div class="col-span-2 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Date Sent</div>
            <div class="col-span-1 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider text-right">Action</div>
        </div>

        {# Email rows #}
        <div class="divide-y divide-slate-100 dark:divide-white/[0.04]">
            {% for email in emails.list %}
            <div class="grid grid-cols-12 gap-3 items-center px-6 py-4 hover:bg-slate-50 dark:hover:bg-white/[0.02] transition-colors group">

                {# Subject + preview #}
                <div class="col-span-10 md:col-span-6 min-w-0">
                    <div class="flex items-start gap-3">
                        <div class="mt-0.5 flex-shrink-0 w-8 h-8 rounded-lg bg-slate-100 dark:bg-white/[0.06] flex items-center justify-center">
                            <svg class="w-4 h-4 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-slate-900 dark:text-white truncate">{{ email.subject|default('(No Subject)') }}</p>
                            <p class="text-xs text-slate-400 dark:text-slate-500 truncate mt-0.5 md:hidden">{{ email.sender }} · {{ email.created_at|date("M j, Y") }}</p>
                        </div>
                    </div>
                </div>

                {# Sender — hidden on mobile #}
                <div class="col-span-3 hidden md:flex items-center gap-2 min-w-0">
                    <div class="flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-white text-[10px] font-bold"
                         style="background: var(--color-primary);">
                        {{ email.sender|first|upper }}
                    </div>
                    <p class="text-sm text-slate-500 dark:text-slate-400 truncate">{{ email.sender }}</p>
                </div>

                {# Date — hidden on mobile #}
                <div class="col-span-2 hidden md:block">
                    <p class="text-sm text-slate-500 dark:text-slate-400">{{ email.created_at|date("M j, Y") }}</p>
                    <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">{{ email.created_at|date("g:i A") }}</p>
                </div>

                {# Action #}
                <div class="col-span-2 md:col-span-1 flex justify-end">
                    <a href="{{ 'email'|link }}/{{ email.id }}"
                       class="text-xs font-semibold transition-colors whitespace-nowrap"
                       style="color: var(--color-primary);">
                        View Email
                    </a>
                </div>

            </div>
            {% endfor %}
        </div>

        {# Pagination #}
        {% if emails.pages >= 2 %}
        {% set totalStart = (currentPage - 1) * 20 + 1 %}
        {% set totalEnd = currentPage * 20 < emails.total ? currentPage * 20 : emails.total %}
        <div class="px-6 py-4 border-t border-slate-100 dark:border-white/[0.06] flex flex-wrap items-center justify-between gap-3 bg-slate-50 dark:bg-white/[0.02]">
            <p class="text-sm text-slate-500 dark:text-slate-400">
                Showing {{ totalStart }}–{{ totalEnd }} of {{ emails.total }} emails
            </p>
            <div class="flex items-center gap-1">
                {% if currentPage > 1 %}
                    <a href="?page={{ currentPage - 1 }}"
                       class="px-3 py-1.5 text-sm text-slate-600 dark:text-slate-400 bg-white dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.08] rounded-lg hover:bg-slate-50 dark:hover:bg-white/[0.08] transition-colors">← Previous</a>
                {% else %}
                    <span class="px-3 py-1.5 text-sm text-slate-300 dark:text-slate-600 bg-slate-50 dark:bg-white/[0.02] border border-slate-100 dark:border-white/[0.04] rounded-lg cursor-not-allowed">← Previous</span>
                {% endif %}

                {% for p in 1..emails.pages %}
                    {% if p == currentPage %}
                        <span class="w-8 h-8 flex items-center justify-center rounded-lg text-sm text-white font-semibold"
                              style="background: var(--color-primary);">{{ p }}</span>
                    {% elseif p == 1 or p == emails.pages or (p >= currentPage - 1 and p <= currentPage + 1) %}
                        <a href="?page={{ p }}"
                           class="w-8 h-8 flex items-center justify-center rounded-lg text-sm text-slate-600 dark:text-slate-400 bg-white dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.08] hover:bg-slate-50 dark:hover:bg-white/[0.08] transition-colors">{{ p }}</a>
                    {% elseif p == currentPage - 2 or p == currentPage + 2 %}
                        <span class="w-8 h-8 flex items-center justify-center text-sm text-slate-400">…</span>
                    {% endif %}
                {% endfor %}

                {% if currentPage < emails.pages %}
                    <a href="?page={{ currentPage + 1 }}"
                       class="px-3 py-1.5 text-sm text-slate-600 dark:text-slate-400 bg-white dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.08] rounded-lg hover:bg-slate-50 dark:hover:bg-white/[0.08] transition-colors">Next →</a>
                {% else %}
                    <span class="px-3 py-1.5 text-sm text-slate-300 dark:text-slate-600 bg-slate-50 dark:bg-white/[0.02] border border-slate-100 dark:border-white/[0.04] rounded-lg cursor-not-allowed">Next →</span>
                {% endif %}
            </div>
        </div>
        {% endif %}

    {% endif %}
</div>

{% endblock %}
