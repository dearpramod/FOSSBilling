{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ 'Partnership Program'|trans }}{% endblock %}
{% block page_header %}{{ 'Partnership Program'|trans }}{% endblock %}

{% block content %}
<div class="max-w-5xl mx-auto space-y-8">

    {# ── Hero — matches Stitch "primary-container" solid hero ─────────── #}
    <section class="relative rounded-xl overflow-hidden bg-primary-container dark:bg-indigo-900 min-h-[320px] flex items-center">
        <div class="absolute inset-0 pointer-events-none opacity-20">
            <div class="absolute inset-0 bg-gradient-to-br from-primary dark:from-indigo-500 to-transparent"></div>
        </div>
        <div class="relative z-10 p-8 md:p-12 flex flex-col md:flex-row items-center gap-8 w-full">
            <div class="flex-1 text-on-primary dark:text-white">
                <h1 class="text-2xl md:text-3xl font-bold mb-3">{{ 'MeroVPS Partner Program'|trans }}</h1>
                <p class="text-sm text-on-primary-container dark:text-indigo-100 max-w-2xl leading-relaxed">
                    {{ 'Scale your agency or hosting business with exclusive volume discounts, priority engineering support, and powerful white-label API access. Join a community of high-growth partners today.'|trans }}
                </p>
                <div class="mt-5">
                    <a href="#apply-form"
                       class="inline-flex items-center gap-2 px-6 py-3 bg-white text-primary font-bold rounded-lg hover:bg-surface-container transition-colors shadow-md">
                        {{ 'Apply Now'|trans }}
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                        </svg>
                    </a>
                </div>
            </div>
            <div class="hidden md:block w-1/3 flex-shrink-0">
                <div class="aspect-square rounded-2xl backdrop-blur-sm border border-white/20 flex items-center justify-center" style="background:rgba(255,255,255,0.12)">
                    <svg class="w-28 h-28 text-white/40" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M11 6C11 3.79 9.21 2 7 2S3 3.79 3 6s1.79 4 4 4 4-1.79 4-4zm2 0c0 2.21 1.79 4 4 4s4-1.79 4-4-1.79-4-4-4-4 1.79-4 4zm-2 2.5c-2.67 0-8 1.34-8 4V15h16v-2.5c0-2.66-5.33-4-8-4zm10 0c-.29 0-.62.02-.97.05C21.19 9.89 22 11.02 22 12.5V15h2v-2.5c0-2.66-5.33-4-8-4z"/>
                    </svg>
                </div>
            </div>
        </div>
    </section>

    {# ── Requirements + Tiers ──────────────────────────────────────────── #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        {# Requirements #}
        <div class="bg-surface-container-lowest dark:bg-white/[0.04] border border-outline-variant dark:border-white/[0.08] p-6 rounded-xl shadow-sm">
            <h3 class="text-base font-semibold text-on-surface dark:text-slate-100 mb-1 flex items-center gap-2">
                <span class="w-8 h-8 rounded-lg bg-primary-fixed dark:bg-indigo-500/20 flex items-center justify-center text-on-primary-fixed-variant dark:text-primary-fixed-dim flex-shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </span>
                {{ 'Requirements'|trans }}
            </h3>
            <p class="text-xs text-on-surface-variant dark:text-slate-500 mb-5">{{ 'Eligibility criteria to maintain partner status and benefits.'|trans }}</p>
            <ul class="space-y-4">
                <li class="flex items-start gap-3">
                    <span class="w-5 h-5 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg class="w-3 h-3 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                        </svg>
                    </span>
                    <div>
                        <p class="text-sm font-semibold text-on-surface dark:text-slate-200">{{ 'Minimum Active Services'|trans }}</p>
                        <p class="text-xs text-on-surface-variant dark:text-slate-500">{{ 'Maintain 5+ active hosting instances.'|trans }}</p>
                    </div>
                </li>
                <li class="flex items-start gap-3">
                    <span class="w-5 h-5 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg class="w-3 h-3 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                        </svg>
                    </span>
                    <div>
                        <p class="text-sm font-semibold text-on-surface dark:text-slate-200">{{ 'Account Standing'|trans }}</p>
                        <p class="text-xs text-on-surface-variant dark:text-slate-500">{{ '180 days of consistent payment history.'|trans }}</p>
                    </div>
                </li>
                <li class="flex items-start gap-3">
                    <span class="w-5 h-5 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg class="w-3 h-3 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                        </svg>
                    </span>
                    <div>
                        <p class="text-sm font-semibold text-on-surface dark:text-slate-200">{{ 'Business Identity'|trans }}</p>
                        <p class="text-xs text-on-surface-variant dark:text-slate-500">{{ 'Verified tax ID and registered business name.'|trans }}</p>
                    </div>
                </li>
            </ul>
        </div>

        {# Program Tiers #}
        <div class="lg:col-span-2 bg-surface-container-lowest dark:bg-white/[0.04] border border-outline-variant dark:border-white/[0.08] p-6 rounded-xl shadow-sm">
            <h3 class="text-base font-semibold text-on-surface dark:text-slate-100 mb-1 flex items-center gap-2">
                <span class="w-8 h-8 rounded-lg bg-primary-fixed dark:bg-indigo-500/20 flex items-center justify-center text-on-primary-fixed-variant dark:text-primary-fixed-dim flex-shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                    </svg>
                </span>
                {{ 'Program Tiers'|trans }}
            </h3>
            <p class="text-xs text-on-surface-variant dark:text-slate-500 mb-5">{{ 'Choose the tier that best fits your business scale and ambitions.'|trans }}</p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

                {# Tier 1 — Associate #}
                <div class="p-5 rounded-xl border border-outline-variant dark:border-white/[0.08] bg-surface-container-low dark:bg-white/[0.03] flex flex-col gap-4">
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-widest text-outline dark:text-slate-500">{{ 'Level 1'|trans }}</span>
                        <p class="text-xl font-bold text-on-surface dark:text-slate-100 mt-0.5">{{ 'Associate'|trans }}</p>
                    </div>
                    <p class="text-lg font-bold text-primary">5% {{ 'Discount'|trans }}</p>
                    <ul class="space-y-2 text-sm text-on-surface-variant dark:text-slate-400">
                        <li class="flex items-center gap-2">
                            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                            {{ 'Standard Support'|trans }}
                        </li>
                        <li class="flex items-center gap-2">
                            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
                            {{ 'Partner Badge'|trans }}
                        </li>
                    </ul>
                </div>

                {# Tier 2 — Professional (highlighted) #}
                <div class="relative p-5 rounded-xl border-2 border-primary dark:border-indigo-500 bg-primary-fixed/20 dark:bg-indigo-500/10 flex flex-col gap-4">
                    <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-primary text-white text-[10px] px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wide whitespace-nowrap">{{ 'Popular'|trans }}</span>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-widest text-primary dark:text-primary-fixed-dim">{{ 'Level 2'|trans }}</span>
                        <p class="text-xl font-bold text-on-surface dark:text-slate-100 mt-0.5">{{ 'Professional'|trans }}</p>
                    </div>
                    <p class="text-lg font-bold text-primary">15% {{ 'Discount'|trans }}</p>
                    <ul class="space-y-2 text-sm text-on-surface-variant dark:text-slate-400">
                        <li class="flex items-center gap-2 font-semibold text-on-surface dark:text-slate-200">
                            <svg class="w-4 h-4 flex-shrink-0 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                            {{ 'Priority Support'|trans }}
                        </li>
                        <li class="flex items-center gap-2">
                            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            {{ 'Account Manager'|trans }}
                        </li>
                        <li class="flex items-center gap-2">
                            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                            {{ 'Marketing Kit'|trans }}
                        </li>
                    </ul>
                </div>

                {# Tier 3 — Elite #}
                <div class="p-5 rounded-xl border border-outline-variant dark:border-white/[0.08] bg-surface-container-low dark:bg-white/[0.03] flex flex-col gap-4">
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-widest text-outline dark:text-slate-500">{{ 'Level 3'|trans }}</span>
                        <p class="text-xl font-bold text-on-surface dark:text-slate-100 mt-0.5">{{ 'Elite'|trans }}</p>
                    </div>
                    <p class="text-lg font-bold text-primary">25% {{ 'Discount'|trans }}</p>
                    <ul class="space-y-2 text-sm text-on-surface-variant dark:text-slate-400">
                        <li class="flex items-center gap-2 font-semibold text-on-surface dark:text-slate-200">
                            <svg class="w-4 h-4 flex-shrink-0 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
                            {{ 'VIP White-Glove'|trans }}
                        </li>
                        <li class="flex items-center gap-2">
                            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            {{ 'Custom API Access'|trans }}
                        </li>
                        <li class="flex items-center gap-2">
                            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                            {{ 'Early Beta Features'|trans }}
                        </li>
                    </ul>
                </div>

            </div>
        </div>
    </div>

    {# ── Application Form ──────────────────────────────────────────────── #}
    <section id="apply-form" class="bg-surface-container-lowest dark:bg-white/[0.04] border border-outline-variant dark:border-white/[0.08] rounded-xl overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-outline-variant dark:border-white/[0.06] bg-surface-container-low/50 dark:bg-white/[0.03]">
            <h3 class="text-base font-semibold text-on-surface dark:text-slate-100">{{ 'Request Partnership'|trans }}</h3>
            <p class="text-[10px] font-bold text-outline dark:text-slate-500 uppercase tracking-widest mt-0.5">{{ 'Reviewed manually by our team within 2–3 business days'|trans }}</p>
        </div>

        <div class="p-6 md:p-8">

            {% if has_helpdesk %}

                <form id="partnership-apply-form" class="space-y-6" novalidate>
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
                    <input type="hidden" name="support_helpdesk_id" value="{{ helpdesk_id }}">
                    <input type="hidden" name="subject" value="{{ 'Partnership Program Application'|trans }}">

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-1.5">
                            <label for="apply-company" class="block text-sm font-semibold text-on-surface dark:text-slate-200">
                                {{ 'Name'|trans }} <span class="text-red-400" aria-hidden="true">*</span>
                            </label>
                            <input type="text"
                                   id="apply-company"
                                   name="_company"
                                   required
                                   placeholder="{{ 'Your full name or company name'|trans }}"
                                   class="w-full px-4 py-3 rounded-lg bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white text-sm placeholder-slate-400 dark:placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
                        </div>
                        <div class="space-y-1.5">
                            <label for="apply-website" class="block text-sm font-semibold text-on-surface dark:text-slate-200">
                                {{ 'Website URL'|trans }}
                            </label>
                            <input type="url"
                                   id="apply-website"
                                   name="_website"
                                   placeholder="https://company.com"
                                   class="w-full px-4 py-3 rounded-lg bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white text-sm placeholder-slate-400 dark:placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <label for="apply-description" class="block text-sm font-semibold text-on-surface dark:text-slate-200">
                            {{ 'Description of Client Base'|trans }} <span class="text-red-400" aria-hidden="true">*</span>
                        </label>
                        <textarea id="apply-description"
                                  name="_description"
                                  rows="5"
                                  required
                                  placeholder="{{ 'Tell us about your customers, the types of websites you host, and your expected growth for the next 12 months...'|trans }}"
                                  class="w-full px-4 py-3 rounded-lg bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white text-sm placeholder-slate-400 dark:placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent resize-none transition-all"></textarea>
                    </div>

                    <div class="flex items-start gap-3">
                        <input type="checkbox"
                               id="apply-terms"
                               required
                               class="mt-1 w-4 h-4 rounded border-slate-300 dark:border-white/20 text-indigo-600 focus:ring-indigo-500 bg-white dark:bg-white/10 flex-shrink-0">
                        <label for="apply-terms" class="text-sm text-on-surface-variant dark:text-slate-400 leading-relaxed">
                            {{ 'I certify that the information provided is accurate and that I have the authority to apply on behalf of my company. I agree to the'|trans }}
                            <a href="#" class="text-primary dark:text-primary-fixed-dim font-medium hover:underline">{{ 'Partner Program Terms of Service'|trans }}</a>.
                        </label>
                    </div>

                    <div class="flex justify-end pt-2">
                        <button type="submit"
                                id="apply-submit-btn"
                                class="w-full md:w-auto px-8 py-3.5 rounded-xl text-white text-sm font-bold transition-all btn-primary-gradient disabled:opacity-60 disabled:cursor-not-allowed flex items-center justify-center gap-2 shadow-lg">
                            <span id="apply-btn-label">{{ 'Submit Request'|trans }}</span>
                            <svg id="apply-btn-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                            </svg>
                            <svg id="apply-btn-spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                            </svg>
                        </button>
                    </div>
                </form>

            {% else %}

                {# Fallback: no helpdesks configured #}
                <div class="flex items-start gap-4 p-5 bg-surface-container-high dark:bg-white/[0.04] rounded-xl border border-outline-variant dark:border-white/[0.08]">
                    <div class="w-10 h-10 rounded-full bg-primary-fixed-dim dark:bg-indigo-500/20 flex items-center justify-center text-primary flex-shrink-0 mt-0.5">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-bold text-on-surface dark:text-slate-100 mb-1">{{ 'Contact Us to Apply'|trans }}</p>
                        <p class="text-sm text-on-surface-variant dark:text-slate-400 leading-relaxed">
                            {{ 'To apply for the Partnership Program, please contact our support team directly and mention you would like to join.'|trans }}
                        </p>
                        <a href="{{ 'support'|url }}" class="inline-flex items-center gap-1.5 mt-3 text-sm font-semibold text-primary hover:underline">
                            {{ 'Go to Support'|trans }}
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </a>
                    </div>
                </div>

            {% endif %}
        </div>
    </section>

</div>

{% if has_helpdesk %}
<script>
(function () {
    var form = document.getElementById('partnership-apply-form');
    var submitBtn = document.getElementById('apply-submit-btn');
    var btnLabel = document.getElementById('apply-btn-label');
    var btnIcon = document.getElementById('apply-btn-icon');
    var btnSpinner = document.getElementById('apply-btn-spinner');

    if (!form) return;

    form.addEventListener('submit', function (e) {
        e.preventDefault();

        var companyField = document.getElementById('apply-company');
        var descField = document.getElementById('apply-description');
        var termsField = document.getElementById('apply-terms');

        if (!companyField.value.trim()) {
            if (typeof StablePanel !== 'undefined') StablePanel.message('{{ 'Please enter your name.'|trans|e('js') }}', 'error');
            companyField.focus();
            return;
        }
        if (!descField.value.trim()) {
            if (typeof StablePanel !== 'undefined') StablePanel.message('{{ 'Please describe your client base.'|trans|e('js') }}', 'error');
            descField.focus();
            return;
        }
        if (!termsField.checked) {
            if (typeof StablePanel !== 'undefined') StablePanel.message('{{ 'Please accept the terms to proceed.'|trans|e('js') }}', 'error');
            termsField.focus();
            return;
        }

        // Build ticket content from individual fields
        var websiteVal = document.getElementById('apply-website').value.trim();
        var content = 'Company Name: ' + companyField.value.trim() + '\n';
        if (websiteVal) content += 'Website: ' + websiteVal + '\n';
        content += '\n' + descField.value.trim();

        submitBtn.disabled = true;
        btnLabel.textContent = '{{ 'Submitting…'|trans|e('js') }}';
        btnIcon.classList.add('hidden');
        btnSpinner.classList.remove('hidden');

        var data = {};
        new FormData(form).forEach(function (v, k) {
            // Skip the individual underscore-prefixed fields; we compose content manually
            if (k.indexOf('_') !== 0) data[k] = v;
        });
        data['content'] = content;

        FOSSBilling.api.client.post(
            'support/ticket_create',
            data,
            function (res) {
                window.location.href = "{{ 'support/ticket'|url }}" + '/' + res;
            },
            function (res) {
                submitBtn.disabled = false;
                btnLabel.textContent = '{{ 'Submit Request'|trans|e('js') }}';
                btnIcon.classList.remove('hidden');
                btnSpinner.classList.add('hidden');
                if (typeof StablePanel !== 'undefined') StablePanel.message(res.message + ' (' + res.code + ')', 'error');
            }
        );
    });
}());
</script>
{% endif %}

{% endblock %}
