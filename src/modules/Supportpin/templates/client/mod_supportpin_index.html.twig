{% extends 'layout_default.html.twig' %}

{% set active_menu = 'profile' %}

{% block meta_title %}{{ 'Support PIN'|trans }}{% endblock %}

{% block content %}
{% set pin_data = client.supportpin_get({}) %}

<div class="max-w-2xl mx-auto space-y-6">

    {# ── Header ── #}
    <div>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">{{ 'Support PIN'|trans }}</h1>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            {{ 'Your unique PIN for identity verification when contacting support.'|trans }}
        </p>
    </div>

    {# ── PIN card ── #}
    <div x-data="{
            pin: {{ pin_data.pin|default('')|json_encode }},
            visible: false,
            loading: false,
            error: '',
            success: '',
            regenCount: 0,
            async regen() {
                this.loading = true; this.error = ''; this.success = '';
                try {
                    const res = await new Promise((resolve, reject) => {
                        FOSSBilling.api.client.post('supportpin/regenerate', {}, resolve, reject);
                    });
                    this.pin = res.pin;
                    this.visible = true;
                    this.success = '{{ 'PIN regenerated successfully.'|trans|e('js') }}';
                    this.regenCount++;
                } catch (e) {
                    this.error = e.message || '{{ 'Failed to regenerate PIN. Please try again later.'|trans|e('js') }}';
                } finally {
                    this.loading = false;
                }
            }
         }"
         class="bg-white dark:bg-white/[0.03] border border-slate-200 dark:border-white/[0.08] rounded-xl shadow-sm overflow-hidden">

        {# Card top accent #}
        <div class="h-1 w-full bg-gradient-to-r from-indigo-500 via-purple-500 to-indigo-600"></div>

        <div class="p-6 sm:p-8">

            {# Icon + title row #}
            <div class="flex items-center gap-4 mb-6">
                <div class="w-12 h-12 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 border border-indigo-100 dark:border-indigo-500/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3a12 12 0 0 0 8.5 3A12 12 0 0 1 12 21 12 12 0 0 1 3.5 6 12 12 0 0 0 12 3"/>
                        <circle cx="12" cy="11" r="1" fill="currentColor"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 12v3"/>
                    </svg>
                </div>
                <div>
                    <h2 class="text-lg font-semibold text-slate-900 dark:text-white">{{ 'Your Support PIN'|trans }}</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">{{ 'Provide this PIN when asked by our support team.'|trans }}</p>
                </div>
            </div>

            {# Locked warning #}
            {% if pin_data.locked %}
            <div class="mb-5 flex items-center gap-3 rounded-lg border border-red-200 dark:border-red-500/20 bg-red-50 dark:bg-red-500/10 px-4 py-3 text-sm text-red-700 dark:text-red-400">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                {{ 'Your PIN is temporarily locked due to too many failed verification attempts. Please wait 30 minutes before trying again.'|trans }}
            </div>
            {% endif %}

            {# PIN display #}
            <div class="mb-6">
                <div class="flex items-center gap-3">
                    <div class="relative flex-1">
                        <div class="flex items-center gap-1 justify-center px-6 py-4 rounded-xl bg-slate-50 dark:bg-white/[0.03] border border-slate-200 dark:border-white/[0.08]">
                            <template x-if="visible">
                                <template x-for="(digit, i) in pin.split('')" :key="i">
                                    <span class="w-9 h-11 flex items-center justify-center text-2xl font-bold font-mono text-slate-900 dark:text-white bg-white dark:bg-white/[0.05] border border-slate-200 dark:border-white/[0.1] rounded-lg shadow-sm" x-text="digit"></span>
                                </template>
                            </template>
                            <template x-if="!visible">
                                <template x-for="i in [1,2,3,4,5,6]" :key="i">
                                    <span class="w-9 h-11 flex items-center justify-center text-2xl font-bold font-mono text-slate-300 dark:text-slate-600 bg-white dark:bg-white/[0.05] border border-slate-200 dark:border-white/[0.1] rounded-lg shadow-sm">•</span>
                                </template>
                            </template>
                        </div>
                    </div>
                    <button @click="visible = !visible"
                            class="flex-shrink-0 p-2.5 rounded-lg border border-slate-200 dark:border-white/[0.1] bg-white dark:bg-white/[0.03] text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-white/[0.06] transition-all"
                            :title="visible ? '{{ 'Hide PIN'|trans }}' : '{{ 'Reveal PIN'|trans }}'">
                        <svg x-show="!visible" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                        <svg x-show="visible" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
                        </svg>
                    </button>
                </div>
                {% if pin_data.changed_at %}
                <p class="mt-2 text-xs text-center text-slate-400 dark:text-slate-600">
                    {{ 'Last changed:'|trans }} {{ pin_data.changed_at|date('M j, Y') }}
                </p>
                {% endif %}
            </div>

            {# Status/feedback messages #}
            <div x-show="error" x-cloak class="mb-4 flex items-center gap-2 rounded-lg border border-red-200 dark:border-red-500/20 bg-red-50 dark:bg-red-500/10 px-4 py-3 text-sm text-red-700 dark:text-red-400">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span x-text="error"></span>
            </div>
            <div x-show="success" x-cloak class="mb-4 flex items-center gap-2 rounded-lg border border-emerald-200 dark:border-emerald-500/20 bg-emerald-50 dark:bg-emerald-500/10 px-4 py-3 text-sm text-emerald-700 dark:text-emerald-400">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span x-text="success"></span>
            </div>

            {# Regenerate button #}
            <button @click="regen()"
                    :disabled="loading{% if pin_data.locked %} || true{% endif %}"
                    class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/[0.1] bg-white dark:bg-white/[0.03] text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-white/[0.06] hover:border-slate-300 dark:hover:border-white/[0.15] text-sm font-medium transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                <svg x-show="!loading" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                <svg x-show="loading" class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                </svg>
                <span x-text="loading ? '{{ 'Regenerating…'|trans|e('js') }}' : '{{ 'Regenerate PIN'|trans|e('js') }}'"></span>
            </button>
            <p class="mt-2 text-center text-xs text-slate-400 dark:text-slate-600">
                {{ 'You can regenerate your PIN up to 3 times per day.'|trans }}
            </p>

        </div>
    </div>

    {# ── How to use ── #}
    <div class="bg-white dark:bg-white/[0.03] border border-slate-200 dark:border-white/[0.08] rounded-xl p-6">
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-3">{{ 'How it works'|trans }}</h3>
        <ol class="space-y-2 text-sm text-slate-500 dark:text-slate-400 list-decimal list-inside">
            <li>{{ 'When contacting support, our agents may ask for your Support PIN.'|trans }}</li>
            <li>{{ 'Reveal your PIN above and share the 6-digit code with the agent.'|trans }}</li>
            <li>{{ 'The agent uses the PIN to instantly verify your identity without your password.'|trans }}</li>
        </ol>
        <p class="mt-3 text-xs text-amber-600 dark:text-amber-400">
            ⚠ {{ 'Never share your PIN in a public channel or unsolicited communication.'|trans }}
        </p>
    </div>

</div>
{% endblock %}
