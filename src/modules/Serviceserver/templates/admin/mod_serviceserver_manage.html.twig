{# Shown under Admin > Orders > [order] > Manage tab.
   Variables: order, service (toApiArray result) #}

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">{{ 'Server Details'|trans }} — {{ order.title }}</h3>
    </div>
    <div class="card-body">
        <form {{ fb_api_form({'message': 'Server details updated'|trans}) }}>
            <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
            <input type="hidden" name="order_id" value="{{ order.id }}">

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">{{ 'Hostname'|trans }}</label>
                    <input class="form-control" type="text" name="hostname" value="{{ service.hostname }}" placeholder="server01.example.com">
                </div>
                <div class="col-md-6">
                    <label class="form-label">{{ 'IP Address'|trans }}</label>
                    <input class="form-control" type="text" name="ip" value="{{ service.ip }}" placeholder="203.0.113.10">
                </div>
                <div class="col-md-6">
                    <label class="form-label">{{ 'Root Password'|trans }}</label>
                    <input class="form-control" type="text" name="root_password" value="{{ service.root_password }}" placeholder="{{ 'Leave blank to keep current'|trans }}">
                </div>
                <div class="col-md-6">
                    <label class="form-label">{{ 'Operating System'|trans }}</label>
                    <input class="form-control" type="text" name="os" value="{{ service.os }}" placeholder="Ubuntu 24.04 LTS">
                </div>
                <div class="col-md-3">
                    <label class="form-label">{{ 'CPU Cores'|trans }}</label>
                    <input class="form-control" type="number" min="1" name="cpu_cores" value="{{ service.cpu_cores ?? '' }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label">{{ 'RAM (MB)'|trans }}</label>
                    <input class="form-control" type="number" min="128" step="128" name="ram_mb" value="{{ service.ram_mb ?? '' }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label">{{ 'Disk (GB)'|trans }}</label>
                    <input class="form-control" type="number" min="1" name="disk_gb" value="{{ service.disk_gb ?? '' }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label">{{ 'Bandwidth (GB)'|trans }}</label>
                    <input class="form-control" type="number" min="0" name="bandwidth_gb" value="{{ service.bandwidth_gb ?? '' }}">
                </div>
                <div class="col-md-6">
                    <label class="form-label">{{ 'Location'|trans }}</label>
                    <input class="form-control" type="text" name="location" value="{{ service.location }}" placeholder="Singapore, SG">
                </div>
                <div class="col-md-6">
                    <label class="form-label">{{ 'Status'|trans }}</label>
                    <select class="form-select" name="status">
                        {% for s in ['pending', 'active', 'suspended', 'cancelled'] %}
                        <option value="{{ s }}" {{ service.status == s ? 'selected' : '' }}>{{ s|capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">{{ 'Admin Notes'|trans }}</label>
                    <textarea class="form-control" rows="3" name="notes">{{ service.notes }}</textarea>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">{{ 'Update'|trans }}</button>
            </div>
        </form>
    </div>
</div>
