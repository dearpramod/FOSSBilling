{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% block meta_title %}{{ 'Server Module Settings'|trans }}{% endblock %}

{% set active_menu = 'system' %}

{% block breadcrumbs %}
    <ul class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ '/'|url(area: 'admin') }}">
                <svg class="icon"><use href="#home"/></svg>
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'system'|url(area: 'admin') }}">{{ 'Settings'|trans }}</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">{{ 'Server Module'|trans }}</li>
    </ul>
{% endblock %}

{% block content %}
<div class="card">
    <div class="card-header">
        <div class="d-flex align-items-center gap-2">
            <span style="width:2.4rem;height:2.4rem;display:grid;place-items:center;flex:none;border-radius:.7rem;color:var(--tblr-primary);background:rgba(var(--tblr-primary-rgb),.08);border:1px solid rgba(var(--tblr-primary-rgb),.14);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" style="width:1.2rem;height:1.2rem;"><rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/><path d="M7 7h.01M7 17h.01M11 7h6M11 17h6"/></svg>
            </span>
            <div>
                <h3 class="card-title mb-0">{{ 'Server Option Fields'|trans }}</h3>
                <p class="card-subtitle mt-0 mb-0">{{ 'Manage checkout pickers per category or per product'|trans }}</p>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="d-flex align-items-start gap-3 p-4 border rounded-2 mb-4" style="background:rgba(var(--tblr-primary-rgb),.03);border-color:rgba(var(--tblr-primary-rgb),.15) !important;">
            <svg class="flex-shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="width:1.4rem;height:1.4rem;color:var(--tblr-primary);"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
            <div>
                <strong class="d-block mb-1">{{ 'Option fields are now configured per category'|trans }}</strong>
                <p class="text-secondary mb-2">
                    {{ 'Each product category can have its own set of option fields (location, operating system, tier, etc.). Individual products can also override the category defaults from their Configuration tab.'|trans }}
                </p>
                <p class="text-secondary mb-0 small">
                    {{ 'Cascade order:'|trans }}
                    <strong>{{ 'Product override'|trans }}</strong> →
                    <strong>{{ 'Category fields'|trans }}</strong> →
                    <strong>{{ 'Built-in defaults'|trans }}</strong>
                </p>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="card h-100" style="border:1px solid var(--tblr-border-color);">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span style="width:2rem;height:2rem;display:grid;place-items:center;flex:none;border-radius:.55rem;color:var(--tblr-primary);background:rgba(var(--tblr-primary-rgb),.09);">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem;"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
                            </span>
                            <strong>{{ 'Category option fields'|trans }}</strong>
                        </div>
                        <p class="text-secondary small flex-grow-1">
                            {{ 'Set the default option fields for each product category. All server products in that category inherit these fields unless a product-level override is set.'|trans }}
                        </p>
                        <a href="{{ 'serviceserver'|url }}" class="btn btn-primary btn-sm mt-auto">
                            <svg class="icon me-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            {{ 'Manage category fields'|trans }}
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100" style="border:1px solid var(--tblr-border-color);">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span style="width:2rem;height:2rem;display:grid;place-items:center;flex:none;border-radius:.55rem;color:var(--tblr-primary);background:rgba(var(--tblr-primary-rgb),.09);">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem;"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                            </span>
                            <strong>{{ 'Product-level override'|trans }}</strong>
                        </div>
                        <p class="text-secondary small flex-grow-1">
                            {{ 'Individual server products can override the category fields from their Configuration tab. Useful when one product needs different location or OS options from the rest of the category.'|trans }}
                        </p>
                        <a href="{{ 'product'|url }}" class="btn btn-outline-secondary btn-sm mt-auto">
                            <svg class="icon me-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            {{ 'Go to Products'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
