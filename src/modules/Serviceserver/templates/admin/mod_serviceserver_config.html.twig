<style>
.srv-fields-editor { display: grid; gap: 1rem; }
.srv-field-card { border: 1px solid var(--tblr-border-color); border-radius: var(--tblr-border-radius); background: var(--tblr-bg-surface); overflow: hidden; transition: border-color .15s, box-shadow .15s; }
.srv-field-card:focus-within { border-color: var(--tblr-primary); box-shadow: 0 0 0 .25rem rgba(var(--tblr-primary-rgb),.1); }
.srv-field-head { display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; border-bottom: 1px solid var(--tblr-border-color); }
.srv-field-index { width: 1.75rem; height: 1.75rem; display: grid; place-items: center; flex: none; margin-top: 1.4rem; border-radius: var(--tblr-border-radius-sm); color: var(--tblr-primary); background: rgba(var(--tblr-primary-rgb),.1); font-size: .7rem; font-weight: 700; }
.srv-field-form { flex: 1; min-width: 0; display: grid; grid-template-columns: minmax(9rem,.27fr) 1fr; gap: .625rem; }
.srv-field-description, .srv-field-required, .srv-field-display { grid-column: 1 / -1; }
.srv-field-required { display: flex; align-items: center; justify-content: space-between; padding: .5rem .75rem; background: rgba(var(--tblr-secondary-rgb),.04); border: 1px solid var(--tblr-border-color); border-radius: var(--tblr-border-radius-sm); }
.srv-remove-field { margin-top: 1.25rem; flex: none; }
.srv-options-wrap { border-top: 1px solid var(--tblr-border-color); }
.srv-options-table { width: 100%; border-collapse: collapse; }
.srv-options-table thead th { padding: .4rem .5rem; font-size: .65rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--tblr-secondary); border-bottom: 1px solid var(--tblr-border-color); white-space: nowrap; }
.srv-options-table tbody tr:hover { background: rgba(var(--tblr-secondary-rgb),.04); }
.srv-options-table tbody td { padding: .35rem .5rem; vertical-align: middle; }
.srv-options-table .form-control-sm, .srv-options-table .form-select-sm { min-height: 2rem; font-size: .8125rem; }
.srv-col-value { width: 9rem; }
.srv-col-label { width: 12rem; }
.srv-col-image { width: 2.5rem; text-align: center; }
.srv-col-group { width: 7rem; }
.srv-col-badge { width: 6.5rem; }
.srv-col-meta { width: 5.5rem; }
.srv-col-price { width: 5rem; }
.srv-col-del { width: 2.25rem; }
.srv-img-preview { width: 1.75rem; height: 1.75rem; object-fit: contain; border-radius: 3px; display: block; margin: 0 auto; }
.srv-field-footer { display: flex; align-items: center; justify-content: space-between; padding: .625rem 1rem; background: rgba(var(--tblr-secondary-rgb),.025); border-top: 1px solid var(--tblr-border-color); }
.srv-empty-options { padding: 1rem 1rem .875rem; text-align: center; color: var(--tblr-secondary); font-size: .875rem; }
.srv-empty-editor { padding: 2rem 1rem; border: 2px dashed var(--tblr-border-color); border-radius: var(--tblr-border-radius); text-align: center; color: var(--tblr-secondary); }
.srv-empty-editor svg { width: 1.75rem; height: 1.75rem; margin-bottom: .5rem; stroke-width: 1.5; }
@media (max-width: 767.98px) {
    .srv-field-head { flex-direction: column; }
    .srv-field-index { display: none; }
    .srv-field-form { width: 100%; grid-template-columns: 1fr; }
    .srv-field-form > * { grid-column: 1; }
    .srv-remove-field { width: 100%; margin-top: 0; }
    .srv-options-table thead { display: none; }
    .srv-options-table tbody tr { display: grid; grid-template-columns: 1fr 1fr; gap: .25rem; padding: .5rem; border-bottom: 1px solid var(--tblr-border-color); }
    .srv-options-table tbody td { display: block; padding: .25rem .5rem; }
    .srv-options-table tbody td::before { content: attr(data-label); display: block; font-size: .65rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--tblr-secondary); margin-bottom: .2rem; }
    .srv-options-table tbody tr td:last-child { grid-column: 2; justify-self: end; }
}
</style>

{# product.config is already decoded by Product\Service::toApiArray() #}
{% set config      = product.config|default({}) %}
{% set category_id = product.product_category_id|default(0) %}
{% set has_override = config.option_fields is defined and config.option_fields is not empty %}

<div class="card-body">

    {# ── Product Specifications ───────────────────────────────────────── #}
    <form method="post" action="{{ 'product/update_config'|api_url }}" {{ fb_api_form({message: 'Product specifications updated.'|trans}) }}>
        <input type="hidden" name="id" value="{{ product.id }}">
        <div class="mb-5">
            <div class="mb-3">
                <h3 class="card-title mb-1">{{ 'Product Specifications'|trans }}</h3>
                <p class="text-secondary mb-0">{{ 'Resource limits shown on the order form and client area for this product.'|trans }}</p>
            </div>
            <div class="row g-3">
                <div class="col-lg-3 col-sm-6">
                    <label class="form-label">{{ 'CPU Cores'|trans }}</label>
                    <input class="form-control" type="number" min="0" step="1"
                           name="config[cpu_cores]" value="{{ config.cpu_cores|default('') }}"
                           placeholder="{{ 'e.g. 2'|trans }}">
                    <div class="form-hint">{{ 'vCPU count shown to the customer.'|trans }}</div>
                </div>
                <div class="col-lg-3 col-sm-6">
                    <label class="form-label">{{ 'RAM (MB)'|trans }}</label>
                    <input class="form-control" type="number" min="0" step="1"
                           name="config[ram_mb]" value="{{ config.ram_mb|default('') }}"
                           placeholder="{{ 'e.g. 2048'|trans }}">
                    <div class="form-hint">{{ 'Memory in megabytes.'|trans }}</div>
                </div>
                <div class="col-lg-3 col-sm-6">
                    <label class="form-label">{{ 'Storage (GB)'|trans }}</label>
                    <input class="form-control" type="number" min="0" step="1"
                           name="config[disk_gb]" value="{{ config.disk_gb|default('') }}"
                           placeholder="{{ 'e.g. 50'|trans }}">
                    <div class="form-hint">{{ 'Disk space in gigabytes.'|trans }}</div>
                </div>
                <div class="col-lg-3 col-sm-6">
                    <label class="form-label">{{ 'Bandwidth (GB)'|trans }}</label>
                    <input class="form-control" type="number" min="0" step="1"
                           name="config[bandwidth_gb]" value="{{ config.bandwidth_gb|default('') }}"
                           placeholder="{{ 'e.g. 1000'|trans }}">
                    <div class="form-hint">{{ 'Monthly transfer limit in gigabytes.'|trans }}</div>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary">{{ 'Update'|trans }}</button>
        </div>
    </form>

    <hr class="my-4" />

    {# ── Order Form Option Fields ─────────────────────────────────────── #}
    <div class="mb-4">
        <h3 class="card-title mb-1">{{ 'Order Form Option Fields'|trans }}</h3>
        <p class="text-secondary mb-0">{{ 'Control which pickers (location, OS, managed options, etc.) appear on the client order form for this product. Fields are merged from global → category → product, with each level able to add or replace specific fields.'|trans }}</p>
    </div>

    {# Source state banner #}
    {% if category_id %}
    <div class="alert {% if has_override %}alert-success{% else %}alert-info{% endif %} mb-4">
        <svg class="icon alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/><path d="M8 7h8M8 17h8"/></svg>
        <div class="flex-fill">
            <h4 class="alert-title">
                {% if has_override %}{{ 'Product-level override active'|trans }}{% else %}{{ 'Inheriting from category and global'|trans }}{% endif %}
            </h4>
            <p class="text-secondary small mb-0">
                {% if has_override %}
                    {{ 'This product\'s own fields are merged on top of category and global defaults. Disable the override below to revert to inherited fields.'|trans }}
                {% else %}
                    {{ 'Showing the merged result of global defaults and any category-level fields. Enable the override below to add or replace specific fields for this product only.'|trans }}
                {% endif %}
            </p>
        </div>
        <a href="{{ ('serviceserver/category/' ~ category_id)|url }}" class="btn btn-sm btn-outline-secondary align-self-start">
            {{ 'Edit category fields'|trans }}
        </a>
    </div>
    {% else %}
    <div class="alert alert-warning mb-4">
        <svg class="icon alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
        <div>
            <h4 class="alert-title">{{ 'No category assigned'|trans }}</h4>
            <p class="text-secondary small mb-0">{{ 'Assign this product to a category to inherit category-level option fields, or configure a product-level override below.'|trans }}</p>
        </div>
    </div>
    {% endif %}

    {# Override toggle #}
    <div class="mb-4">
        <label class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="srv-cfg-override-toggle"
                   {% if has_override %}checked{% endif %}
                   onchange="document.getElementById('srv-cfg-override-wrap').style.display = this.checked ? '' : 'none'">
            <span class="form-check-label fw-medium">{{ 'Enable product-level override'|trans }}</span>
        </label>
        <div class="form-text">{{ 'When enabled, the fields below are merged on top of any category and global defaults for this product only.'|trans }}</div>
    </div>

    {# Override editor #}
    <div id="srv-cfg-override-wrap" {% if not has_override %}style="display:none"{% endif %}>

        <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="d-flex align-items-center gap-2">
                <span id="srv-cfg-field-count" class="badge bg-blue-lt"></span>
            </div>
            <div class="d-flex align-items-center gap-2">
                {% if category_id %}
                <button type="button" class="btn btn-sm btn-ghost-secondary" id="srv-cfg-load-category">
                    <svg class="icon me-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 109-9M3 12V7m0 5H8"/></svg>
                    {{ 'Load from category'|trans }}
                </button>
                {% endif %}
                <button type="button" class="btn btn-sm btn-ghost-danger" id="srv-cfg-remove-override">
                    <svg class="icon me-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M9 6V4h6v2"/></svg>
                    {{ 'Remove override'|trans }}
                </button>
                <button type="button" class="btn btn-sm btn-primary" id="srv-cfg-save">
                    <svg class="icon me-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    {{ 'Save override'|trans }}
                </button>
            </div>
        </div>

        <div id="srv-cfg-fields-editor" class="srv-fields-editor" aria-live="polite"></div>

        <div class="d-flex align-items-center gap-2 mt-3 pt-3 border-top">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="srv-cfg-add-field">
                <svg class="icon me-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                {{ 'Add Option Field'|trans }}
            </button>
            <span class="text-secondary small">{{ 'Add another picker shown on the order form for this product.'|trans }}</span>
        </div>
    </div>

</div>

<script>
(function () {
    const PRODUCT_ID = {{ product.id }};
    let fields = {{ has_override ? config.option_fields|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw : '[]' }};
    const BADGE_OPTS = ['', 'Best', 'Good', 'Fair', 'Distant'];

    function esc(s) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    function imgCell(url, fi, oi) {
        const safe = esc(url ?? '');
        const preview = (url ?? '').trim() && /^(https?:\/\/|\/)/.test((url ?? '').trim())
            ? `<img src="${safe}" class="srv-img-preview mb-1" alt="" onerror="this.style.display='none'">`
            : '';
        return `<td class="srv-col-image" data-label="{{ 'Image'|trans }}">${preview}<input type="text" class="form-control form-control-sm" value="${safe}" oninput="srvCfgFields[${fi}].options[${oi}].image_url=this.value;srvCfgUpdateImg(this)" placeholder="https://…" title="${safe}"></td>`;
    }

    window.srvCfgUpdateImg = function(input) {
        const cell = input.closest('td');
        let img = cell.querySelector('.srv-img-preview');
        const url = input.value.trim();
        if (!img) { img = document.createElement('img'); img.className = 'srv-img-preview mb-1'; img.alt = ''; img.onerror = () => img.style.display='none'; cell.insertBefore(img, input); }
        if (url && /^(https?:\/\/|\/)/.test(url)) { img.src = url; img.style.display = ''; } else { img.style.display = 'none'; }
    };

    function render() {
        const container = document.getElementById('srv-cfg-fields-editor');
        if (!container) return;
        const counter = document.getElementById('srv-cfg-field-count');
        if (counter) counter.textContent = fields.length === 1 ? '1 {{ 'field'|trans }}' : `${fields.length} {{ 'fields'|trans }}`;

        if (!fields.length) {
            container.innerHTML = `
                <div class="srv-empty-editor">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/><path d="M8 7h8M8 17h8"/></svg>
                    <p class="h4 mb-1">{{ 'No override fields set'|trans }}</p>
                    <p class="mb-0 small">{{ 'Add a field or load from the category defaults above.'|trans }}</p>
                </div>`;
            return;
        }

        container.innerHTML = fields.map((field, fi) => `
            <section class="srv-field-card" data-fi="${fi}" aria-label="{{ 'Option field'|trans }} ${fi + 1}">
                <div class="srv-field-head">
                    <span class="srv-field-index" aria-hidden="true">${String(fi+1).padStart(2,'0')}</span>
                    <div class="srv-field-form">
                        <div>
                            <label for="srv-cfg-fid-${fi}" class="form-label text-secondary small mb-1">{{ 'Field ID'|trans }}</label>
                            <input id="srv-cfg-fid-${fi}" class="form-control font-monospace" value="${esc(field.id)}"
                                   oninput="srvCfgFields[${fi}].id=this.value" pattern="[a-z0-9_]+" placeholder="location">
                            <small class="form-hint">{{ 'Lowercase letters, numbers, underscores.'|trans }}</small>
                        </div>
                        <div>
                            <label for="srv-cfg-flabel-${fi}" class="form-label text-secondary small mb-1">{{ 'Customer-facing label'|trans }}</label>
                            <input id="srv-cfg-flabel-${fi}" class="form-control fw-medium" value="${esc(field.label)}"
                                   oninput="srvCfgFields[${fi}].label=this.value" placeholder="{{ 'e.g. Server Location'|trans }}">
                        </div>
                        <div class="srv-field-description">
                            <label for="srv-cfg-fdesc-${fi}" class="form-label text-secondary small mb-1">{{ 'Description'|trans }} <span class="text-secondary fw-normal">({{ 'optional'|trans }})</span></label>
                            <input id="srv-cfg-fdesc-${fi}" class="form-control" value="${esc(field.description??'')}"
                                   oninput="srvCfgFields[${fi}].description=this.value" placeholder="{{ 'Helper text shown below the picker'|trans }}">
                        </div>
                        <div class="srv-field-display">
                            <label for="srv-cfg-fdisp-${fi}" class="form-label text-secondary small mb-1">{{ 'Display style'|trans }}</label>
                            <select id="srv-cfg-fdisp-${fi}" class="form-select form-select-sm" onchange="srvCfgFields[${fi}].display=this.value">
                                <option value="dropdown" ${(field.display||'dropdown')==='dropdown'?'selected':''}>{{ 'Searchable dropdown'|trans }}</option>
                                <option value="card-grid" ${field.display==='card-grid'?'selected':''}>{{ 'Card grid with tabs'|trans }}</option>
                            </select>
                        </div>
                        <div class="srv-field-required">
                            <div>
                                <strong class="small">{{ 'Require a selection'|trans }}</strong>
                                <span class="text-secondary small d-block">{{ 'Customers must pick an option before continuing.'|trans }}</span>
                            </div>
                            <label class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" ${field.required?'checked':''}
                                       onchange="srvCfgFields[${fi}].required=this.checked">
                            </label>
                        </div>
                    </div>
                    <div class="srv-remove-field">
                        <button type="button" class="btn btn-ghost-danger btn-sm" onclick="srvCfgRemoveField(${fi})" title="{{ 'Remove field'|trans }}">
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M9 6V4h6v2"/></svg>
                        </button>
                    </div>
                </div>

                <div class="srv-options-wrap">
                ${field.options&&field.options.length ? `
                    <div class="table-responsive">
                    <table class="srv-options-table">
                        <thead>
                            <tr>
                                <th class="srv-col-value">{{ 'Value'|trans }}</th>
                                <th class="srv-col-label">{{ 'Label'|trans }}</th>
                                <th class="srv-col-image">{{ 'Image'|trans }}</th>
                                <th class="srv-col-group">{{ 'Group'|trans }}</th>
                                <th class="srv-col-badge">{{ 'Badge'|trans }}</th>
                                <th class="srv-col-meta">{{ 'Meta'|trans }}</th>
                                <th class="srv-col-price">{{ '$/mo'|trans }}</th>
                                <th class="srv-col-del"></th>
                            </tr>
                        </thead>
                        <tbody>
                            ${field.options.map((opt,oi) => `
                            <tr>
                                <td class="srv-col-value" data-label="{{ 'Value'|trans }}"><input class="form-control form-control-sm font-monospace" value="${esc(opt.value)}" oninput="srvCfgFields[${fi}].options[${oi}].value=this.value" placeholder="india"></td>
                                <td class="srv-col-label" data-label="{{ 'Label'|trans }}"><input class="form-control form-control-sm" value="${esc(opt.label)}" oninput="srvCfgFields[${fi}].options[${oi}].label=this.value" placeholder="{{ 'India'|trans }}"></td>
                                ${imgCell(opt.image_url, fi, oi)}
                                <td class="srv-col-group" data-label="{{ 'Group'|trans }}"><input class="form-control form-control-sm" value="${esc(opt.group??'')}" oninput="srvCfgFields[${fi}].options[${oi}].group=this.value" placeholder="{{ 'Asia'|trans }}"></td>
                                <td class="srv-col-badge" data-label="{{ 'Badge'|trans }}"><select class="form-select form-select-sm" onchange="srvCfgFields[${fi}].options[${oi}].badge=this.value">${BADGE_OPTS.map(b=>`<option value="${b}"${opt.badge===b?' selected':''}>${b||'—'}</option>`).join('')}</select></td>
                                <td class="srv-col-meta" data-label="{{ 'Meta'|trans }}"><input class="form-control form-control-sm" value="${esc(opt.meta??'')}" oninput="srvCfgFields[${fi}].options[${oi}].meta=this.value" placeholder="39ms"></td>
                                <td class="srv-col-price" data-label="{{ '$/mo'|trans }}"><input class="form-control form-control-sm" type="number" min="0" step="0.01" value="${parseFloat(opt.price_monthly||0).toFixed(2)}" oninput="srvCfgFields[${fi}].options[${oi}].price_monthly=parseFloat(this.value)||0"></td>
                                <td class="srv-col-del"><button type="button" class="btn btn-ghost-danger btn-icon btn-sm" onclick="srvCfgRemoveOption(${fi},${oi})" title="{{ 'Remove'|trans }}"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button></td>
                            </tr>`).join('')}
                        </tbody>
                    </table>
                    </div>
                ` : `<div class="srv-empty-options"><span class="text-secondary">{{ 'No choices yet.'|trans }}</span> <span class="small text-secondary">{{ 'Add at least one selectable value below.'|trans }}</span></div>`}
                </div>

                <div class="srv-field-footer">
                    <button type="button" class="btn btn-ghost-secondary btn-sm" onclick="srvCfgAddOption(${fi})">
                        <svg class="icon me-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        {{ 'Add Choice'|trans }}
                    </button>
                    <span class="text-secondary small">${field.options?.length||0} ${(field.options?.length||0)===1?'{{ 'option'|trans }}':'{{ 'options'|trans }}'}</span>
                </div>
            </section>
        `).join('');
    }

    window.srvCfgFields = fields;

    window.srvCfgRemoveField = function(fi) {
        if (!confirm('{{ 'Remove this option field and all its options?'|trans }}')) return;
        fields.splice(fi,1); window.srvCfgFields = fields; render();
    };

    window.srvCfgAddOption = function(fi) {
        fields[fi].options = fields[fi].options||[];
        fields[fi].options.push({value:'',label:'',image_url:'',group:'',badge:'',meta:'',price_monthly:0});
        window.srvCfgFields = fields; render();
    };

    window.srvCfgRemoveOption = function(fi,oi) {
        fields[fi].options.splice(oi,1); window.srvCfgFields = fields; render();
    };

    function validate() {
        for (let fi=0;fi<fields.length;fi++) {
            const f = fields[fi];
            if (!/^[a-z0-9_]+$/.test((f.id||'').trim())) {
                const inp = document.getElementById(`srv-cfg-fid-${fi}`);
                inp?.focus(); inp?.classList.add('is-invalid');
                alert('{{ 'Field ID must use lowercase letters, numbers, or underscores only.'|trans }}'); return false;
            }
            if (!(f.label||'').trim()) {
                const inp = document.getElementById(`srv-cfg-flabel-${fi}`);
                inp?.focus(); inp?.classList.add('is-invalid');
                alert('{{ 'Every option field needs a customer-facing label.'|trans }}'); return false;
            }
            for (let oi=0;oi<(f.options||[]).length;oi++) {
                const opt = f.options[oi];
                if (!(opt.value||'').trim()||!(opt.label||'').trim()) {
                    alert('{{ 'Every option needs both a value and a label.'|trans }}'); return false;
                }
            }
        }
        return true;
    }

    function doSave(optionsJson, successMsg) {
        const btn = document.getElementById('srv-cfg-save');
        const saveSvg = '<svg class="icon me-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>';
        if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>{{ 'Saving…'|trans }}'; }

        FOSSBilling.api.admin.post('serviceserver/product_options_save', {
            product_id: PRODUCT_ID,
            options_json: optionsJson,
        }, function() {
            if (btn) { btn.disabled = false; btn.innerHTML = saveSvg + '{{ 'Save override'|trans }}'; }
            const toast = document.createElement('div');
            toast.className = 'alert alert-success alert-dismissible fade show position-fixed bottom-0 end-0 m-4 shadow';
            toast.style.cssText = 'z-index:9999;min-width:280px;';
            toast.innerHTML = '<svg class="icon me-2 text-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>' + (successMsg||'{{ 'Saved.'|trans }}') + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
            document.body.appendChild(toast);
            setTimeout(()=>{ toast.classList.remove('show'); setTimeout(()=>toast.remove(),300); },3500);
        }, function(err) {
            if (btn) { btn.disabled = false; btn.innerHTML = saveSvg + '{{ 'Save override'|trans }}'; }
            alert('{{ 'Error:'|trans }} ' + ((err&&err.message)?err.message:JSON.stringify(err)));
        });
    }

    document.getElementById('srv-cfg-add-field')?.addEventListener('click', function() {
        fields.push({id:'field_'+Date.now(),label:'{{ 'New Field'|trans }}',description:'',required:false,display:'dropdown',options:[]});
        window.srvCfgFields = fields; render();
        const cards = document.querySelectorAll('#srv-cfg-fields-editor [data-fi]');
        if (cards.length) cards[cards.length-1].scrollIntoView({behavior:'smooth',block:'center'});
    });

    {% if category_id %}
    document.getElementById('srv-cfg-load-category')?.addEventListener('click', function() {
        FOSSBilling.api.admin.get('serviceserver/category_options_get', {category_id:{{ category_id }}}, function(res) {
            fields = Array.isArray(res.result) ? res.result : (Array.isArray(res) ? res : []);
            window.srvCfgFields = fields; render();
        }, function(err) {
            alert('{{ 'Could not load category fields.'|trans }} ' + (err?.message??''));
        });
    });
    {% endif %}

    document.getElementById('srv-cfg-save')?.addEventListener('click', function() {
        if (!validate()) return;
        doSave(JSON.stringify(fields), '{{ 'Product option fields saved.'|trans }}');
    });

    document.getElementById('srv-cfg-remove-override')?.addEventListener('click', function() {
        if (!confirm('{{ 'Remove the product-level override? This product will inherit from category and global defaults.'|trans }}')) return;
        doSave('[]', '{{ 'Product-level override removed.'|trans }}');
        fields = []; window.srvCfgFields = fields;
        document.getElementById('srv-cfg-override-toggle').checked = false;
        document.getElementById('srv-cfg-override-wrap').style.display = 'none';
    });

    render();
}());
</script>
