{% set srv = client.serviceserver_get({'order_id': order.id}) %}
{% set addons = client.order_addons({'id': order.id}) %}
{% set daysUntilDue = order.expires_at ? ((order.expires_at|date('U') - 'now'|date('U')) / 86400)|round : null %}
{% set _unpaid_hash = order.unpaid_invoice_id ? client.invoice_renewal_invoice({'order_id': order.id}) : null %}
{% set _product = order.product_id ? guest.product_get({'id': order.product_id}) : null %}
{% set avail_addons = _product.addons ?? [] %}

{% if srv is empty or (srv.status == 'pending' and not srv.hostname) %}
{# ── Pending / not provisioned ─────────────────────────────────────────────── #}
<div class="srv-manage srv-manage-v2 srv-manage-card srv-manage-pending overflow-hidden">
  <div class="px-6 py-14 flex flex-col items-center text-center gap-5">
    <div class="relative">
      <div class="w-20 h-20 rounded-2xl flex items-center justify-center"
           style="background:rgb(var(--brand-500)/.1); border:1px solid rgb(var(--brand-500)/.22);">
        <svg class="w-10 h-10 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </div>
      <span class="absolute -top-1 -right-1 flex h-4 w-4">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-60"></span>
        <span class="relative inline-flex rounded-full h-4 w-4 bg-amber-400"></span>
      </span>
    </div>
    <div>
      <h4 class="text-base font-bold text-white mb-2">{{ 'Server Being Configured'|trans }}</h4>
      <p class="text-sm text-gray-500 max-w-sm leading-relaxed">
        {{ 'Your server is being set up. Credentials and access details will appear here once provisioning is complete.'|trans }}
      </p>
    </div>
    <a href="{{ '/support'|url }}"
       class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-white/10 text-sm text-gray-400
              hover:text-white hover:border-white/20 hover:bg-white/5 transition-all">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
      </svg>
      {{ 'Contact Support'|trans }}
    </a>
  </div>
</div>

{% else %}
{# ── Active Dashboard ──────────────────────────────────────────────────────── #}
<div class="srv-manage srv-manage-v2 space-y-5">

  {# ═══ SECTION 1 — Hero: Identity + Stats (left 2/3) + Billing Summary (right 1/3) ═══ #}
  <div class="srv-manage-overview grid grid-cols-1 xl:grid-cols-3 gap-5">

    {# Left 2/3 #}
    <div class="xl:col-span-2 space-y-4">

      {# Server Identity Card #}
      <section class="srv-manage-card srv-identity-card p-5 sm:p-6" aria-labelledby="srv-title">
        <div class="flex flex-col md:flex-row items-start md:items-center gap-5">

          {# Icon #}
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center flex-shrink-0"
               style="background:rgb(var(--brand-500)/.15); border:1px solid rgb(var(--brand-500)/.25);">
            <svg class="w-7 h-7" style="color:rgb(var(--brand-500));" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"
                    d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>

          {# Identity #}
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap mb-1">
              <h2 id="srv-title" class="text-2xl font-bold text-white tracking-tight">{{ order.title }}</h2>
              {% if srv.hostname %}
              <span class="text-white/30 text-lg">/</span>
              <span class="text-sm font-medium text-indigo-300 font-mono">{{ srv.hostname }}</span>
              {% endif %}
              <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold px-2.5 py-0.5 rounded-full
                {% if srv.status == 'active' %}bg-emerald-500/20 border border-emerald-400/35 text-emerald-300
                {% elseif srv.status == 'suspended' %}bg-amber-500/25 border border-amber-400/40 text-amber-300
                {% else %}bg-red-500/25 border border-red-400/40 text-red-300{% endif %}">
                <span class="w-1.5 h-1.5 rounded-full
                  {% if srv.status == 'active' %}bg-emerald-400 animate-pulse
                  {% elseif srv.status == 'suspended' %}bg-amber-400
                  {% else %}bg-red-400{% endif %}"></span>
                {{ srv.status|capitalize }}
              </span>
            </div>
            {% if srv.location or srv.ip %}
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-white/30 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path clip-rule="evenodd" fill-rule="evenodd"
                      d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/>
              </svg>
              <span class="text-sm text-white/45">
                {% if srv.location %}{{ srv.location }}{% endif %}{% if srv.location and srv.ip %} · {% endif %}{% if srv.ip %}IP: {{ srv.ip }}{% endif %}
              </span>
            </div>
            {% endif %}
          </div>

          {# Right: Next Payment + Pay Invoice #}
          <div class="flex flex-col items-start md:items-end gap-2 flex-shrink-0">
            {% if order.expires_at %}
            <div class="text-left md:text-right">
              <p class="text-[10px] font-bold text-white/40 uppercase tracking-widest mb-1">{{ 'Next Payment'|trans }}</p>
              <p class="text-sm font-semibold
                {% if daysUntilDue is not null and daysUntilDue <= 7 %}text-red-300
                {% elseif daysUntilDue is not null and daysUntilDue <= 14 %}text-amber-300
                {% else %}text-white{% endif %}">
                {{ order.expires_at|format_date }}
              </p>
            </div>
            {% endif %}
            {% if order.unpaid_invoice_id %}
            <a href="{{ 'invoice'|url }}/{{ _unpaid_hash }}"
               class="srv-pay-invoice inline-flex items-center gap-2 px-5 py-2 rounded-lg text-white text-sm font-semibold transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
              </svg>
              {{ 'Pay Invoice'|trans }}
            </a>
            {% endif %}
          </div>

        </div>
      </section>

      {# Stats Grid with decorative progress bars #}
      <div class="srv-manage-metrics grid grid-cols-2 md:grid-cols-5 gap-3">
        <div class="text-center px-3 py-4 rounded-xl">
          <p class="text-[9px] font-bold uppercase tracking-widest text-white/40 mb-2">vCPU</p>
          <p class="text-xl font-bold text-white">{{ srv.cpu_cores ?: '---' }}</p>
          <div class="srv-meter-track mt-2 w-full h-0.5 rounded-full overflow-hidden">
            <div class="h-full w-1/3" style="background:rgb(var(--brand-500));"></div>
          </div>
        </div>
        <div class="text-center px-3 py-4 rounded-xl">
          <p class="text-[9px] font-bold uppercase tracking-widest text-white/40 mb-2">RAM</p>
          <p class="text-xl font-bold text-white">
            {% if srv.ram_mb %}{{ (srv.ram_mb / 1024)|round(1) }} GB{% else %}---{% endif %}
          </p>
          <div class="srv-meter-track mt-2 w-full h-0.5 rounded-full overflow-hidden">
            <div class="h-full w-1/2" style="background:rgb(var(--brand-500));"></div>
          </div>
        </div>
        <div class="text-center px-3 py-4 rounded-xl">
          <p class="text-[9px] font-bold uppercase tracking-widest text-white/40 mb-2">Disk</p>
          <p class="text-xl font-bold text-white">{% if srv.disk_gb %}{{ srv.disk_gb }} GB{% else %}---{% endif %}</p>
          <div class="srv-meter-track mt-2 w-full h-0.5 rounded-full overflow-hidden">
            <div class="h-full w-2/3" style="background:rgb(var(--brand-500));"></div>
          </div>
        </div>
        <div class="text-center px-3 py-4 rounded-xl">
          <p class="text-[9px] font-bold uppercase tracking-widest text-white/40 mb-2">Traffic</p>
          <p class="text-xl font-bold text-white">{% if srv.bandwidth_gb %}{{ srv.bandwidth_gb }} GB{% else %}Unltd{% endif %}</p>
          <div class="srv-meter-track mt-2 w-full h-0.5 rounded-full overflow-hidden">
            <div class="h-full w-1/4" style="background:rgb(var(--brand-500));"></div>
          </div>
        </div>
        <div class="text-center px-3 py-4 rounded-xl col-span-2 md:col-span-1">
          <p class="text-[9px] font-bold uppercase tracking-widest text-white/40 mb-2">Price</p>
          <p class="text-xl font-bold" style="color:rgb(var(--brand-400));">
            {% if order.price %}{{ order.price|money(order.currency) }}{% else %}---{% endif %}
          </p>
          {% if order.period %}<p class="text-[10px] text-white/40 mt-1">/ {{ order.period|period_title }}</p>{% endif %}
        </div>
      </div>

    </div>
    {# End Left 2/3 #}

    {# Right 1/3 — Billing Summary (full-height, Pay button at bottom) #}
    <section class="srv-manage-card srv-billing-summary p-5 flex flex-col" aria-labelledby="srv-billing-summary-title">
      <div class="flex items-center justify-between mb-6">
        <h3 id="srv-billing-summary-title" class="font-bold text-white">{{ 'Billing Summary'|trans }}</h3>
        <svg class="w-5 h-5 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </div>

      <div class="space-y-4 flex-1">
        <div class="flex justify-between items-center text-sm">
          <span class="text-white/45">{{ 'Plan'|trans }}</span>
          <span class="font-semibold text-white text-right max-w-[60%] truncate" title="{{ order.title }}">{{ order.title }}</span>
        </div>
        <div class="flex justify-between items-center text-sm">
          <span class="text-white/45">{{ 'Billing Cycle'|trans }}</span>
          <span class="font-semibold text-white">
            {% if order.price %}{{ order.price|money(order.currency) }} / {{ order.period|period_title }}{% else %}N/A{% endif %}
          </span>
        </div>
        <div class="flex justify-between items-center text-sm">
          <span class="text-white/45">{{ 'Status'|trans }}</span>
          <span class="font-bold uppercase text-sm
            {% if srv.status == 'active' %}text-emerald-400
            {% elseif srv.status == 'suspended' %}text-amber-400
            {% else %}text-red-400{% endif %}">
            {{ srv.status }}
          </span>
        </div>
        {% if order.expires_at %}
        <div class="flex justify-between items-center text-sm pt-4 border-t border-white/[0.06]">
          <span class="text-white/45">{{ 'Next due'|trans }}</span>
          <span class="font-bold
            {% if daysUntilDue is not null and daysUntilDue <= 7 %}text-red-400
            {% elseif daysUntilDue is not null and daysUntilDue <= 14 %}text-amber-400
            {% else %}text-white{% endif %}">
            {{ order.expires_at|format_date }}
          </span>
        </div>
        {% endif %}
      </div>

      <a href="{{ order.unpaid_invoice_id ? (('invoice'|url) ~ '/' ~ _unpaid_hash) : ('/client/invoices'|url) }}"
         class="srv-pay-invoice mt-8 w-full inline-flex items-center justify-center gap-2 py-3 rounded-xl text-white font-semibold text-sm transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        {{ order.unpaid_invoice_id ? ('Quick Pay Invoice'|trans) : ('View Invoices'|trans) }}
      </a>
    </section>

  </div>
  {# ═══ END SECTION 1 ═══ #}


  {# ═══ SECTION 2 — SSH / Control Panels / Server Info (left 2/3) + Actions / Addons (right 1/3) ═══ #}
  <div class="srv-manage-content grid grid-cols-1 xl:grid-cols-3 gap-5">

    {# Left 2/3 #}
    <div class="xl:col-span-2 space-y-6">

      {# SSH Access #}
      <div class="srv-manage-card overflow-hidden">
        <div class="px-5 py-4 border-b border-white/[0.06] bg-white/[0.015] flex items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <h3 class="font-bold text-white">{{ 'SSH Access'|trans }}</h3>
          </div>
          <span class="text-xs font-mono text-white/35 bg-white/5 px-2.5 py-1 rounded border border-white/10">PORT: 22</span>
        </div>
        <div class="p-6 space-y-6">

          {% if srv.ip %}
          <div>
            <p class="text-[10px] font-bold text-white/40 uppercase tracking-widest mb-3">{{ 'Quick Connect'|trans }}</p>
            <div class="srv-ssh-command flex items-center justify-between px-4 py-3.5 rounded-lg">
              <code class="text-indigo-300 font-mono text-sm select-all">ssh root@{{ srv.ip }}</code>
              <button onclick="(function(b){navigator.clipboard.writeText(b.previousElementSibling.textContent).then(function(){b.classList.add('text-white');setTimeout(function(){b.classList.remove('text-white');},1500);})})(this)"
                      aria-label="{{ 'Copy SSH command'|trans }}"
                      class="ml-3 flex-shrink-0 text-white/25 hover:text-white transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
                </svg>
              </button>
            </div>
          </div>
          {% endif %}

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <p class="text-[10px] font-bold text-white/40 uppercase tracking-widest mb-1.5">{{ 'IP Address'|trans }}</p>
              <div class="flex items-center gap-2">
                <span class="font-mono font-semibold {% if srv.ip %}text-white{% else %}text-white/30{% endif %}">
                  {{ srv.ip ?: ('Not assigned'|trans) }}
                </span>
                {% if srv.ip %}
                <button onclick="(function(b){var t=b.previousElementSibling;navigator.clipboard.writeText(t.textContent.trim()).then(function(){b.classList.add('text-indigo-400');setTimeout(function(){b.classList.remove('text-indigo-400');},1500);})})(this)"
                        aria-label="{{ 'Copy IP address'|trans }}"
                        class="text-white/25 hover:text-indigo-400 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2"/>
                  </svg>
                </button>
                {% endif %}
              </div>
            </div>
            {% if srv.hostname %}
            <div>
              <p class="text-[10px] font-bold text-white/40 uppercase tracking-widest mb-1.5">{{ 'Hostname'|trans }}</p>
              <div class="flex items-center gap-2">
                <span class="font-mono font-semibold text-white truncate">{{ srv.hostname }}</span>
                <button onclick="(function(b){var t=b.previousElementSibling;navigator.clipboard.writeText(t.textContent.trim()).then(function(){b.classList.add('text-indigo-400');setTimeout(function(){b.classList.remove('text-indigo-400');},1500);})})(this)"
                        aria-label="{{ 'Copy hostname'|trans }}"
                        class="text-white/25 hover:text-indigo-400 transition-colors flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2"/>
                  </svg>
                </button>
              </div>
            </div>
            {% endif %}
          </div>

          <div class="srv-info-note flex items-start gap-3 p-4 rounded-lg border border-indigo-500/20">
            <svg class="w-5 h-5 text-indigo-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="text-xs text-indigo-300 leading-relaxed">
              {{ 'Root password and full credentials were sent to your registered email at provisioning. If you need a password reset, please'|trans }}
              <a href="{{ '/support'|url }}" class="font-bold underline underline-offset-2 hover:text-white transition-colors">{{ 'contact support'|trans }}</a>.
            </p>
          </div>

        </div>
      </div>

      {# Control Panel Access #}
      {% if srv.ip %}
      <div class="srv-manage-card srv-control-panels overflow-hidden">
        <div class="px-5 py-4 border-b border-white/[0.06] bg-white/[0.015] flex items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <h3 class="font-bold text-white">{{ 'Control Panel Access'|trans }}</h3>
          </div>
          <span class="text-xs text-white/25">{{ 'Opens in new tab'|trans }}</span>
        </div>
        <div class="p-5">
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {% set panels = [
              { name: 'cPanel',      port: '2083',  color: 'rgba(var(--brand-500),.15)',  tcolor: 'text-indigo-400',  icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9' },
              { name: 'WHM',         port: '2087',  color: 'rgba(59,130,246,.15)',  tcolor: 'text-blue-400',    icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z' },
              { name: 'Plesk',       port: '8443',  color: 'rgba(16,185,129,.15)',  tcolor: 'text-emerald-400', icon: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
              { name: 'DirectAdmin', port: '2222',  color: 'rgba(245,158,11,.15)',  tcolor: 'text-amber-400',   icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z' },
              { name: 'Webmin',      port: '10000', color: 'rgba(139,92,246,.15)',  tcolor: 'text-violet-400',  icon: 'M5 12h14M12 5l7 7-7 7' },
              { name: 'Proxmox VE',  port: '8006',  color: 'rgba(239,68,68,.15)',   tcolor: 'text-red-400',     icon: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z' }
            ] %}
            {% for panel in panels %}
            <a href="https://{{ srv.ip }}:{{ panel.port }}" target="_blank" rel="noopener"
               class="group flex items-center gap-3 px-4 py-3.5 rounded-xl border border-white/[0.06]
                      hover:border-white/[0.14] transition-all"
               style="background:rgba(255,255,255,0.02);">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform"
                   style="background:{{ panel.color }};">
                <svg class="w-4 h-4 {{ panel.tcolor }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="{{ panel.icon }}"/>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-sm font-medium text-white/65 group-hover:text-white transition-colors truncate">{{ panel.name }}</p>
                <p class="text-[10px] text-white/25 font-mono mt-0.5">:{{ panel.port }}</p>
              </div>
            </a>
            {% endfor %}
          </div>
          <p class="mt-3.5 flex items-start gap-1.5 text-xs text-white/25">
            <svg class="w-3.5 h-3.5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {{ 'Direct links to'|trans }} {{ srv.ip }}. {{ 'Only works if the control panel is installed on your VPS.'|trans }}
          </p>
        </div>
      </div>
      {% endif %}

      {# Server Information — 2×3 boxed fact grid #}
      <div class="srv-manage-card overflow-hidden">
        <div class="px-5 py-4 border-b border-white/[0.06] bg-white/[0.015] flex items-center gap-2">
          <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <h3 class="font-bold text-white">{{ 'Server Information'|trans }}</h3>
        </div>
        <div class="p-5">
          <div class="srv-manage-facts grid grid-cols-1 md:grid-cols-2 gap-4">

            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-1">{{ 'Plan'|trans }}</p>
              <p class="text-lg font-bold text-white">{{ order.title }}</p>
            </div>

            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-1">{{ 'Operating System'|trans }}</p>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-white/25 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"
                        d="M9.75 17L9 21h6l-.75-4M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <p class="text-lg font-bold text-white">{{ srv.os ?: ('Not set'|trans) }}</p>
              </div>
            </div>

            {% if srv.location %}
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-1">{{ 'Datacenter Location'|trans }}</p>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-white/25 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path clip-rule="evenodd" fill-rule="evenodd"
                        d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/>
                </svg>
                <p class="text-lg font-bold text-white">{{ srv.location }}</p>
              </div>
            </div>
            {% endif %}

            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-1">{{ 'Order ID'|trans }}</p>
              <p class="text-lg font-bold text-white font-mono">#{{ order.id }}</p>
            </div>

            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-1">{{ 'Since'|trans }}</p>
              <p class="text-lg font-bold text-white">
                {{ (srv.created_at and srv.created_at != '---') ? srv.created_at|format_date : (order.created_at ? order.created_at|format_date : 'Unknown') }}
              </p>
            </div>

            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-1">{{ 'Next Due Date'|trans }}</p>
              <p class="text-lg font-bold
                {% if daysUntilDue is not null and daysUntilDue <= 7 %}text-red-400
                {% elseif daysUntilDue is not null and daysUntilDue <= 14 %}text-amber-400
                {% else %}text-white{% endif %}">
                {{ order.expires_at ? order.expires_at|format_date : ('Not set'|trans) }}
              </p>
            </div>

          </div>
        </div>
      </div>

    </div>
    {# End Left 2/3 #}

    {# Right 1/3 — Quick Actions + Available Addons #}
    <aside class="srv-manage-rail space-y-5" aria-label="{{ 'Server actions and addons'|trans }}">

      {# Quick Actions — chevron style matching design #}
      <section class="srv-manage-card srv-quick-actions p-5" aria-labelledby="srv-quick-actions-title">
        <h3 id="srv-quick-actions-title" class="font-bold text-white mb-3 flex items-center gap-2">
          <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          {{ 'Quick Actions'|trans }}
        </h3>
        <div class="space-y-1">
          <a href="{{ '/support'|url }}"
             class="w-full flex items-center justify-between p-3 rounded-lg hover:bg-white/[0.05] transition-colors group">
            <span class="text-sm font-medium text-white/65 group-hover:text-white">{{ 'Open Support Ticket'|trans }}</span>
            <svg class="w-4 h-4 text-white/25 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="{{ '/order/service'|url }}"
             class="w-full flex items-center justify-between p-3 rounded-lg hover:bg-white/[0.05] transition-colors group">
            <span class="text-sm font-medium text-white/65 group-hover:text-white">{{ 'All My Services'|trans }}</span>
            <svg class="w-4 h-4 text-white/25 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="{{ '/order'|url }}"
             class="w-full flex items-center justify-between p-3 rounded-lg hover:bg-white/[0.05] transition-colors group">
            <span class="text-sm font-medium text-white/65 group-hover:text-white">{{ 'Upgrade / Add-ons'|trans }}</span>
            <svg class="w-4 h-4 text-white/25 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="{{ '/support'|url }}?subject=Cancellation+Request+%23{{ order.id }}"
             class="w-full flex items-center justify-between p-3 rounded-lg hover:bg-red-500/5 transition-colors group">
            <span class="text-sm font-medium text-red-400/60 group-hover:text-red-400">{{ 'Cancellation Request'|trans }}</span>
            <svg class="w-4 h-4 text-red-400/30 group-hover:text-red-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </section>

      {# Available Addons — compact manual carousel #}
      {% if avail_addons|length > 0 %}
      <section class="srv-manage-card srv-available-addons overflow-hidden" aria-labelledby="srv-available-addons-title">

        <div class="px-5 pt-5 pb-3 flex items-center gap-2">
          <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
          </svg>
          <h3 id="srv-available-addons-title" class="font-bold text-white flex-1">{{ 'Available Addons'|trans }}</h3>
          <span class="text-[11px] font-medium px-2 py-0.5 rounded-full border border-indigo-500/30 bg-indigo-500/10 text-indigo-400">
            {{ avail_addons|length }}
          </span>
        </div>

        {# Card carousel — one card at a time, prev/next arrows, dot indicators #}
        <div x-data="{ current: 0, total: {{ avail_addons|length }} }">

          {# One card at a time — x-show fade, no overflow clipping so full card is always visible #}
          <div class="srv-addon-carousel-stage px-5 pb-2">
            {% for addon in avail_addons %}
            <article x-cloak
                     x-show="current === {{ loop.index0 }}"
                     x-transition:enter="transition-opacity duration-200 ease-out"
                     x-transition:enter-start="opacity-0"
                     x-transition:enter-end="opacity-100"
                     x-transition:leave="transition-opacity duration-150 ease-in"
                     x-transition:leave-start="opacity-100"
                     x-transition:leave-end="opacity-0"
                     class="srv-addon-option flex flex-col p-4 rounded-xl">
              <p class="text-sm font-bold text-white mb-1">{{ addon.title }}</p>
              {% if addon.description %}
              <p class="srv-addon-description text-xs text-white/40 mb-3 leading-relaxed">
                {{- addon.description|striptags|slice(0, 110) -}}{% if addon.description|length > 110 %}…{% endif %}
              </p>
              {% else %}
              <p class="srv-addon-description text-xs text-white/35 mb-3">{{ 'Extend your server capabilities.'|trans }}</p>
              {% endif %}
              <a href="{{ '/order'|url }}"
                 class="srv-addon-cta mt-auto flex min-h-[36px] w-full items-center justify-center rounded-lg px-3 py-2 text-center text-xs font-semibold text-white transition-colors">
                {{- 'Add'|trans -}}{% if addon.price is defined and addon.price %} – {{ addon.price|money(addon.currency ?? order.currency) }}/{{ (addon.period ?? 'month')|period_title }}{% endif %}
              </a>
            </article>
            {% endfor %}
          </div>

          {# Controls: dots left, arrows right #}
          <div class="flex items-center justify-between px-5 pb-4 pt-1">
            {# Dot indicators #}
            <div class="flex items-center gap-1.5">
              {% for addon in avail_addons %}
              <button @click="current = {{ loop.index0 }}"
                      :class="current === {{ loop.index0 }} ? 'w-4 bg-indigo-400' : 'w-1.5 bg-white/20 hover:bg-white/40'"
                      class="h-1.5 rounded-full transition-all duration-200"
                      aria-label="{{ 'Go to addon'|trans }} {{ loop.index }}"></button>
              {% endfor %}
            </div>
            {# Prev / Next arrows #}
            <div class="flex items-center gap-1">
              <button @click="current = current > 0 ? current - 1 : total - 1"
                      class="w-7 h-7 rounded-lg flex items-center justify-center text-white/30 hover:text-white hover:bg-white/[0.07] transition-all"
                      aria-label="{{ 'Previous addon'|trans }}">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
              </button>
              <button @click="current = current < total - 1 ? current + 1 : 0"
                      class="w-7 h-7 rounded-lg flex items-center justify-center text-white/30 hover:text-white hover:bg-white/[0.07] transition-all"
                      aria-label="{{ 'Next addon'|trans }}">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
          </div>

        </div>

      </section>
      {% endif %}

    </aside>
    {# End Right 1/3 #}

  </div>
  {# ═══ END SECTION 2 ═══ #}


  {# ═══ Subscribed Addons — full-width bottom section ═══ #}
  {% if addons|length > 0 %}
  <div class="srv-manage-card srv-manage-addons overflow-hidden">
    <div class="px-5 py-4 border-b border-white/[0.06] bg-white/[0.015] flex items-center justify-between gap-3">
      <h3 class="font-bold text-white flex items-center gap-2">
        <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
        {{ 'My Active Addons'|trans }}
      </h3>
      <span class="text-[11px] font-medium px-2.5 py-0.5 rounded-full border border-indigo-500/30 bg-indigo-500/10 text-indigo-400">
        {{ addons|length }}
      </span>
    </div>
    <div class="srv-manage-addons-head hidden sm:grid grid-cols-12 px-5 py-2.5 border-b border-white/[0.04]">
      <p class="col-span-5 text-[10px] font-semibold uppercase tracking-widest text-white/25">{{ 'Addon'|trans }}</p>
      <p class="col-span-3 text-[10px] font-semibold uppercase tracking-widest text-white/25">{{ 'Billing'|trans }}</p>
      <p class="col-span-2 text-[10px] font-semibold uppercase tracking-widest text-white/25">{{ 'Renews'|trans }}</p>
      <p class="col-span-2 text-[10px] font-semibold uppercase tracking-widest text-white/25 text-right">{{ 'Status'|trans }}</p>
    </div>
    <div class="divide-y divide-white/[0.04]">
      {% for addon in addons %}
      <div class="srv-manage-addon-row grid grid-cols-12 items-center px-5 py-3.5 hover:bg-white/[0.02] transition-colors">
        <div class="col-span-12 sm:col-span-5 min-w-0 mb-2 sm:mb-0">
          <p class="text-sm font-medium text-white truncate">{{ addon.title }}</p>
        </div>
        <div class="col-span-6 sm:col-span-3">
          <p class="text-sm text-white/55">{% if addon.price %}{{ addon.price|money(addon.currency) }}/{{ addon.period|period_title }}{% else %}N/A{% endif %}</p>
        </div>
        <div class="col-span-6 sm:col-span-2">
          <p class="text-sm text-white/35">{{ addon.expires_at ? addon.expires_at|format_date : 'N/A' }}</p>
        </div>
        <div class="col-span-10 sm:col-span-1 sm:flex sm:justify-end">
          <span class="inline-flex items-center gap-1 text-[11px] font-medium px-2 py-0.5 rounded-full
            {% if addon.status == 'active' %}border border-emerald-500/30 bg-emerald-500/10 text-emerald-400
            {% elseif addon.status == 'suspended' %}border border-amber-500/30 bg-amber-500/10 text-amber-400
            {% else %}border border-white/10 bg-white/5 text-white/35{% endif %}">
            <span class="w-1.5 h-1.5 rounded-full
              {% if addon.status == 'active' %}bg-emerald-400
              {% elseif addon.status == 'suspended' %}bg-amber-400
              {% else %}bg-white/35{% endif %}"></span>
            {{ addon.status|replace({'_': ' '})|capitalize }}
          </span>
        </div>
        <div class="col-span-2 sm:col-span-1 flex justify-end">
          <a href="{{ '/order/service/manage'|url }}/{{ addon.id }}"
             class="text-xs px-2.5 py-1.5 rounded-lg border border-white/10 bg-white/[0.03] text-white/35
                    hover:text-white hover:border-white/20 transition-all">
            {{ 'Manage'|trans }}
          </a>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

</div>
{% endif %}
