{% block subject %}[{{ guest.system_company.name }}] {{ order.title|default('') }} Activated{% endblock %}
{% block content %}
{% set order = order|default({}) %}
{% set service = service|default({}) %}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style type="text/css">
        body { font-family: Arial, sans-serif; font-size: 14px; color: #333333; }
        h1 { font-size: 24px; font-weight: bold; margin: 0 0 20px; }
        h2 { font-size: 18px; font-weight: bold; margin: 20px 0 10px; }
        p { margin: 0 0 10px; }
        ul { margin: 0 0 15px; padding-left: 20px; }
        li { margin-bottom: 4px; }
        .signature { font-style: italic; color: #999999; margin-top: 20px; border-top: 1px solid #cccccc; padding-top: 10px; }
    </style>
</head>
<body>
    <h1>Server Activated</h1>
    <p>Hello {{ c.first_name|default('') }} {{ c.last_name|default('') }},</p>
    <p>Your server has been provisioned and is now active. Below are your server details.</p>

    <h2>{{ order.title|default('') }}</h2>
    <ul>
        <li><strong>Activated:</strong> {{ order.activated_at|default('')|format_date }}</li>
        {% if order.expires_at|default(false) %}<li><strong>Renews:</strong> {{ order.expires_at|default('')|format_date }}</li>{% endif %}
        {% if order.period|default(false) %}<li><strong>Billing:</strong> {{ order.total|default(0)|format_currency(order.currency|default('')) }} every {{ order.period|default('')|period_title }}</li>{% endif %}
    </ul>

    <h2>Server Details</h2>
    <ul>
        {% if service.hostname|default('') %}<li><strong>Hostname:</strong> {{ service.hostname }}</li>{% endif %}
        {% if service.ip|default('') %}<li><strong>IP Address:</strong> {{ service.ip }}</li>{% endif %}
        {% if service.os|default('') %}<li><strong>Operating System:</strong> {{ service.os }}</li>{% endif %}
        {% if service.location|default('') %}<li><strong>Location:</strong> {{ service.location }}</li>{% endif %}
        {% if service.cpu_cores|default('') %}<li><strong>CPU Cores:</strong> {{ service.cpu_cores }}</li>{% endif %}
        {% if service.ram_mb|default('') %}<li><strong>RAM:</strong> {{ service.ram_mb }} MB</li>{% endif %}
        {% if service.disk_gb|default('') %}<li><strong>Disk:</strong> {{ service.disk_gb }} GB</li>{% endif %}
        {% if service.bandwidth_gb|default('') %}<li><strong>Bandwidth:</strong> {{ service.bandwidth_gb }} GB</li>{% endif %}
    </ul>

    <p>You can manage your server from the <a href="{{ 'order/service/manage/'~order.id|default('')|url(area: 'client') }}">client area</a>.</p>

    <div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
