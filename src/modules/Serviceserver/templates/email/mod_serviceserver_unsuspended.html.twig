{% block subject %}[{{ guest.system_company.name }}] {{ order.title|default('') }} Reactivated{% endblock %}
{% block content %}
{% set order = order|default({}) %}
{% set service = service|default({}) %}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style type="text/css">
        body { font-family: Arial, sans-serif; font-size: 14px; color: #333333; }
        h1 { font-size: 24px; font-weight: bold; margin: 0 0 20px; }
        h2 { font-size: 18px; font-weight: bold; margin: 20px 0 10px; }
        p { margin: 0 0 10px; }
        ul { margin: 0 0 15px; padding-left: 20px; }
        li { margin-bottom: 4px; }
        .signature { font-style: italic; color: #999999; margin-top: 20px; border-top: 1px solid #cccccc; padding-top: 10px; }
    </style>
</head>
<body>
    <h1>Server Reactivated</h1>
    <p>Hello {{ c.first_name|default('') }} {{ c.last_name|default('') }},</p>
    <p>Your server has been reactivated and is now accessible again.</p>

    <h2>{{ order.title|default('') }}</h2>
    <ul>
        {% if service.hostname|default('') %}<li><strong>Hostname:</strong> {{ service.hostname }}</li>{% endif %}
        {% if service.ip|default('') %}<li><strong>IP Address:</strong> {{ service.ip }}</li>{% endif %}
        {% if service.os|default('') %}<li><strong>Operating System:</strong> {{ service.os }}</li>{% endif %}
        {% if order.expires_at|default(false) %}<li><strong>Next renewal:</strong> {{ order.expires_at|default('')|format_date }}</li>{% endif %}
    </ul>

    <p>Manage your server in the <a href="{{ 'order/service/manage/'~order.id|default('')|url(area: 'client') }}">client area</a>.</p>

    <div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
